diff --git a/src/sw_raster_bounds.h b/src/sw_raster_bounds.h
new file mode 100644
index 0000000..f723c0a
--- /dev/null
+++ b/src/sw_raster_bounds.h
@@ -0,0 +1,11 @@
+#pragma once
+
+#include <math.h>
+#include <stdint.h>
+
+// Raster coverage is evaluated at pixel centers. This same half-open rule is
+// used for both the first covered pixel and the exclusive end of an edge.
+static inline int32_t swPixelCoverageEdge(float edge)
+{
+    return (int32_t)ceilf(edge - 0.5f);
+}
