diff --git a/src/crt_ui_inset.h b/src/crt_ui_inset.h
new file mode 100644
index 0000000..db78373
--- /dev/null
+++ b/src/crt_ui_inset.h
@@ -0,0 +1,37 @@
+// SPDX-License-Identifier: AGPL-3.0-only
+
+#ifndef _BS_CRT_UI_INSET_H_
+#define _BS_CRT_UI_INSET_H_
+
+#include <stdint.h>
+
+// Keep edge UI at native pixel size. Only elements which actually enter the
+// sixteen-line overscan band move; full-screen artwork and gameplay layers do
+// not qualify.
+static inline int32_t CrtUi_verticalOffset(int32_t frameHeight,
+                                            int32_t minY, int32_t maxY,
+                                            uint32_t inset) {
+    if (frameHeight <= 0 || minY >= maxY || inset == 0) return 0;
+    if (inset > (uint32_t)(frameHeight / 4)) inset = (uint32_t)(frameHeight / 4);
+
+    const int32_t edgeBand = 16;
+    const int32_t middle = frameHeight / 2;
+    if (minY < edgeBand && maxY <= middle) return (int32_t)inset;
+    if (maxY > frameHeight - edgeBand && minY >= middle) return -(int32_t)inset;
+    return 0;
+}
+
+// AM2R 1.1 draws the small version tag and project URL as separate BGND
+// resources in titleroom. Keep those two UI overlays visible without moving
+// the title artwork behind them. The resource IDs are stable for the only
+// supported data.win revision and are additionally gated by the room ID.
+static inline int32_t CrtUi_am2rTitleBackgroundOffset(int32_t roomIndex,
+                                                       int32_t backgroundIndex,
+                                                       uint32_t inset) {
+    if (roomIndex != 1 || inset == 0) return 0;
+    if (backgroundIndex == 164) return (int32_t)inset;
+    if (backgroundIndex == 165) return -(int32_t)inset;
+    return 0;
+}
+
+#endif
