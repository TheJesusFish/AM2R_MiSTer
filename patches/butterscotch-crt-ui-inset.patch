 } SWVertex;
 
+#ifdef USE_MISTER
+static void swApplyCrtUiTextOffset(SWRenderer* sw, SWVertex vertices[4]) {
+    int32_t minY = (int32_t)floorf(vertices[0].y);
+    int32_t maxY = (int32_t)ceilf(vertices[0].y);
+    for (int i = 1; i < 4; ++i) {
+        int32_t y0 = (int32_t)floorf(vertices[i].y);
+        int32_t y1 = (int32_t)ceilf(vertices[i].y);
+        if (y0 < minY) minY = y0;
+        if (y1 > maxY) maxY = y1;
+    }
+    int32_t offset = CrtUi_verticalOffset(sw->hostHeight, minY, maxY,
+                                          MisterGpu_getCrtUiInset());
+    if (offset != 0) {
+        for (int i = 0; i < 4; ++i) vertices[i].y += (float)offset;
+    }
+}
+#endif
