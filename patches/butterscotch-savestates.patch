+#ifdef USE_MISTER
+static int am2rStateFd = -1;
+static volatile sig_atomic_t am2rStateSignalAction = 0;
+static volatile sig_atomic_t am2rStateSignalSlot = 0;
+
+static void am2rStateSignalHandler(int signalNumber) {
+    int offset = signalNumber - SIGRTMIN;
+    if (offset >= 0 && offset < AM2R_STATE_SLOT_COUNT) {
+        am2rStateSignalAction = AM2R_STATE_REQUEST_SAVE;
+        am2rStateSignalSlot = offset;
+    } else if (offset >= AM2R_STATE_SLOT_COUNT && offset < AM2R_STATE_SLOT_COUNT * 2) {
+        am2rStateSignalAction = AM2R_STATE_REQUEST_LOAD;
+        am2rStateSignalSlot = offset - AM2R_STATE_SLOT_COUNT;
+    }
+}
+
+static void am2rStateInit(void) {
+    const char* value = getenv(AM2R_STATE_FD_ENV);
+    if (value == nullptr || value[0] == '\0') return;
+    char* end = nullptr;
+    long fd = strtol(value, &end, 10);
+    if (end == value || *end != '\0' || fd < 0 || fd > INT32_MAX) return;
+    am2rStateFd = (int)fd;
+    int flags = fcntl(am2rStateFd, F_GETFL, 0);
+    if (flags >= 0) fcntl(am2rStateFd, F_SETFL, flags | O_NONBLOCK);
+    signal(SIGCHLD, SIG_IGN);
+    struct sigaction action = {0};
+    action.sa_handler = am2rStateSignalHandler;
+    sigemptyset(&action.sa_mask);
+    for (int i = 0; i < AM2R_STATE_SLOT_COUNT * 2; ++i)
+        sigaction(SIGRTMIN + i, &action, nullptr);
+    logInfo("AM2R save states: four RAM slots enabled (protocol fd %d)\n", am2rStateFd);
+}
+
+static bool am2rStateSend(Am2rStateMessageType type, int slot, int frame, int error) {
+    if (am2rStateFd < 0) return false;
+    Am2rStateMessage message = {
+        .magic = AM2R_STATE_MAGIC,
+        .type = (uint32_t)type,
+        .slot = slot,
+        .pid = (int32_t)getpid(),
+        .frame = frame,
+        .error = error,
+    };
+    return send(am2rStateFd, &message, sizeof(message), MSG_NOSIGNAL) == (ssize_t)sizeof(message);
+}
+
+static bool am2rStateReceive(Am2rStateMessage* message) {
+    if (am2rStateFd < 0) return false;
+    ssize_t count = recv(am2rStateFd, message, sizeof(*message), MSG_DONTWAIT);
+    return count == (ssize_t)sizeof(*message) && message->magic == AM2R_STATE_MAGIC;
+}
+
+// Returns true only in a snapshot process that has just been restored.
+static bool am2rStateSave(Runner* runner, int slot) {
+#ifdef USE_MINIAUDIO
+    if (!MaAudioSystem_prepareSaveState(runner->audioSystem)) {
+        am2rStateSend(AM2R_STATE_SNAPSHOT_ERROR, slot, runner->frameCount, EIO);
+        return false;
+    }
+#else
+    runner->audioSystem->vtable->suspend(runner->audioSystem);
+#endif
+    if (!MisterGpu_prepareSaveState()) {
+#ifdef USE_MINIAUDIO
+        MaAudioSystem_restoreSaveState(runner->audioSystem);
+#else
+        runner->audioSystem->vtable->resume(runner->audioSystem);
+#endif
+        am2rStateSend(AM2R_STATE_SNAPSHOT_ERROR, slot, runner->frameCount, EIO);
+        return false;
+    }
+    fflush(nullptr);
+
+    pid_t snapshot = fork();
+    if (snapshot < 0) {
+        int savedError = errno;
+#ifdef USE_MINIAUDIO
+        MaAudioSystem_restoreSaveState(runner->audioSystem);
+#else
+        runner->audioSystem->vtable->resume(runner->audioSystem);
+#endif
+        am2rStateSend(AM2R_STATE_SNAPSHOT_ERROR, slot, runner->frameCount, savedError);
+        logWarn("AM2R save state %d failed: %s\n", slot + 1, strerror(savedError));
+        return false;
+    }
+
+    if (snapshot == 0) {
+        // A loaded slot is cloned again before it resumes, so loading is
+        // non-destructive and behaves like the four reusable slots in NES.
+        for (;;) {
+            am2rStateSend(AM2R_STATE_SNAPSHOT_READY, slot, runner->frameCount, 0);
+            raise(SIGSTOP);
+            int parentSignal = 0;
+            prctl(PR_GET_PDEATHSIG, &parentSignal);
+            logError("AM2R save state %d resume stage=awake pid=%d ppid=%d pdeath=%d\n",
+                     slot + 1, (int)getpid(), (int)getppid(), parentSignal);
+            pid_t retained = fork();
+            if (retained == 0) continue;
+            if (retained < 0)
+                am2rStateSend(AM2R_STATE_SNAPSHOT_ERROR, slot, runner->frameCount, errno);
+            break;
+        }
+        logError("AM2R save state %d resume stage=gpu-begin pid=%d\n", slot + 1, (int)getpid());
+        MisterGpu_afterSaveStateRestore();
+        logError("AM2R save state %d resume stage=gpu-done pid=%d\n", slot + 1, (int)getpid());
+#ifdef USE_MINIAUDIO
+        if (!MaAudioSystem_restoreSaveState(runner->audioSystem)) {
+            am2rStateSend(AM2R_STATE_SNAPSHOT_ERROR, slot, runner->frameCount, EIO);
+            _exit(125);
+        }
+#else
+        runner->audioSystem->vtable->resume(runner->audioSystem);
+#endif
+        logError("AM2R save state %d resume stage=audio-done pid=%d\n", slot + 1, (int)getpid());
+        am2rStateSend(AM2R_STATE_RESTORED, slot, runner->frameCount, 0);
+        logInfo("AM2R save state %d restored at frame %d\n", slot + 1, runner->frameCount);
+        return true;
+    }
+
+#ifdef USE_MINIAUDIO
+    if (!MaAudioSystem_restoreSaveState(runner->audioSystem)) {
+        am2rStateSend(AM2R_STATE_SNAPSHOT_ERROR, slot, runner->frameCount, EIO);
+        return false;
+    }
+#else
+    runner->audioSystem->vtable->resume(runner->audioSystem);
+#endif
+    logInfo("AM2R save state %d captured at frame %d (snapshot pid %d)\n",
+            slot + 1, runner->frameCount, (int)snapshot);
+    return false;
+}
+
+static void am2rStateLoad(Runner* runner, int slot) {
+    runner->audioSystem->vtable->suspend(runner->audioSystem);
+    if (!MisterGpu_prepareSaveState() ||
+        !am2rStateSend(AM2R_STATE_REQUEST_LOAD, slot, runner->frameCount, 0)) {
+        runner->audioSystem->vtable->resume(runner->audioSystem);
+        logWarn("AM2R save state %d load request failed\n", slot + 1);
+        return;
+    }
+
+    // A successful request terminates this active timeline and resumes the
+    // selected stopped snapshot.  Only a missing-slot response returns here.
+    for (int wait = 0; wait < 500; ++wait) {
+        Am2rStateMessage response = {0};
+        if (am2rStateReceive(&response) && response.type == AM2R_STATE_LOAD_MISSING &&
+            response.slot == slot) {
+            runner->audioSystem->vtable->resume(runner->audioSystem);
+            logWarn("AM2R save state %d is empty\n", slot + 1);
+            return;
+        }
+        usleep(1000);
+    }
+    runner->audioSystem->vtable->resume(runner->audioSystem);
+    logWarn("AM2R save state %d load request timed out\n", slot + 1);
+}
+
+static bool am2rStatePoll(Runner* runner) {
+    if (am2rStateFd < 0) return false;
+
+    int action = 0;
+    int slot = -1;
+    Am2rStateMessage command = {0};
+    while (am2rStateReceive(&command)) {
+        if ((command.type == AM2R_STATE_REQUEST_SAVE || command.type == AM2R_STATE_REQUEST_LOAD) &&
+            command.slot >= 0 && command.slot < AM2R_STATE_SLOT_COUNT) {
+            action = (int)command.type;
+            slot = command.slot;
+        }
+    }
+
+    if (am2rStateSignalAction != 0) {
+        action = (int)am2rStateSignalAction;
+        slot = (int)am2rStateSignalSlot;
+        am2rStateSignalAction = 0;
+    }
+
+    static const int keys[AM2R_STATE_SLOT_COUNT] = { VK_F1, VK_F2, VK_F3, VK_F4 };
+    for (int i = 0; i < AM2R_STATE_SLOT_COUNT; ++i) {
+        if (!RunnerKeyboard_checkPressed(runner->keyboard, keys[i])) continue;
+        action = RunnerKeyboard_check(runner->keyboard, VK_ALT) ?
+            AM2R_STATE_REQUEST_SAVE : AM2R_STATE_REQUEST_LOAD;
+        slot = i;
+    }
+
+    if (action == AM2R_STATE_REQUEST_SAVE) return am2rStateSave(runner, slot);
+    if (action == AM2R_STATE_REQUEST_LOAD) am2rStateLoad(runner, slot);
+    return false;
+}
