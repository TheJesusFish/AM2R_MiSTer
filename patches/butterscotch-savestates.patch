+
+void MisterGpu_afterSaveStateRestore(void) {
+    if (!g_gpu_available) return;
+
+    // The CPU address space came from the selected snapshot, while the shared
+    // DDR texture pool and FPGA mailbox were most recently used by another
+    // process.  Re-publish every texture owned by this snapshot before the
+    // restored game can submit a new frame.
+    g_gpu_control[0] = 0;
+    __sync_synchronize();
+    g_gpu_pending = false;
+    g_gpu_presented = false;
+    g_gpu_software_frame = false;
+    g_gpu_command_count = 0;
+    g_gpu_write_buffer = 0;
+    g_gpu_commands = g_gpu_command_buffers[0];
+    g_gpu_sequence = g_gpu_control[6];
+    g_gpu_pending_sequence = 0;
+
+    for (uint32_t i = 0; i < g_gpu_texture_record_count; ++i) {
+        MisterGpuTexture* record = &g_gpu_texture_records[i];
+        if (record->shadow == NULL || record->bytes == 0) continue;
+        for (uint32_t copy = 0; copy < (record->dynamic ? 2u : 1u); ++copy) {
+            size_t offset = (size_t)(record->physical[copy] - GPU_TEXTURE_PHYS);
+            if (offset <= GPU_TEXTURE_BYTES && record->bytes <= GPU_TEXTURE_BYTES - offset)
+                memcpy(g_gpu_textures + offset, record->shadow, record->bytes);
+        }
+        record->active = 0;
+        record->last_upload_frame = g_gpu_frame_serial;
+    }
+    __sync_synchronize();
+    logInfo("MiSTer GPU: restored %u texture records after save-state load\n",
+            g_gpu_texture_record_count);
+}
