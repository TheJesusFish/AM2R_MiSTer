+        saved->currentGain = inst->currentGain;
+        saved->fadeTimeRemaining = inst->fadeTimeRemaining;
+        saved->fadeTotalTime = inst->fadeTotalTime;
+        saved->startGain = inst->startGain;
+        saved->pitch = ma_sound_get_pitch(&inst->maSound);
+        ma_sound_get_cursor_in_pcm_frames(&inst->maSound, &saved->cursorFrame);
+
+        ma_sound_uninit(&inst->maSound);
