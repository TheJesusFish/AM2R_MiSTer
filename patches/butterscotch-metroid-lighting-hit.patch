+// AM2R builds its lighting mask by subtractively blending large, axis-aligned
+// light sprites into a CPU surface. The generic per-pixel path re-evaluates
+// render state and performs six scalar colour divisions for every texel. Keep
+// the same two /255 stages, but process the common contiguous atlas spans
+// eight pixels at a time on the Cortex-A9. Scalar edges retain clamped
+// nearest-neighbour sampling, so scaled or clipped lights remain exact.
+static void blendSubtractTextureSpan(uint32_t* destination,
+                                     const uint32_t* sourceRow,
+                                     int32_t textureWidth,
+                                     int64_t sourceX,
+                                     int64_t sourceStep,
+                                     int32_t count,
+                                     uint8_t tintR,
+                                     uint8_t tintG,
+                                     uint8_t tintB,
+                                     uint8_t tintA) {
+    int32_t output = 0;
+#if defined(USE_MISTER) && defined(__ARM_NEON)
+    const bool contiguous = sourceStep == (1ll << 16) ||
+                            sourceStep == -(1ll << 16);
+    const uint8x8_t tintRv = vdup_n_u8(tintR);
+    const uint8x8_t tintGv = vdup_n_u8(tintG);
+    const uint8x8_t tintBv = vdup_n_u8(tintB);
+    const uint8x8_t tintAv = vdup_n_u8(tintA);
+    while (contiguous && output + 8 <= count) {
+        int32_t sourceIndex = (int32_t)(sourceX >> 16);
+        const bool forward = sourceStep > 0;
+        if ((forward && (sourceIndex < 0 || sourceIndex + 7 >= textureWidth)) ||
+            (!forward && (sourceIndex - 7 < 0 || sourceIndex >= textureWidth)))
+            break;
+        const uint8_t* source = (const uint8_t*)(sourceRow +
+            (forward ? sourceIndex : sourceIndex - 7));
+        uint8x8x4_t pixels = vld4_u8(source);
+        if (!forward) {
+            pixels.val[0] = vrev64_u8(pixels.val[0]);
+            pixels.val[1] = vrev64_u8(pixels.val[1]);
+            pixels.val[2] = vrev64_u8(pixels.val[2]);
+            pixels.val[3] = vrev64_u8(pixels.val[3]);
+        }
+        uint8x8_t alpha = divideBy255U16(vmull_u8(pixels.val[3], tintAv));
+        uint8x8_t red = divideBy255U16(vmull_u8(pixels.val[0], tintRv));
+        uint8x8_t green = divideBy255U16(vmull_u8(pixels.val[1], tintGv));
+        uint8x8_t blue = divideBy255U16(vmull_u8(pixels.val[2], tintBv));
+        red = divideBy255U16(vmull_u8(red, alpha));
+        green = divideBy255U16(vmull_u8(green, alpha));
+        blue = divideBy255U16(vmull_u8(blue, alpha));
+        uint8x8x4_t target = vld4_u8((const uint8_t*)(destination + output));
+        target.val[0] = vqsub_u8(target.val[0], red);
+        target.val[1] = vqsub_u8(target.val[1], green);
+        target.val[2] = vqsub_u8(target.val[2], blue);
+        vst4_u8((uint8_t*)(destination + output), target);
+        output += 8;
+        sourceX += sourceStep * 8;
+    }
+#endif
+    for (; output < count; ++output, sourceX += sourceStep) {
+        int32_t sourceIndex = (int32_t)(sourceX >> 16);
+        if (sourceIndex < 0) sourceIndex = 0;
+        if (sourceIndex >= textureWidth) sourceIndex = textureWidth - 1;
+        uint32_t pixel = sourceRow[sourceIndex];
+        uint32_t alpha = ((pixel >> 24) & 255u) * tintA / 255u;
+        uint32_t red = (pixel & 255u) * tintR / 255u;
+        uint32_t green = ((pixel >> 8) & 255u) * tintG / 255u;
+        uint32_t blue = ((pixel >> 16) & 255u) * tintB / 255u;
+        red = red * alpha / 255u;
+        green = green * alpha / 255u;
+        blue = blue * alpha / 255u;
+        uint8_t* target = (uint8_t*)&destination[output];
+        target[0] = target[0] > red ? (uint8_t)(target[0] - red) : 0;
+        target[1] = target[1] > green ? (uint8_t)(target[1] - green) : 0;
+        target[2] = target[2] > blue ? (uint8_t)(target[2] - blue) : 0;
+    }
+}
