+            entry->width == width && entry->height == height &&
+            entry->uStart == uStart && entry->vStart == vStart &&
+            entry->uDx == uDx && entry->vDx == vDx &&
+            entry->uDy == uDy && entry->vDy == vDy &&
+            entry->uMin == uMin && entry->uMax == uMax &&
+            entry->vMin == vMin && entry->vMax == vMax)
+            return entry->address;
+    }
+    if (sw->gpuQuarterTurnCacheCount >= 8) return 0;
+
+    SWGpuQuarterTurnCache* entry =
+        &sw->gpuQuarterTurnCache[sw->gpuQuarterTurnCacheCount];
+    entry->pixels = (uint8_t*)safeCalloc((size_t)width * height, 4u);
+    uint32_t* output = (uint32_t*)entry->pixels;
+    const uint32_t* input = (const uint32_t*)source;
+    for (int32_t y = 0; y < height; ++y) {
+        for (int32_t x = 0; x < width; ++x) {
+            int64_t u = (int64_t)uStart + (int64_t)x * uDx + (int64_t)y * uDy;
+            int64_t v = (int64_t)vStart + (int64_t)x * vDx + (int64_t)y * vDy;
+            if (u < uMin || u >= uMax || v < vMin || v >= vMax) continue;
+            int32_t sourceX = (int32_t)(u >> 16);
+            int32_t sourceY = (int32_t)(v >> 16);
+            if (sourceX < 0 || sourceX >= sourceWidth ||
+                sourceY < 0 || sourceY >= sourceHeight) continue;
+            output[(size_t)y * width + x] =
+                input[(size_t)sourceY * sourceWidth + sourceX];
+        }
+    }
+    entry->address = MisterGpu_uploadTexture(
+        entry->pixels, (size_t)width * height * 4u);
+    if (entry->address == 0) {
+        free(entry->pixels);
+        memset(entry, 0, sizeof(*entry));
+        return 0;
+    }
+    entry->source = source;
+    entry->sourceWidth = sourceWidth;
+    entry->sourceHeight = sourceHeight;
+    entry->width = width;
+    entry->height = height;
+    entry->uStart = uStart;
+    entry->vStart = vStart;
+    entry->uDx = uDx;
+    entry->vDx = vDx;
+    entry->uDy = uDy;
+    entry->vDy = vDy;
+    entry->uMin = uMin;
+    entry->uMax = uMax;
+    entry->vMin = vMin;
+    entry->vMax = vMax;
+    sw->gpuQuarterTurnCacheCount++;
+    return entry->address;
