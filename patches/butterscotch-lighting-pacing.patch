+
+// AM2R's sand rooms can have hundreds of visible oBlockSand instances. Their
+// custom Draw event is intentionally simple, but interpreting the same four
+// flag checks and draw_sprite calls for every 16x16 cell consumes several
+// milliseconds per frame on the Cortex-A9. Execute that exact event natively
+// while retaining the ordinary interpreter for every other code entry and for
+// any AM2R data revision whose object/code/variables do not match.
+static bool Runner_tryExecuteAm2rSandDraw(Runner* runner, Instance* instance,
+                                          int32_t eventType, int32_t eventSubtype,
+                                          int32_t codeId, int32_t ownerObjectIndex) {
+    static const char objectName[] = "oBlockSand";
+    static const char codeName[] = "gml_Object_oBlockSand_Draw_0";
+    static const char cornerSpriteName[] = "sSandCorner";
+    static const char* const cornerVariableNames[] = {
+        "sandcrn0", "sandcrn1", "sandcrn2", "sandcrn3"
+    };
+    int32_t cornerVariableIds[sizeof(cornerVariableNames) /
+                              sizeof(cornerVariableNames[0])];
+
+    if (eventType != EVENT_DRAW || eventSubtype != DRAW_NORMAL ||
+        instance == nullptr || runner->renderer == nullptr ||
+        codeId < 0 || (uint32_t)codeId >= runner->dataWin->code.count ||
+        ownerObjectIndex < 0 ||
+        (uint32_t)ownerObjectIndex >= runner->dataWin->objt.count)
+        return false;
+
+    const CodeEntry* code = &runner->dataWin->code.entries[codeId];
+    const GameObject* owner = &runner->dataWin->objt.objects[ownerObjectIndex];
+    if (code->name == nullptr || owner->name == nullptr ||
+        strcmp(code->name, codeName) != 0 ||
+        strcmp(owner->name, objectName) != 0)
+        return false;
+
+    VMContext* vm = runner->vmContext;
+    for (size_t i = 0;
+         i < sizeof(cornerVariableNames) / sizeof(cornerVariableNames[0]); ++i) {
+        ptrdiff_t slot = shgeti(vm->varNameMap, (char*)cornerVariableNames[i]);
+        if (slot < 0) return false;
+        cornerVariableIds[i] = vm->varNameMap[slot].value;
+        if (!IntRValueHashMap_contains(&instance->selfVars,
+                                       cornerVariableIds[i]))
+            return false;
+    }
+
+    int32_t cornerSprite = shget(runner->assetsByName,
+                                 (char*)cornerSpriteName);
+    if (cornerSprite < 0 ||
+        (uint32_t)cornerSprite >= runner->dataWin->sprt.count ||
+        runner->dataWin->sprt.sprites[cornerSprite].name == nullptr ||
+        strcmp(runner->dataWin->sprt.sprites[cornerSprite].name,
+               cornerSpriteName) != 0)
+        return false;
+
+    Renderer_drawSprite(runner->renderer, instance->spriteIndex,
+                        (int32_t)instance->imageIndex,
+                        instance->x, instance->y);
+    for (int32_t corner = 0; corner < 4; ++corner) {
+        if (RValue_toBool(Instance_getSelfVar(
+                instance, cornerVariableIds[corner]))) {
+            Renderer_drawSprite(runner->renderer, cornerSprite, corner,
+                                instance->x, instance->y);
+        }
+    }
+    return true;
+}
 #endif
 
