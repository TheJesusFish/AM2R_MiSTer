+void platformConfigureGameThread(void) {
+    // MiSTer Linux runs a filesystem sync service every five seconds. Under
+    // SCHED_OTHER that service can preempt the ARM renderer across an entire
+    // 60 Hz raster interval even when the game itself is comfortably within
+    // budget. Match the established hybrid-core policy: keep the vblank-paced
+    // game thread real-time, below the audio callback, while its regular wait
+    // still yields the CPU every frame. This is called only after audio and
+    // worker threads exist so they retain SCHED_OTHER unless they explicitly
+    // opt in. Failure is non-fatal for non-root development environments.
+    struct sched_param gameSchedule = { 0 };
+    gameSchedule.sched_priority = 49;
+    if (sched_setscheduler(0, SCHED_FIFO, &gameSchedule) != 0)
+        logWarn("MiSTer pacing: could not enable real-time game scheduling: %s\n",
+                strerror(errno));
+}
+
+void platformPrepareGameThreadRestore(void) {
+    // The original checkpoint timeline retains SCHED_FIFO while DMTCP's
+    // restarted timeline resumes as SCHED_OTHER. Normalize both before
+    // miniaudio recreates its ordinary worker so that helper can never inherit
+    // the game loop's real-time policy. platformConfigureGameThread() raises
+    // only this caller again after worker creation has completed.
+    struct sched_param normalSchedule = { 0 };
+    if (sched_setscheduler(0, SCHED_OTHER, &normalSchedule) != 0)
+        logWarn("MiSTer pacing: could not normalize game scheduling for restore: %s\n",
+                strerror(errno));
+}
