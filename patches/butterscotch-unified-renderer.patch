+        "blend_enabled=%d blend=%d factors=%d,%d,%d,%d fog=%d write_mask=%u "
+        "alpha_test=%d alpha_ref=%u shader=%d\n",
+        samples, limit, frame, renderer->runner->currentRoomIndex, g_gpu_available,
+        sw->unifiedEnabled, sw->unifiedStrict, g_gpu_surface_failed, g_gpu_pending,
+        (unsigned long long)g_gpu_texture_offset, (unsigned long long)arenaOwned,
+        (unsigned long long)arenaFree, (unsigned long long)arenaLargestFree,
+        arenaAllocations, g_gpu_arena_initialized, g_gpu_texture_record_count, textures,
+        textureLive, textureReleased, textureZero, offscreenKeys, offscreenCurrent,
+        targetSlots, targetLive, sw->surfaceCount, surfaceScanned, surfaceLive,
+        surfaceScanned != sw->surfaceCount, sw->textureCount, atlasScanned,
+        atlasLoaded, atlasZero, atlasScanned != sw->textureCount, g_vblank_status_disabled,
+        g_vblank_timeout_count, sw->gpuFrameEligible, sw->offscreenEnabled, sw->currentSurface,
+        sw->blendEnable, sw->blendMode, sw->blendFactors.src, sw->blendFactors.dst,
+        sw->blendFactors.srcAlpha, sw->blendFactors.dstAlpha, sw->fogEnable, mask,
+        sw->alphaTestEnable, (unsigned)sw->alphaTestRef, renderer->currentShader);
