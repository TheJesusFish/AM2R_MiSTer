+struct VMContext;
+struct Runner;
+struct Instance;
+void Am2rOrphanSurfaceCreated(struct VMContext* ctx, int32_t id, int32_t width, int32_t height);
+void Am2rOrphanSurfaceForgotten(int32_t id);
+void Am2rOrphanSurfaceReset(void);
+void Am2rOrphanSurfaceRoomRemove(struct Runner* runner, struct Instance* instance);
+#else
