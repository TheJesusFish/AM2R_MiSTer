diff --git a/src/am2r_shutdown_signal.h b/src/am2r_shutdown_signal.h
new file mode 100644
--- /dev/null
+++ b/src/am2r_shutdown_signal.h
@@ -0,0 +1,27 @@
+// A MiSTer termination request must leave GPU ownership intact until the main
+// thread reaches renderer/platform cleanup. No allocation, I/O or GPU access
+// is legal in this handler (the signal can arrive on an audio worker).
+#ifndef AM2R_SHUTDOWN_SIGNAL_H
+#define AM2R_SHUTDOWN_SIGNAL_H
+#include <signal.h>
+#include <stdbool.h>
+#include <string.h>
+
+static volatile sig_atomic_t am2rShutdownSignal = 0;
+
+static void am2rShutdownSignalHandler(int signalNumber) {
+    am2rShutdownSignal = signalNumber;
+}
+
+static bool am2rShutdownSignalInstall(void) {
+    struct sigaction action;
+    memset(&action, 0, sizeof(action));
+    action.sa_handler = am2rShutdownSignalHandler;
+    sigemptyset(&action.sa_mask);
+    // Let a synchronous save finish or return an ordinary EINTR failure. Its
+    // .new + fsync + rename transaction preserves the old slot on failure.
+    return sigaction(SIGTERM, &action, NULL) == 0 &&
+           sigaction(SIGINT, &action, NULL) == 0 &&
+           sigaction(SIGHUP, &action, NULL) == 0;
+}
+#endif
