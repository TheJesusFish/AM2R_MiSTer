+/* Included by sw_renderer.c after its target/bounds helpers. Only the
+ * capability-negotiated path uses these helpers; old cores retain legacy mode.
+ * Vertex setup stays on ARM; no per-pixel image preparation is accepted here.
+ */
+static bool swGpuTryAffineQuad(SWRenderer*, SWVertex[4], const uint8_t*, int32_t, int32_t);
+static void swMarkSurfaceWrite(SWRenderer*, int32_t);
+
+static void swUnifiedFatal(const char* operation) {
+    logError("MiSTer unified renderer lost coherent GPU state during %s\n", operation);
+    // A device failure cannot be recovered by presenting an obsolete CPU
+    // shadow. Terminate the runner and leave the normal core recovery path.
+    exit(EXIT_FAILURE);
+}
+
+static void swUnifiedCheck(SWRenderer* sw, bool success, const char* operation) {
+    if (sw->unifiedEnabled && (!success || !MisterGpu_unifiedEnabled()))
+        swUnifiedFatal(operation);
+}
+
+static void swUnifiedDisable(SWRenderer* sw, const char* reason) {
+    if (!sw->unifiedEnabled) return;
+    if (sw->unifiedStrict) swUnifiedFatal(reason);
+    if (!MisterGpu_setUnifiedEnabled(false)) swUnifiedFatal(reason);
+    // setUnifiedEnabled(false) has materialized and invalidated every live
+    // backend record. Do not restore the old frame's GPU eligibility.
+    sw->unifiedEnabled = false;
+    sw->gpuFrameEligible = false;
+    sw->gpuHasSkippedDraws = false;
+    sw->offscreenEnabled = false;
+    sw->unifiedHostHandle = 0;
+    for (uint32_t i = 0; i < sw->surfaceCapacity; ++i)
+        sw->unifiedSurfaceHandles[i] = 0;
+    MisterGpu_useSoftwareFrame();
+    logWarn("MiSTer unified renderer switched to coherent CPU fallback: %s\n", reason);
+}
+
+static uint32_t swUnifiedHandle(SWRenderer* sw, int32_t id) {
+    if (!sw->unifiedEnabled) return 0;
+    if (!MisterGpu_unifiedEnabled()) swUnifiedFatal("surface lookup");
+    uint32_t* handle;
+    uint8_t* pixels;
+    int32_t width, height;
+    uint32_t revision;
+    if (id == RENDER_TARGET_HOST_FRAMEBUFFER) {
+        handle = &sw->unifiedHostHandle;
+        pixels = sw->hostFramebuffer;
+        width = sw->hostWidth; height = sw->hostHeight;
+        revision = 0;
+    } else {
+        if (id <= 0 || (uint32_t)id >= sw->surfaceCount || !sw->surfaceExistsFlags[id])
+            return 0;
+        handle = &sw->unifiedSurfaceHandles[id];
+        pixels = sw->surfacePixels[id];
+        width = sw->surfaceWidths[id]; height = sw->surfaceHeights[id];
+        revision = sw->surfaceRevisions[id];
+    }
+    if (!*handle) {
+        *handle = MisterGpu_surfaceEnsure(pixels, width, height, pixels, revision);
+        if (!*handle) {
+            if (!MisterGpu_unifiedEnabled()) swUnifiedFatal("surface allocation");
+            swUnifiedDisable(sw, "surface allocation/capacity");
+            return 0;
+        }
+        // Registration is lazy: a subsequent clear can supersede these
+        // initial pixels without any DDR upload. Do not count it as traffic.
+        sw->unifiedInitialShadowBytes += (uint64_t)width * height * 4u;
+    }
+    return *handle;
+}
+
+static bool swUnifiedSelect(SWRenderer* sw) {
+    uint32_t handle = swUnifiedHandle(sw, sw->currentSurface);
+    if (!handle) return false;
+    swUnifiedCheck(sw, MisterGpu_surfaceSelect(handle), "target select");
+    return true;
+}
+
+static void swUnifiedReadTarget(SWRenderer* sw, int32_t id) {
+    uint32_t handle = swUnifiedHandle(sw, id);
+    if (!handle) return;
+    uint8_t* pixels = id == RENDER_TARGET_HOST_FRAMEBUFFER ?
+        sw->hostFramebuffer : sw->surfacePixels[id];
+    uint32_t width = id == RENDER_TARGET_HOST_FRAMEBUFFER ?
+        sw->hostWidth : sw->surfaceWidths[id];
+    uint32_t height = id == RENDER_TARGET_HOST_FRAMEBUFFER ?
+        sw->hostHeight : sw->surfaceHeights[id];
+    swUnifiedCheck(sw, MisterGpu_surfaceReadback(handle, pixels, (size_t)width * 4u),
+                   "CPU read barrier");
+    sw->unifiedReadbackBytes += (uint64_t)width * height * 4u;
+}
+
+static int32_t swUnifiedSourceId(SWRenderer* sw, const uint8_t* source) {
+    if (source == sw->hostFramebuffer) return RENDER_TARGET_HOST_FRAMEBUFFER;
+    for (uint32_t id = 1; id < sw->surfaceCount; ++id)
+        if (sw->surfaceExistsFlags[id] && source == sw->surfacePixels[id]) return (int32_t)id;
+    return -2;
+}
+
+static uint32_t swUnifiedSource(SWRenderer* sw, const uint8_t* source,
+        int32_t width, int32_t height, uint32_t* stride) {
+    for (uint32_t page = 0; page < sw->textureCount; ++page) {
+        if (source == sw->texturePixels[page] && width == sw->textureWidths[page] &&
+            height == sw->textureHeights[page]) {
+            *stride = (uint32_t)width * 4u;
+            return sw->gpuTextureAddresses[page];
+        }
+    }
+    int32_t id = swUnifiedSourceId(sw, source);
+    if (id == -2) return 0;
+    if (id >= 0 && (width != sw->surfaceWidths[id] || height != sw->surfaceHeights[id]))
+        return 0;
+    if (id < 0 && (width != sw->hostWidth || height != sw->hostHeight)) return 0;
+    uint32_t handle = swUnifiedHandle(sw, id);
+    if (!handle) return 0;
+    // A source/target alias returns a full GPU snapshot, not a CPU staging image.
+    uint32_t address = MisterGpu_surfaceTexture(handle, stride);
+    if (!address && !MisterGpu_unifiedEnabled()) swUnifiedFatal("source snapshot");
+    return address;
+}
+
+static void swUnifiedRelease(SWRenderer* sw, int32_t id) {
+    if (!sw->unifiedEnabled) return;
+    uint32_t* handle = id == RENDER_TARGET_HOST_FRAMEBUFFER ?
+        &sw->unifiedHostHandle : &sw->unifiedSurfaceHandles[id];
+    if (*handle) {
+        swUnifiedCheck(sw, MisterGpu_surfaceRelease(*handle), "surface release");
+        *handle = 0;
+    }
+}
+
+static void swUnifiedCpuBegin(SWRenderer* sw, const uint8_t* source, const char* reason) {
+    if (!sw->unifiedEnabled || sw->unifiedCpuDepth) return;
+    if (sw->unifiedStrict) swUnifiedFatal(reason);
+    int32_t sourceId = source ? swUnifiedSourceId(sw, source) : -2;
+    if (sourceId != -2 && sourceId != sw->currentSurface) swUnifiedReadTarget(sw, sourceId);
+    swUnifiedReadTarget(sw, sw->currentSurface);
+    ++sw->unifiedCpuDraws;
+    if (sw->unifiedFallbackLogs < 16) {
+        logWarn("MiSTer unified CPU raster fallback: %s target=%d\n", reason, sw->currentSurface);
+        ++sw->unifiedFallbackLogs;
+    }
+}
+
+static void swUnifiedCpuEnd(SWRenderer* sw) {
+    if (!sw->unifiedEnabled || sw->unifiedCpuDepth) return;
+    uint32_t handle = swUnifiedHandle(sw, sw->currentSurface);
+    if (!handle) return;
+    swMarkSurfaceWrite(sw, sw->currentSurface);
+    uint32_t revision = sw->currentSurface >= 0 ? sw->surfaceRevisions[sw->currentSurface] : 0;
+    swUnifiedCheck(sw, MisterGpu_surfaceCpuWritten(handle, sw->framebuffer,
+        (size_t)sw->fbWidth * 4u, revision), "CPU write publication");
+    sw->unifiedUploadBytes += (uint64_t)sw->fbWidth * sw->fbHeight * 4u;
+}
+
+static uint8_t* swUnifiedCpuAliasSnapshot(SWRenderer* sw, const uint8_t* source,
+        int32_t width, int32_t height) {
+    if (!source || source != sw->framebuffer || width != sw->fbWidth ||
+        height != sw->fbHeight || width <= 0 || height <= 0) return NULL;
+    // Exceptional CPU fallback must retain the same read-before-write alias
+    // contract as GPU draws. The caller has already fenced the target.
+    size_t bytes = (size_t)width * (size_t)height * 4u;
+    uint8_t* snapshot = safeMalloc(bytes);
+    memcpy(snapshot, source, bytes);
+    return snapshot;
+}
+
+static bool swUnifiedStateSupported(const SWRenderer* sw) {
+    return sw->blendEnable && sw->base.currentShader < 0 &&
+        (sw->blendMode == bm_normal || sw->blendMode == bm_add || sw->blendMode == bm_subtract) &&
+        !sw->alphaTestEnable && !sw->fogEnable && sw->colorWriteR &&
+        sw->colorWriteG && sw->colorWriteB && sw->colorWriteA;
+}
+
+static bool swUnifiedAxisGeometry(const SWVertex v[4]) {
+    // A separable axis packet discards cross-axis geometry. Near-axis quads
+    // must retain their actual vertices via affine/triangle setup, not snap.
+    return v[0].y == v[1].y && v[2].y == v[3].y &&
+        v[0].x == v[3].x && v[1].x == v[2].x;
+}
+
+static bool swUnifiedSeparableUv(const SWVertex v[4]) {
+    // U varies only along edge 0->1; V only along 0->3. Constant, mirrored
+    // and out-of-range domains remain valid for dimensioned/clamped packets.
+    return v[0].u == v[3].u && v[1].u == v[2].u &&
+        v[0].v == v[1].v && v[3].v == v[2].v;
+}
+
+static bool swUnifiedAffineUvSupported(const SWVertex v[4], const uint8_t* source,
+        int32_t width, int32_t height) {
+    if (!source) return true; // The affine helper supplies its own 1x1 white texel.
+    if (width <= 0 || height <= 0) return false;
+    for (unsigned i=0;i<4;++i)
+        if (!isfinite(v[i].u) || !isfinite(v[i].v) ||
+            v[i].u < 0 || v[i].u > 1 || v[i].v < 0 || v[i].v > 1) return false;
+    // Opcode4 clips against a rectangular UV domain and does not know the
+    // texture dimensions. Nonrectangular, degenerate or clamped UV mappings
+    // need the dimensioned generic triangles, never unchecked texture reads.
+    return swUnifiedSeparableUv(v) &&
+        v[0].u != v[1].u && v[0].v != v[3].v;
+}
+
+static bool swUnifiedAffineFixedInputs(const double* values, size_t count) {
+    // Reject before llround: merely checking the resulting int64 is too late
+    // for a nearly collinear transform whose coefficient overflows conversion.
+    for (size_t i=0;i<count;++i) {
+        double fixed=values[i]*65536.0;
+        if (!isfinite(fixed) || fixed < INT32_MIN || fixed > INT32_MAX) return false;
+    }
+    return true;
+}
+
+static bool swUnifiedAffineAccumulationFits(int64_t start, int64_t dx, int64_t dy,
+        int32_t width, int32_t height) {
+    if (width <= 0 || height <= 0 || width > UINT16_MAX || height > UINT16_MAX ||
+        start < INT32_MIN || start > INT32_MAX || dx < INT32_MIN || dx > INT32_MAX ||
+        dy < INT32_MIN || dy > INT32_MAX) return false;
+    // Opcode4 clips by its UV rectangle after signed32 accumulation. A wrapped
+    // coordinate could re-enter that rectangle and paint unrelated pixels.
+    // Linear extrema occur at bbox corners; prove the whole emitted footprint
+    // with the actual quantized coefficients, including off-polygon samples.
+    int64_t ox = (int64_t)(width - 1) * dx;
+    int64_t oy = (int64_t)(height - 1) * dy;
+    const int64_t corners[] = {start, start + ox, start + oy, start + ox + oy};
+    for (unsigned i = 0; i < 4; ++i)
+        if (corners[i] < INT32_MIN || corners[i] > INT32_MAX) return false;
+    return true;
+}
+
+static bool swUnifiedPlane(uint64_t* out, double start, double dx, double dy,
+        double dxy, int32_t width, int32_t height, bool cross) {
+    // Conservative bound covers every intermediate addition as well as the
+    // final result in both the original and independently clipped tile packet.
+    if (width <= 0 || height <= 0 || !isfinite(start) || !isfinite(dx) ||
+        !isfinite(dy) || !isfinite(dxy) || fabs(start) > 1000000000.0 ||
+        fabs(dx) > 1000000000.0 || fabs(dy) > 1000000000.0 ||
+        fabs(dxy) > 1000000000.0) return false;
+    double bound = fabs(start) + fabs(dx)*(width-1) + fabs(dy)*(height-1) +
+        fabs(dxy)*(width-1)*(height-1);
+    if (!isfinite(bound) || bound > 1000000000.0) return false;
+    out[0] = (uint64_t)(int64_t)llround(start*4294967296.0);
+    out[1] = (uint64_t)(int64_t)llround(dx*4294967296.0);
+    out[2] = (uint64_t)(int64_t)llround(dy*4294967296.0);
+    if (cross) out[3] = (uint64_t)(int64_t)llround(dxy*4294967296.0);
+    return true;
+}
+
+static bool swUnifiedPacketState(SWRenderer* sw, uint64_t packet[64],
+        bool textured, bool triangle, int32_t texW, int32_t texH) {
+    if (!MisterGpu_hasGenericPrimitive() || sw->base.currentShader >= 0 ||
+        (textured && (texW <= 0 || texH <= 0 || texW > 65535 || texH > 65535))) return false;
+    int32_t mode = sw->blendMode == bm_complex ? 6 : sw->blendMode;
+    if (mode < 0 || mode > 6) return false;
+    BlendFactors factors = sw->blendFactors;
+    if (mode == 6 && (factors.src < 1 || factors.src > 11 || factors.dst < 1 || factors.dst > 11 ||
+        factors.srcAlpha < 1 || factors.srcAlpha > 11 || factors.dstAlpha < 1 || factors.dstAlpha > 11)) return false;
+    uint32_t mask = (sw->colorWriteR ? 1u : 0u) | (sw->colorWriteG ? 2u : 0u) |
+        (sw->colorWriteB ? 4u : 0u) | (sw->colorWriteA ? 8u : 0u);
+    packet[0] = UINT64_C(0x31504741) | ((uint64_t)textured<<32) | ((uint64_t)triangle<<33);
+    packet[2] = (uint16_t)texW | ((uint64_t)(uint16_t)texH<<16) |
+        ((uint64_t)mode<<32) | ((uint64_t)mask<<40) | ((uint64_t)sw->alphaTestRef<<48) |
+        ((uint64_t)sw->alphaTestEnable<<56) | ((uint64_t)sw->fogEnable<<57) | ((uint64_t)sw->blendEnable<<58);
+    uint32_t fog = (uint32_t)BGR_R(sw->fogColor) | ((uint32_t)BGR_G(sw->fogColor)<<8) |
+        ((uint32_t)BGR_B(sw->fogColor)<<16);
+    packet[3] = (uint8_t)factors.src | ((uint64_t)(uint8_t)factors.dst<<8) |
+        ((uint64_t)(uint8_t)factors.srcAlpha<<16) | ((uint64_t)(uint8_t)factors.dstAlpha<<24) |
+        ((uint64_t)fog<<32);
+    return true;
+}
+
+static bool swUnifiedBounds(SWRenderer* sw, const SWVertex* v, unsigned count,
+        bool axis, int32_t box[4]) {
+    double minX = v[0].x, maxX = v[0].x, minY = v[0].y, maxY = v[0].y;
+    for (unsigned i=0; i<count; ++i) {
+        const float values[8] = {v[i].x,v[i].y,v[i].u,v[i].v,v[i].r,v[i].g,v[i].b,v[i].a};
+        for (unsigned j=0; j<8; ++j) if (!isfinite(values[j])) return false;
+        if (fabsf(v[i].x)>32767 || fabsf(v[i].y)>32767) return false;
+        if (v[i].x<minX) minX=v[i].x; if (v[i].x>maxX) maxX=v[i].x;
+        if (v[i].y<minY) minY=v[i].y; if (v[i].y>maxY) maxY=v[i].y;
+    }
+    int32_t left = axis ? swPixelCoverageEdge(minX) : (int32_t)floor(minX);
+    int32_t right = axis ? swPixelCoverageEdge(maxX) : (int32_t)ceil(maxX);
+    int32_t top = axis ? swPixelCoverageEdge(minY) : (int32_t)floor(minY);
+    int32_t bottom = axis ? swPixelCoverageEdge(maxY) : (int32_t)ceil(maxY);
+    if (left<sw->scissorX) left=sw->scissorX; if (top<sw->scissorY) top=sw->scissorY;
+    if (right>sw->scissorX+sw->scissorW) right=sw->scissorX+sw->scissorW;
+    if (bottom>sw->scissorY+sw->scissorH) bottom=sw->scissorY+sw->scissorH;
+    if (left<0) left=0; if (top<0) top=0;
+    if (right>sw->fbWidth) right=sw->fbWidth; if (bottom>sw->fbHeight) bottom=sw->fbHeight;
+    box[0]=left; box[1]=top; box[2]=right>left ? right-left : 0; box[3]=bottom>top ? bottom-top : 0;
+    return true;
+}
+
+static double swUnifiedComponent(const SWVertex* v, unsigned channel) {
+    switch (channel) { case 0:return v->r; case 1:return v->g; case 2:return v->b; default:return v->a; }
+}
+
+static bool swUnifiedBuildAxisPacket(SWRenderer* sw, const SWVertex v[4],
+        const int32_t box[4], bool textured, int32_t texW, int32_t texH, uint64_t packet[64]) {
+    if (!swUnifiedAxisGeometry(v) || (textured && !swUnifiedSeparableUv(v))) return false;
+    if (!swUnifiedPacketState(sw,packet,textured,false,texW,texH)) return false;
+    double dx=(double)v[1].x-v[0].x, dy=(double)v[3].y-v[0].y;
+    if (fabs(dx)<.01 || fabs(dy)<.01) return false;
+    double tx=(box[0]+.5-v[0].x)/dx, ty=(box[1]+.5-v[0].y)/dy;
+    if (textured && (!swUnifiedPlane(packet+17,
+        ((double)v[0].u+tx*((double)v[1].u-v[0].u))*texW,
+        ((double)v[1].u-v[0].u)*texW/dx,0,0,box[2],box[3],false) ||
+        !swUnifiedPlane(packet+20,((double)v[0].v+ty*((double)v[3].v-v[0].v))*texH,
+        0,((double)v[3].v-v[0].v)*texH/dy,0,box[2],box[3],false))) return false;
+    for (unsigned c=0; c<4; ++c) {
+        double c0=swUnifiedComponent(v,c), c1=swUnifiedComponent(v+1,c);
+        double c2=swUnifiedComponent(v+2,c), c3=swUnifiedComponent(v+3,c);
+        double a=c1-c0,b=c3-c0,cross=c2-c1-c3+c0;
+        if (!swUnifiedPlane(packet+23+4*c,c0+tx*a+ty*b+tx*ty*cross,
+            (a+ty*cross)/dx,(b+tx*cross)/dy,cross/(dx*dy),box[2],box[3],true)) return false;
+    }
+    return true;
+}
+
+static bool swUnifiedBuildTrianglePacket(SWRenderer* sw, const SWVertex input[3],
+        const int32_t box[4], bool textured, int32_t texW, int32_t texH, uint64_t packet[64], bool* empty) {
+    SWVertex v[3] = {input[0],input[1],input[2]};
+    double area=((double)v[1].x-v[0].x)*((double)v[2].y-v[0].y)-
+                ((double)v[1].y-v[0].y)*((double)v[2].x-v[0].x);
+    *empty=fabs(area)<.001;
+    if (*empty) return true;
+    if (area<0) { SWVertex tmp=v[1];v[1]=v[2];v[2]=tmp;area=-area; }
+    if (!swUnifiedPacketState(sw,packet,textured,true,texW,texH)) return false;
+    double e[3][3];
+    for (unsigned i=0;i<3;++i) {
+        const SWVertex* a=&v[(i+1)%3]; const SWVertex* b=&v[(i+2)%3];
+        e[i][0]=((double)b->x-a->x)*(box[1]+.5-a->y)-((double)b->y-a->y)*(box[0]+.5-a->x);
+        e[i][1]=(double)a->y-b->y; e[i][2]=(double)b->x-a->x;
+        if (!swUnifiedPlane(packet+8+3*i,e[i][0],e[i][1],e[i][2],0,box[2],box[3],false)) return false;
+        // Screen Y grows downward. Top/left edges are inclusive; bottom/right
+        // edges are exclusive, so adjacent triangles own each shared sample
+        // exactly once. Bias only the encoded coverage plane by one Q32 LSB:
+        // the unbiased e[] planes below still determine UV/color interpolation.
+        bool inclusive = b->y < a->y || (b->y == a->y && b->x > a->x);
+        if (!inclusive) --packet[8+3*i];
+    }
+    for (unsigned c=0;c<6;++c) {
+        double value[3],plane[3]={0};
+        for (unsigned i=0;i<3;++i) value[i]=c<4 ? swUnifiedComponent(v+i,c) :
+            c==4 ? (double)v[i].u*texW : (double)v[i].v*texH;
+        for (unsigned axis=0;axis<3;++axis)
+            for (unsigned i=0;i<3;++i) plane[axis]+=e[i][axis]*value[i]/area;
+        unsigned offset=c<4 ? 23+4*c : c==4 ? 17 : 20;
+        if (!swUnifiedPlane(packet+offset,plane[0],plane[1],plane[2],0,box[2],box[3],c<4)) return false;
+    }
+    return true;
+}
+
+static bool swUnifiedEmitGeneric(SWRenderer* sw, const uint8_t* source,
+        int32_t texW,int32_t texH,uint64_t packets[2][64],int32_t boxes[2][4],unsigned count) {
+    if (!count) return true;
+    if (!swUnifiedSelect(sw)) return false;
+    uint32_t stride=0,address=0;
+    if (source) {
+        address=swUnifiedSource(sw,source,texW,texH,&stride);
+        if (!address) return false;
+    }
+    // Acquire a self-source snapshot once for the complete logical quad,
+    // before either constituent triangle can mutate the target.
+    for (unsigned i=0;i<count;++i) {
+        packets[i][1]=address|((uint64_t)stride<<32);
+        bool ok=MisterGpu_addGeneric(boxes[i][0],boxes[i][1],boxes[i][2],boxes[i][3],packets[i]);
+        if (!ok) {
+            if (i || MisterGpu_unifiedFailed()) swUnifiedFatal("generic primitive publication");
+            return false;
+        }
+        swExtendSurfaceContentBounds(sw,boxes[i][0],boxes[i][1],boxes[i][0]+boxes[i][2],boxes[i][1]+boxes[i][3]);
+    }
+    ++sw->unifiedGpuDraws;
+    swMarkSurfaceWrite(sw,sw->currentSurface);
+    return true;
+}
+
+static bool swUnifiedTryGenericQuad(SWRenderer* sw, SWVertex v[4],const uint8_t* source,int32_t texW,int32_t texH) {
+    if (!MisterGpu_hasGenericPrimitive()) return false;
+    uint64_t packets[2][64]={{0}};int32_t boxes[2][4];unsigned count=0;
+    bool axis=swUnifiedAxisGeometry(v) && (!source || swUnifiedSeparableUv(v));
+    if (axis) {
+        if (!swUnifiedBounds(sw,v,4,true,boxes[0])) return false;
+        if (!boxes[0][2] || !boxes[0][3] || fabsf(v[1].x-v[0].x)<.01f || fabsf(v[3].y-v[0].y)<.01f) return true;
+        if (!swUnifiedBuildAxisPacket(sw,v,boxes[0],source!=NULL,texW,texH,packets[0])) return false;
+        count=1;
+    } else {
+        const SWVertex triangles[2][3]={{v[0],v[1],v[2]},{v[2],v[3],v[0]}};
+        for (unsigned i=0;i<2;++i) {
+            bool empty;
+            if (!swUnifiedBounds(sw,triangles[i],3,false,boxes[count])) return false;
+            if (!boxes[count][2] || !boxes[count][3]) continue;
+            if (!swUnifiedBuildTrianglePacket(sw,triangles[i],boxes[count],source!=NULL,texW,texH,packets[count],&empty)) return false;
+            if (!empty) ++count;
+        }
+    }
+    return swUnifiedEmitGeneric(sw,source,texW,texH,packets,boxes,count);
+}
+
+static bool swUnifiedTryGenericTriangle(SWRenderer* sw, SWVertex v0,SWVertex v1,SWVertex v2,
+        const uint8_t* source,int32_t texW,int32_t texH) {
+    if (!MisterGpu_hasGenericPrimitive()) return false;
+    SWVertex v[3]={v0,v1,v2};uint64_t packets[2][64]={{0}};int32_t boxes[2][4];bool empty;
+    if (!swUnifiedBounds(sw,v,3,false,boxes[0])) return false;
+    if (!boxes[0][2] || !boxes[0][3]) return true;
+    if (!swUnifiedBuildTrianglePacket(sw,v,boxes[0],source!=NULL,texW,texH,packets[0],&empty)) return false;
+    return empty || swUnifiedEmitGeneric(sw,source,texW,texH,packets,boxes,1);
+}
+
+static bool swUnifiedTryQuad(SWRenderer* sw, SWVertex v[4],
+        const uint8_t* source, int32_t texW, int32_t texH) {
+    if (!swUnifiedStateSupported(sw)) return false;
+    for (unsigned i = 0; i < 4; ++i) {
+        if (!isfinite(v[i].x) || !isfinite(v[i].y) || !isfinite(v[i].u) || !isfinite(v[i].v) ||
+            fabsf(v[i].x) > 32767 || fabsf(v[i].y) > 32767 ||
+            !isfinite(v[i].r) || !isfinite(v[i].g) || !isfinite(v[i].b) || !isfinite(v[i].a))
+            return false;
+        if (i && (v[i].r != v[0].r || v[i].g != v[0].g ||
+                  v[i].b != v[0].b || v[i].a != v[0].a)) return false;
+    }
+    // Legacy byte-tint setup rounds before clamping. Restrict that conversion
+    // to normalized inputs; the generic packet clamps finite wider values
+    // without overflowing lroundf on the ARM.
+    if (v[0].r<0 || v[0].r>1 || v[0].g<0 || v[0].g>1 ||
+        v[0].b<0 || v[0].b>1 || v[0].a<0 || v[0].a>1) return false;
+    bool axis = swUnifiedAxisGeometry(v);
+    if (!axis) {
+        // The existing affine descriptor models a parallelogram, not an
+        // arbitrary four-corner deformation. Leave the latter explicit.
+        if (fabsf(v[2].x-v[1].x-v[3].x+v[0].x) > .01f ||
+            fabsf(v[2].y-v[1].y-v[3].y+v[0].y) > .01f) return false;
+        if (!swUnifiedAffineUvSupported(v,source,texW,texH)) return false;
+        if (!swUnifiedSelect(sw)) return false;
+        bool ok = swGpuTryAffineQuad(sw, v, source, texW, texH);
+        if (ok) { ++sw->unifiedGpuDraws; swMarkSurfaceWrite(sw, sw->currentSurface); }
+        else if (MisterGpu_unifiedFailed()) swUnifiedFatal("affine draw");
+        return ok;
+    }
+    if (source && !swUnifiedSeparableUv(v)) return false;
+    float dx = v[1].x-v[0].x, dy = v[3].y-v[0].y;
+    if (fabsf(dx) < .01f || fabsf(dy) < .01f) return true;
+    int32_t left = swPixelCoverageEdge(fminf(v[0].x,v[1].x));
+    int32_t right = swPixelCoverageEdge(fmaxf(v[0].x,v[1].x));
+    int32_t top = swPixelCoverageEdge(fminf(v[0].y,v[3].y));
+    int32_t bottom = swPixelCoverageEdge(fmaxf(v[0].y,v[3].y));
+    if (left < sw->scissorX) left = sw->scissorX;
+    if (top < sw->scissorY) top = sw->scissorY;
+    if (right > sw->scissorX+sw->scissorW) right = sw->scissorX+sw->scissorW;
+    if (bottom > sw->scissorY+sw->scissorH) bottom = sw->scissorY+sw->scissorH;
+    if (left < 0) left = 0; if (top < 0) top = 0;
+    if (right > sw->fbWidth) right = sw->fbWidth;
+    if (bottom > sw->fbHeight) bottom = sw->fbHeight;
+    if (left >= right || top >= bottom) return true;
+    uint32_t tint = (uint32_t)floatColorByte(v[0].r) |
+        ((uint32_t)floatColorByte(v[0].g)<<8) | ((uint32_t)floatColorByte(v[0].b)<<16) |
+        ((uint32_t)floatColorByte(v[0].a)<<24);
+    uint8_t blend = sw->blendMode == bm_add ? MISTER_GPU_BLEND_ADDITIVE :
+        sw->blendMode == bm_subtract ? MISTER_GPU_BLEND_SUBTRACT : MISTER_GPU_BLEND_NORMAL;
+    if (!source) {
+        if (!swUnifiedSelect(sw)) return false;
+        bool ok = MisterGpu_addFill(left, top, right-left, bottom-top, tint, blend);
+        if (!ok && !MisterGpu_unifiedEnabled()) swUnifiedFatal("solid draw");
+        if (ok) { ++sw->unifiedGpuDraws; swMarkSurfaceWrite(sw, sw->currentSurface);
+                  swExtendSurfaceContentBounds(sw, left, top, right, bottom); }
+        return ok;
+    }
+    if (texW <= 0 || texH <= 0 || !MisterGpu_hasFloorTint()) return false;
+    double srcX = (double)v[0].u*texW;
+    double stepX = (double)(v[1].u-v[0].u)*texW/dx;
+    double start = (srcX+((double)left+.5-v[0].x)*stepX)*65536.0;
+    double step = stepX*65536.0;
+    if (!isfinite(start) || !isfinite(step) || fabs(start)>1e12 || fabs(step)>1e9) return false;
+    MisterOffscreenAxis op = {
+        .source = (const uint32_t*)source, .sourceWidth=texW, .sourceHeight=texH,
+        .x=left, .y=top, .width=right-left, .height=bottom-top,
+        .startU=(int64_t)start, .stepU=(int64_t)step,
+        .sourceY0=(double)v[0].v*texH,
+        .sourceDy=(double)(v[3].v-v[0].v)*texH/dy, .vertexY0=v[0].y, .tint=tint
+    };
+    // Plan every tile before publishing a draw, retaining the original source
+    // sampling phase. The planner proves exact CPU Y rows and floor tint.
+    size_t capacity = (size_t)((right-left+319)/320)*(bottom-top);
+    MisterOffscreenBlit* planned = safeMalloc(capacity*sizeof(*planned));
+    size_t count = 0;
+    bool valid = true;
+    for (int32_t y=top; valid && y<bottom; y+=240) {
+        int32_t h = bottom-y < 240 ? bottom-y : 240;
+        for (int32_t x=left; valid && x<right; x+=320) {
+            int32_t w = right-x < 320 ? right-x : 320;
+            size_t added = 0;
+            valid = MisterOffscreen_planAxisTint(&op, x, y, w, h,
+                planned+count, capacity-count, &added, MisterGpu_hasFloorTint());
+            for (size_t i=0; i<added; ++i) {
+                planned[count+i].x += x; planned[count+i].y += y;
+            }
+            count += added;
+        }
+    }
+    if (!valid || !swUnifiedSelect(sw)) { free(planned); return false; }
+    uint32_t stride = 0, address = swUnifiedSource(sw, source, texW, texH, &stride);
+    if (!address) { free(planned); return false; }
+    for (size_t i=0; i<count; ++i) {
+        MisterOffscreenBlit* b=&planned[i];
+        // Planning and state validation finished before the first accepted
+        // descriptor. Any later rejection is an ownership/device failure.
+        swUnifiedCheck(sw, MisterGpu_addBlitFloorTint(address, stride,
+            b->x,b->y,b->width,b->height,b->u,b->v,b->du,b->dv,tint,blend), "axis draw");
+    }
+    free(planned);
+    ++sw->unifiedGpuDraws;
+    swMarkSurfaceWrite(sw, sw->currentSurface);
+    swExtendSurfaceContentBounds(sw, left, top, right, bottom);
+    return true;
+}
