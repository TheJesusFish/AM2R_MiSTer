diff --git a/src/am2r_orphan_surfaces_impl.h b/src/am2r_orphan_surfaces_impl.h
new file mode 100644
--- /dev/null
+++ b/src/am2r_orphan_surfaces_impl.h
@@ -0,0 +1,162 @@
+/* Included by runner.c, after its runtime/renderer definitions. This is a
+ * closed-program orphan proof for one exactly hashed game, NOT a general
+ * creator-owns-surface rule, a new Destroy event, or a surface-pressure policy.
+ * Enabled by default only behind the exact data/ownership guards below;
+ * AM2R_LIGHT_ORPHAN_CLEANUP=0 (or any value except 1) disables it. */
+#include <limits.h>
+#define AM2R_ORPHAN_RECORDS 128u
+typedef struct {
+    Runner* runner;
+    Instance* creator;
+    uint32_t instance;
+    int32_t surface;
+} Am2rOrphanRecord;
+static Am2rOrphanRecord am2rOrphanRecords[AM2R_ORPHAN_RECORDS];
+static bool am2rOrphanConfigured, am2rOrphanEnabled;
+
+static bool am2rOrphanIsEnabled(void) {
+    if (!am2rOrphanConfigured) {
+        const char* setting = getenv("AM2R_LIGHT_ORPHAN_CLEANUP");
+        am2rOrphanEnabled = setting == NULL || strcmp(setting, "1") == 0;
+        am2rOrphanConfigured = true;
+    }
+    return am2rOrphanEnabled;
+}
+
+void Am2rOrphanSurfaceReset(void) {
+    memset(am2rOrphanRecords, 0, sizeof(am2rOrphanRecords));
+}
+
+void Am2rOrphanSurfaceForgotten(int32_t id) {
+    if (!am2rOrphanIsEnabled()) return;
+    for (unsigned i = 0; i < AM2R_ORPHAN_RECORDS; ++i)
+        if (am2rOrphanRecords[i].creator != NULL && am2rOrphanRecords[i].surface == id)
+            am2rOrphanRecords[i] = (Am2rOrphanRecord){0};
+}
+
+static bool am2rOrphanDataVerified(Runner* runner) {
+    if (runner == NULL || runner->dataWin == NULL || runner->vmContext == NULL ||
+        runner->renderer == NULL || !runner->dataWin->am2rLightSurfaceOwnershipVerified ||
+        runner->dataWin->objt.count != 737u || runner->dataWin->code.count != 8667u)
+        return false;
+    GameObject* object = &runner->dataWin->objt.objects[727];
+    if (object->persistent || object->parentId != -100 || object->name == NULL ||
+        strcmp(object->name, "oLightEngine") != 0) return false;
+    for (uint32_t i = 0; i < runner->dataWin->objt.count; ++i)
+        if (runner->dataWin->objt.objects[i].parentId == 727) return false;
+    return true;
+}
+
+void Am2rOrphanSurfaceCreated(VMContext* ctx, int32_t id, int32_t width, int32_t height) {
+    if (!am2rOrphanIsEnabled()) return;
+    /* Every reused ID invalidates old ownership, including foreign creators. */
+    Am2rOrphanSurfaceForgotten(id);
+    if (ctx == NULL || !am2rOrphanDataVerified(ctx->runner) || id <= 0 ||
+        width != 512 || height != 256 || ctx->currentInstance == NULL ||
+        ctx->currentInstance->objectIndex != 727 || ctx->currentInstance->persistent ||
+        ctx->currentEventType != EVENT_OTHER || ctx->currentEventSubtype != 10 ||
+        ctx->currentEventObjectIndex != 727 || ctx->currentCodeName == NULL ||
+        strcmp(ctx->currentCodeName, "gml_Object_oLightEngine_Other_10") != 0 ||
+        !Renderer_surfaceExists(ctx->runner->renderer, id)) return;
+    for (unsigned i = 0; i < AM2R_ORPHAN_RECORDS; ++i) {
+        if (am2rOrphanRecords[i].creator != NULL) continue;
+        am2rOrphanRecords[i] = (Am2rOrphanRecord){
+            ctx->runner, ctx->currentInstance, ctx->currentInstance->instanceId, id
+        };
+        return;
+    }
+    /* A full provenance table is a conservative refusal, never eviction. */
+}
+
+static bool am2rOrphanSurfaceNumber(RValue value, int32_t* surface) {
+    double number;
+    switch (value.type) {
+        case RVALUE_REAL: number = value.real; break;
+        case RVALUE_INT32: number = value.int32; break;
+#ifndef NO_RVALUE_INT64
+        case RVALUE_INT64:
+            if (value.int64 <= 0 || value.int64 > INT32_MAX) return false;
+            number = (double)value.int64; break;
+#endif
+        default: return false;
+    }
+    if (!isfinite(number) || number < 1.0 || number > INT32_MAX ||
+        number != (double)(int32_t)number) return false;
+    *surface = (int32_t)number;
+    return true;
+}
+
+static bool am2rOrphanInstanceAliases(Instance* instance, const int32_t fields[5], int32_t surface) {
+    if (instance == NULL) return false;
+    for (unsigned i = 0; i < 5; ++i) {
+        int32_t other;
+        if (fields[i] >= 0 && am2rOrphanSurfaceNumber(Instance_getSelfVar(instance, fields[i]), &other) &&
+            other == surface) return true;
+    }
+    return false;
+}
+
+void Am2rOrphanSurfaceRoomRemove(Runner* runner, Instance* instance) {
+    if (!am2rOrphanIsEnabled() || runner == NULL || instance == NULL) return;
+    int32_t surface = -1;
+    for (unsigned i = 0; i < AM2R_ORPHAN_RECORDS; ++i) {
+        Am2rOrphanRecord* record = &am2rOrphanRecords[i];
+        if (record->runner != runner || record->creator != instance ||
+            record->instance != instance->instanceId) continue;
+        surface = record->surface;
+        /* Retire provenance even if a safety condition refuses cleanup. This
+         * prevents ABA after the caller frees this exact instance. */
+        *record = (Am2rOrphanRecord){0};
+    }
+    if (surface <= 0 || !am2rOrphanDataVerified(runner) ||
+        instance->objectIndex != 727 || instance->persistent ||
+        runner->applicationSurfaceId == surface ||
+        ((SWRenderer*)runner->renderer)->currentSurface == surface ||
+        (runner->inGuiPass && runner->guiPassTarget == surface)) return;
+
+    for (unsigned i = 0; i < MAX_SURFACES; ++i)
+        if (runner->surfaceStack[i] == surface) return;
+    for (unsigned i = 0; i < MAX_VIEWS; ++i)
+        if (runner->views[i].surfaceId == surface) return;
+
+    /* Complete audited program: all surface IDs are held in these fields or
+     * the application target, never DS containers, reflective fields, texture
+     * handles, or calculated integers. Numeric values in unrelated variables
+     * are NOT resource aliases. An exact whole-file mismatch disables this. */
+    static const char* const names[5] = {"surf", "mysurf", "gui_surface", "screen_surface", "s_map"};
+    int32_t fields[5];
+    for (unsigned i = 0; i < 5; ++i) {
+        ptrdiff_t slot = shgeti(runner->vmContext->varNameMap, (char*)names[i]);
+        fields[i] = slot >= 0 ? runner->vmContext->varNameMap[slot].value : -1;
+    }
+    int32_t owned;
+    if (fields[0] < 0 || !am2rOrphanSurfaceNumber(Instance_getSelfVar(instance, fields[0]), &owned) ||
+        owned != surface) return;
+    /* Ignore the single proven owner field, but no second alias on the owner. */
+    int32_t otherFields[5] = {-1, fields[1], fields[2], fields[3], fields[4]};
+    if (am2rOrphanInstanceAliases(instance, otherFields, surface) ||
+        am2rOrphanInstanceAliases(runner->vmContext->globalScopeInstance, fields, surface)) return;
+    for (ptrdiff_t i = 0; i < hmlen(runner->instancesById); ++i) {
+        Instance* other = runner->instancesById[i].value;
+        if (other != instance && am2rOrphanInstanceAliases(other, fields, surface)) return;
+    }
+    if (runner->savedRoomStates != NULL) {
+        for (uint32_t room = 0; room < runner->dataWin->room.count; ++room) {
+            SavedRoomState* saved = &runner->savedRoomStates[room];
+            for (ptrdiff_t i = 0; i < arrlen(saved->instances); ++i) {
+                Instance* other = saved->instances[i];
+                if (other == instance || (other != NULL && other->instanceId == instance->instanceId) ||
+                    am2rOrphanInstanceAliases(other, fields, surface)) return;
+            }
+            if (saved->initialized)
+                for (unsigned i = 0; i < MAX_VIEWS; ++i)
+                    if (saved->views[i].surfaceId == surface) return;
+        }
+    }
+    if (!Renderer_surfaceExists(runner->renderer, surface) ||
+        Renderer_getSurfaceWidth(runner->renderer, surface) != 512.0f ||
+        Renderer_getSurfaceHeight(runner->renderer, surface) != 256.0f) return;
+    /* The normal SW release seals logical/descriptor queues and waits for GPU
+     * completion before freeing backing memory. Do not bypass that path. */
+    runner->renderer->vtable->surfaceFree(runner->renderer, surface);
+}
