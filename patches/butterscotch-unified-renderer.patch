+    logInfo("MiSTer resource state: sample=%u/%u frame=%d room=%d gpu_available=%d "
+        "unified=%d strict=%d gpu_failed=%d gpu_pending=%d "
+        "texture_highwater_bytes=%llu arena_owned_bytes=%llu arena_free_bytes=%llu "
+        "arena_largest_free_bytes=%llu arena_live_allocations=%u arena_initialized=%d "
+        "texture_total=%u texture_scanned=%u texture_live=%u "
+        "texture_released=%u texture_zero=%u offscreen_keys=%u offscreen_current=%u "
+        "target_slots=%u target_live=%u sw_surface_total=%u sw_surface_scanned=%u "
