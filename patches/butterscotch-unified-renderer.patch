+static uint32_t blendFactorByte(int32_t factor, const uint8_t source[4],
+                               const uint8_t destination[4], unsigned channel) {
+    switch (factor) {
+        case bm_zero: return 0;
+        case bm_one: return 255;
+        case bm_src_color: return source[channel];
+        case bm_inv_src_color: return 255u-source[channel];
+        case bm_src_alpha: return source[3];
+        case bm_inv_src_alpha: return 255u-source[3];
+        case bm_dest_alpha: return destination[3];
+        case bm_inv_dest_alpha: return 255u-destination[3];
+        case bm_dest_color: return destination[channel];
+        case bm_inv_dest_color: return 255u-destination[channel];
+        case bm_src_alpha_sat:
+            return channel == 3 ? 255u : source[3] < 255u-destination[3] ? source[3] : 255u-destination[3];
+        default: return 0; // Invalid factor is rejected by unified submission.
+    }
+}
