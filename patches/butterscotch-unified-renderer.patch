+/* Included by mister.c after its low-level submission/allocation helpers.
+ * Persistent raw-RGBA targets share the reserved texture DDR pool, not Linux
+ * memory. A CPU shadow is never authoritative after an accepted GPU write.
+ * All descriptors execute in order; no-present fences preserve scanout.
+ */
+#include "../render_diagnostics.h"
+#define GPU_SURFACE_RECORDS 128u
+#define GPU_SURFACE_BATCH 512u
+
+typedef struct { uint32_t left, top, right, bottom; } GpuSurfaceRect;
+typedef struct {
+    bool valid;
+    uint32_t rgba;
+    GpuSurfaceRect dirty;
+} GpuSurfaceBackground;
+
+typedef struct {
+    const void* key;
+    void* cpu;
+    uint32_t width, height, stride, physical, capacity;
+    uint32_t generation, revision;
+    bool live, cpu_valid, needs_import;
+    // Exact base version before the selected target's pending batch. Only a
+    // complete clear (or its already-proven constant fold) establishes this.
+    bool uniform_valid, uniform_ddr_current;
+    uint32_t uniform_rgba;
+    // Pixels outside dirty are exactly rgba, including raw alpha/RGB at alpha0.
+    // Logical refers to the sealed base before pending draws; canonical refers
+    // to the last fully accepted DDR version, which may be older than logical.
+    GpuSurfaceBackground background, canonical_background;
+} GpuSurface;
+
+typedef struct {
+    MisterGpuCommand command;
+    MisterGpuCommand setup;
+    bool has_setup;
+    bool has_packet;
+    uint64_t packet[64];
+} GpuSurfaceDraw;
+
+static GpuSurface g_gpu_surfaces[GPU_SURFACE_RECORDS];
+static GpuSurfaceDraw g_gpu_surface_batch[GPU_SURFACE_BATCH];
+static uint32_t g_gpu_surface_batch_count;
+static uint32_t g_gpu_surface_selected;
+static uint32_t g_gpu_surface_present;
+static uint32_t g_gpu_surface_resident;
+static bool g_gpu_surface_resident_dirty;
+static uint32_t g_gpu_surface_snapshot;
+static uint32_t g_gpu_surface_snapshot_capacity;
+static bool g_gpu_surface_failed;
+static uint32_t g_gpu_surface_packet_banks[GPU_COMMAND_BUFFER_COUNT];
+static bool gpuSurfaceFoldUniformFill(uint32_t destination, uint32_t targetWidth,
+    uint32_t targetHeight, const uint64_t words[8], uint32_t* result);
+
+static bool gpuSurfacePacket(const GpuSurfaceDraw* draw,
+                              const MisterGpuCommand* translated,
+                              uint32_t tileX, uint32_t tileY,
+                              MisterGpuCommand* output) {
+    if (!draw->has_packet) return false;
+    if (g_gpu_command_count >= GPU_COMMAND_CAPACITY - 1u) return false;
+    // The caller has already reserved a command slot; payload and descriptor
+    // therefore belong to the same bank and cannot straddle a fence.
+    if (!g_gpu_surface_packet_banks[g_gpu_write_buffer]) return false;
+    uint64_t packet[64];
+    memcpy(packet, draw->packet, sizeof(packet));
+    int32_t originalX = (int16_t)draw->command.word[2];
+    int32_t originalY = (int16_t)(draw->command.word[2] >> 16);
+    uint64_t ox = (uint64_t)((int32_t)tileX + (int16_t)translated->word[2] - originalX);
+    uint64_t oy = (uint64_t)((int32_t)tileY + (int16_t)(translated->word[2] >> 16) - originalY);
+    for (unsigned q = 8; q < 23; q += 3)
+        packet[q] += ox * packet[q + 1] + oy * packet[q + 2];
+    for (unsigned q = 23; q < 39; q += 4) {
+        packet[q] += ox * packet[q + 1] + oy * packet[q + 2] + ox * oy * packet[q + 3];
+        packet[q + 1] += oy * packet[q + 3];
+        packet[q + 2] += ox * packet[q + 3];
+    }
+    uint32_t physical = g_gpu_surface_packet_banks[g_gpu_write_buffer] + g_gpu_command_count * 512u;
+    GPU_TEXTURE_COPY(g_gpu_textures + physical - GPU_TEXTURE_PHYS, packet, sizeof(packet));
+    __sync_synchronize();
+    *output = *translated;
+    output->word[1] = physical;
+    return true;
+}
+
+static GpuSurface* gpuSurfaceRecord(uint32_t handle) {
+    uint32_t slot = handle & 255u;
+    if (!slot || slot > GPU_SURFACE_RECORDS) return NULL;
+    GpuSurface* surface = &g_gpu_surfaces[slot - 1u];
+    return surface->live && surface->generation == (handle >> 8) ? surface : NULL;
+}
+
+static uint32_t gpuSurfaceHandle(uint32_t slot) {
+    return (g_gpu_surfaces[slot].generation << 8) | (slot + 1u);
+}
+
+static bool gpuSurfaceSubmitFence(void) {
+    RD_SCOPE(RD_SURFACE_FENCE, (int32_t)g_gpu_surface_selected, 0);
+    if (g_gpu_surface_failed || !g_gpu_available) return false;
+    if (g_gpu_command_count) {
+        if (g_gpu_command_count >= GPU_COMMAND_CAPACITY) return false;
+        MisterGpuCommand* end = &g_gpu_commands[g_gpu_command_count++];
+        memset(end, 0, sizeof(*end));
+        end->word[0] = 12u;
+        if (!waitGpuCompletion(NULL) || !submitGpuCommandsAsync()) {
+            g_gpu_surface_failed = true;
+            return false;
+        }
+        g_gpu_command_count = 0;
+    }
+    if (!waitGpuCompletion(NULL)) {
+        g_gpu_surface_failed = true;
+        return false;
+    }
+    return true;
+}
+
+static bool gpuSurfaceRaw(const MisterGpuCommand* command) {
+    if (g_gpu_surface_failed || !g_gpu_available) return false;
+    // One reserved slot always remains for END_NO_PRESENT/END_PRESENT.
+    if (g_gpu_command_count >= GPU_COMMAND_CAPACITY - 1u &&
+        !gpuSurfaceSubmitFence()) return false;
+    g_gpu_commands[g_gpu_command_count++] = *command;
+    return true;
+}
+
+static bool gpuSurfaceDmaRect(uint8_t opcode, uint32_t physical, uint32_t stride,
+                             uint32_t x, uint32_t y, uint32_t width, uint32_t height) {
+    if ((physical & 3u) || (stride & 7u) || !width || !height ||
+        x >= MISTER_WIDTH || y >= MISTER_HEIGHT ||
+        width > MISTER_WIDTH - x || height > MISTER_HEIGHT - y || stride < width * 4u)
+        return false;
+    MisterGpuCommand command = {{0}};
+    command.word[0] = opcode | ((uint64_t)width << 16) | ((uint64_t)height << 32);
+    command.word[1] = physical | ((uint64_t)stride << 32);
+    command.word[2] = x | ((uint64_t)y << 16);
+    return gpuSurfaceRaw(&command);
+}
+
+static bool gpuSurfaceDma(uint8_t opcode, uint32_t physical, uint32_t stride,
+                           uint32_t width, uint32_t height) {
+    return gpuSurfaceDmaRect(opcode, physical, stride, 0, 0, width, height);
+}
+
+static bool gpuSurfaceRectEmpty(GpuSurfaceRect rect) {
+    return rect.left >= rect.right || rect.top >= rect.bottom;
+}
+
+static GpuSurfaceRect gpuSurfaceRectUnion(GpuSurfaceRect a, GpuSurfaceRect b) {
+    if (gpuSurfaceRectEmpty(a)) return b;
+    if (gpuSurfaceRectEmpty(b)) return a;
+    return (GpuSurfaceRect){a.left < b.left ? a.left : b.left,
+        a.top < b.top ? a.top : b.top, a.right > b.right ? a.right : b.right,
+        a.bottom > b.bottom ? a.bottom : b.bottom};
+}
+
+static GpuSurfaceBackground gpuSurfaceBatchBackground(const GpuSurface* surface) {
+    GpuSurfaceBackground result = surface->background;
+    for (uint32_t i = 0; i < g_gpu_surface_batch_count; ++i) {
+        const uint64_t* words = g_gpu_surface_batch[i].command.word;
+        if ((words[0] & 255u) == 1u) {
+            result = (GpuSurfaceBackground){.valid = true, .rgba = (uint32_t)words[1]};
+        } else if (result.valid) {
+            int32_t left = (int16_t)words[2], top = (int16_t)(words[2] >> 16);
+            int32_t right = left + (uint16_t)(words[0] >> 16);
+            int32_t bottom = top + (uint16_t)(words[0] >> 32);
+            if (left < 0) left = 0;
+            if (top < 0) top = 0;
+            if (right > (int32_t)surface->width) right = (int32_t)surface->width;
+            if (bottom > (int32_t)surface->height) bottom = (int32_t)surface->height;
+            if (left < right && top < bottom)
+                result.dirty = gpuSurfaceRectUnion(result.dirty,
+                    (GpuSurfaceRect){(uint32_t)left, (uint32_t)top,
+                                     (uint32_t)right, (uint32_t)bottom});
+        }
+    }
+    return result;
+}
+
+static bool gpuSurfaceExportTile(GpuSurface* surface, GpuSurfaceBackground result,
+        uint32_t x, uint32_t y, uint32_t width, uint32_t height) {
+    GpuSurfaceRect rect = {x, y, x + width, y + height};
+    if (result.valid && surface->canonical_background.valid &&
+        result.rgba == surface->canonical_background.rgba) {
+        GpuSurfaceRect dirty = gpuSurfaceRectUnion(result.dirty,
+                                                   surface->canonical_background.dirty);
+        if (gpuSurfaceRectEmpty(dirty)) return true;
+        if (rect.left < dirty.left) rect.left = dirty.left;
+        if (rect.top < dirty.top) rect.top = dirty.top;
+        if (rect.right > dirty.right) rect.right = dirty.right;
+        if (rect.bottom > dirty.bottom) rect.bottom = dirty.bottom;
+        if (gpuSurfaceRectEmpty(rect)) return true;
+    }
+    // Preserve every possible old non-background pixel, including disappeared
+    // draws. Pixels outside the union are proved identical rawRGBA, not merely
+    // visually transparent. Unknown/background-changing versions export fully.
+    if (!gpuSurfaceDmaRect(11, surface->physical + rect.top * surface->stride + rect.left * 4u,
+            surface->stride, rect.left - x, rect.top - y,
+            rect.right - rect.left, rect.bottom - rect.top)) {
+        g_gpu_surface_failed = true;
+        return false;
+    }
+    return true;
+}
+
+static bool gpuSurfaceSpill(void) {
+    GpuSurface* surface = gpuSurfaceRecord(g_gpu_surface_resident);
+    if (surface && g_gpu_surface_resident_dirty) {
+        // A constant has an authoritative, lossless representation without
+        // DDR pixels. Real source/readback requests materialize it explicitly.
+        if (surface->uniform_valid) {
+            g_gpu_surface_resident_dirty = false;
+            return true;
+        }
+        RD_SCOPE(RD_SURFACE_SPILL, (int32_t)g_gpu_surface_resident,
+                 (uint64_t)surface->width * surface->height);
+        if (!gpuSurfaceExportTile(surface, surface->background, 0, 0,
+                                  surface->width, surface->height)) return false;
+        surface->canonical_background = surface->background;
+        g_gpu_surface_resident_dirty = false;
+    }
+    return true;
+}
+
+static bool gpuSurfaceClearRect(uint32_t width, uint32_t height, uint32_t rgba) {
+    MisterGpuCommand clear = {{0}};
+    clear.word[0] = 1u;
+    if ((width != MISTER_WIDTH || height != MISTER_HEIGHT) && MisterGpu_hasReplaceRect())
+        clear.word[0] = 14u | ((uint64_t)width << 16) | ((uint64_t)height << 32);
+    clear.word[1] = rgba;
+    return gpuSurfaceRaw(&clear);
+}
+
+static bool gpuSurfaceImport(GpuSurface* surface) {
+    if (!surface || !surface->needs_import) return surface != NULL;
+    // Fresh allocations have no queued readers: release/reuse fenced the
+    // previous incarnation, and surfaceTexture imports before publishing an
+    // address. Do not copy initial CPU zeros for a target about to be cleared.
+    uint8_t* destination = g_gpu_textures + surface->physical - GPU_TEXTURE_PHYS;
+    for (uint32_t y = 0; y < surface->height; ++y) {
+        GPU_TEXTURE_COPY(destination + y * surface->stride,
+                         (uint8_t*)surface->cpu + y * surface->width * 4u,
+                         surface->width * 4u);
+        if (surface->stride != surface->width * 4u)
+            memset(destination + y * surface->stride + surface->width * 4u, 0,
+                   surface->stride - surface->width * 4u);
+    }
+    __sync_synchronize();
+    surface->needs_import = false;
+    surface->canonical_background.valid = false;
+    return true;
+}
+
+static bool gpuSurfaceLoad(uint32_t handle, bool discard) {
+    GpuSurface* surface = gpuSurfaceRecord(handle);
+    if (!surface || surface->width > MISTER_WIDTH || surface->height > MISTER_HEIGHT)
+        return false;
+    if (g_gpu_surface_resident == handle) return true;
+    if (!gpuSurfaceSpill()) return false;
+    if (!discard) {
+        if (surface->uniform_valid) {
+            if (!gpuSurfaceClearRect(surface->width, surface->height, surface->uniform_rgba)) return false;
+        } else if (!gpuSurfaceImport(surface) ||
+                   !gpuSurfaceDma(10, surface->physical, surface->stride,
+                                   surface->width, surface->height)) return false;
+    }
+    g_gpu_surface_resident = handle;
+    if (discard) surface->needs_import = false;
+    g_gpu_surface_resident_dirty = false;
+    return true;
+}
+
+// Clip by translation, preserving the original fixed-point sampling sequence.
+// Gradient starting tint has no fractional field in the legacy ABI: preserve
+// its original row origin and let the FPGA discard negative destination rows.
+static bool gpuSurfaceTranslate(const GpuSurfaceDraw* draw,
+        uint32_t tileX, uint32_t tileY, uint32_t tileW, uint32_t tileH,
+        MisterGpuCommand* output) {
+    *output = draw->command;
+    uint32_t opcode = (uint32_t)output->word[0] & 255u;
+    if (opcode == 1u) {
+        // A partial workspace tile owns only this rectangle. New cores can
+        // clear it directly instead of touching every one of 76,800 pixels.
+        // Retain opcode1 on old cores and on complete320x240 workspace tiles.
+        if ((tileW != MISTER_WIDTH || tileH != MISTER_HEIGHT) && MisterGpu_hasReplaceRect()) {
+            output->word[0] = 14u | ((uint64_t)tileW << 16) | ((uint64_t)tileH << 32);
+            output->word[2] = 0;
+        }
+        return true;
+    }
+    int32_t x = (int16_t)output->word[2];
+    int32_t y = (int16_t)(output->word[2] >> 16);
+    int32_t width = (uint16_t)(output->word[0] >> 16);
+    int32_t height = (uint16_t)(output->word[0] >> 32);
+    int32_t left = x > (int32_t)tileX ? x : (int32_t)tileX;
+    int32_t top = y > (int32_t)tileY ? y : (int32_t)tileY;
+    int32_t right = x + width < (int32_t)(tileX + tileW) ? x + width : (int32_t)(tileX + tileW);
+    int32_t bottom = y + height < (int32_t)(tileY + tileH) ? y + height : (int32_t)(tileY + tileH);
+    if (left >= right || top >= bottom) return false;
+    bool gradient = (opcode == 2u || opcode == 3u) && output->word[7] != 0;
+    if (gradient) top = y;
+    uint32_t ox = (uint32_t)(left - x), oy = (uint32_t)(top - y);
+    output->word[0] = (output->word[0] & UINT64_C(0xffff)) |
+        ((uint64_t)(uint16_t)(right - left) << 16) |
+        ((uint64_t)(uint16_t)(bottom - top) << 32);
+    output->word[2] = (uint16_t)(left - (int32_t)tileX) |
+        ((uint64_t)(uint16_t)(top - (int32_t)tileY) << 16);
+    if (opcode == 2u) {
+        uint32_t u = (uint32_t)output->word[4] + ox * (uint32_t)output->word[5];
+        uint32_t v = (uint32_t)(output->word[4] >> 32) + oy * (uint32_t)(output->word[5] >> 32);
+        output->word[4] = u | ((uint64_t)v << 32);
+    } else if (opcode == 4u) {
+        uint32_t u = (uint32_t)output->word[5] + ox * (uint32_t)output->word[6] + oy * (uint32_t)output->word[7];
+        uint32_t v = (uint32_t)(output->word[5] >> 32) + ox * (uint32_t)(output->word[6] >> 32) + oy * (uint32_t)(output->word[7] >> 32);
+        output->word[5] = u | ((uint64_t)v << 32);
+    }
+    return true;
+}
+
+static bool gpuSurfaceFlushBatch(void) {
+    if (!g_gpu_surface_batch_count) return !g_gpu_surface_failed;
+    GpuSurface* surface = gpuSurfaceRecord(g_gpu_surface_selected);
+    if (!surface || g_gpu_surface_failed) return false;
+    RD_SCOPE(RD_SURFACE_BATCH, (int32_t)g_gpu_surface_selected,
+             (uint64_t)surface->width * surface->height);
+    GpuSurfaceBackground resultBackground = gpuSurfaceBatchBackground(surface);
+    bool cleared = (g_gpu_surface_batch[0].command.word[0] & 255u) == 1u;
+    if (cleared && g_gpu_surface_batch_count == 1u) {
+        // Sealing a clear-only batch must not take BRAM from an unrelated
+        // target or spill the target's now-obsolete resident version.
+        surface->uniform_valid = true;
+        surface->uniform_ddr_current = false;
+        surface->uniform_rgba = (uint32_t)g_gpu_surface_batch[0].command.word[1];
+        surface->background = resultBackground;
+        surface->needs_import = false;
+        if (g_gpu_surface_resident == g_gpu_surface_selected) {
+            g_gpu_surface_resident = 0;
+            g_gpu_surface_resident_dirty = false;
+        }
+        g_gpu_surface_batch_count = 0;
+        return true;
+    }
+    // Keep this base fact until every tile's seed has been emitted. It refers
+    // to the version before this batch, not its accepted but deferred draws.
+    bool uniformSeed = !cleared && surface->uniform_valid;
+    bool materializeUntouched = uniformSeed && !surface->uniform_ddr_current;
+    bool resident = surface->width <= MISTER_WIDTH && surface->height <= MISTER_HEIGHT;
+    if (resident) {
+        if (!gpuSurfaceLoad(g_gpu_surface_selected, cleared)) return false;
+    } else {
+        if (!gpuSurfaceSpill()) return false;
+        g_gpu_surface_resident = 0;
+        if (!cleared && !uniformSeed && !gpuSurfaceImport(surface)) return false;
+        if (cleared) surface->needs_import = false;
+    }
+    for (uint32_t ty = 0; ty < surface->height; ty += MISTER_HEIGHT) {
+        uint32_t th = surface->height - ty;
+        if (th > MISTER_HEIGHT) th = MISTER_HEIGHT;
+        for (uint32_t tx = 0; tx < surface->width; tx += MISTER_WIDTH) {
+            uint32_t tw = surface->width - tx;
+            if (tw > MISTER_WIDTH) tw = MISTER_WIDTH;
+            bool touched = false;
+            MisterGpuCommand translated;
+            for (uint32_t i = 0; i < g_gpu_surface_batch_count; ++i) {
+                if (gpuSurfaceTranslate(&g_gpu_surface_batch[i], tx, ty, tw, th, &translated)) {
+                    touched = true;
+                    break;
+                }
+            }
+            // Once this target ceases to be uniform, its untouched tiles must
+            // also contain the uniform base; older canonical bytes are stale.
+            if (!touched && !materializeUntouched) continue;
+            uint32_t address = surface->physical + ty * surface->stride + tx * 4u;
+            if (!resident && !cleared) {
+                if (uniformSeed) {
+                    if (!gpuSurfaceClearRect(tw, th, surface->uniform_rgba)) return false;
+                } else if (!gpuSurfaceDma(10, address, surface->stride, tw, th)) return false;
+            }
+            uint32_t tileStart = g_gpu_command_count, tileSequence = g_gpu_sequence;
+            for (uint32_t i = 0; i < g_gpu_surface_batch_count; ++i) {
+                if (!gpuSurfaceTranslate(&g_gpu_surface_batch[i], tx, ty, tw, th, &translated)) continue;
+                if (i == 0 && cleared && g_gpu_surface_batch_count > 1u) {
+                    MisterGpuCommand fill;
+                    uint32_t folded;
+                    if (gpuSurfaceTranslate(&g_gpu_surface_batch[1], tx, ty, tw, th, &fill) &&
+                        gpuSurfaceFoldUniformFill((uint32_t)translated.word[1], tw, th, fill.word, &folded)) {
+                        // This particular tile is uniform even when the fill
+                        // covers only part of the larger logical target. Keep
+                        // untouched border tiles and all later draws intact.
+                        translated.word[1] = folded;
+                        ++i;
+                    }
+                }
+                uint32_t needed = g_gpu_surface_batch[i].has_setup ? 2u : 1u;
+                if (g_gpu_command_count + needed >= GPU_COMMAND_CAPACITY &&
+                    !gpuSurfaceSubmitFence()) return false;
+                if (g_gpu_surface_batch[i].has_setup && !gpuSurfaceRaw(&g_gpu_surface_batch[i].setup)) return false;
+                if (g_gpu_surface_batch[i].has_packet &&
+                    !gpuSurfacePacket(&g_gpu_surface_batch[i], &translated, tx, ty, &translated)) {
+                    g_gpu_surface_failed = true;
+                    return false;
+                }
+                if (!gpuSurfaceRaw(&translated)) return false;
+            }
+            // Never cross a LOAD/STORE/fence or a bank switch. The helper also
+            // rejects affine state and generic index-addressed packet payloads.
+            if (tileSequence == g_gpu_sequence) gpuSurfaceCullOpaquePrefix(tileStart, tw, th);
+            if (!resident && !gpuSurfaceExportTile(surface, resultBackground, tx, ty, tw, th)) return false;
+        }
+    }
+    if (resident) g_gpu_surface_resident_dirty = true;
+    else surface->canonical_background = resultBackground;
+    surface->background = resultBackground;
+    surface->uniform_valid = surface->uniform_ddr_current = false;
+    g_gpu_surface_batch_count = 0;
+    return true;
+}
+
+static bool gpuSurfaceCanonical(GpuSurface* surface) {
+    if (!surface) return false;
+    if (!surface->uniform_valid) return gpuSurfaceImport(surface);
+    if (surface->uniform_ddr_current) return true;
+    // This may borrow BRAM from the current target, so first seal all of its
+    // earlier consumers/writes. It is an ordering operation, not a CPU wait.
+    if (!gpuSurfaceFlushBatch()) return false;
+    if (!surface->uniform_valid) return gpuSurfaceImport(surface);
+    if (!gpuSurfaceSpill()) return false;
+    g_gpu_surface_resident = 0;
+    g_gpu_surface_resident_dirty = false;
+    for (uint32_t y = 0; y < surface->height; y += MISTER_HEIGHT) {
+        uint32_t h = surface->height - y;
+        if (h > MISTER_HEIGHT) h = MISTER_HEIGHT;
+        for (uint32_t x = 0; x < surface->width; x += MISTER_WIDTH) {
+            uint32_t w = surface->width - x;
+            if (w > MISTER_WIDTH) w = MISTER_WIDTH;
+            if (!gpuSurfaceClearRect(w, h, surface->uniform_rgba) ||
+                !gpuSurfaceExportTile(surface, surface->background, x, y, w, h)) {
+                g_gpu_surface_failed = true;
+                return false;
+            }
+        }
+    }
+    // Publish this fact only after all stores were accepted. Queue/bank
+    // retirement still protects the physical bytes until their consumers run.
+    surface->uniform_ddr_current = true;
+    surface->canonical_background = surface->background;
+    if (surface->width <= MISTER_WIDTH && surface->height <= MISTER_HEIGHT)
+        g_gpu_surface_resident = gpuSurfaceHandle((uint32_t)(surface - g_gpu_surfaces));
+    return true;
+}
+
+bool MisterGpu_hasSurfaceTargets(void) { return g_gpu_available && g_gpu_surface_targets; }
+bool MisterGpu_hasGenericPrimitive(void) { return g_gpu_available && g_gpu_generic_primitive; }
+bool MisterGpu_unifiedEnabled(void) {
+    return g_gpu_unified_enabled && MisterGpu_hasSurfaceTargets() && !g_gpu_surface_failed;
+}
+bool MisterGpu_unifiedFailed(void) {
+    return g_gpu_unified_enabled && (g_gpu_surface_failed || !MisterGpu_hasSurfaceTargets());
+}
+
+bool MisterGpu_surfaceFlush(void) {
+    RD_SCOPE(RD_SURFACE_QUEUE_FLUSH, (int32_t)g_gpu_surface_selected, 0);
+    return MisterGpu_unifiedEnabled() && gpuSurfaceFlushBatch();
+}
+
+bool MisterGpu_flushNoPresent(void) {
+    RD_SCOPE(RD_SURFACE_FLUSH, (int32_t)g_gpu_surface_selected, 0);
+    if (!MisterGpu_unifiedEnabled()) return false;
+    return gpuSurfaceFlushBatch() && gpuSurfaceSpill() && gpuSurfaceSubmitFence();
+}
+
+bool MisterGpu_setUnifiedEnabled(bool enabled) {
+    if (enabled == g_gpu_unified_enabled) return !enabled || MisterGpu_unifiedEnabled();
+    if (enabled) {
+        if (!MisterGpu_hasSurfaceTargets() || !waitGpuCompletion(NULL) || g_gpu_command_count)
+            return false;
+        g_gpu_surface_failed = false;
+        g_gpu_unified_enabled = true;
+        g_gpu_offscreen_allowed = false;
+        g_gpu_offscreen_needs_scene_clear = false;
+        return true;
+    }
+    // Disabling cannot silently lose GPU-owned pixels. Materialize every live
+    // surface before the renderer is allowed to use the ordinary CPU path.
+    for (uint32_t i = 0; i < GPU_SURFACE_RECORDS; ++i)
+        if (g_gpu_surfaces[i].live &&
+            !MisterGpu_surfaceReadback(gpuSurfaceHandle(i), g_gpu_surfaces[i].cpu,
+                                      g_gpu_surfaces[i].width * 4u)) return false;
+    if (!MisterGpu_flushNoPresent()) return false;
+    for (uint32_t i = 0; i < GPU_SURFACE_RECORDS; ++i) {
+        g_gpu_surfaces[i].live = false;
+        g_gpu_surfaces[i].uniform_valid = g_gpu_surfaces[i].uniform_ddr_current = false;
+        g_gpu_surfaces[i].background.valid = g_gpu_surfaces[i].canonical_background.valid = false;
+        g_gpu_surfaces[i].key = g_gpu_surfaces[i].cpu = NULL;
+    }
+    g_gpu_unified_enabled = false;
+    g_gpu_surface_selected = g_gpu_surface_present = g_gpu_surface_resident = 0;
+    return true;
+}
+
+uint32_t MisterGpu_surfaceEnsure(const void* key, uint32_t width, uint32_t height,
+                                 void* cpuRgba, uint32_t cpuRevision) {
+    if (!MisterGpu_unifiedEnabled() || !key || !cpuRgba || !width || !height ||
+        width > 4096u || height > 4096u) return 0;
+    for (uint32_t i = 0; i < GPU_SURFACE_RECORDS; ++i) {
+        GpuSurface* s = &g_gpu_surfaces[i];
+        if (s->live && s->key == key)
+            return s->width == width && s->height == height && s->cpu == cpuRgba ? gpuSurfaceHandle(i) : 0;
+    }
+    uint32_t stride = (width * 4u + 7u) & ~7u;
+    uint32_t bytes = stride * height;
+    uint32_t slot = GPU_SURFACE_RECORDS;
+    for (uint32_t i = 0; i < GPU_SURFACE_RECORDS; ++i)
+        if (!g_gpu_surfaces[i].live && g_gpu_surfaces[i].capacity >= bytes) { slot = i; break; }
+    if (slot == GPU_SURFACE_RECORDS)
+        for (uint32_t i = 0; i < GPU_SURFACE_RECORDS; ++i)
+            if (!g_gpu_surfaces[i].live) { slot = i; break; }
+    if (slot == GPU_SURFACE_RECORDS) return 0;
+    GpuSurface* surface = &g_gpu_surfaces[slot];
+    if (surface->capacity < bytes) {
+        // This slot is released. A barrier covers all earlier references,
+        // including Step batches and unsubmitted descriptors, before recycling
+        // its old parent allocation. No live pixels are moved or discarded.
+        if (surface->physical) {
+            if (!MisterGpu_flushNoPresent() || !gpuArenaRelease(surface->physical)) return 0;
+            surface->physical = surface->capacity = 0;
+        }
+        uint32_t physical = reserveGpuTexture(bytes);
+        if (!physical && MisterGpu_flushNoPresent()) {
+            // Cached released capacities are optional; their old pixels are
+            // not game state. Reclaim them only on actual allocation pressure.
+            for (uint32_t i = 0; i < GPU_SURFACE_RECORDS; ++i) {
+                GpuSurface* dead = &g_gpu_surfaces[i];
+                if (dead->live || !dead->physical) continue;
+                if (!gpuArenaRelease(dead->physical)) return 0;
+                dead->physical = dead->capacity = 0;
+            }
+            physical = gpuReserveTextureWithReclaim(bytes);
+        }
+        if (!physical) return 0;
+        surface->physical = physical;
+        surface->capacity = bytes;
+    }
+    surface->generation = (surface->generation + 1u) & 0x00ffffffu;
+    if (!surface->generation) surface->generation = 1;
+    surface->key = key;
+    surface->cpu = cpuRgba;
+    surface->width = width; surface->height = height; surface->stride = stride;
+    surface->revision = cpuRevision;
+    surface->live = surface->cpu_valid = surface->needs_import = true;
+    surface->uniform_valid = surface->uniform_ddr_current = false;
+    surface->background = surface->canonical_background = (GpuSurfaceBackground){0};
+    RD_SCOPE(RD_SURFACE_REGISTER, (int32_t)gpuSurfaceHandle(slot), (uint64_t)width * height);
+    return gpuSurfaceHandle(slot);
+}
+
+bool MisterGpu_surfaceSelect(uint32_t handle) {
+    if (!MisterGpu_unifiedEnabled() || !gpuSurfaceRecord(handle)) return false;
+    if (handle == g_gpu_surface_selected) return true;
+    RD_SCOPE(RD_SURFACE_SELECT, (int32_t)handle, 0);
+    if (handle != g_gpu_surface_selected && !gpuSurfaceFlushBatch()) return false;
+    g_gpu_surface_selected = handle;
+    return true;
+}
+
+static bool gpuSurfaceGradientFits(const GpuSurface* surface, const uint64_t words[8]) {
+    uint32_t opcode = (uint32_t)words[0] & 255u;
+    if ((opcode != 2u && opcode != 3u) || words[7] == 0) return true;
+    int32_t x = (int16_t)words[2], y = (int16_t)(words[2] >> 16);
+    int32_t width = (uint16_t)(words[0] >> 16), height = (uint16_t)(words[0] >> 32);
+    if (!width || !height || x >= (int32_t)surface->width || x + width <= 0 ||
+        y >= (int32_t)surface->height || y + height <= 0) return true;
+    int32_t bottom = y + height;
+    if (bottom > (int32_t)surface->height) bottom = (int32_t)surface->height;
+    int32_t lastTileY = ((bottom - 1) / (int32_t)MISTER_HEIGHT) * (int32_t)MISTER_HEIGHT;
+    // Legacy gradient packets preserve their initial row instead of rounding
+    // a clipped starting tint. Prove every touched tile's signed local Y fits
+    // before accepting the draw; op13 planes do not have this restriction.
+    return y - lastTileY >= INT16_MIN;
+}
+
+static bool gpuSurfaceFoldUniformFill(uint32_t destination, uint32_t targetWidth,
+        uint32_t targetHeight, const uint64_t words[8], uint32_t* result) {
+    if ((words[0] & 255u) != 3u ||
+        (words[0] & UINT64_C(0xffff00000000fc00)) != 0 ||
+        (words[0] & 0x300u) == 0x300u || (words[1] >> 32) || (words[2] >> 32))
+        return false;
+    for (unsigned i = 3; i < 8; ++i) if (words[i]) return false;
+    int32_t x = (int16_t)words[2], y = (int16_t)(words[2] >> 16);
+    int32_t w = (uint16_t)(words[0] >> 16), h = (uint16_t)(words[0] >> 32);
+    if (x > 0 || y > 0 || x + w < (int32_t)targetWidth ||
+        y + h < (int32_t)targetHeight) return false;
+    uint32_t source = (uint32_t)words[1];
+    uint32_t alpha = source >> 24, packed = 0;
+    for (unsigned channel = 0; channel < 4; ++channel) {
+        uint32_t s = (source >> (channel * 8)) & 255u;
+        uint32_t d = (destination >> (channel * 8)) & 255u;
+        uint32_t value;
+        if (words[0] & 0x200u) value = d * (255u - s) / 255u;
+        else if (words[0] & 0x100u) {
+            value = d + (channel == 3 ? s : s * alpha / 255u);
+            if (value > 255u) value = 255u;
+        } else value = channel == 3 ? alpha + d * (255u - alpha) / 255u :
+            (s * alpha + d * (255u - alpha)) / 255u;
+        packed |= value << (channel * 8);
+    }
+    *result = packed;
+    return true;
+}
+
+bool MisterGpu_surfacePush(const uint64_t words[8], const uint64_t setup[8]) {
+    GpuSurface* surface = gpuSurfaceRecord(g_gpu_surface_selected);
+    if (!MisterGpu_unifiedEnabled() || !surface || !words) return false;
+    uint32_t opcode = (uint32_t)words[0] & 255u;
+    if (opcode != 1u && opcode != 2u && opcode != 3u && opcode != 4u) return false;
+    if (setup && (opcode != 4u || (setup[0] & 255u) != 5u)) return false;
+    if (!gpuSurfaceGradientFits(surface, words)) return false;
+    uint32_t folded;
+    if (g_gpu_surface_batch_count == 1u &&
+        (g_gpu_surface_batch[0].command.word[0] & 255u) == 1u &&
+        gpuSurfaceFoldUniformFill((uint32_t)g_gpu_surface_batch[0].command.word[1],
+                                 surface->width, surface->height, words, &folded)) {
+        // A proven uniform destination plus complete uniform source is still
+        // uniform. Compute one setup color, never a CPU pixel raster loop.
+        g_gpu_surface_batch[0].command.word[1] = folded;
+        surface->cpu_valid = false;
+        if (++surface->revision == 0) ++surface->revision;
+        return true;
+    }
+    if (opcode == 1u) g_gpu_surface_batch_count = 0; // Full overwrite, no dependency escapes this batch.
+    if (g_gpu_surface_batch_count == GPU_SURFACE_BATCH && !gpuSurfaceFlushBatch()) return false;
+    GpuSurfaceDraw* draw = &g_gpu_surface_batch[g_gpu_surface_batch_count++];
+    memcpy(draw->command.word, words, sizeof(draw->command.word));
+    draw->has_setup = setup != NULL;
+    draw->has_packet = false;
+    if (setup) memcpy(draw->setup.word, setup, sizeof(draw->setup.word));
+    surface->cpu_valid = false;
+    if (++surface->revision == 0) ++surface->revision;
+    return true;
+}
+
+static bool gpuSurfaceGenericPacketValid(const uint64_t packet[64]) {
+    if (!packet || (uint32_t)packet[0] != UINT32_C(0x31504741) ||
+        (packet[0] >> 34) != 0 || (packet[2] >> 59) != 0 ||
+        (packet[2] & (UINT64_C(15) << 44)) != 0) return false;
+    uint32_t mode = (uint32_t)(packet[2] >> 32) & 255u;
+    if (mode > 6u) return false;
+    for (unsigned q = 4; q < 8; ++q) if (packet[q] != 0) return false;
+    for (unsigned q = 39; q < 64; ++q) if (packet[q] != 0) return false;
+    if (mode == 6u)
+        for (unsigned shift = 0; shift < 32; shift += 8) {
+            uint32_t factor = (uint32_t)(packet[3] >> shift) & 255u;
+            if (factor < 1u || factor > 11u) return false;
+        }
+    if (packet[0] & (UINT64_C(1) << 32)) {
+        uint32_t address = (uint32_t)packet[1], stride = (uint32_t)(packet[1] >> 32);
+        uint32_t width = (uint16_t)packet[2], height = (uint16_t)(packet[2] >> 16);
+        if (!width || !height || (address & 3u) || (stride & 3u) ||
+            stride < width * 4u || address < GPU_TEXTURE_PHYS ||
+            g_gpu_texture_offset > GPU_TEXTURE_BYTES) return false;
+        uint64_t offset = (uint64_t)address - GPU_TEXTURE_PHYS;
+        uint64_t bytes = (uint64_t)(height - 1u) * stride + (uint64_t)width * 4u;
+        if (offset > g_gpu_texture_offset || bytes > g_gpu_texture_offset - offset ||
+            !gpuArenaParent(address, (size_t)bytes))
+            return false;
+    }
+    return true;
+}
+
+bool MisterGpu_addGeneric(int16_t x, int16_t y, uint16_t width, uint16_t height,
+                           const uint64_t packet[64]) {
+    GpuSurface* surface = gpuSurfaceRecord(g_gpu_surface_selected);
+    if (!MisterGpu_unifiedEnabled() || !MisterGpu_hasGenericPrimitive() || !surface ||
+        !width || !height || !gpuSurfaceGenericPacketValid(packet))
+        return false;
+    // Allocate all packet banks before accepting any draw. Allocation failure
+    // is therefore a clean per-operation fallback, never a half-flushed batch.
+    for (uint32_t i = 0; i < GPU_COMMAND_BUFFER_COUNT; ++i) {
+        if (g_gpu_surface_packet_banks[i]) continue;
+        uint32_t physical = gpuReserveTextureWithReclaim(GPU_COMMAND_CAPACITY * 512u);
+        if (!physical) return false;
+        g_gpu_surface_packet_banks[i] = physical;
+    }
+    if (g_gpu_surface_batch_count == GPU_SURFACE_BATCH && !gpuSurfaceFlushBatch()) return false;
+    GpuSurfaceDraw* draw = &g_gpu_surface_batch[g_gpu_surface_batch_count++];
+    memset(&draw->command, 0, sizeof(draw->command));
+    draw->command.word[0] = 13u | ((uint64_t)width << 16) | ((uint64_t)height << 32);
+    draw->command.word[2] = (uint16_t)x | ((uint64_t)(uint16_t)y << 16);
+    draw->has_setup = false;
+    draw->has_packet = true;
+    memcpy(draw->packet, packet, sizeof(draw->packet));
+    surface->cpu_valid = false;
+    if (++surface->revision == 0) ++surface->revision;
+    return true;
+}
+
+static uint32_t gpuSurfaceSnapshot(GpuSurface* source) {
+    uint32_t bytes = source->stride * source->height;
+    // Snapshot storage may still be referenced by earlier queued/submitted
+    // draws. Retire those before recycling it, not merely before allocation.
+    if (!MisterGpu_flushNoPresent()) return 0;
+    if (g_gpu_surface_snapshot_capacity < bytes) {
+        if (g_gpu_surface_snapshot) {
+            if (!gpuArenaRelease(g_gpu_surface_snapshot)) return 0;
+            g_gpu_surface_snapshot = g_gpu_surface_snapshot_capacity = 0;
+        }
+        uint32_t physical = gpuReserveTextureWithReclaim(bytes);
+        if (!physical) return 0;
+        g_gpu_surface_snapshot = physical;
+        g_gpu_surface_snapshot_capacity = bytes;
+    }
+    g_gpu_surface_resident = 0;
+    for (uint32_t y = 0; y < source->height; y += MISTER_HEIGHT) {
+        uint32_t h = source->height - y;
+        if (h > MISTER_HEIGHT) h = MISTER_HEIGHT;
+        for (uint32_t x = 0; x < source->width; x += MISTER_WIDTH) {
+            uint32_t w = source->width - x;
+            if (w > MISTER_WIDTH) w = MISTER_WIDTH;
+            uint32_t offset = y * source->stride + x * 4u;
+            if (!gpuSurfaceDma(10, source->physical + offset, source->stride, w, h) ||
+                !gpuSurfaceDma(11, g_gpu_surface_snapshot + offset, source->stride, w, h)) return 0;
+        }
+    }
+    return g_gpu_surface_snapshot;
+}
+
+uint32_t MisterGpu_surfaceTexture(uint32_t handle, uint32_t* stride) {
+    GpuSurface* surface = gpuSurfaceRecord(handle);
+    RD_SCOPE(RD_SURFACE_SOURCE, (int32_t)handle,
+             surface ? (uint64_t)surface->width * surface->height : 0);
+    if (!MisterGpu_unifiedEnabled() || !surface) return 0;
+    uint32_t physical;
+    if (handle == g_gpu_surface_selected) {
+        if (!gpuSurfaceFlushBatch() || !gpuSurfaceSpill() || !gpuSurfaceCanonical(surface)) return 0;
+        physical = gpuSurfaceSnapshot(surface);
+    } else {
+        // Selecting another target already sealed this source's logical draw
+        // batch. Its canonical STORE is either queued or still needed from its
+        // own resident BRAM copy. A different dirty resident target can stay in
+        // BRAM: returning this independent source neither reads nor mutates it.
+        if (g_gpu_surface_resident == handle && !gpuSurfaceSpill()) return 0;
+        if (!gpuSurfaceCanonical(surface)) return 0;
+        physical = surface->physical;
+    }
+    if (physical && stride) *stride = surface->stride;
+    return physical;
+}
+
+bool MisterGpu_surfaceReadback(uint32_t handle, void* rgba, size_t rowBytes) {
+    GpuSurface* surface = gpuSurfaceRecord(handle);
+    RD_SCOPE(RD_SURFACE_READBACK, (int32_t)handle,
+             surface ? (uint64_t)surface->width * surface->height : 0);
+    if (!MisterGpu_unifiedEnabled() || !surface || !rgba || rowBytes < surface->width * 4u ||
+        !gpuSurfaceFlushBatch() || !gpuSurfaceCanonical(surface) ||
+        !MisterGpu_flushNoPresent()) return false;
+    const uint8_t* source = g_gpu_textures + surface->physical - GPU_TEXTURE_PHYS;
+    __sync_synchronize();
+    for (uint32_t y = 0; y < surface->height; ++y) {
+        memcpy((uint8_t*)rgba + y * rowBytes, source + y * surface->stride, surface->width * 4u);
+        if (rgba != surface->cpu || rowBytes != surface->width * 4u)
+            memcpy((uint8_t*)surface->cpu + y * surface->width * 4u,
+                   source + y * surface->stride, surface->width * 4u);
+    }
+    surface->cpu_valid = true;
+    return true;
+}
+
+bool MisterGpu_surfaceCpuWritten(uint32_t handle, const void* rgba,
+                                  size_t rowBytes, uint32_t revision) {
+    GpuSurface* surface = gpuSurfaceRecord(handle);
+    RD_SCOPE(RD_SURFACE_CPU_WRITE, (int32_t)handle,
+             surface ? (uint64_t)surface->width * surface->height : 0);
+    if (!MisterGpu_unifiedEnabled() || !surface || !rgba || rowBytes < surface->width * 4u ||
+        !MisterGpu_flushNoPresent()) return false;
+    uint8_t* destination = g_gpu_textures + surface->physical - GPU_TEXTURE_PHYS;
+    for (uint32_t y = 0; y < surface->height; ++y) {
+        GPU_TEXTURE_COPY(destination + y * surface->stride, (const uint8_t*)rgba + y * rowBytes,
+                         surface->width * 4u);
+        if (rgba != surface->cpu || rowBytes != surface->width * 4u)
+            memcpy((uint8_t*)surface->cpu + y * surface->width * 4u,
+                   (const uint8_t*)rgba + y * rowBytes, surface->width * 4u);
+    }
+    __sync_synchronize();
+    if (g_gpu_surface_resident == handle) g_gpu_surface_resident = 0;
+    surface->cpu_valid = true;
+    surface->needs_import = false;
+    surface->uniform_valid = surface->uniform_ddr_current = false;
+    surface->background.valid = surface->canonical_background.valid = false;
+    surface->revision = revision;
+    return true;
+}
+
+bool MisterGpu_surfaceRelease(uint32_t handle) {
+    GpuSurface* surface = gpuSurfaceRecord(handle);
+    RD_SCOPE(RD_SURFACE_RELEASE, (int32_t)handle,
+             surface ? (uint64_t)surface->width * surface->height : 0);
+    if (!surface || !MisterGpu_flushNoPresent()) return false;
+    if (g_gpu_surface_selected == handle) g_gpu_surface_selected = 0;
+    if (g_gpu_surface_present == handle) g_gpu_surface_present = 0;
+    if (g_gpu_surface_resident == handle) g_gpu_surface_resident = 0;
+    surface->live = false;
+    surface->uniform_valid = surface->uniform_ddr_current = false;
+    surface->background.valid = surface->canonical_background.valid = false;
+    surface->key = surface->cpu = NULL;
+    return true;
+}
+
+bool MisterGpu_surfaceReset(void) {
+    if (!MisterGpu_unifiedEnabled() || !MisterGpu_flushNoPresent()) return false;
+    for (uint32_t i = 0; i < GPU_SURFACE_RECORDS; ++i) {
+        g_gpu_surfaces[i].live = false;
+        g_gpu_surfaces[i].uniform_valid = g_gpu_surfaces[i].uniform_ddr_current = false;
+        g_gpu_surfaces[i].background.valid = g_gpu_surfaces[i].canonical_background.valid = false;
+        g_gpu_surfaces[i].key = g_gpu_surfaces[i].cpu = NULL;
+    }
+    g_gpu_surface_selected = g_gpu_surface_present = g_gpu_surface_resident = 0;
+    g_gpu_surface_batch_count = 0;
+    return true;
+}
+
+bool MisterGpu_surfaceCopy(uint32_t destination, int32_t dx, int32_t dy,
+                            uint32_t source, int32_t sx, int32_t sy,
+                            int32_t width, int32_t height) {
+    RD_SCOPE(RD_SURFACE_COPY, (int32_t)destination,
+             width > 0 && height > 0 ? (uint64_t)width * (uint32_t)height : 0);
+    GpuSurface* dst = gpuSurfaceRecord(destination);
+    GpuSurface* src = gpuSurfaceRecord(source);
+    if (!MisterGpu_unifiedEnabled() || !dst || !src || width < 0 || height < 0) return false;
+    // Wide intermediates make public clipping safe even for hostile int32 coordinates.
+    int64_t xx = sx, yy = sy, x = dx, y = dy, w = width, h = height;
+    if (xx < 0) { x -= xx; w += xx; xx = 0; }
+    if (yy < 0) { y -= yy; h += yy; yy = 0; }
+    if (x < 0) { xx -= x; w += x; x = 0; }
+    if (y < 0) { yy -= y; h += y; y = 0; }
+    if (w > (int64_t)src->width - xx) w = (int64_t)src->width - xx;
+    if (h > (int64_t)src->height - yy) h = (int64_t)src->height - yy;
+    if (w > (int64_t)dst->width - x) w = (int64_t)dst->width - x;
+    if (h > (int64_t)dst->height - y) h = (int64_t)dst->height - y;
+    if (w <= 0 || h <= 0) return true;
+    bool fullDestination = x == 0 && y == 0 && w == dst->width && h == dst->height;
+    bool fullSource = xx == 0 && yy == 0 && w == src->width && h == src->height;
+    // An exact self-copy has no observable pixel effect, including when the
+    // surface still has deferred writes. Do not manufacture a snapshot/fence.
+    if (source == destination && fullDestination && fullSource) return true;
+    if (!gpuSurfaceFlushBatch()) return false;
+    if (fullDestination && fullSource && !src->uniform_valid && g_gpu_surface_resident == source &&
+        src->width <= MISTER_WIDTH && src->height <= MISTER_HEIGHT) {
+        // The complete source already occupies BRAM. Preserve its independent
+        // canonical version first, then transfer BRAM ownership to the copied
+        // destination. A later target switch/readback will store destination
+        // pixels if needed; presentation can consume them without another DMA.
+        // Do not publish the ownership change until a required spill is queued.
+        if (!gpuSurfaceSpill()) return false;
+        g_gpu_surface_resident = destination;
+        g_gpu_surface_resident_dirty = true;
+        dst->cpu_valid = false;
+        dst->needs_import = false;
+        dst->uniform_valid = dst->uniform_ddr_current = false;
+        dst->background.valid = false;
+        if (++dst->revision == 0) ++dst->revision;
+        return true;
+    }
+    if (!gpuSurfaceCanonical(src)) return false;
+    if (!fullDestination && !gpuSurfaceCanonical(dst)) return false;
+    if (!gpuSurfaceSpill()) return false;
+    uint32_t srcBase = src->physical;
+    if (source == destination) {
+        srcBase = gpuSurfaceSnapshot(src);
+        if (!srcBase) return false;
+    }
+    g_gpu_surface_resident = 0;
+    for (uint32_t row = 0; row < (uint32_t)h; row += MISTER_HEIGHT) {
+        uint32_t th = (uint32_t)h - row;
+        if (th > MISTER_HEIGHT) th = MISTER_HEIGHT;
+        for (uint32_t column = 0; column < (uint32_t)w; column += MISTER_WIDTH) {
+            uint32_t tw = (uint32_t)w - column;
+            if (tw > MISTER_WIDTH) tw = MISTER_WIDTH;
+            if (!gpuSurfaceDma(10, srcBase + ((uint32_t)yy + row) * src->stride + ((uint32_t)xx + column) * 4u,
+                               src->stride, tw, th) ||
+                !gpuSurfaceDma(11, dst->physical + ((uint32_t)y + row) * dst->stride + ((uint32_t)x + column) * 4u,
+                               dst->stride, tw, th)) return false;
+        }
+    }
+    dst->cpu_valid = false;
+    dst->needs_import = false;
+    dst->uniform_valid = dst->uniform_ddr_current = false;
+    dst->background.valid = dst->canonical_background.valid = false;
+    if (++dst->revision == 0) ++dst->revision;
+    return true;
+}
+
+bool MisterGpu_surfaceSetPresent(uint32_t handle) {
+    GpuSurface* surface = gpuSurfaceRecord(handle);
+    if (!MisterGpu_unifiedEnabled() || !surface || surface->width != MISTER_WIDTH ||
+        surface->height != MISTER_HEIGHT) return false;
+    g_gpu_surface_present = handle;
+    return true;
+}
+
+static bool gpuSurfacePreparePresent(void) {
+    return gpuSurfaceFlushBatch() && gpuSurfaceLoad(g_gpu_surface_present, false);
+}
+
+static bool gpuSurfacePrepareCheckpoint(void) {
+    if (!g_gpu_unified_enabled) return true;
+    for (uint32_t i = 0; i < GPU_SURFACE_RECORDS; ++i)
+        if (g_gpu_surfaces[i].live &&
+            !MisterGpu_surfaceReadback(gpuSurfaceHandle(i), g_gpu_surfaces[i].cpu,
+                                      g_gpu_surfaces[i].width * 4u)) return false;
+    return true;
+}
+
+static bool gpuSurfaceRestoreCheckpoint(void) {
+    if (!g_gpu_unified_enabled) return true;
+    if (!MisterGpu_hasSurfaceTargets()) return false;
+    g_gpu_surface_resident = 0;
+    g_gpu_surface_resident_dirty = false;
+    g_gpu_surface_batch_count = 0;
+    for (uint32_t i = 0; i < GPU_SURFACE_RECORDS; ++i) {
+        GpuSurface* surface = &g_gpu_surfaces[i];
+        if (!surface->live) continue;
+        if (!surface->cpu_valid) return false;
+        surface->uniform_valid = surface->uniform_ddr_current = false;
+        surface->background.valid = surface->canonical_background.valid = false;
+        uint8_t* destination = g_gpu_textures + surface->physical - GPU_TEXTURE_PHYS;
+        for (uint32_t y = 0; y < surface->height; ++y)
+            GPU_TEXTURE_COPY(destination + y * surface->stride,
+                             (uint8_t*)surface->cpu + y * surface->width * 4u, surface->width * 4u);
+        surface->needs_import = false;
+    }
+    __sync_synchronize();
+    return true;
+}
diff --git a/src/backends/mister_capture_surfaces_impl.h b/src/backends/mister_capture_surfaces_impl.h
new file mode 100644
--- /dev/null
+++ b/src/backends/mister_capture_surfaces_impl.h
@@ -0,0 +1,293 @@
+/* Diagnostic-only sparse capture extension; included inside the existing
+ * MISTER_RENDER_DIAGNOSTICS guard. No capture polling/I/O ships in release.
+ */
+#define GPU_CAPTURE_RANGES 1024u
+#define GPU_CAPTURE_BYTE_LIMIT (64u * 1024u * 1024u)
+typedef struct { uint32_t first, end; } GpuCaptureRange;
+static GpuCaptureRange g_capture_inputs[GPU_CAPTURE_RANGES];
+static GpuCaptureRange g_capture_outputs[GPU_CAPTURE_RANGES];
+static uint32_t g_capture_input_count, g_capture_output_count;
+static uint32_t g_capture_probe_commands, g_capture_probe_rgba;
+static size_t g_capture_input_bytes, g_capture_output_bytes;
+
+static bool gpuCaptureRange(GpuCaptureRange* ranges, uint32_t* count,
+                             uint64_t first, uint64_t end, bool cacheLines) {
+    if (end <= first || first < GPU_TEXTURE_PHYS ||
+        end > (uint64_t)GPU_TEXTURE_PHYS + g_gpu_texture_offset) return false;
+    if (cacheLines) { first &= ~UINT64_C(127); end = (end + 127u) & ~UINT64_C(127); }
+    if (end > (uint64_t)GPU_TEXTURE_PHYS + GPU_TEXTURE_BYTES) return false;
+    uint32_t at = 0;
+    while (at < *count && ranges[at].end < first) ++at;
+    uint32_t after = at;
+    while (after < *count && ranges[after].first <= end) {
+        if (ranges[after].first < first) first = ranges[after].first;
+        if (ranges[after].end > end) end = ranges[after].end;
+        ++after;
+    }
+    if (at == after && *count == GPU_CAPTURE_RANGES) return false;
+    memmove(&ranges[at + 1], &ranges[after], (*count - after) * sizeof(*ranges));
+    *count = *count - (after - at) + 1;
+    ranges[at].first = (uint32_t)first; ranges[at].end = (uint32_t)end;
+    return true;
+}
+
+static bool gpuCaptureInput(uint64_t first, uint64_t bytes) {
+    return bytes && gpuCaptureRange(g_capture_inputs, &g_capture_input_count,
+                                    first, first + bytes, true);
+}
+
+static bool gpuCaptureReadRect(uint32_t base, uint32_t stride,
+                                int64_t minX, int64_t minY, int64_t maxX, int64_t maxY) {
+    if (minX < 0 || minY < 0 || maxX < minX || maxY < minY ||
+        maxX >= 65536 || maxY >= 65536 || stride == 0) return false;
+    uint64_t first = (uint64_t)base + (uint64_t)minY * stride + (uint64_t)minX * 4u;
+    uint64_t end = (uint64_t)base + (uint64_t)maxY * stride + (uint64_t)(maxX + 1) * 4u;
+    return gpuCaptureInput(first, end - first);
+}
+
+static bool gpuCapturePlanUnified(GpuCapture* capture) {
+    g_capture_input_count = g_capture_output_count = 0;
+    capture->exportCount = 0;
+    for (uint32_t i = 0; i < capture->commandCount; ++i) {
+        const uint64_t* q = g_gpu_commands[i].word;
+        uint32_t op = (uint8_t)q[0], w = (uint16_t)(q[0] >> 16), h = (uint16_t)(q[0] >> 32);
+        uint32_t base = (uint32_t)q[1], stride = (uint32_t)(q[1] >> 32);
+        int32_t x = (int16_t)q[2], y = (int16_t)(q[2] >> 16);
+        bool terminal = op == 0 || op == 12;
+        if (op > 14 || terminal != (i + 1 == capture->commandCount)) return false;
+        if (terminal) {
+            for (unsigned j = 1; j < 8; ++j) if (q[j]) return false;
+            if (q[0] != op) return false;
+        } else if (op == 14) {
+            if ((q[0] & UINT64_C(0xffff00000000ff00)) || (q[1] >> 32) || (q[2] >> 32)) return false;
+            for (unsigned j = 3; j < 8; ++j) if (q[j]) return false;
+            if (!w || !h) continue;
+            if (x < 0 || y < 0 || x + w > 320 || y + h > 240) return false;
+        } else if (op == 10 || op == 11) {
+            if (!w || !h) continue;
+            if ((base & 3u) || (stride & 7u) || stride < w * 4u ||
+                x < 0 || y < 0 || x + w > 320 || y + h > 240) return false;
+            for (unsigned j = 3; j < 8; ++j) if (q[j]) return false;
+            if (op == 10) {
+                if (!gpuCaptureReadRect(base, stride, 0, 0, w - 1u, h - 1u)) return false;
+            } else for (uint32_t row = 0; row < h; ++row) {
+                uint64_t first = (uint64_t)base + (uint64_t)row * stride;
+                if (!gpuCaptureRange(g_capture_outputs, &g_capture_output_count,
+                                      first, first + w * 4u, false)) return false;
+            }
+        } else if (op == 13) {
+            if (!w || !h) continue;
+            if ((base & 7u) || x < 0 || y < 0 || x + w > 320 || y + h > 240 ||
+                !gpuCaptureInput(base, 512u)) return false;
+            uint64_t packet[64];
+            memcpy(packet, g_gpu_textures + base - GPU_TEXTURE_PHYS, sizeof(packet));
+            if ((uint32_t)packet[0] != UINT32_C(0x31504741) || (packet[0] >> 34) != 0) return false;
+            if (packet[0] & (UINT64_C(1) << 32)) {
+                uint32_t tw = (uint16_t)packet[2], th = (uint16_t)(packet[2] >> 16);
+                uint32_t texture = (uint32_t)packet[1], textureStride = (uint32_t)(packet[1] >> 32);
+                if (!tw || !th || textureStride < tw * 4u ||
+                    !gpuCaptureReadRect(texture, textureStride, 0, 0, tw - 1u, th - 1u)) return false;
+            }
+        } else if (op == 2 || op == 4 || op == 9) {
+            if (!w || !h) continue;
+            int64_t umin, umax, vmin, vmax;
+            if (op == 4) {
+                umin = (int32_t)q[3]; umax = (int32_t)(q[3] >> 32) - INT64_C(1);
+                vmin = (int32_t)q[4]; vmax = (int32_t)(q[4] >> 32) - INT64_C(1);
+            } else {
+                int64_t left = x < 0 ? -(int64_t)x : 0, top = y < 0 ? -(int64_t)y : 0;
+                int64_t right = w < 320 - (int64_t)x ? w : 320 - (int64_t)x;
+                int64_t bottom = h < 240 - (int64_t)y ? h : 240 - (int64_t)y;
+                if (left >= right || top >= bottom) continue;
+                int64_t u0 = (int32_t)q[4], v0 = (int32_t)(q[4] >> 32);
+                int64_t du = (int32_t)q[5], dv = (int32_t)(q[5] >> 32);
+                umin = u0 + left * du; umax = u0 + (right - 1) * du;
+                vmin = v0 + top * dv; vmax = v0 + (bottom - 1) * dv;
+                if (op == 9) { umin = u0; umax = u0 + 31 * INT64_C(65536); }
+                if (umin > umax) { int64_t tmp = umin; umin = umax; umax = tmp; }
+                if (vmin > vmax) { int64_t tmp = vmin; vmin = vmax; vmax = tmp; }
+            }
+            // Wrapped signed16.16 coordinates require disjoint regions; reject
+            // that diagnostic sample rather than invent a bounding interval.
+            if (umin < 0 || vmin < 0 || umax > INT32_MAX || vmax > INT32_MAX ||
+                !gpuCaptureReadRect(base, stride, umin / 65536, vmin / 65536,
+                                    umax / 65536, vmax / 65536)) return false;
+        } else if (op == 7 || op == 8) {
+            uint32_t table = (uint32_t)q[2];
+            if (!w || w > 240 || (table & 7u) || !gpuCaptureInput(table, w * 8u)) return false;
+            if (op == 8 && !capture->nativeSourceBase) return false;
+            if (op == 7) for (uint32_t row = 0; row < w; ++row) {
+                uint64_t packed;
+                memcpy(&packed, g_gpu_textures + table - GPU_TEXTURE_PHYS + row * 8u, 8);
+                uint32_t sy = (uint16_t)(packed >> 48);
+                if (!gpuCaptureInput((uint64_t)base + sy * 1280u, 1280u)) return false;
+            }
+        } else if (op == 6) {
+            if ((base & 7u) || (uint64_t)base + MISTER_FB_BYTES >
+                (uint64_t)GPU_TEXTURE_PHYS + g_gpu_texture_offset || base < GPU_TEXTURE_PHYS) return false;
+            uint32_t j = 0;
+            while (j < capture->exportCount && capture->exports[j] != base) ++j;
+            if (j == capture->exportCount) {
+                if (capture->exportCount == GPU_TEXTURE_RECORDS) return false;
+                capture->exports[capture->exportCount++] = base;
+            }
+        }
+    }
+    // Keep legacy op6 identities independently, matching the reference's
+    // output map, while rectangular writes are the exact merged byte union.
+    for (uint32_t i = 0; i < capture->exportCount; ++i) {
+        uint32_t base = capture->exports[i], j = 0;
+        while (j < g_capture_output_count && g_capture_outputs[j].first != base) ++j;
+        if (j == g_capture_output_count) {
+            if (j == GPU_CAPTURE_RANGES) return false;
+            g_capture_outputs[j].first = base; g_capture_outputs[j].end = base + MISTER_FB_BYTES;
+            ++g_capture_output_count;
+        } else if (g_capture_outputs[j].end < base + MISTER_FB_BYTES)
+            g_capture_outputs[j].end = base + MISTER_FB_BYTES;
+    }
+    g_capture_input_bytes = g_capture_output_bytes = 0;
+    for (uint32_t i = 0; i < g_capture_input_count; ++i)
+        g_capture_input_bytes += g_capture_inputs[i].end - g_capture_inputs[i].first;
+    for (uint32_t i = 0; i < g_capture_output_count; ++i)
+        g_capture_output_bytes += g_capture_outputs[i].end - g_capture_outputs[i].first;
+    return g_capture_input_bytes <= GPU_CAPTURE_BYTE_LIMIT && g_capture_output_bytes <= GPU_CAPTURE_BYTE_LIMIT;
+}
+
+static bool gpuCaptureSnapshotBram(uint32_t capturedSequence) {
+    if (!g_gpu_available || !g_gpu_surface_targets || g_gpu_pending) return false;
+    if (!g_capture_probe_commands) g_capture_probe_commands = reserveGpuTexture(128u);
+    if (!g_capture_probe_rgba) g_capture_probe_rgba = reserveGpuTexture(MISTER_FB_BYTES);
+    if (!g_capture_probe_commands || !g_capture_probe_rgba) return false;
+    MisterGpuCommand commands[2] = {{{0}},{{0}}};
+    commands[0].word[0] = 11u | (UINT64_C(320) << 16) | (UINT64_C(240) << 32);
+    commands[0].word[1] = g_capture_probe_rgba | (UINT64_C(1280) << 32);
+    commands[1].word[0] = 12u;
+    memcpy(g_gpu_textures + g_capture_probe_commands - GPU_TEXTURE_PHYS, commands, sizeof(commands));
+    uint32_t saved[8];
+    for (unsigned i = 0; i < 8; ++i) saved[i] = g_gpu_control[i];
+    uint32_t sequence = capturedSequence ^ UINT32_C(0x80000000);
+    if (!sequence) sequence = UINT32_MAX;
+    g_gpu_control[0] = 0;
+    __sync_synchronize();
+    g_gpu_control[1] = sequence; g_gpu_control[2] = g_capture_probe_commands;
+    g_gpu_control[3] = 2; g_gpu_control[4] = GPU_FRAMEBUFFER_PHYS;
+    g_gpu_control[5] = g_gpu_control[6] = g_gpu_control[7] = 0;
+    __sync_synchronize();
+    g_gpu_control[0] = GPU_CONTROL_MAGIC;
+    __sync_synchronize();
+    bool completed = false;
+    for (unsigned wait = 0; wait < 10000; ++wait) {
+        if (g_gpu_control[6] == sequence) { completed = true; break; }
+        usleep(100);
+        __sync_synchronize();
+    }
+    if (!completed) {
+        // A timed-out producer may still be writing. Never restore/reuse its
+        // mailbox or submit the original job over an indeterminate command.
+        g_gpu_available = false;
+        return false;
+    }
+    g_gpu_control[0] = 0;
+    __sync_synchronize();
+    for (unsigned i = 1; i < 8; ++i) g_gpu_control[i] = saved[i];
+    // Keep magic cleared. Restoring the old magic after the probe changed
+    // the FPGA's last sequence could resubmit the previously completed job.
+    __sync_synchronize();
+    return true;
+}
+
+static bool gpuCapturePrepareUnified(GpuCapture* capture) {
+    if (!gpuCapturePlanUnified(capture)) {
+        gpuCaptureAbort("unified capture dependency/range/64 MiB bound rejected"); return false;
+    }
+    uint64_t required = g_capture_input_bytes + g_capture_output_bytes +
+        (GPU_NATIVE_BUFFER_COUNT + 2u) * MISTER_FB_BYTES + GPU_COMMAND_BYTES + 1024u * 1024u;
+    struct statvfs storage;
+    if (fstatvfs(g_gpu_capture_root, &storage) != 0 ||
+        (uint64_t)storage.f_bavail * storage.f_frsize < required) {
+        gpuCaptureAbort("insufficient unified capture storage"); return false;
+    }
+    char name[96];
+    snprintf(name, sizeof(name), "job-%ld-%u-%u", (long)getpid(), capture->sequence, g_gpu_capture_attempts);
+    if (mkdirat(g_gpu_capture_root, name, 0700) != 0) {
+        gpuCaptureAbort("unified capture directory exists or cannot be created"); return false;
+    }
+    capture->directory = openat(g_gpu_capture_root, name, O_RDONLY|O_DIRECTORY|O_NOFOLLOW|O_CLOEXEC);
+    if (capture->directory < 0) return false;
+    if (!gpuCaptureSnapshotBram(capture->sequence)) {
+        gpuCaptureAbort("raw initial BRAM observation failed"); return false;
+    }
+    bool ok = gpuCaptureWrite(capture->directory, "initial.rgba",
+        g_gpu_textures + g_capture_probe_rgba - GPU_TEXTURE_PHYS, MISTER_FB_BYTES) &&
+        gpuCaptureWrite(capture->directory, "commands.bin", g_gpu_commands,
+                        capture->commandCount * sizeof(MisterGpuCommand));
+    for (uint32_t i = 0; i < g_capture_input_count && ok; ++i) {
+        snprintf(name, sizeof(name), "region-%u.bin", i);
+        ok = gpuCaptureWrite(capture->directory, name,
+            g_gpu_textures + g_capture_inputs[i].first - GPU_TEXTURE_PHYS,
+            g_capture_inputs[i].end - g_capture_inputs[i].first);
+    }
+    for (uint32_t i = 0; i < GPU_NATIVE_BUFFER_COUNT && ok; ++i) {
+        snprintf(name, sizeof(name), "native-%u.bin", i);
+        ok = gpuCaptureWrite(capture->directory, name, g_gpu_native_buffers[i], MISTER_FB_BYTES);
+    }
+    if (!ok) { gpuCaptureAbort("unified input write failed"); return false; }
+    logInfo("MiSTer GPU capture: unified inputs frozen (%zu bytes in %u referenced regions)\n",
+             g_capture_input_bytes, g_capture_input_count);
+    return true;
+}
+
+static void gpuCaptureCompleteUnified(GpuCapture* capture) {
+    if (g_gpu_pending || !g_gpu_available || g_gpu_control[6] != capture->sequence) {
+        gpuCaptureAbort("unified job did not complete"); return;
+    }
+    if (!gpuCaptureSnapshotBram(capture->sequence)) {
+        gpuCaptureAbort("raw final BRAM observation failed"); return;
+    }
+    bool ok = gpuCaptureWrite(capture->directory, "expected.rgba",
+        g_gpu_textures + g_capture_probe_rgba - GPU_TEXTURE_PHYS, MISTER_FB_BYTES);
+    char name[64];
+    for (uint32_t i = 0; i < g_capture_output_count && ok; ++i) {
+        snprintf(name, sizeof(name), "export-%u.bin", i);
+        ok = gpuCaptureWrite(capture->directory, name,
+            g_gpu_textures + g_capture_outputs[i].first - GPU_TEXTURE_PHYS,
+            g_capture_outputs[i].end - g_capture_outputs[i].first);
+    }
+    if (!ok) { gpuCaptureAbort("unified expected write failed"); return; }
+    int fd = openat(capture->directory, "manifest.json.tmp", O_WRONLY|O_CREAT|O_EXCL|O_NOFOLLOW|O_CLOEXEC,0600);
+    FILE* manifest = fd >= 0 ? fdopen(fd,"w") : NULL;
+    if (!manifest) { if (fd >= 0) close(fd); gpuCaptureAbort("unified manifest creation failed"); return; }
+    fprintf(manifest,
+        "{\n\"format\":\"am2r-gpu-capture-v1\",\"capture_kind\":\"gpu-job\",\n"
+        "\"perturbs_timing\":true,\"diagnostic_fence_count\":2,\"input_capture\":\"bounded-referenced-regions\",\n"
+        "\"initial_framebuffer_status\":\"captured-raw-rgba\",\"requires_initialization_proof\":false,\n"
+        "\"initial_framebuffer\":{\"file\":\"initial.rgba\"},\n"
+        "\"sequence\":%u,\"frame_serial\":%u,\"game_frame\":%d,\"room\":%d,\n"
+        "\"command_count\":%u,\"command_physical\":%u,\"gpu_cycles\":%u,\"underflow\":%s,\n"
+        "\"width\":320,\"height\":240,\"byte_order\":\"little\",\n"
+        "\"commands\":{\"file\":\"commands.bin\"},\"regions\":[",
+        capture->sequence,capture->frameSerial,capture->gameFrame,capture->room,
+        capture->commandCount,capture->commandPhysical,g_gpu_last_completed_cycles,
+        g_gpu_scanout_underflow?"true":"false");
+    for (uint32_t i=0;i<g_capture_input_count;++i)
+        fprintf(manifest,"%s{\"base\":%u,\"file\":\"region-%u.bin\",\"bytes\":%u}",i?",":"",
+                g_capture_inputs[i].first,i,g_capture_inputs[i].end-g_capture_inputs[i].first);
+    for(uint32_t i=0;i<GPU_NATIVE_BUFFER_COUNT;++i)
+        fprintf(manifest,"%s{\"base\":%u,\"file\":\"native-%u.bin\",\"bytes\":%zu}",
+                i||g_capture_input_count?",":"",GPU_NATIVE_WINDOW_PHYS+GPU_NATIVE_BUFFER_OFFSET+i*(uint32_t)GPU_NATIVE_BUFFER_BYTES,
+                i,MISTER_FB_BYTES);
+    fprintf(manifest,"],\n\"native_source_base\":");
+    if(capture->nativeSourceBase)fprintf(manifest,"%u",capture->nativeSourceBase);else fprintf(manifest,"null");
+    fprintf(manifest,",\n\"expected\":{\"file\":\"expected.rgba\",\"format\":\"rgba8888\"},\n\"expected_exports\":[");
+    for(uint32_t i=0;i<g_capture_output_count;++i)
+        fprintf(manifest,"%s{\"base\":%u,\"file\":\"export-%u.bin\",\"bytes\":%u}",i?",":"",
+                g_capture_outputs[i].first,i,g_capture_outputs[i].end-g_capture_outputs[i].first);
+    fprintf(manifest,"]\n}\n");
+    ok=!ferror(manifest)&&fflush(manifest)==0&&fsync(fd)==0;
+    if(fclose(manifest)!=0)ok=false;
+    if(!ok||renameat(capture->directory,"manifest.json.tmp",capture->directory,"manifest.json")!=0){
+        unlinkat(capture->directory,"manifest.json.tmp",0);gpuCaptureAbort("unified manifest publication failed");return;
+    }
+    fsync(capture->directory);close(capture->directory);capture->directory=-1;
+    logInfo("MiSTer GPU capture: unified job complete (two intrusive observer fences; not a speed sample)\n");
+}
diff --git a/src/backends/mister_gpu_arena_impl.h b/src/backends/mister_gpu_arena_impl.h
new file mode 100644
--- /dev/null
+++ b/src/backends/mister_gpu_arena_impl.h
@@ -0,0 +1,96 @@
+/* Pure bounded storage bookkeeping. Callers, never this allocator, prove that
+ * all GPU references have retired before releasing a block. No live compaction,
+ * hidden drain, eviction, CPU pixel access, or rendering occurs here.
+ */
+#ifndef MISTER_GPU_ARENA_IMPL_H
+#define MISTER_GPU_ARENA_IMPL_H
+#define GPU_ARENA_SEGMENTS 1024u
+typedef struct {
+    uint32_t offset, capacity, generation;
+    uint8_t state; /* 0 unused metadata, 1 free interval, 2 owned allocation. */
+} GpuArenaSegment;
+static GpuArenaSegment g_gpu_arena[GPU_ARENA_SEGMENTS];
+static uint32_t g_gpu_arena_generation;
+static unsigned g_gpu_arena_slots;
+static bool g_gpu_arena_initialized;
+
+static inline void gpuArenaReset(void) {
+    memset(g_gpu_arena, 0, sizeof(g_gpu_arena));
+    g_gpu_arena_generation = 0;
+    g_gpu_arena_slots = 0;
+    g_gpu_arena_initialized = false;
+}
+
+static inline uint32_t gpuArenaReserve(size_t bytes) {
+    if (!bytes || bytes > SIZE_MAX - 127u) return 0;
+    size_t capacity = (bytes + 127u) & ~(size_t)127u;
+    if (capacity > GPU_TEXTURE_BYTES) return 0;
+    if (!g_gpu_arena_initialized) {
+        g_gpu_arena[0] = (GpuArenaSegment){.capacity = GPU_TEXTURE_BYTES, .state = 1};
+        g_gpu_arena_slots = 1;
+        g_gpu_arena_initialized = true;
+    }
+    unsigned best = GPU_ARENA_SEGMENTS, spare = GPU_ARENA_SEGMENTS;
+    for (unsigned i = 0; i < g_gpu_arena_slots; ++i) {
+        const GpuArenaSegment* s = &g_gpu_arena[i];
+        if (!s->state && spare == GPU_ARENA_SEGMENTS) spare = i;
+        if (s->state == 1 && s->capacity >= capacity &&
+            (best == GPU_ARENA_SEGMENTS || s->capacity < g_gpu_arena[best].capacity ||
+             (s->capacity == g_gpu_arena[best].capacity && s->offset < g_gpu_arena[best].offset))) best = i;
+    }
+    if (best == GPU_ARENA_SEGMENTS) return 0;
+    GpuArenaSegment* s = &g_gpu_arena[best];
+    if (s->capacity > capacity) {
+        if (spare == GPU_ARENA_SEGMENTS && g_gpu_arena_slots < GPU_ARENA_SEGMENTS) spare = g_gpu_arena_slots;
+        if (spare == GPU_ARENA_SEGMENTS) return 0; // Atomic metadata exhaustion.
+        if (spare == g_gpu_arena_slots) ++g_gpu_arena_slots;
+        g_gpu_arena[spare] = (GpuArenaSegment){.offset = s->offset + (uint32_t)capacity,
+            .capacity = s->capacity - (uint32_t)capacity, .state = 1};
+        s->capacity = (uint32_t)capacity;
+    }
+    if (++g_gpu_arena_generation == 0) ++g_gpu_arena_generation;
+    s->generation = g_gpu_arena_generation;
+    s->state = 2;
+    size_t end = (size_t)s->offset + s->capacity;
+    if (g_gpu_texture_offset < end) g_gpu_texture_offset = end;
+    return GPU_TEXTURE_PHYS + s->offset;
+}
+
+static inline uint32_t gpuArenaParent(uint32_t address, size_t bytes) {
+    if (address < GPU_TEXTURE_PHYS || !bytes) return 0;
+    size_t offset = (size_t)(address - GPU_TEXTURE_PHYS);
+    for (unsigned i = 0; i < g_gpu_arena_slots; ++i) {
+        const GpuArenaSegment* s = &g_gpu_arena[i];
+        if (s->state == 2 && offset >= s->offset && offset - s->offset < s->capacity &&
+            bytes <= s->capacity - (offset - s->offset)) return GPU_TEXTURE_PHYS + s->offset;
+    }
+    return 0;
+}
+
+static inline bool gpuArenaRelease(uint32_t base) {
+    if (base < GPU_TEXTURE_PHYS) return false;
+    uint32_t offset = base - GPU_TEXTURE_PHYS;
+    unsigned slot = GPU_ARENA_SEGMENTS;
+    for (unsigned i = 0; i < g_gpu_arena_slots; ++i)
+        if (g_gpu_arena[i].state == 2 && g_gpu_arena[i].offset == offset) { slot = i; break; }
+    if (slot == GPU_ARENA_SEGMENTS) return false; // Interior/double/unknown free.
+    GpuArenaSegment* s = &g_gpu_arena[slot];
+    s->state = 1;
+    s->generation = 0;
+    // Free intervals are already maximally coalesced, so at most one neighbor
+    // on each side can merge; scan once more to cover arbitrary metadata order.
+    for (unsigned pass = 0; pass < 2; ++pass)
+        for (unsigned i = 0; i < g_gpu_arena_slots; ++i) {
+            GpuArenaSegment* other = &g_gpu_arena[i];
+            if (i == slot || other->state != 1) continue;
+            if (other->offset + other->capacity == s->offset) {
+                s->offset = other->offset; s->capacity += other->capacity;
+                memset(other, 0, sizeof(*other));
+            } else if (s->offset + s->capacity == other->offset) {
+                s->capacity += other->capacity; memset(other, 0, sizeof(*other));
+            }
+        }
+    while (g_gpu_arena_slots && !g_gpu_arena[g_gpu_arena_slots - 1u].state) --g_gpu_arena_slots;
+    return true;
+}
+#endif
