diff --git a/src/am2r_data_proof.h b/src/am2r_data_proof.h
new file mode 100644
--- /dev/null
+++ b/src/am2r_data_proof.h
@@ -0,0 +1,139 @@
+#ifndef BS_AM2R_DATA_PROOF_H
+#define BS_AM2R_DATA_PROOF_H
+
+/* Whole-file identity for a closed-program ownership proof, not a title/name
+ * heuristic. SHA-256 follows FIPS 180-4; this compact implementation has no
+ * external dependencies and is exercised against standard vectors/hashlib.
+ * This only recognizes original AM2R 1.1 data. A mismatch disables cleanup. */
+#include <stdbool.h>
+#include <stdint.h>
+#include <stddef.h>
+#include <stdio.h>
+#include <string.h>
+
+#define AM2R_11_DATA_PROOF_SIZE ((size_t)48345822u)
+typedef struct {
+    uint32_t state[8];
+    uint64_t bytes;
+    size_t used;
+    uint8_t block[64];
+} Am2rProofSha256;
+
+static inline uint32_t am2rProofRotate(uint32_t value, unsigned shift) {
+    return (value >> shift) | (value << (32u - shift));
+}
+
+static inline void am2rProofSha256Block(Am2rProofSha256* hash, const uint8_t* data) {
+    static const uint32_t k[64] = {
+        0x428a2f98u,0x71374491u,0xb5c0fbcfu,0xe9b5dba5u,0x3956c25bu,0x59f111f1u,0x923f82a4u,0xab1c5ed5u,
+        0xd807aa98u,0x12835b01u,0x243185beu,0x550c7dc3u,0x72be5d74u,0x80deb1feu,0x9bdc06a7u,0xc19bf174u,
+        0xe49b69c1u,0xefbe4786u,0x0fc19dc6u,0x240ca1ccu,0x2de92c6fu,0x4a7484aau,0x5cb0a9dcu,0x76f988dau,
+        0x983e5152u,0xa831c66du,0xb00327c8u,0xbf597fc7u,0xc6e00bf3u,0xd5a79147u,0x06ca6351u,0x14292967u,
+        0x27b70a85u,0x2e1b2138u,0x4d2c6dfcu,0x53380d13u,0x650a7354u,0x766a0abbu,0x81c2c92eu,0x92722c85u,
+        0xa2bfe8a1u,0xa81a664bu,0xc24b8b70u,0xc76c51a3u,0xd192e819u,0xd6990624u,0xf40e3585u,0x106aa070u,
+        0x19a4c116u,0x1e376c08u,0x2748774cu,0x34b0bcb5u,0x391c0cb3u,0x4ed8aa4au,0x5b9cca4fu,0x682e6ff3u,
+        0x748f82eeu,0x78a5636fu,0x84c87814u,0x8cc70208u,0x90befffau,0xa4506cebu,0xbef9a3f7u,0xc67178f2u
+    };
+    uint32_t w[64];
+    for (unsigned i = 0; i < 16; ++i)
+        w[i] = ((uint32_t)data[4*i] << 24) | ((uint32_t)data[4*i+1] << 16) |
+               ((uint32_t)data[4*i+2] << 8) | (uint32_t)data[4*i+3];
+    for (unsigned i = 16; i < 64; ++i) {
+        uint32_t x = w[i-15], y = w[i-2];
+        uint32_t s0 = am2rProofRotate(x,7) ^ am2rProofRotate(x,18) ^ (x >> 3);
+        uint32_t s1 = am2rProofRotate(y,17) ^ am2rProofRotate(y,19) ^ (y >> 10);
+        w[i] = w[i-16] + s0 + w[i-7] + s1;
+    }
+    uint32_t a=hash->state[0], b=hash->state[1], c=hash->state[2], d=hash->state[3];
+    uint32_t e=hash->state[4], f=hash->state[5], g=hash->state[6], h=hash->state[7];
+    for (unsigned i = 0; i < 64; ++i) {
+        uint32_t s1=am2rProofRotate(e,6)^am2rProofRotate(e,11)^am2rProofRotate(e,25);
+        uint32_t t1=h+s1+((e&f)^((~e)&g))+k[i]+w[i];
+        uint32_t s0=am2rProofRotate(a,2)^am2rProofRotate(a,13)^am2rProofRotate(a,22);
+        uint32_t t2=s0+((a&b)^(a&c)^(b&c));
+        h=g; g=f; f=e; e=d+t1; d=c; c=b; b=a; a=t1+t2;
+    }
+    hash->state[0]+=a; hash->state[1]+=b; hash->state[2]+=c; hash->state[3]+=d;
+    hash->state[4]+=e; hash->state[5]+=f; hash->state[6]+=g; hash->state[7]+=h;
+}
+
+static inline void am2rProofSha256Init(Am2rProofSha256* hash) {
+    static const uint32_t initial[8] = {
+        0x6a09e667u,0xbb67ae85u,0x3c6ef372u,0xa54ff53au,
+        0x510e527fu,0x9b05688cu,0x1f83d9abu,0x5be0cd19u
+    };
+    memcpy(hash->state, initial, sizeof(initial));
+    hash->bytes = 0;
+    hash->used = 0;
+}
+
+static inline void am2rProofSha256Update(Am2rProofSha256* hash, const void* input, size_t size) {
+    const uint8_t* data = (const uint8_t*)input;
+    hash->bytes += (uint64_t)size;
+    while (size != 0) {
+        size_t count = 64u - hash->used;
+        if (count > size) count = size;
+        memcpy(hash->block + hash->used, data, count);
+        hash->used += count; data += count; size -= count;
+        if (hash->used == 64u) {
+            am2rProofSha256Block(hash, hash->block);
+            hash->used = 0;
+        }
+    }
+}
+
+static inline void am2rProofSha256Finish(Am2rProofSha256* hash, uint8_t digest[32]) {
+    uint64_t bits = hash->bytes * 8u;
+    hash->block[hash->used++] = 0x80;
+    if (hash->used > 56u) {
+        memset(hash->block + hash->used, 0, 64u - hash->used);
+        am2rProofSha256Block(hash, hash->block);
+        hash->used = 0;
+    }
+    memset(hash->block + hash->used, 0, 56u - hash->used);
+    for (unsigned i = 0; i < 8; ++i) hash->block[63u-i] = (uint8_t)(bits >> (8u*i));
+    am2rProofSha256Block(hash, hash->block);
+    for (unsigned i = 0; i < 32; ++i)
+        digest[i] = (uint8_t)(hash->state[i/4u] >> (24u-8u*(i%4u)));
+}
+
+static inline bool am2rDataProofDigestMatches(const uint8_t digest[32], size_t size) {
+    static const uint8_t expected[32] = {
+        0x36,0xe4,0xa2,0x51,0xd7,0xb6,0x87,0xf2,0xd7,0x42,0xa8,0xe9,0x11,0xcb,0x1e,0x11,
+        0x85,0xae,0xa9,0x9e,0x36,0x52,0x9f,0xcf,0x32,0xcd,0x18,0xd4,0x45,0xa3,0x55,0xe3
+    };
+    return size == AM2R_11_DATA_PROOF_SIZE && memcmp(digest, expected, sizeof(expected)) == 0;
+}
+
+/* Called once during parsing. No retained pointer into the input, global state,
+ * heap allocation, or per-frame work. Unavailable/changed files fail closed. */
+static inline bool am2rDataProofMatches(const void* memory, size_t size, FILE* file) {
+    if (size != AM2R_11_DATA_PROOF_SIZE) return false;
+    Am2rProofSha256 hash;
+    uint8_t digest[32];
+    am2rProofSha256Init(&hash);
+    if (memory != NULL) {
+        am2rProofSha256Update(&hash, memory, size);
+    } else {
+        if (file == NULL) return false;
+        long previous = ftell(file);
+        if (previous < 0 || fseek(file, 0, SEEK_SET) != 0) return false;
+        uint8_t block[16384];
+        size_t left = size;
+        bool success = true;
+        while (left != 0) {
+            size_t amount = left < sizeof(block) ? left : sizeof(block);
+            if (fread(block, 1, amount, file) != amount) { success = false; break; }
+            am2rProofSha256Update(&hash, block, amount);
+            left -= amount;
+        }
+        if (success && (fgetc(file) != EOF || ferror(file))) success = false;
+        clearerr(file);
+        if (fseek(file, previous, SEEK_SET) != 0) return false;
+        if (!success) return false;
+    }
+    am2rProofSha256Finish(&hash, digest);
+    return am2rDataProofDigestMatches(digest, size);
+}
+
+#endif
