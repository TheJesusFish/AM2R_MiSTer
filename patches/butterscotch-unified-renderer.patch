+#if defined(USE_MISTER) && defined(MISTER_RENDER_DIAGNOSTICS)
+// SURFACE_LIFETIME_DIAGNOSTICS_BEGIN
+/* Creator identity is evidence, not ownership: GML may share a surface through
+ * globals or other instances. Nothing here frees, renders, or reads pixels.
+ * A fresh process plus bounded natural traversal is the intended experiment;
+ * this diagnostic table is deliberately not part of a save-state contract. */
+#define VM_SURFACE_TRACE_RECORDS 128u
+typedef struct {
+    bool used, creatorRemoved;
+    int32_t surface, object, room, frame;
+    uint32_t creator;
+} VmSurfaceTraceRecord;
+static VmSurfaceTraceRecord vmSurfaceTraceRecords[VM_SURFACE_TRACE_RECORDS];
+static bool vmSurfaceTraceConfigured;
+static unsigned vmSurfaceTraceLimit, vmSurfaceTraceLines;
+
+void VM_surfaceTraceResetRecords(void) {
+    /* Logical restore replaces surface and instance identities without builtin
+     * create/free calls. Keep the finite logging budget, discard attribution. */
+    memset(vmSurfaceTraceRecords, 0, sizeof(vmSurfaceTraceRecords));
+}
+
+static unsigned vmSurfaceTraceParseLimit(const char* value) {
+    unsigned limit = 0;
+    if (value == nullptr || *value == 0) return 0;
+    for (unsigned i = 0; value[i] != 0; ++i) {
+        if (i >= 4 || value[i] < '0' || value[i] > '9') return 0;
+        limit = limit * 10u + (unsigned)(value[i] - '0');
+        if (limit > 1024u) return 0;
+    }
+    return limit;
+}
+
+static bool vmSurfaceTraceReady(VMContext* ctx) {
+    if (!vmSurfaceTraceConfigured) {
+        vmSurfaceTraceLimit = vmSurfaceTraceParseLimit(getenv("AM2R_SURFACE_TRACE_LIMIT"));
+        vmSurfaceTraceConfigured = true;
+    }
+    return vmSurfaceTraceLines < vmSurfaceTraceLimit && ctx != nullptr &&
+           ctx->runner != nullptr && ctx->runner->renderer != nullptr;
+}
+
+static void vmSurfaceTraceEmit(VMContext* ctx, const char* operation, int32_t surface,
+                               int32_t requestedWidth, int32_t requestedHeight,
+                               Instance* creator, VmSurfaceTraceRecord* record) {
+    if (vmSurfaceTraceLines >= vmSurfaceTraceLimit) return;
+    Renderer* renderer = ctx->runner->renderer;
+    bool exists = Renderer_surfaceExists(renderer, surface);
+    int32_t width = exists ? (int32_t)Renderer_getSurfaceWidth(renderer, surface) : 0;
+    int32_t height = exists ? (int32_t)Renderer_getSurfaceHeight(renderer, surface) : 0;
+    char code[96];
+    const char* source = creator != nullptr ? "runner_room_remove" : ctx->currentCodeName;
+    if (source == nullptr) source = "unknown";
+    unsigned i = 0;
+    while (source[i] != 0 && i + 1u < sizeof(code)) {
+        unsigned char c = (unsigned char)source[i];
+        code[i++] = ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
+                     (c >= '0' && c <= '9') || c == '_') ? (char)c : '?';
+    }
+    code[i] = 0;
+    Instance* current = creator != nullptr ? creator : ctx->currentInstance;
+    logInfo("MiSTer surface lifetime: sample=%u/%u op=%s frame=%d room=%d "
+            "code=%s event=%d,%d event_object=%d instance=%u object=%d "
+            "surface=%d requested=%d,%d actual=%d,%d exists=%d tracked=%d "
+            "creator=%u creator_object=%d created_room=%d created_frame=%d creator_removed=%d\n",
+            ++vmSurfaceTraceLines, vmSurfaceTraceLimit, operation,
+            ctx->runner->frameCount, ctx->runner->currentRoomIndex, code,
+            creator != nullptr ? -1 : ctx->currentEventType,
+            creator != nullptr ? -1 : ctx->currentEventSubtype,
+            creator != nullptr ? -1 : ctx->currentEventObjectIndex,
+            current != nullptr ? current->instanceId : 0u,
+            current != nullptr ? current->objectIndex : -1,
+            surface, requestedWidth, requestedHeight, width, height, exists, record != nullptr,
+            record != nullptr ? record->creator : 0u,
+            record != nullptr ? record->object : -1,
+            record != nullptr ? record->room : -1,
+            record != nullptr ? record->frame : -1,
+            record != nullptr && record->creatorRemoved);
+}
+
+void VM_surfaceTrace(VMContext* ctx, const char* operation, int32_t surface,
+                     int32_t requestedWidth, int32_t requestedHeight) {
+    if (!vmSurfaceTraceReady(ctx)) return;
+    VmSurfaceTraceRecord* record = nullptr;
+    VmSurfaceTraceRecord* empty = nullptr;
+    for (unsigned i = 0; i < VM_SURFACE_TRACE_RECORDS; ++i) {
+        VmSurfaceTraceRecord* candidate = &vmSurfaceTraceRecords[i];
+        if (candidate->used && candidate->surface == surface) record = candidate;
+        if (!candidate->used && empty == nullptr) empty = candidate;
+    }
+    if (strcmp(operation, "create") == 0 &&
+        Renderer_surfaceExists(ctx->runner->renderer, surface)) {
+        if (record == nullptr) record = empty;
+        if (record != nullptr) {
+            Instance* current = ctx->currentInstance;
+            *record = (VmSurfaceTraceRecord){
+                .used = true, .surface = surface,
+                .object = current != nullptr ? current->objectIndex : -1,
+                .creator = current != nullptr ? current->instanceId : 0u,
+                .room = ctx->runner->currentRoomIndex, .frame = ctx->runner->frameCount
+            };
+        }
+    }
+    vmSurfaceTraceEmit(ctx, operation, surface, requestedWidth, requestedHeight, nullptr, record);
+    if (record != nullptr && !Renderer_surfaceExists(ctx->runner->renderer, surface))
+        record->used = false;
+}
+
+void VM_surfaceTraceRoomRemove(VMContext* ctx, Instance* creator) {
+    if (!vmSurfaceTraceReady(ctx) || creator == nullptr) return;
+    for (unsigned i = 0; i < VM_SURFACE_TRACE_RECORDS &&
+                         vmSurfaceTraceLines < vmSurfaceTraceLimit; ++i) {
+        VmSurfaceTraceRecord* record = &vmSurfaceTraceRecords[i];
+        if (!record->used || record->creatorRemoved || record->creator != creator->instanceId ||
+            record->object != creator->objectIndex) continue;
+        record->creatorRemoved = true;
+        vmSurfaceTraceEmit(ctx, "creator_removed", record->surface, 0, 0, creator, record);
+        if (!Renderer_surfaceExists(ctx->runner->renderer, record->surface)) record->used = false;
+    }
+}
+// SURFACE_LIFETIME_DIAGNOSTICS_END
+#endif
