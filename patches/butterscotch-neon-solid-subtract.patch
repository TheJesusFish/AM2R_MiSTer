+// Solid inverse-source spans have no sampling or tint stage. Keep the
+// 8x8-bit products in 16-bit NEON lanes instead of relying on auto-vectorized
+// uint32_t division identities. AM2R's mask rectangle covers 331x251 pixels
+// every Step, so this is substantial work even though it is a simple draw.
+// Each RGBA factor remains independent, including an alpha-zero source.
+static void blendSubtractSolidSpan(uint32_t* destination, int32_t count,
+                                   uint8_t sourceR, uint8_t sourceG,
+                                   uint8_t sourceB, uint8_t sourceA) {
+    const uint8_t inverseR = 255u - sourceR;
+    const uint8_t inverseG = 255u - sourceG;
+    const uint8_t inverseB = 255u - sourceB;
+    const uint8_t inverseA = 255u - sourceA;
+    int32_t output = 0;
+#if defined(USE_MISTER) && defined(__ARM_NEON)
+    const uint8x8_t factorR = vdup_n_u8(inverseR);
+    const uint8x8_t factorG = vdup_n_u8(inverseG);
+    const uint8x8_t factorB = vdup_n_u8(inverseB);
+    const uint8x8_t factorA = vdup_n_u8(inverseA);
+    for (; output + 8 <= count; output += 8) {
+        uint8x8x4_t target = vld4_u8((const uint8_t*)(destination + output));
+        target.val[0] = divideBy255U16(vmull_u8(target.val[0], factorR));
+        target.val[1] = divideBy255U16(vmull_u8(target.val[1], factorG));
+        target.val[2] = divideBy255U16(vmull_u8(target.val[2], factorB));
+        target.val[3] = divideBy255U16(vmull_u8(target.val[3], factorA));
+        vst4_u8((uint8_t*)(destination + output), target);
+    }
+#endif
+    for (; output < count; ++output) {
+        uint8_t* target = (uint8_t*)&destination[output];
+        target[0] = divideBy255U32(target[0] * inverseR);
+        target[1] = divideBy255U32(target[1] * inverseG);
+        target[2] = divideBy255U32(target[2] * inverseB);
+        target[3] = divideBy255U32(target[3] * inverseA);
+    }
+}
 
