+        return;
+
+    int32_t count = (int32_t) arrlen(runner->cachedDrawables);
+    int32_t oldIndex = -1;
+    repeat(count, i) {
+        Drawable* drawable = &runner->cachedDrawables[i];
+        if (drawable->type == DRAWABLE_INSTANCE && drawable->instance == inst) {
+            oldIndex = (int32_t) i;
+            break;
