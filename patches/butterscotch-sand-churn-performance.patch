+static void rebuildDrawableCacheIfDirty(Runner* runner);
+
+// Keep the valid drawable cache synchronized with ordinary instance churn.
+// Projectiles and destructible room objects are created and destroyed during
+// Step events; rebuilding and qsorting the whole room on every such change
+// costs several milliseconds on the MiSTer HPS.  Inserting into the already
+// sorted cache preserves the exact DrawKey order. cursorDirty is raised so a
+// creation that occurs from inside a Draw event still makes Runner_draw
+// re-evaluate its cursor exactly as the former structure-dirty rebuild did,
+// without turning the insertion into another full depth refresh and qsort.
+static void cacheNewInstanceDrawable(Runner* runner, Instance* inst) {
+    if (runner->drawableListStructureDirty) return;
+
+    Drawable added;
+    ZERO_STRUCT(added);
+    added.type = DRAWABLE_INSTANCE;
+    added.depth = inst->depth;
+    added.instance = inst;
+
+    // A genuine depth change has already made the ordering uncertain. Append
+    // now and let the next draw-boundary refresh sort the entire batch once.
+    // In particular, do not rebuild here: one shot can create many temporary
+    // objects while collision events are still being dispatched.
+    if (runner->drawableListSortDirty) {
+        arrput(runner->cachedDrawables, added);
+        return;
+    }
+
+    DrawKey addedKey = drawableKey(&added);
+
+    int32_t count = (int32_t) arrlen(runner->cachedDrawables);
+    int32_t low = 0;
+    int32_t high = count;
+    while (low < high) {
+        int32_t middle = low + (high - low) / 2;
+        DrawKey middleKey = drawableKey(&runner->cachedDrawables[middle]);
+        if (compareDrawKeys(&middleKey, &addedKey) <= 0)
+            low = middle + 1;
+        else
+            high = middle;
+    }
+
+    arrput(runner->cachedDrawables, added);
+    if (low < count) {
+        memmove(&runner->cachedDrawables[low + 1],
+                &runner->cachedDrawables[low],
+                (size_t)(count - low) * sizeof(Drawable));
+        runner->cachedDrawables[low] = added;
+    }
+    runner->drawableListCursorDirty = true;
+}
+
+void Runner_instanceDrawableDepthChanged(Runner* runner, Instance* inst) {
+    if (runner == nullptr || inst == nullptr ||
