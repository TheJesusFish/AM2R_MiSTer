+    Drawable moved = runner->cachedDrawables[oldIndex];
+    moved.depth = inst->depth;
+    if (oldIndex + 1 < count) {
+        memmove(&runner->cachedDrawables[oldIndex],
+                &runner->cachedDrawables[oldIndex + 1],
+                (size_t)(count - oldIndex - 1) * sizeof(Drawable));
+    }
+    arrsetlen(runner->cachedDrawables, count - 1);
+
+    DrawKey movedKey = drawableKey(&moved);
+    int32_t low = 0;
+    int32_t high = count - 1;
+    while (low < high) {
+        int32_t middle = low + (high - low) / 2;
