+static void swDrawRectangleColor(Renderer* renderer, float x1, float y1, float x2, float y2, uint32_t c1, uint32_t c2, uint32_t c3, uint32_t c4, float alpha, bool outline) {
+    if (outline) {
+        swDrawLine(renderer, x1, y1, x2, y1, 1.0f, c1, alpha);
+        swDrawLine(renderer, x2, y1, x2, y2, 1.0f, c2, alpha);
+        swDrawLine(renderer, x2, y2, x1, y2, 1.0f, c3, alpha);
+        swDrawLine(renderer, x1, y2, x1, y1, 1.0f, c4, alpha);
+        return;
+    }
+    SWRenderer* sw = (SWRenderer*)renderer;
+    SWVertex v[4];
+    worldToScreen(sw, x1, y1, &v[0].x, &v[0].y);
+    worldToScreen(sw, x2 + 1.0f, y1, &v[1].x, &v[1].y);
+    worldToScreen(sw, x2 + 1.0f, y2 + 1.0f, &v[2].x, &v[2].y);
+    worldToScreen(sw, x1, y2 + 1.0f, &v[3].x, &v[3].y);
+    uint32_t colors[4] = {c1, c2, c3, c4};
+    for (int i = 0; i < 4; ++i) {
+        v[i].u = v[i].v = 0.0f;
+        v[i].r = (float)BGR_R(colors[i]) / 255.0f;
+        v[i].g = (float)BGR_G(colors[i]) / 255.0f;
+        v[i].b = (float)BGR_B(colors[i]) / 255.0f;
+        v[i].a = alpha;
+    }
+    rasterizeQuad(sw, v, nullptr, 0, 0);
+}
