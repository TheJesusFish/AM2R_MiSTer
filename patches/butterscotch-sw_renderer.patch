+static void swDrawSurface(Renderer* renderer, int32_t id, int32_t srcLeft, int32_t srcTop, int32_t srcWidth, int32_t srcHeight, float x, float y, float xscale, float yscale, float angleDeg, uint32_t color, float alpha) {
+    swDrawSurfaceColor(renderer,id,srcLeft,srcTop,srcWidth,srcHeight,x,y,xscale,yscale,angleDeg,color,color,color,color,alpha);
+}
