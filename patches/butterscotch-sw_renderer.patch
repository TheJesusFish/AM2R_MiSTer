+static bool swSurfaceGetPixels(Renderer* renderer, int32_t id, uint8_t* outRGBA) {
+    SWRenderer* sw=(SWRenderer*)renderer; if(!swSurfaceExists(renderer,id)||outRGBA==nullptr)return false;
+#ifdef USE_MISTER
+    if (id == renderer->runner->applicationSurfaceId)
+        swGpuFallback(sw, "application surface readback");
+#endif
+    memcpy(outRGBA,sw->surfacePixels[id],(size_t)sw->surfaceWidths[id]*sw->surfaceHeights[id]*4);return true;
+}
