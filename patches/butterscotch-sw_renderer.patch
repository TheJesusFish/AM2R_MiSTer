+static uint32_t swSpriteGetTexture(Renderer* renderer, int32_t tpagIndex) {
+    SWRenderer* sw=(SWRenderer*)renderer; DataWin* dw=renderer->dataWin;
+    if(tpagIndex<0||(uint32_t)tpagIndex>=dw->tpag.count)return 0;
+    int32_t page=dw->tpag.items[tpagIndex].texturePageId;
+    if(page<0||!swEnsureTextureLoaded(sw,(uint32_t)page))return 0;
+    return (uint32_t)tpagIndex+1;
+}
+static uint32_t swSurfaceGetTexture(Renderer* renderer,int32_t id){return swSurfaceExists(renderer,id)?(0x40000000u|(uint32_t)id):0;}
+
+static bool swResolveTextureHandle(SWRenderer* sw,uint32_t handle,TexturePageItem** tpag,int32_t* width,int32_t* height){
+    if(handle==0)return false;
+    if(handle&0x40000000u){int32_t id=(int32_t)(handle&~0x40000000u);if(!swSurfaceExists((Renderer*)sw,id))return false;if(tpag)*tpag=nullptr;*width=sw->surfaceWidths[id];*height=sw->surfaceHeights[id];return true;}
+    int32_t idx=(int32_t)handle-1;DataWin*dw=sw->base.dataWin;if(idx<0||(uint32_t)idx>=dw->tpag.count)return false;
+    TexturePageItem*t=&dw->tpag.items[idx];if(t->texturePageId<0||!swEnsureTextureLoaded(sw,(uint32_t)t->texturePageId))return false;
+    if(tpag)*tpag=t;*width=sw->textureWidths[t->texturePageId];*height=sw->textureHeights[t->texturePageId];return true;
+}
+static float swTextureGetTexelWidth(Renderer* renderer,uint32_t handle){int32_t w=0,h=0;return swResolveTextureHandle((SWRenderer*)renderer,handle,nullptr,&w,&h)&&w>0?1.0f/w:1.0f;}
+static float swTextureGetTexelHeight(Renderer* renderer,uint32_t handle){int32_t w=0,h=0;return swResolveTextureHandle((SWRenderer*)renderer,handle,nullptr,&w,&h)&&h>0?1.0f/h:1.0f;}
+static bool swTextureGetUVs(Renderer* renderer,uint32_t handle,float*out){SWRenderer*sw=(SWRenderer*)renderer;TexturePageItem*t=nullptr;int32_t w=0,h=0;if(!out||!swResolveTextureHandle(sw,handle,&t,&w,&h))return false;if(!t){out[0]=out[1]=0;out[2]=out[3]=1;return true;}out[0]=(float)t->sourceX/w;out[1]=(float)t->sourceY/h;out[2]=(float)(t->sourceX+t->sourceWidth)/w;out[3]=(float)(t->sourceY+t->sourceHeight)/h;return true;}
