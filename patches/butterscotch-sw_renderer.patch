+static void swDrawSurfaceTiled(Renderer* renderer, int32_t id, float x, float y, float xscale, float yscale, float roomW, float roomH, uint32_t color, float alpha) {
+    SWRenderer* sw=(SWRenderer*)renderer; if(!swSurfaceExists(renderer,id))return;
+    float stepX=sw->surfaceWidths[id]*fabsf(xscale), stepY=sw->surfaceHeights[id]*fabsf(yscale);
+    if(stepX<1.0f||stepY<1.0f)return;
+    while(x>0)x-=stepX; while(y>0)y-=stepY;
+    for(float py=y;py<roomH;py+=stepY)for(float px=x;px<roomW;px+=stepX)
+        swDrawSurface(renderer,id,0,0,sw->surfaceWidths[id],sw->surfaceHeights[id],px,py,xscale,yscale,0,color,alpha);
+}
