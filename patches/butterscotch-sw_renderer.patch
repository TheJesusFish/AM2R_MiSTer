+static void swDrawSurfaceColor(Renderer* renderer, int32_t id, int32_t srcLeft, int32_t srcTop, int32_t srcWidth, int32_t srcHeight, float x, float y, float xscale, float yscale, float angleDeg, uint32_t c1, uint32_t c2, uint32_t c3, uint32_t c4, float alpha) {
+    SWRenderer* sw=(SWRenderer*)renderer;
+    if (!swSurfaceExists(renderer,id)) return;
+    if (srcWidth < 0) {srcLeft=srcTop=0;srcWidth=sw->surfaceWidths[id];srcHeight=sw->surfaceHeights[id];}
+    swDrawPixelBuffer(sw,sw->surfacePixels[id],sw->surfaceWidths[id],sw->surfaceHeights[id],srcLeft,srcTop,srcWidth,srcHeight,x,y,xscale,yscale,angleDeg,c1,c2,c3,c4,alpha);
+}
