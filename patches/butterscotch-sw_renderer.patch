+static void swSurfaceCopy(Renderer* renderer, int32_t dstId, int32_t dx, int32_t dy, int32_t srcId, int32_t sx, int32_t sy, int32_t swidth, int32_t sheight, bool part) {
+    SWRenderer* sw=(SWRenderer*)renderer;
+#ifdef USE_MISTER
+    if (dstId == renderer->runner->applicationSurfaceId ||
+        srcId == renderer->runner->applicationSurfaceId)
+        swGpuFallback(sw, "application surface copy");
+#endif
+    if(!swSurfaceExists(renderer,dstId)||!swSurfaceExists(renderer,srcId))return;
+    if(!part){sx=sy=0;swidth=sw->surfaceWidths[srcId];sheight=sw->surfaceHeights[srcId];}
+    if(sx<0){dx-=sx;swidth+=sx;sx=0;} if(sy<0){dy-=sy;sheight+=sy;sy=0;}
+    if(dx<0){sx-=dx;swidth+=dx;dx=0;} if(dy<0){sy-=dy;sheight+=dy;dy=0;}
+    if(sx+swidth>sw->surfaceWidths[srcId])swidth=sw->surfaceWidths[srcId]-sx;
+    if(sy+sheight>sw->surfaceHeights[srcId])sheight=sw->surfaceHeights[srcId]-sy;
+    if(dx+swidth>sw->surfaceWidths[dstId])swidth=sw->surfaceWidths[dstId]-dx;
+    if(dy+sheight>sw->surfaceHeights[dstId])sheight=sw->surfaceHeights[dstId]-dy;
+    if(swidth<=0||sheight<=0)return;
+    uint8_t* temp=(uint8_t*)safeMalloc((size_t)swidth*sheight*4);
+    for(int32_t row=0;row<sheight;++row)memcpy(temp+(size_t)row*swidth*4,sw->surfacePixels[srcId]+((size_t)(sy+row)*sw->surfaceWidths[srcId]+sx)*4,(size_t)swidth*4);
+    for(int32_t row=0;row<sheight;++row)memcpy(sw->surfacePixels[dstId]+((size_t)(dy+row)*sw->surfaceWidths[dstId]+dx)*4,temp+(size_t)row*swidth*4,(size_t)swidth*4);
+    free(temp);
+}
