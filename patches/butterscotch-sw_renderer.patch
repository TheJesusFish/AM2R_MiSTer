+    sw->scissorX=0; sw->scissorY=0; sw->scissorW=sw->fbWidth; sw->scissorH=sw->fbHeight;
+    swBeginView(renderer, 0, 0, sw->fbWidth, sw->fbHeight, 0, 0, sw->fbWidth, sw->fbHeight, 0.0f);
+    return true;
+}
