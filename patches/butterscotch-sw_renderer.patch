+static void swSurfaceResize(Renderer* renderer, int32_t id, int32_t width, int32_t height) {
+    SWRenderer* sw=(SWRenderer*)renderer;
+    if (!swSurfaceExists(renderer,id) || width <= 0 || height <= 0) return;
+    bool current = sw->currentSurface == id;
+    free(sw->surfacePixels[id]);
+    sw->surfacePixels[id]=(uint8_t*)safeCalloc((size_t)width*(size_t)height,4);
+    sw->surfaceWidths[id]=width; sw->surfaceHeights[id]=height;
+    if (current) swUseSurfaceTarget(sw,id);
+}
