+void SWRenderer_clearFrameBuffer(Renderer* renderer, uint32_t color) {
+    SWRenderer* sw = (SWRenderer*)renderer;
+    if (sw->hostFramebuffer == nullptr) return;
+    uint8_t* dst = sw->hostFramebuffer;
+    uint8_t r = BGR_R(color), g = BGR_G(color), b = BGR_B(color);
+    for (int32_t i = 0; i < sw->hostWidth * sw->hostHeight; ++i) {
+        dst[i * 4 + 0] = r;
+        dst[i * 4 + 1] = g;
+        dst[i * 4 + 2] = b;
+        dst[i * 4 + 3] = 255;
+    }
+}
+
+static void swClearScreen(Renderer* renderer, uint32_t color, float alpha) {
+    SWRenderer* sw = (SWRenderer*)renderer;
+    if (sw->framebuffer == nullptr) return;
+    uint8_t r = BGR_R(color), g = BGR_G(color), b = BGR_B(color);
+    uint8_t a = clampByte((int32_t)(alpha * 255.0f + 0.5f));
+#ifdef USE_MISTER
+    if (sw->gpuFrameEligible) {
+        if (swGpuIsOutputTarget(sw) && sw->fbWidth == 320 && sw->fbHeight == 240 &&
+            MisterGpu_addClear((uint32_t)r | ((uint32_t)g << 8) |
+                               ((uint32_t)b << 16) | ((uint32_t)a << 24))) {
+            sw->gpuSawClear = true;
+            // The CPU copy is not presented while the FPGA owns this frame.
+            // Mark the clear as skipped work so a later fallback submits and
+            // reads it back before software drawing resumes.
+            sw->gpuHasSkippedDraws = true;
+            return;
+        } else {
+            swGpuFallbackIfOutput(sw, "clear target/state");
+        }
+    }
+#endif
+    for (int32_t i = 0; i < sw->fbWidth * sw->fbHeight; ++i) {
+        uint8_t* dst = sw->framebuffer + (size_t)i * 4;
+        dst[0] = r; dst[1] = g; dst[2] = b; dst[3] = a;
+    }
+}
