+static int32_t swCreateSurface(Renderer* renderer, int32_t width, int32_t height) {
+    SWRenderer* sw = (SWRenderer*)renderer;
+    if (width <= 0 || height <= 0) return -1;
+    uint32_t id;
+    for (id = 0; id < sw->surfaceCount; ++id) if (!sw->surfaceExistsFlags[id]) break;
+    if (id == sw->surfaceCount) {
+        swEnsureSurfaceCapacity(sw, id + 1);
+        sw->surfaceCount = id + 1;
+    }
+    free(sw->surfacePixels[id]);
+    sw->surfacePixels[id] = (uint8_t*)safeCalloc((size_t)width * (size_t)height, 4);
+    sw->surfaceWidths[id] = width;
+    sw->surfaceHeights[id] = height;
+    sw->surfaceExistsFlags[id] = true;
+    return (int32_t)id;
+}
+
+static bool swSurfaceExists(Renderer* renderer, int32_t id) {
+    SWRenderer* sw = (SWRenderer*)renderer;
+    return id >= 0 && (uint32_t)id < sw->surfaceCount && sw->surfaceExistsFlags[id];
+}
+
+static int32_t swEnsureApplicationSurface(Renderer* renderer, int32_t width, int32_t height) {
+    SWRenderer* sw = (SWRenderer*)renderer;
+    int32_t id = renderer->runner->applicationSurfaceId;
+    if (!swSurfaceExists(renderer, id)) {
+        id = swCreateSurface(renderer, width, height);
+        renderer->runner->applicationSurfaceId = id;
+    } else if (sw->surfaceWidths[id] != width || sw->surfaceHeights[id] != height) {
+        uint8_t* pixels = (uint8_t*)safeCalloc((size_t)width * (size_t)height, 4);
+        free(sw->surfacePixels[id]);
+        sw->surfacePixels[id] = pixels;
+        sw->surfaceWidths[id] = width;
+        sw->surfaceHeights[id] = height;
+    }
+    return id;
+}
