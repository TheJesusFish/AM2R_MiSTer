+static void swSurfaceFree(Renderer* renderer, int32_t id) {
+    SWRenderer* sw=(SWRenderer*)renderer;
+    if (!swSurfaceExists(renderer,id) || id == renderer->runner->applicationSurfaceId) return;
+    if (sw->currentSurface == id) swUseHostTarget(sw);
+    free(sw->surfacePixels[id]); sw->surfacePixels[id]=nullptr;
+    sw->surfaceWidths[id]=sw->surfaceHeights[id]=0; sw->surfaceExistsFlags[id]=false;
+}
