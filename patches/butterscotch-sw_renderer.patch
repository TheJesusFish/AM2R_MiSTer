+static void swDrawSpriteTiled(Renderer* renderer, int32_t tpagIndex, float originX, float originY, float x, float y, float xscale, float yscale, bool tileX, bool tileY, float roomW, float roomH, uint32_t color, float alpha) {
+    DataWin* dw=renderer->dataWin; if(tpagIndex<0||(uint32_t)tpagIndex>=dw->tpag.count)return;
+    TexturePageItem* t=&dw->tpag.items[tpagIndex];
+    float stepX=t->boundingWidth*fabsf(xscale),stepY=t->boundingHeight*fabsf(yscale);if(stepX<1||stepY<1)return;
+    float startX=x-originX*xscale,startY=y-originY*yscale;
+    if(tileX)while(startX>0)startX-=stepX; if(tileY)while(startY>0)startY-=stepY;
+    float endX=tileX?roomW:startX+stepX,endY=tileY?roomH:startY+stepY;
+    for(float py=startY;py<endY;py+=stepY)for(float px=startX;px<endX;px+=stepX)
+        swDrawSprite(renderer,tpagIndex,px,py,0,0,xscale,yscale,0,color,alpha);
+}
+
+static void swDrawTiledPart(Renderer* renderer, int32_t tpagIndex, int32_t srcX, int32_t srcY, int32_t srcW, int32_t srcH, float dstX, float dstY, float dstW, float dstH, uint32_t color, float alpha) {
+    if(srcW<=0||srcH<=0)return;
+    for(float y=0;y<dstH;y+=srcH)for(float x=0;x<dstW;x+=srcW){
+        int32_t w=(int32_t)fminf((float)srcW,dstW-x),h=(int32_t)fminf((float)srcH,dstH-y);
+        swDrawSpritePart(renderer,tpagIndex,srcX,srcY,w,h,dstX+x,dstY+y,1,1,0,0,0,color,alpha);
+    }
+}
