+static void swDrawPixelBuffer(SWRenderer* sw, const uint8_t* pixels, int32_t texW, int32_t texH,
+                              int32_t srcLeft, int32_t srcTop, int32_t srcWidth, int32_t srcHeight,
+                              float x, float y, float xscale, float yscale, float angleDeg,
+                              uint32_t c1, uint32_t c2, uint32_t c3, uint32_t c4, float alpha) {
+    if (pixels == nullptr || texW <= 0 || texH <= 0 || srcWidth <= 0 || srcHeight <= 0) return;
+    Matrix4f transform;
+    Matrix4f_setTransform2D(&transform, x, y, xscale, yscale, -angleDeg*((float)M_PI/180.0f));
+    float wx[4], wy[4];
+    Matrix4f_transformPoint(&transform,0,0,&wx[0],&wy[0]);
+    Matrix4f_transformPoint(&transform,(float)srcWidth,0,&wx[1],&wy[1]);
+    Matrix4f_transformPoint(&transform,(float)srcWidth,(float)srcHeight,&wx[2],&wy[2]);
+    Matrix4f_transformPoint(&transform,0,(float)srcHeight,&wx[3],&wy[3]);
+    SWVertex v[4];
+    for(int i=0;i<4;++i) worldToScreen(sw,wx[i],wy[i],&v[i].x,&v[i].y);
+    float u0=(float)srcLeft/texW, vv0=(float)srcTop/texH, u1=(float)(srcLeft+srcWidth)/texW, vv1=(float)(srcTop+srcHeight)/texH;
+    v[0].u=u0;v[0].v=vv0;v[1].u=u1;v[1].v=vv0;v[2].u=u1;v[2].v=vv1;v[3].u=u0;v[3].v=vv1;
+    uint32_t colors[4]={c1,c2,c3,c4};
+    for(int i=0;i<4;++i){v[i].r=(float)BGR_R(colors[i])/255.0f;v[i].g=(float)BGR_G(colors[i])/255.0f;v[i].b=(float)BGR_B(colors[i])/255.0f;v[i].a=alpha;}
