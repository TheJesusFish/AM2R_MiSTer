+#ifdef USE_MISTER
+// AM2R 1.1 implements its water distortion as a 240-iteration interpreted
+// Draw event.  Each iteration computes one sine offset and submits a one-row
+// surface copy.  The MiSTer renderer already recognizes and batches that exact
+// command sequence for the FPGA; executing the loop natively removes the much
+// larger VM dispatch/stack cost without changing the generated draw calls.
+//
+// Keep this deliberately tied to the exact object and CODE entry.  Any other
+// game, AM2R revision, inherited handler, or incomplete instance state falls
+// back to the ordinary bytecode interpreter.
+static bool Runner_tryExecuteAm2rWaterDraw(Runner* runner, Instance* instance,
+                                           int32_t eventType, int32_t eventSubtype,
+                                           int32_t codeId, int32_t ownerObjectIndex) {
+    static const char objectName[] = "oWaterFXV2";
+    static const char codeName[] = "gml_Object_oWaterFXV2_Draw_0";
+    static const char* const variableNames[] = {
+        "AMP", "THETA", "FREQ", "y_bottom", "y_top", "mysurf", "xx", "yy"
+    };
+    int32_t variableIds[sizeof(variableNames) / sizeof(variableNames[0])];
+
+    if (eventType != EVENT_DRAW || eventSubtype != DRAW_NORMAL ||
+        instance == nullptr || runner->renderer == nullptr ||
+        runner->renderer->vtable == nullptr ||
+        runner->renderer->vtable->drawSurface == nullptr ||
+        runner->renderer->vtable->surfaceExists == nullptr ||
+        codeId < 0 || (uint32_t)codeId >= runner->dataWin->code.count ||
+        ownerObjectIndex < 0 ||
+        (uint32_t)ownerObjectIndex >= runner->dataWin->objt.count)
+        return false;
+
+    const CodeEntry* code = &runner->dataWin->code.entries[codeId];
+    const GameObject* owner = &runner->dataWin->objt.objects[ownerObjectIndex];
+    if (code->name == nullptr || owner->name == nullptr ||
+        strcmp(code->name, codeName) != 0 || strcmp(owner->name, objectName) != 0)
+        return false;
+
+    VMContext* vm = runner->vmContext;
+    for (size_t i = 0; i < sizeof(variableNames) / sizeof(variableNames[0]); ++i) {
+        ptrdiff_t slot = shgeti(vm->varNameMap, (char*)variableNames[i]);
+        if (slot < 0) return false;
+        variableIds[i] = vm->varNameMap[slot].value;
+    }
+
+    // The six inputs must have been initialized by AM2R's Create/Step events.
+    // xx and yy are outputs, so Instance_setSelfVar may create their slots.
+    for (size_t i = 0; i < 6; ++i) {
+        if (!IntRValueHashMap_contains(&instance->selfVars, variableIds[i]))
+            return false;
+    }
+
+    GMLReal amp = RValue_toReal(Instance_getSelfVar(instance, variableIds[0]));
+    GMLReal theta = RValue_toReal(Instance_getSelfVar(instance, variableIds[1]));
+    GMLReal freq = RValue_toReal(Instance_getSelfVar(instance, variableIds[2]));
+    GMLReal yBottom = RValue_toReal(Instance_getSelfVar(instance, variableIds[3]));
+    GMLReal yTop = RValue_toReal(Instance_getSelfVar(instance, variableIds[4]));
+    int32_t surfaceId = RValue_toInt32(Instance_getSelfVar(instance, variableIds[5]));
+    GMLCamera* camera = Runner_getCameraForView(runner, 0);
+    if (camera == nullptr || yBottom == 0.0)
+        return false;
+
+    bool surfaceExists = runner->renderer->vtable->surfaceExists(
+        runner->renderer, surfaceId);
+    GMLReal xOffsets[240];
+    GMLReal angleStep = freq / yBottom;
+    GMLReal sine = GMLReal_sin(theta);
+    GMLReal cosine = GMLReal_cos(theta);
+    GMLReal sineStep = GMLReal_sin(angleStep);
+    GMLReal cosineStep = GMLReal_cos(angleStep);
+    for (int32_t yy = 0; yy < 240; ++yy) {
+        xOffsets[yy] = amp * sine;
+        GMLReal nextSine = sine * cosineStep + cosine * sineStep;
+        cosine = cosine * cosineStep - sine * sineStep;
+        sine = nextSine;
+    }
+
+    bool submittedWater = surfaceExists && SWRenderer_misterDrawAm2rWater(
+        runner->renderer, surfaceId, xOffsets, yTop,
+        camera->viewX, camera->viewY, camera->viewWidth);
+    if (!submittedWater) {
+        for (int32_t yy = 0; yy < 240; ++yy) {
+            if ((GMLReal)yy < yTop || !surfaceExists) continue;
+            runner->renderer->vtable->drawSurface(
+                runner->renderer, surfaceId,
+                0, yy, camera->viewWidth, 1,
+                (float)(xOffsets[yy] + camera->viewX),
+                (float)(yy + camera->viewY),
+                1.0f, 1.0f, 0.0f, 0xffffffffu, 0.2f);
+        }
+    }
+
+    // The bytecode leaves xx set to the exact final evaluation. Keep that
+    // observable value independent from the tiny recurrence round-off used
+    // only to choose water scanline offsets.
+    GMLReal finalX = amp * GMLReal_sin(theta + angleStep * 239.0);
+    Instance_setSelfVar(instance, variableIds[6], RValue_makeReal(finalX));
+    Instance_setSelfVar(instance, variableIds[7], RValue_makeInt32(240));
+    return true;
+}
