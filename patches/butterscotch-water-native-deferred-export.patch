+static uint32_t tryFuseWaterEffect(void) {
+    uint32_t readIndex = 0;
+    uint32_t writeIndex = 0;
+    uint32_t tableRows = g_gpu_water_table_rows;
+    uint32_t fusedRows = g_gpu_water_direct_rows;
+
+    while (readIndex < g_gpu_command_count) {
+        MisterGpuWaterRow first;
+        if (!decodeFusibleWaterRow(&g_gpu_commands[readIndex], &first)) {
+            if (writeIndex != readIndex)
+                g_gpu_commands[writeIndex] = g_gpu_commands[readIndex];
+            writeIndex++;
+            readIndex++;
+            continue;
+        }
+
+        uint32_t runEnd = readIndex + 1u;
+        MisterGpuWaterRow previous = first;
+        while (runEnd < g_gpu_command_count) {
+            MisterGpuWaterRow next;
+            if (!decodeFusibleWaterRow(&g_gpu_commands[runEnd], &next) ||
+                next.source != first.source || next.stride != first.stride ||
+                next.tint != first.tint ||
+                next.destination_y != previous.destination_y + 1)
+                break;
+            previous = next;
+            runEnd++;
+        }
+
+        uint32_t runRows = runEnd - readIndex;
+        if (runRows < GPU_WATER_MIN_RUN ||
+            runRows > GPU_WATER_ROWS - tableRows) {
+            while (readIndex < runEnd) {
+                if (writeIndex != readIndex)
+                    g_gpu_commands[writeIndex] = g_gpu_commands[readIndex];
+                writeIndex++;
+                readIndex++;
+            }
+            continue;
+        }
+
+        if (g_gpu_water_table_physical[g_gpu_write_buffer] == 0) {
+            uint32_t physical = reserveGpuTexture(GPU_WATER_ROWS * sizeof(uint64_t));
+            if (physical == 0) {
+                while (readIndex < g_gpu_command_count) {
+                    if (writeIndex != readIndex)
+                        g_gpu_commands[writeIndex] = g_gpu_commands[readIndex];
+                    writeIndex++;
+                    readIndex++;
+                }
+                break;
+            }
+            g_gpu_water_table_physical[g_gpu_write_buffer] = physical;
+        }
+
+        uint32_t tablePhysical =
+            g_gpu_water_table_physical[g_gpu_write_buffer] +
+            tableRows * (uint32_t)sizeof(uint64_t);
+        uint64_t *table = (uint64_t *)(g_gpu_textures +
+            (tablePhysical - GPU_TEXTURE_PHYS));
+        for (uint32_t i = 0; i < runRows; ++i) {
+            MisterGpuWaterRow row;
+            if (!decodeFusibleWaterRow(&g_gpu_commands[readIndex + i], &row))
+                return fusedRows;
+            table[i] = (uint16_t)row.destination_x |
+                       ((uint64_t)row.width << 16) |
+                       ((uint64_t)row.source_x << 32) |
+                       ((uint64_t)row.source_y << 48);
+        }
+
+        MisterGpuCommand fused;
+        memset(&fused, 0, sizeof(fused));
+        fused.word[0] = 7u | ((uint64_t)runRows << 16);
+        fused.word[1] = first.source | ((uint64_t)first.stride << 32);
+        fused.word[2] = tablePhysical |
+                        ((uint64_t)(uint16_t)first.destination_y << 32);
+        fused.word[6] = first.tint;
+        g_gpu_commands[writeIndex++] = fused;
+        tableRows += runRows;
+        fusedRows += runRows;
+        readIndex = runEnd;
+    }
+
+    g_gpu_command_count = writeIndex;
+    g_gpu_water_table_rows = tableRows;
+    if (fusedRows != 0) __sync_synchronize();
+    return fusedRows;
+}
