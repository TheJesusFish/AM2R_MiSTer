+static bool decodeFusibleWaterRow(const MisterGpuCommand *command,
+                                  MisterGpuWaterRow *row) {
+    if (command == NULL || row == NULL ||
+        (command->word[0] & 0x1ffu) != 2u ||
+        (uint16_t)(command->word[0] >> 32) != 1u ||
+        command->word[3] != 0 || command->word[7] != 0)
+        return false;
+
+    uint16_t width = (uint16_t)(command->word[0] >> 16);
+    int16_t destinationX = (int16_t)command->word[2];
+    int16_t destinationY = (int16_t)(command->word[2] >> 16);
+    uint32_t source = (uint32_t)command->word[1];
+    uint32_t stride = (uint32_t)(command->word[1] >> 32);
+    int32_t uStart = (int32_t)command->word[4];
+    int32_t vStart = (int32_t)(command->word[4] >> 32);
+    int32_t uStep = (int32_t)command->word[5];
+    uint32_t tint = (uint32_t)command->word[6];
+    int32_t sourceX = gpuFixedFloor(uStart);
+    int32_t sourceY = gpuFixedFloor(vStart);
+
+    // This command is deliberately narrow: it represents the full-screen
+    // white-alpha scanline copies produced by AM2R's water shader substitute.
+    // The FPGA batch engine consumes complete 320-pixel source rows, so reject
+    // anything with clipping, another blend mode, or a different source layout.
+    if (width == 0 || width > MISTER_WIDTH || stride != MISTER_WIDTH * 4u ||
+        tint != 0x33ffffffu ||
+        destinationX < 0 || destinationY < 0 ||
+        destinationX + (int32_t)width > MISTER_WIDTH ||
+        destinationY >= MISTER_HEIGHT ||
+        sourceX < 0 || sourceY < 0 ||
+        sourceX + (int32_t)width > MISTER_WIDTH)
+        return false;
+
+    uint64_t firstByte = (uint64_t)source + (uint64_t)sourceY * stride;
+    uint64_t lastByte = firstByte + MISTER_WIDTH * 4u;
+    if (source < GPU_TEXTURE_PHYS || firstByte < GPU_TEXTURE_PHYS ||
+        lastByte > (uint64_t)GPU_TEXTURE_PHYS + GPU_TEXTURE_BYTES)
+        return false;
+
+    // The compact hardware engine assumes one consecutive source pixel per
+    // destination pixel. Verify the exact 16.16 floors rather than assuming a
+    // nearly-unit derivative is harmless; exceptional rows retain opcode 2.
+    for (uint32_t x = 0; x < width; ++x) {
+        int64_t coordinate = (int64_t)uStart + (int64_t)x * uStep;
+        if (coordinate < INT32_MIN || coordinate > INT32_MAX ||
+            gpuFixedFloor((int32_t)coordinate) != sourceX + (int32_t)x)
+            return false;
+    }
+
+    row->destination_x = destinationX;
+    row->destination_y = destinationY;
+    row->width = width;
+    row->source_x = (uint16_t)sourceX;
+    row->source_y = (uint16_t)sourceY;
+    row->source = source;
+    row->stride = stride;
+    row->tint = tint;
+    return true;
+}
