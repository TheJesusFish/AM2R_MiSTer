+// Find exactly the old first-to-last differing-byte span rounded outward to
+// four-byte pixels. Comparing whole rows and then rescanning their unchanged
+// prefixes/suffixes bytewise is costly for the recreated lighting surface.
+// Scan each end in blocks instead, retaining identical upload spans and bytes.
+// Unaligned sources and partial final words remain valid; no load crosses a row.
+static bool gpuCropChangedBounds(const uint8_t* a, const uint8_t* b, size_t bytes,
+                                  size_t* firstOut, size_t* lastOut) {
+    size_t first = 0;
+    while (bytes - first >= 32 && gpuCropBlockEqual32(a + first, b + first)) first += 32;
+    while (bytes - first >= 4 && gpuCropReadWord(a + first) == gpuCropReadWord(b + first)) first += 4;
+    if (bytes - first < 4) {
+        while (first < bytes && a[first] == b[first]) ++first;
+    }
+    if (first == bytes) return false;
+    first &= ~(size_t)3u;
+    size_t last = bytes;
+    while ((last & 3u) && a[last - 1] == b[last - 1]) --last;
+    if (!(last & 3u)) {
+        while (last - first >= 32 && gpuCropBlockEqual32(a + last - 32, b + last - 32)) last -= 32;
+        while (last - first >= 4 && gpuCropReadWord(a + last - 4) == gpuCropReadWord(b + last - 4)) last -= 4;
+    }
+    *firstOut = first;
+    last = (last + 3u) & ~(size_t)3u;
+    *lastOut = last > bytes ? bytes : last;
+    return true;
+}
