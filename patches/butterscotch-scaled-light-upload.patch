+static inline uint32_t gpuCropReadWord(const uint8_t* pixels) {
+    uint32_t word;
+    memcpy(&word, pixels, sizeof(word));
+    return word;
+}
+
+static inline bool gpuCropBlockEqual32(const uint8_t* a, const uint8_t* b) {
+#if defined(__ARM_NEON)
+    uint8x16_t difference = vorrq_u8(veorq_u8(vld1q_u8(a), vld1q_u8(b)),
+                                    veorq_u8(vld1q_u8(a + 16), vld1q_u8(b + 16)));
+    uint32x2_t folded = vreinterpret_u32_u8(vorr_u8(vget_low_u8(difference),
+                                                  vget_high_u8(difference)));
+    return (vget_lane_u32(folded, 0) | vget_lane_u32(folded, 1)) == 0;
+#else
+    uint32_t difference = 0;
+    for (unsigned i = 0; i < 8; ++i)
+        difference |= gpuCropReadWord(a + 4 * i) ^ gpuCropReadWord(b + 4 * i);
+    return difference == 0;
+#endif
+}
