+static void resetFastStateRoomMetadata(Runner* runner) {
+    // Parsed rooms survive Runner_reset, including lazy/unloaded headers.
+    // Remove mutations from the replaced timeline before restoring its state.
+    repeat(runner->dataWin->room.count, i) {
+        Room* room = &runner->dataWin->room.rooms[i];
+        room->width = room->initialWidth;
+        room->height = room->initialHeight;
+        room->speed = room->initialSpeed;
+        room->persistent = room->initialPersistent;
+    }
+}
