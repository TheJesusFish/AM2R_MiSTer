+
+static bool roomMetadataOkay(const Room* room, uint32_t width, uint32_t height,
+                             uint32_t speed, uint8_t persistent) {
+    if (persistent > 1u) return false;
+    if (!room->present)
+        return width == 0u && height == 0u && speed == 0u && persistent == 0u;
+    return width > 0u && width <= FAST_STATE_MAX_ROOM_DIMENSION &&
+           height > 0u && height <= FAST_STATE_MAX_ROOM_DIMENSION &&
+           speed > 0u && speed <= FAST_STATE_MAX_ROOM_SPEED;
+}
+
+static bool writeRoomMetadata(FastWriter* writer, const Runner* runner) {
+    if (!writerU32(writer, runner->dataWin->room.count)) return false;
+    repeat(runner->dataWin->room.count, i) {
+        const Room* room = &runner->dataWin->room.rooms[i];
+        if (!roomMetadataOkay(room, room->width, room->height, room->speed,
+                              (uint8_t)room->persistent)) {
+            writer->error = ENOTSUP;
+            return false;
+        }
+        // Explicit scalar fields avoid adding host struct padding to v5.
+        if (!writerU32(writer, room->width) || !writerU32(writer, room->height) ||
+            !writerU32(writer, room->speed) ||
+            !writerU8(writer, (uint8_t)room->persistent)) return false;
+    }
+    return true;
+}
+
+static bool readRoomMetadata(FastReader* reader, Runner* runner, bool apply) {
+    uint32_t count = readerU32(reader);
+    if (reader->error || count != runner->dataWin->room.count ||
+        !countOkay(reader, count)) {
+        reader->error = EBADMSG;
+        return false;
+    }
+    // Validate the complete bounded table before touching any Room header.
+    FastReader check = *reader;
+    repeat(count, i) {
+        uint32_t width = readerU32(&check);
+        uint32_t height = readerU32(&check);
+        uint32_t speed = readerU32(&check);
+        uint8_t persistent = readerU8(&check);
+        if (check.error || !roomMetadataOkay(&runner->dataWin->room.rooms[i],
+                                             width, height, speed, persistent)) {
+            reader->error = EBADMSG;
+            return false;
+        }
+    }
+    if (!apply) {
+        reader->offset = check.offset;
+        return true;
+    }
+    repeat(count, i) {
+        Room* room = &runner->dataWin->room.rooms[i];
+        room->width = readerU32(reader);
+        room->height = readerU32(reader);
+        room->speed = readerU32(reader);
+        room->persistent = readerU8(reader) != 0;
+    }
+    return !reader->error;
+}
+
+static void recoverLegacyRoomPersistence(Runner* runner) {
+    // AM2R's v4 files omitted mutable ROOM-header flags. A populated parked
+    // actor list is produced only by persistRoomState, while successful room
+    // restore consumes it. Empty initialized records also mark visited rooms
+    // and must never be mistaken for a parked room. AM2R changes persistence
+    // only for its current room, so an unconsumed actor list recovers the flag.
+    repeat(runner->dataWin->room.count, i) {
+        SavedRoomState* state = &runner->savedRoomStates[i];
+        if (state->initialized && arrlen(state->instances) > 0)
+            runner->dataWin->room.rooms[i].persistent = true;
+    }
 }
 
