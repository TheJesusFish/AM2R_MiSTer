+    }
+}
+
+static int virtualPadButton(uint16_t code) {
+    switch (code) {
+        case KEY_ENTER: return 0;     // MiSTer framebuffer JOY_A
+        case KEY_ESC: return 1;       // MiSTer framebuffer JOY_B
+        case KEY_PAGEUP: return 4;    // JOY_L
+        case KEY_PAGEDOWN: return 5;  // JOY_R
+        case KEY_SPACE: return 8;     // JOY_SELECT
+        case KEY_TAB: return 9;       // JOY_START
+        case KEY_UP: return 12;
+        case KEY_DOWN: return 13;
+        case KEY_LEFT: return 14;
+        case KEY_RIGHT: return 15;
+        default: return -1;
+    }
+}
+
+static void openVirtualInput(void) {
+    char path[64];
+    char name[256];
+    for (int i = 0; i < 32; ++i) {
+        snprintf(path, sizeof(path), "/dev/input/event%d", i);
+        int fd = open(path, O_RDONLY | O_NONBLOCK | O_CLOEXEC);
+        if (fd < 0) continue;
+        memset(name, 0, sizeof(name));
+        if (ioctl(fd, EVIOCGNAME(sizeof(name) - 1), name) >= 0 &&
+            strcmp(name, "MiSTer virtual input") == 0) {
+            g_input_fd = fd;
+            logInfo("MiSTer input backend: %s (%s)\n", path, name);
+            return;
+        }
+        close(fd);
+    }
+    logWarn("MiSTer: virtual input device not found; keyboard/gamepad disabled\n");
+}
+
+static bool openJoyShared(void) {
+    const char *path = getenv(AM2R_JOY_SHM_ENV);
+    if (path == NULL || path[0] == '\0') path = AM2R_JOY_SHM_PATH;
+    g_joy_fd = open(path, O_RDONLY | O_CLOEXEC);
+    if (g_joy_fd < 0) {
+        logError("MiSTer input: cannot open %s: %s\n", path, strerror(errno));
+        return false;
+    }
+    g_joy_shm = (const volatile Am2rJoyShm *)mmap(NULL, sizeof(Am2rJoyShm),
+        PROT_READ, MAP_SHARED, g_joy_fd, 0);
+    if (g_joy_shm == MAP_FAILED) {
+        g_joy_shm = NULL;
+        close(g_joy_fd);
+        g_joy_fd = -1;
+        logError("MiSTer input: cannot map %s: %s\n", path, strerror(errno));
+        return false;
+    }
+    __sync_synchronize();
+    if (g_joy_shm->magic != AM2R_JOY_SHM_MAGIC ||
+        g_joy_shm->version != AM2R_JOY_SHM_VERSION) {
+        logError("MiSTer input: invalid shared joystick protocol\n");
+        munmap((void *)g_joy_shm, sizeof(Am2rJoyShm));
+        close(g_joy_fd);
+        g_joy_shm = NULL;
+        g_joy_fd = -1;
+        return false;
+    }
+    logInfo("MiSTer input backend: shared controller state from %s\n", path);
+    return true;
+}
+
+bool platformInit(int32_t reqW, int32_t reqH, const char *title, bool headless) {
+    (void)reqW;
+    (void)reqH;
+    (void)title;
+    (void)headless;
+
+    g_fb_fd = open("/dev/fb0", O_RDWR | O_SYNC);
+    if (g_fb_fd < 0) {
+        logError("MiSTer: cannot open /dev/fb0: %s\n", strerror(errno));
+        return false;
+    }
+    g_fb = (uint32_t *)mmap(NULL, MISTER_FB_BYTES, PROT_READ | PROT_WRITE, MAP_SHARED, g_fb_fd, 0);
+    if (g_fb == MAP_FAILED) {
+        logError("MiSTer: cannot map /dev/fb0: %s\n", strerror(errno));
+        g_fb = NULL;
+        close(g_fb_fd);
+        g_fb_fd = -1;
+        return false;
+    }
+    memset(g_fb, 0, MISTER_FB_BYTES);
+    openVirtualInput();
+    if (!openJoyShared()) {
+        if (g_input_fd >= 0) { close(g_input_fd); g_input_fd = -1; }
+        munmap(g_fb, MISTER_FB_BYTES);
+        g_fb = NULL;
+        close(g_fb_fd);
+        g_fb_fd = -1;
+        return false;
+    }
+    initGpu();
+    g_initialized = true;
+    logInfo("MiSTer framebuffer backend: %dx%d XRGB8888\n", MISTER_WIDTH, MISTER_HEIGHT);
+    return true;
+}
+
+void platformExit(void) {
+    if (g_gpu_available) waitGpuCompletion(NULL);
+    if (g_input_fd >= 0) {
+        close(g_input_fd);
+        g_input_fd = -1;
+    }
+    if (g_joy_shm != NULL) {
+        munmap((void *)g_joy_shm, sizeof(Am2rJoyShm));
+        g_joy_shm = NULL;
+    }
+    if (g_joy_fd >= 0) {
+        close(g_joy_fd);
+        g_joy_fd = -1;
+    }
+    if (g_gpu_textures != NULL) { munmap(g_gpu_textures, GPU_TEXTURE_BYTES); g_gpu_textures = NULL; }
+    for (uint32_t i = 0; i < GPU_COMMAND_BUFFER_COUNT; ++i) {
+        if (g_gpu_command_buffers[i] != NULL) {
+            munmap(g_gpu_command_buffers[i], GPU_COMMAND_BYTES);
+            g_gpu_command_buffers[i] = NULL;
+        }
+    }
+    g_gpu_commands = NULL;
+    if (g_gpu_control != NULL) { munmap((void*)g_gpu_control, GPU_CONTROL_BYTES); g_gpu_control = NULL; }
+    if (g_mem_fd >= 0) { close(g_mem_fd); g_mem_fd = -1; }
+    g_gpu_available = false;
+    if (g_fb != NULL) {
+        munmap(g_fb, MISTER_FB_BYTES);
+        g_fb = NULL;
+    }
+    if (g_fb_fd >= 0) {
+        close(g_fb_fd);
+        g_fb_fd = -1;
+    }
+    g_initialized = false;
+}
