+
+static void reportPresentRate(void) {
+    static uint64_t reportStart = 0;
+    static uint32_t reportFrames = 0;
+    uint64_t now = nowNanos();
+    if (reportStart == 0) reportStart = now;
+    reportFrames++;
+    if (now - reportStart >= 1000000000ULL) {
+        logInfo("MiSTer present rate: %.1f fps\n",
+                (double)reportFrames * 1000000000.0 / (double)(now - reportStart));
+        reportStart = now;
+        reportFrames = 0;
+    }
+}
+
+void platformSwapBuffers(void) {
+    if (g_fb == NULL || g_next_frame == NULL || g_next_width != MISTER_WIDTH || g_next_height != MISTER_HEIGHT) return;
+
+    if (!g_gpu_software_frame && g_gpu_command_count != 0) {
+        uint32_t cycles = 0;
+        uint32_t commandCount = g_gpu_command_count;
+        if (MisterGpu_finishFrame(&cycles)) {
+            g_gpu_submitted_frames++;
+            if (g_runner != NULL && (g_runner->frameCount % 300) == 0)
+                logInfo("MiSTer GPU submit frame %d: %u commands, previous=%u cycles, submitted=%u\n",
+                        g_runner->frameCount, commandCount, cycles, g_gpu_submitted_frames);
+        }
+    }
+    if (g_gpu_presented) {
+        g_gpu_presented = false;
+        reportPresentRate();
+        return;
+    }
+
+    const uint8_t *src = (const uint8_t *)g_next_frame;
+    for (size_t i = 0; i < (size_t)MISTER_WIDTH * MISTER_HEIGHT; ++i) {
+        const uint8_t r = src[i * 4 + 0];
+        const uint8_t g = src[i * 4 + 1];
+        const uint8_t b = src[i * 4 + 2];
+        g_fb[i] = ((uint32_t)r << 16) | ((uint32_t)g << 8) | b;
+    }
+    reportPresentRate();
+}
