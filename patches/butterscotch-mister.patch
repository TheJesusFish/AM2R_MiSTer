+
+bool platformHandleEvents(void) {
+    if (g_runner == NULL) return false;
+
+    RunnerGamepadState *gamepads = g_runner->gamepads;
+    GamepadSlot *pad = &gamepads->slots[0];
+    memcpy(pad->buttonDownPrev, pad->buttonDown, sizeof(pad->buttonDown));
+    memset(pad->buttonPressed, 0, sizeof(pad->buttonPressed));
+    memset(pad->buttonReleased, 0, sizeof(pad->buttonReleased));
+    pad->connected = true;
+    gamepads->connectedCount = 1;
+
+    struct input_event events[32];
+    ssize_t count;
+    while (g_input_fd >= 0 && (count = read(g_input_fd, events, sizeof(events))) > 0) {
+        size_t eventCount = (size_t)count / sizeof(events[0]);
+        for (size_t i = 0; i < eventCount; ++i) {
+            const struct input_event *ev = &events[i];
+            if (ev->type != EV_KEY || ev->value == 2) continue;
+            if (InputRecording_isPlaybackActive(globalInputRecording)) continue;
+
+            int key = linuxKeyToGml(ev->code);
+            if (key >= 0) {
+                if (ev->value) RunnerKeyboard_onKeyDown(g_runner->keyboard, key);
+                else RunnerKeyboard_onKeyUp(g_runner->keyboard, key);
+            }
+
+            int button = virtualPadButton(ev->code);
+            if (button >= 0) g_keyboard_pad[button] = ev->value != 0;
+        }
+    }
+
+    memcpy(pad->buttonDown, g_keyboard_pad, sizeof(pad->buttonDown));
+    if (g_joy_shm != NULL && g_joy_shm->magic == AM2R_JOY_SHM_MAGIC &&
+        g_joy_shm->version == AM2R_JOY_SHM_VERSION) {
+        __sync_synchronize();
+        uint32_t mask = g_joy_shm->joy_mask[0];
+        pad->buttonDown[15] |= (mask & (1u << 0)) != 0; // Right
+        pad->buttonDown[14] |= (mask & (1u << 1)) != 0; // Left
+        pad->buttonDown[13] |= (mask & (1u << 2)) != 0; // Down
+        pad->buttonDown[12] |= (mask & (1u << 3)) != 0; // Up
+        pad->buttonDown[0]  |= (mask & (1u << 4)) != 0; // A
+        pad->buttonDown[1]  |= (mask & (1u << 5)) != 0; // B
+        pad->buttonDown[8]  |= (mask & (1u << 6)) != 0; // Select
+        pad->buttonDown[9]  |= (mask & (1u << 7)) != 0; // Start
+        pad->buttonDown[4]  |= (mask & (1u << 8)) != 0; // L
+        pad->buttonDown[5]  |= (mask & (1u << 9)) != 0; // R
+    }
+
+    for (int button = 0; button < GP_BUTTON_COUNT; ++button) {
+        bool wasDown = pad->buttonDownPrev[button];
+        bool isDown = pad->buttonDown[button];
+        pad->buttonPressed[button] = isDown && !wasDown;
+        pad->buttonReleased[button] = !isDown && wasDown;
+        pad->buttonValue[button] = isDown ? 1.0f : 0.0f;
+    }
+    pad->axisValue[0] = (pad->buttonDown[15] ? 1.0f : 0.0f) - (pad->buttonDown[14] ? 1.0f : 0.0f);
+    pad->axisValue[1] = (pad->buttonDown[13] ? 1.0f : 0.0f) - (pad->buttonDown[12] ? 1.0f : 0.0f);
+    // A menu-launched hybrid cannot rely on the FPGA OSD to terminate its HPS
+    // companion. Select+Start exits the runner; the launcher trap restores the
+    // normal MiSTer menu core.
+    return pad->buttonDown[8] && pad->buttonDown[9];
+}
+
+void platformSleepUntil(uint64_t target) {
+    int64_t remaining = (int64_t)target - (int64_t)nowNanos();
+    if (remaining > 2000000) {
+        struct timespec ts;
+        remaining -= 1000000;
+        ts.tv_sec = (time_t)(remaining / 1000000000);
+        ts.tv_nsec = (long)(remaining % 1000000000);
+        nanosleep(&ts, NULL);
+    }
+    while (nowNanos() < target) YIELD();
+}
