+static void measuredAudioCallback(ma_device* device, void* output,
+                                  const void* input, ma_uint32 frameCount) {
+    (void)input;
+    MaAudioSystem* ma = (MaAudioSystem*)device->pUserData;
+    ma_engine_read_pcm_frames(&ma->engine, output, frameCount, NULL);
+    const float* samples = (const float*)output;
+    float peak = 0.0f;
+    for (ma_uint32 i = 0; i < frameCount * 2; ++i) {
+        float magnitude = samples[i] < 0.0f ? -samples[i] : samples[i];
+        if (magnitude > peak) peak = magnitude;
+    }
+    uint32_t scaled = peak >= 1.0f ? 1000000u : (uint32_t)(peak * 1000000.0f);
+    __atomic_fetch_add(&ma->outputFrames, frameCount, __ATOMIC_RELAXED);
+    if (scaled != 0) __atomic_fetch_add(&ma->nonSilentCallbacks, 1, __ATOMIC_RELAXED);
+    uint32_t previous = __atomic_load_n(&ma->peakMicrounits, __ATOMIC_RELAXED);
+    while (scaled > previous && !__atomic_compare_exchange_n(&ma->peakMicrounits,
+           &previous, scaled, false, __ATOMIC_RELAXED, __ATOMIC_RELAXED)) {}
+}
+
