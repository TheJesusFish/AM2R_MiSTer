     deviceConfig.periods           = 3;
     deviceConfig.periodSizeInMilliseconds = 10;
-    deviceConfig.dataCallback = ma_engine_data_callback_internal;
-    deviceConfig.pUserData    = &ma->engine;
+    deviceConfig.dataCallback = measuredAudioCallback;
+    deviceConfig.pUserData    = ma;
     ma_result deviceResult = ma_device_init(NULL, &deviceConfig, &ma->device);
     if (deviceResult != MA_SUCCESS) {
         logError("Audio: Failed to initialize playback device (error %d)\n", deviceResult);
@@ -174,6 +197,15 @@ static void maDestroy(AudioSystem* audio) {
 
 static void maUpdate(AudioSystem* audio, float deltaTime) {
     MaAudioSystem* ma = (MaAudioSystem*) audio;
+    ma->outputLogElapsed += deltaTime;
+    if (ma->outputLogElapsed >= 5.0f) {
+        uint64_t frames = __atomic_load_n(&ma->outputFrames, __ATOMIC_RELAXED);
+        uint32_t active = __atomic_load_n(&ma->nonSilentCallbacks, __ATOMIC_RELAXED);
+        uint32_t peak = __atomic_exchange_n(&ma->peakMicrounits, 0, __ATOMIC_RELAXED);
+        logInfo("Audio output: %llu frames, non-silent callbacks=%u, peak=%.4f\n",
+                (unsigned long long)frames, active, peak / 1000000.0f);
+        ma->outputLogElapsed = 0.0f;
+    }
 
     repeat(MAX_SOUND_INSTANCES, i) {
         SoundInstance* inst = &ma->instances[i];
