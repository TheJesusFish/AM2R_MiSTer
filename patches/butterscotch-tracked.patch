+typedef struct {
+    uint8_t* data;
+    size_t size;
+    size_t capacity;
+} SurfacePngBuffer;
+
+static void surfacePngWrite(void* context, void* data, int size) {
+    SurfacePngBuffer* png = (SurfacePngBuffer*)context;
+    if (size <= 0) return;
+    size_t required = png->size + (size_t)size;
+    if (required > png->capacity) {
+        size_t capacity = png->capacity != 0 ? png->capacity : 4096;
+        while (capacity < required) capacity *= 2;
+        png->data = (uint8_t*)safeRealloc(png->data, capacity);
+        png->capacity = capacity;
+    }
+    memcpy(png->data + png->size, data, (size_t)size);
+    png->size = required;
+}
+
+static RValue builtin_surface_save(VMContext* ctx, RValue* args, int32_t argCount) {
+    if (argCount < 2 || args[1].type != RVALUE_STRING) return RValue_makeUndefined();
+    Runner* runner = ctx->runner;
+    Renderer* renderer = runner != nullptr ? runner->renderer : nullptr;
+    int32_t surfaceId = RValue_toInt32(args[0]);
+    if (renderer == nullptr || renderer->vtable->surfaceGetPixels == nullptr ||
+        !Renderer_surfaceExists(renderer, surfaceId)) return RValue_makeUndefined();
+
+    int32_t width = (int32_t)Renderer_getSurfaceWidth(renderer, surfaceId);
+    int32_t height = (int32_t)Renderer_getSurfaceHeight(renderer, surfaceId);
+    if (width <= 0 || height <= 0) return RValue_makeUndefined();
+
+    size_t pixelBytes = (size_t)width * (size_t)height * 4u;
+    uint8_t* pixels = (uint8_t*)safeMalloc(pixelBytes);
+    if (!renderer->vtable->surfaceGetPixels(renderer, surfaceId, pixels)) {
+        free(pixels);
+        return RValue_makeUndefined();
+    }
+
+    SurfacePngBuffer png = {0};
+    int encoded = stbi_write_png_to_func(surfacePngWrite, &png, width, height, 4,
+                                         pixels, width * 4);
+    free(pixels);
+    if (encoded && png.size <= INT32_MAX) {
+        FileSystem* fs = runner->fileSystem;
+        fs->vtable->writeFileBinary(fs, args[1].string, png.data, (int32_t)png.size);
+    }
+    free(png.data);
+    return RValue_makeUndefined();
+}
