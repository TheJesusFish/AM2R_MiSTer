+static void swGpuFallbackForApplicationSurfaceSnapshot(SWRenderer* sw) {
+    if (!sw->gpuFrameEligible) return;
+    sw->gpuFallbackReasons[5]++;
+    if (sw->gpuFallbackFrames < 20 ||
+        (sw->base.runner->frameCount % 300) == 0) {
+        logInfo("MiSTer GPU fallback frame %d: application surface snapshot "
+                "(clear=%d skipped=%d host=%d)\n",
+                sw->base.runner->frameCount, sw->gpuSawClear,
+                sw->gpuHasSkippedDraws, sw->gpuHostContinuation);
+    }
+    if (sw->gpuHasSkippedDraws) {
+        int32_t app = sw->base.runner->applicationSurfaceId;
+        uint8_t* destination = nullptr;
+        if (app >= 0 && (uint32_t)app < sw->surfaceCount &&
+            sw->surfaceExistsFlags[app]) destination = sw->surfacePixels[app];
+        if (!MisterGpu_readbackLastPresentedRgba(destination, 320, 240)) {
+            // Startup transitions can ask for a snapshot before any frame has
+            // been presented.  In that narrow case the current command list
+            // is the only possible source.
+            bool hostContinuation = sw->gpuHostContinuation;
+            sw->gpuHostContinuation = false;
+            swGpuFallback(sw, "application surface readback");
+            sw->gpuHostContinuation = hostContinuation;
+            return;
+        }
+    }
+    MisterGpu_useSoftwareFrame();
+    sw->gpuFrameEligible = false;
+    sw->gpuFallbackFrames++;
+}
