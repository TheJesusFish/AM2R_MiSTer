+bool MisterGpu_readbackLastPresentedRgba(uint8_t* rgba, int32_t width, int32_t height) {
+    if (rgba == NULL || width != MISTER_WIDTH || height != MISTER_HEIGHT)
+        return false;
+    // Do not submit the command list currently being assembled.  Retire the
+    // prior asynchronous job, then copy the last completed scanout.  AM2R's
+    // item cutscene snapshots application_surface before the new room/frame is
+    // drawn, so submitting the current list here would capture its black clear
+    // instead of the gameplay image that is still on screen.
+    if (!waitGpuCompletion(NULL) || !g_gpu_last_presented_valid ||
+        g_gpu_native_buffers[g_gpu_last_presented_buffer] == NULL) return false;
+    const uint32_t *completed = g_gpu_native_buffers[g_gpu_last_presented_buffer];
+    __sync_synchronize();
+    for (size_t i = 0; i < (size_t)width * height; ++i) {
+        uint32_t xrgb = completed[i];
+        rgba[i * 4 + 0] = (uint8_t)(xrgb >> 16);
+        rgba[i * 4 + 1] = (uint8_t)(xrgb >> 8);
+        rgba[i * 4 + 2] = (uint8_t)xrgb;
+        rgba[i * 4 + 3] = 255;
+    }
+    return true;
+}
