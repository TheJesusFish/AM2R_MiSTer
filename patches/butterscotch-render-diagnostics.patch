+// SPDX-License-Identifier: GPL-3.0-or-later
+// Opt-in main-thread measurements. No timers, storage or I/O in release builds.
+#ifndef AM2R_RENDER_DIAGNOSTICS_H
+#define AM2R_RENDER_DIAGNOSTICS_H
+#include <stdint.h>
+
+enum RD_Operation {
+    RD_CPU_WORK, RD_STEP, RD_DRAW, RD_PRESENT, RD_GPU_WAIT, RD_UPLOAD,
+    RD_USER_AXIS, RD_USER_TRIANGLE, RD_USER_CLEAR, RD_OUTPUT_AXIS,
+    RD_SUBTRACT_SCALED, RD_SUBTRACT_UNIT, RD_CAPTURE, RD_OPERATION_COUNT
+};
+
+#ifdef MISTER_RENDER_DIAGNOSTICS
+typedef struct { uint64_t start; int bucket; int operation; } RD_Scope;
+void RD_beginFrame(int32_t frame, int32_t room, uint32_t inputMask);
+void RD_endFrame(void);
+RD_Scope RD_scopeBegin(int operation, int32_t surface, uint64_t pixels);
+void RD_scopeEnd(RD_Scope* scope);
+void RD_uploadBytes(uint64_t bytes);
+void RD_capturePerturbation(void);
+#define RD_SCOPE(op, surface, pixels) \
+    RD_Scope rdScope __attribute__((cleanup(RD_scopeEnd))) = \
+        RD_scopeBegin((op), (surface), (pixels))
+#define RD_UPLOAD_BYTES(bytes) RD_uploadBytes(bytes)
+#else
+#define RD_beginFrame(frame, room, inputMask) ((void)0)
+#define RD_endFrame() ((void)0)
+#define RD_SCOPE(op, surface, pixels) ((void)0)
+#define RD_UPLOAD_BYTES(bytes) ((void)0)
+#define RD_capturePerturbation() ((void)0)
+#endif
+#endif
