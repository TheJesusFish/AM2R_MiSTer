diff --git a/src/render_diagnostics.c b/src/render_diagnostics.c
new file mode 100644
--- /dev/null
+++ b/src/render_diagnostics.c
@@ -0,0 +1,183 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#include "render_diagnostics.h"
+#ifdef MISTER_RENDER_DIAGNOSTICS
+#include <errno.h>
+#include <fcntl.h>
+#include <inttypes.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <time.h>
+#include <unistd.h>
+
+#ifndef RD_REQUEST
+#define RD_REQUEST "/tmp/am2r-render-diag.request"
+#endif
+#define RD_MAX_FRAMES 1800u
+#define RD_BUCKETS 64u
+
+typedef struct {
+    uint64_t nanos, pixels, bytes;
+    uint32_t calls;
+    int32_t surface, operation;
+} RD_Bucket;
+typedef struct {
+    uint64_t start, work;
+    int32_t frame, room;
+    uint32_t input, count, dropped;
+    RD_Bucket buckets[RD_BUCKETS];
+} RD_Frame;
+static const char* const operationNames[] = {
+    "cpu_work", "step", "draw", "present", "gpu_wait", "upload",
+    "user_axis", "user_triangle", "user_clear", "output_axis",
+    "subtract_scaled", "subtract_unit", "capture_perturbation"
+};
+static RD_Frame* frames;
+static RD_Frame* current;
+static uint32_t limit, used, polls;
+static uint32_t depths[RD_OPERATION_COUNT];
+static uint64_t origin;
+static FILE* output;
+
+static uint64_t rdNow(void) {
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (uint64_t)ts.tv_sec * 1000000000ull + (uint64_t)ts.tv_nsec;
+}
+
+static int bucketFor(int operation, int32_t surface) {
+    for (uint32_t i = 0; i < current->count; ++i)
+        if (current->buckets[i].operation == operation &&
+            current->buckets[i].surface == surface) return (int)i;
+    if (current->count == RD_BUCKETS) {
+        current->dropped++;
+        return -1;
+    }
+    int index = (int)current->count++;
+    current->buckets[index].operation = operation;
+    current->buckets[index].surface = surface;
+    return index;
+}
+
+static void flushFrames(void) {
+    // Deliberately outside measured work. This finite diagnostic pass pauses
+    // here; never use its flush/capture boundary to measure gameplay cadence.
+    fputs("elapsed_ns,frame,room,operation,surface_id,calls,pixels,elapsed_work_ns,uploaded_bytes,input_mask,dropped_scopes\n", output);
+    for (uint32_t i = 0; i < used; ++i) {
+        RD_Frame* f = &frames[i];
+        for (uint32_t j = 0; j < f->count; ++j) {
+            RD_Bucket* b = &f->buckets[j];
+            fprintf(output, "%" PRIu64 ",%d,%d,%s,%d,%u,%" PRIu64 ",%" PRIu64 ",%" PRIu64 ",%u,%u\n",
+                f->start - origin, f->frame, f->room, operationNames[b->operation],
+                b->surface, b->calls, b->pixels, b->nanos, b->bytes,
+                f->input, f->dropped);
+        }
+    }
+    int failed = ferror(output);
+    if (fclose(output) != 0) failed = 1;
+    fprintf(stderr, "AM2R render diagnostics: %u frames, output %s\n",
+            used, failed ? "FAILED (discard incomplete CSV)" : "complete");
+    output = NULL;
+    free(frames);
+    frames = current = NULL;
+}
+
+static void pollRequest(void) {
+    // One-shot request: '<frame count> <existing QA directory>\n'.
+    // Fixed filename, bounded allocation, exclusive output; never overwrite.
+    int fd = open(RD_REQUEST, O_RDONLY | O_CLOEXEC | O_NOFOLLOW | O_NONBLOCK);
+    if (fd < 0) return;
+    struct stat st;
+    char request[768];
+    ssize_t size = -1;
+    if (fstat(fd, &st) == 0 && S_ISREG(st.st_mode) && st.st_size < (off_t)sizeof(request))
+        size = read(fd, request, sizeof(request) - 1);
+    close(fd);
+    unlink(RD_REQUEST);
+    if (size <= 0) return;
+    request[size] = 0;
+    char* path;
+    errno = 0;
+    unsigned long wanted = strtoul(request, &path, 10);
+    if (errno || wanted < 1 || wanted > RD_MAX_FRAMES || *path != ' ') return;
+    while (*path == ' ') ++path;
+    path[strcspn(path, "\r\n")] = 0;
+    if (*path != '/' || stat(path, &st) != 0 || !S_ISDIR(st.st_mode)) return;
+    char name[1024];
+    if (snprintf(name, sizeof(name), "%s/render-timing.csv", path) >= (int)sizeof(name)) return;
+    RD_Frame* allocation = calloc(wanted, sizeof(*frames));
+    if (!allocation) return;
+    fd = open(name, O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC | O_NOFOLLOW, 0600);
+    if (fd < 0) { free(allocation); return; }
+    output = fdopen(fd, "w");
+    if (!output) { close(fd); free(allocation); return; }
+    frames = allocation;
+    limit = (uint32_t)wanted;
+    used = 0;
+    origin = rdNow();
+    fprintf(stderr, "AM2R render diagnostics: recording %u frames (timings inclusive; no per-frame I/O)\n", limit);
+}
+
+void RD_beginFrame(int32_t frame, int32_t room, uint32_t inputMask) {
+    // A prior incomplete iteration is discarded, not attributed to this one.
+    if (current) { current = NULL; memset(depths, 0, sizeof(depths)); }
+    if (!frames && (++polls & 15u) == 0) pollRequest();
+    if (!frames) return;
+    current = &frames[used];
+    memset(current, 0, sizeof(*current));
+    current->frame = frame;
+    current->room = room;
+    current->input = inputMask;
+    current->start = rdNow();
+    // Reserve mandatory coverage evidence even if a scene exceeds the detail cap.
+    (void)bucketFor(RD_CPU_WORK, -1);
+}
+
+void RD_endFrame(void) {
+    if (!current) return;
+    uint64_t elapsed = rdNow() - current->start;
+    int index = bucketFor(RD_CPU_WORK, -1);
+    if (index >= 0) {
+        current->buckets[index].calls = 1;
+        current->buckets[index].nanos = elapsed;
+    }
+    current = NULL;
+    memset(depths, 0, sizeof(depths));
+    if (++used == limit) flushFrames();
+}
+
+RD_Scope RD_scopeBegin(int operation, int32_t surface, uint64_t pixels) {
+    RD_Scope scope = {0, -1, -1};
+    if (!current || operation < 0 || operation >= RD_OPERATION_COUNT) return scope;
+    scope.operation = operation;
+    if (depths[operation]++ != 0) return scope;
+    scope.bucket = bucketFor(operation, surface);
+    if (scope.bucket >= 0) {
+        RD_Bucket* bucket = &current->buckets[scope.bucket];
+        bucket->calls++;
+        bucket->pixels += pixels;
+        scope.start = rdNow();
+    }
+    return scope;
+}
+
+void RD_scopeEnd(RD_Scope* scope) {
+    if (scope->operation < 0 || !current) return;
+    if (depths[scope->operation]) depths[scope->operation]--;
+    if (scope->bucket >= 0)
+        current->buckets[scope->bucket].nanos += rdNow() - scope->start;
+}
+
+void RD_uploadBytes(uint64_t bytes) {
+    if (!current) return;
+    int index = bucketFor(RD_UPLOAD, -1);
+    if (index >= 0) current->buckets[index].bytes += bytes;
+}
+
+void RD_capturePerturbation(void) {
+    if (!current) return;
+    int index = bucketFor(RD_CAPTURE, -1);
+    if (index >= 0) current->buckets[index].calls++;
+}
+#endif
