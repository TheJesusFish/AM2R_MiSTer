+// Count bytes actually written to shared texture DDR, never CPU shadow copies.
+// The release macro expands to the original memcpy with no extra work.
+#if defined(MISTER_RENDER_DIAGNOSTICS)
+#define GPU_TEXTURE_COPY(destination, source, bytes) do { \
+    size_t rdTextureCopyBytes = (bytes); \
+    RD_UPLOAD_BYTES(rdTextureCopyBytes); \
+    memcpy((destination), (source), rdTextureCopyBytes); \
+} while (0)
+#else
+#define GPU_TEXTURE_COPY(destination, source, bytes) memcpy((destination), (source), (bytes))
+#endif
+
+#if defined(MISTER_RENDER_DIAGNOSTICS)
+// Deliberately intrusive, one-job diagnostic captures. No disk reads/writes,
+// request polling, or capture code are compiled into ordinary release builds.
+// The game thread is the sole submitter/texture writer here; all parallel CPU
+// compositing workers have joined before publication. Capture only while the
+// preceding GPU job is retired, then synchronously retire this job before the
+// game may mutate its inputs. Native scanout reads these buffers but never
+// writes them. Capturing a live in-flight /dev/mem snapshot would not be safe.
+// Prior on-chip RGBA/alpha is not exposed. Jobs without a leading clear are
+// captured unchanged, but are replayable only if the independent reference
+// proves every needed pixel initialized before it is read or presented. Never
+// substitute the alpha-discarding native XRGB copy or an invented black frame.
+typedef struct {
+    int directory;
+    uint32_t sequence, commandCount, commandPhysical, frameSerial;
+    uint32_t nativeSourceBase;
+    int gameFrame, room;
+    size_t textureBytes;
+    uint32_t exports[GPU_TEXTURE_RECORDS];
+    uint32_t exportCount;
+    bool requiresInitializationProof;
+} GpuCapture;
+static GpuCapture g_gpu_capture = { .directory = -1 };
+static int g_gpu_capture_root = -1;
+static bool g_gpu_capture_initialized = false;
+static uint32_t g_gpu_capture_attempts = 0;
+
+static bool gpuCaptureWrite(int directory, const char* name,
+                             const void* source, size_t bytes) {
+    int fd = openat(directory, name, O_WRONLY | O_CREAT | O_EXCL |
+                    O_NOFOLLOW | O_CLOEXEC, 0600);
+    if (fd < 0) return false;
+    // Limit additional RAM, and copy uncached device mappings to ordinary RAM
+    // before file I/O. No framebuffer/texture allocation is modified.
+    uint8_t buffer[16384];
+    const uint8_t* input = (const uint8_t*)source;
+    bool ok = true;
+    while (bytes != 0 && ok) {
+        size_t chunk = bytes < sizeof(buffer) ? bytes : sizeof(buffer);
+        memcpy(buffer, input, chunk);
+        size_t written = 0;
+        while (written != chunk) {
+            ssize_t count = write(fd, buffer + written, chunk - written);
+            if (count < 0 && errno == EINTR) continue;
+            if (count <= 0) { ok = false; break; }
+            written += (size_t)count;
+        }
+        input += chunk;
+        bytes -= chunk;
+    }
+    if (ok && fsync(fd) != 0) ok = false;
+    if (close(fd) != 0) ok = false;
+    return ok;
+}
+
+static void gpuCaptureAbort(const char* reason) {
+    logWarn("MiSTer GPU capture rejected/incomplete: %s (no manifest published)\n",
+            reason);
+    if (g_gpu_capture.directory >= 0) close(g_gpu_capture.directory);
+    g_gpu_capture.directory = -1;
+}
+
+static bool gpuCapturePrepare(uint32_t sequence, uint32_t physical) {
+    if (!g_gpu_capture_initialized) {
+        g_gpu_capture_initialized = true;
+        const char* path = getenv("AM2R_GPU_CAPTURE_DIR");
+        if (path != NULL && path[0] == '/') {
+            g_gpu_capture_root = open(path, O_RDONLY | O_DIRECTORY |
+                                      O_NOFOLLOW | O_CLOEXEC);
+            if (g_gpu_capture_root < 0)
+                logWarn("MiSTer GPU capture: cannot open requested output directory\n");
+        }
+    }
+    // At most eight requests per process. Caller creates the existing private
+    // QA directory and an empty regular capture.request file when ready.
+    if (g_gpu_capture_root < 0 || g_gpu_capture_attempts >= 8u) return false;
+    int request = openat(g_gpu_capture_root, "capture.request",
+                         O_RDONLY | O_NONBLOCK | O_NOFOLLOW | O_CLOEXEC);
+    if (request < 0) return false;
+    struct stat requestStat;
+    bool valid = fstat(request, &requestStat) == 0 &&
+                 S_ISREG(requestStat.st_mode) && requestStat.st_size == 0;
+    close(request);
+    if (!valid) return false;
+    if (unlinkat(g_gpu_capture_root, "capture.request", 0) != 0) return false;
+    g_gpu_capture_attempts++;
+    RD_capturePerturbation();
+    RD_SCOPE(RD_CAPTURE, -1, 0);
+    if (g_gpu_pending || g_gpu_command_count < 2u ||
+        g_gpu_command_count > GPU_COMMAND_CAPACITY ||
+        g_gpu_texture_offset == 0 || g_gpu_texture_offset > GPU_TEXTURE_BYTES) {
+        gpuCaptureAbort("job is pending, empty, over capacity, or has invalid texture bounds");
+        return false;
+    }
+    GpuCapture* capture = &g_gpu_capture;
+    capture->sequence = sequence;
+    capture->commandCount = g_gpu_command_count;
+    capture->commandPhysical = physical;
+    capture->frameSerial = g_gpu_frame_serial;
+    capture->gameFrame = g_runner != NULL ? g_runner->frameCount : -1;
+    capture->room = g_runner != NULL ? g_runner->currentRoomIndex : -1;
+    capture->textureBytes = g_gpu_texture_offset;
+    capture->requiresInitializationProof = (uint8_t)g_gpu_commands[0].word[0] != 1u;
+    capture->nativeSourceBase = g_gpu_last_presented_valid ?
+        GPU_NATIVE_WINDOW_PHYS + GPU_NATIVE_BUFFER_OFFSET +
+            g_gpu_last_presented_buffer * GPU_NATIVE_BUFFER_BYTES : 0;
+    capture->exportCount = 0;
+    bool hasPotentialFramebufferWrite = false;
+    for (uint32_t i = 0; i < capture->commandCount; ++i) {
+        const MisterGpuCommand* command = &g_gpu_commands[i];
+        uint8_t opcode = (uint8_t)command->word[0];
+        if (opcode > 9u || ((opcode == 0u) != (i + 1u == capture->commandCount)) ||
+            (opcode == 8u && capture->nativeSourceBase == 0)) {
+            gpuCaptureAbort("unsupported opcode, missing END, or unavailable native source");
+            return false;
+        }
+        if (opcode == 6u) {
+            if (!hasPotentialFramebufferWrite) {
+                gpuCaptureAbort("export prefix needs unavailable prior BRAM RGBA");
+                return false;
+            }
+            uint32_t base = (uint32_t)command->word[1];
+            if ((base & 7u) != 0 || base < GPU_TEXTURE_PHYS ||
+                (uint64_t)base + MISTER_FB_BYTES >
+                    (uint64_t)GPU_TEXTURE_PHYS + capture->textureBytes) {
+                gpuCaptureAbort("export destination outside captured texture allocation");
+                return false;
+            }
+            uint32_t j = 0;
+            while (j < capture->exportCount && capture->exports[j] != base) j++;
+            if (j == capture->exportCount) {
+                if (j == GPU_TEXTURE_RECORDS) {
+                    gpuCaptureAbort("too many distinct export destinations");
+                    return false;
+                }
+                capture->exports[capture->exportCount++] = base;
+            }
+        }
+        if (opcode == 1u || opcode == 2u || opcode == 3u || opcode == 4u ||
+            opcode == 7u || opcode == 8u || opcode == 9u)
+            hasPotentialFramebufferWrite = true;
+    }
+    struct statvfs storage;
+    const uint64_t required = (uint64_t)capture->textureBytes +
+        (GPU_NATIVE_BUFFER_COUNT + 1u + capture->exportCount) * MISTER_FB_BYTES +
+        GPU_COMMAND_BYTES + 1024u * 1024u;
+    if (fstatvfs(g_gpu_capture_root, &storage) != 0 ||
+        (uint64_t)storage.f_bavail * storage.f_frsize < required) {
+        gpuCaptureAbort("insufficient output storage");
+        return false;
+    }
+    char name[96];
+    snprintf(name, sizeof(name), "job-%ld-%u-%u", (long)getpid(),
+             sequence, g_gpu_capture_attempts);
+    if (mkdirat(g_gpu_capture_root, name, 0700) != 0) {
+        gpuCaptureAbort("capture directory already exists or cannot be created");
+        return false;
+    }
+    capture->directory = openat(g_gpu_capture_root, name,
+        O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC);
+    if (capture->directory < 0) return false;
+    __sync_synchronize();
+    bool ok = gpuCaptureWrite(capture->directory, "commands.bin", g_gpu_commands,
+                              capture->commandCount * sizeof(MisterGpuCommand)) &&
+              gpuCaptureWrite(capture->directory, "textures.bin", g_gpu_textures,
+                              capture->textureBytes);
+    for (uint32_t i = 0; i < GPU_NATIVE_BUFFER_COUNT && ok; ++i) {
+        snprintf(name, sizeof(name), "native-%u.bin", i);
+        ok = gpuCaptureWrite(capture->directory, name,
+                              g_gpu_native_buffers[i], MISTER_FB_BYTES);
+    }
+    if (!ok) { gpuCaptureAbort("input write failed"); return false; }
+    logInfo("MiSTer GPU capture: inputs for sequence %u frozen (%zu texture bytes)\n",
+            sequence, capture->textureBytes);
+    return true;
+}
+
+static void gpuCaptureComplete(void) {
+    GpuCapture* capture = &g_gpu_capture;
+    if (capture->directory < 0) return;
+    RD_SCOPE(RD_CAPTURE, -1, 0);
+    if (g_gpu_pending || !g_gpu_available || !g_gpu_last_presented_valid ||
+        g_gpu_control[6] != capture->sequence) {
+        gpuCaptureAbort("captured job did not complete");
+        return;
+    }
+    __sync_synchronize();
+    bool ok = gpuCaptureWrite(capture->directory, "expected.bin",
+        g_gpu_native_buffers[g_gpu_last_presented_buffer], MISTER_FB_BYTES);
+    char name[64];
+    for (uint32_t i = 0; i < capture->exportCount && ok; ++i) {
+        snprintf(name, sizeof(name), "export-%u.bin", i);
+        ok = gpuCaptureWrite(capture->directory, name,
+            g_gpu_textures + (capture->exports[i] - GPU_TEXTURE_PHYS), MISTER_FB_BYTES);
+    }
+    if (!ok) { gpuCaptureAbort("expected-output write failed"); return; }
+    int fd = openat(capture->directory, "manifest.json.tmp", O_WRONLY | O_CREAT |
+                     O_EXCL | O_NOFOLLOW | O_CLOEXEC, 0600);
+    FILE* manifest = fd >= 0 ? fdopen(fd, "w") : NULL;
+    if (manifest == NULL) {
+        if (fd >= 0) close(fd);
+        gpuCaptureAbort("cannot create final manifest");
+        return;
+    }
+    fprintf(manifest,
+        "{\n  \"format\":\"am2r-gpu-capture-v1\",\n"
+        "  \"capture_kind\":\"gpu-job\",\"perturbs_timing\":true,\n"
+        "  \"initial_framebuffer_status\":\"unavailable\",\"requires_initialization_proof\":%s,\n"
+        "  \"sequence\":%u,\"frame_serial\":%u,\"game_frame\":%d,\"room\":%d,\n"
+        "  \"command_count\":%u,\"command_physical\":%u,\n"
+        "  \"gpu_cycles\":%u,\"completion_buffer\":%u,\"underflow\":%s,\n"
+        "  \"width\":320,\"height\":240,\"byte_order\":\"little\",\n"
+        "  \"commands\":{\"file\":\"commands.bin\"},\n"
+        "  \"regions\":[{\"base\":%u,\"file\":\"textures.bin\",\"bytes\":%zu}",
+        capture->requiresInitializationProof ? "true" : "false",
+        capture->sequence, capture->frameSerial, capture->gameFrame, capture->room,
+        capture->commandCount, capture->commandPhysical, g_gpu_last_completed_cycles,
+        g_gpu_last_presented_buffer, g_gpu_scanout_underflow ? "true" : "false",
+        GPU_TEXTURE_PHYS, capture->textureBytes);
+    for (uint32_t i = 0; i < GPU_NATIVE_BUFFER_COUNT; ++i)
+        fprintf(manifest, ",{\"base\":%u,\"file\":\"native-%u.bin\",\"bytes\":%zu}",
+            GPU_NATIVE_WINDOW_PHYS + GPU_NATIVE_BUFFER_OFFSET +
+                i * (uint32_t)GPU_NATIVE_BUFFER_BYTES, i, MISTER_FB_BYTES);
+    fprintf(manifest, "],\n  \"native_source_base\":");
+    if (capture->nativeSourceBase != 0) fprintf(manifest, "%u", capture->nativeSourceBase);
+    else fprintf(manifest, "null");
+    fprintf(manifest, ",\n  \"expected\":{\"file\":\"expected.bin\",\"format\":\"xrgb8888\"},\n"
+        "  \"expected_exports\":[");
+    for (uint32_t i = 0; i < capture->exportCount; ++i)
+        fprintf(manifest, "%s{\"base\":%u,\"file\":\"export-%u.bin\"}",
+                i == 0 ? "" : ",", capture->exports[i], i);
+    fprintf(manifest, "]\n}\n");
+    ok = !ferror(manifest) && fflush(manifest) == 0 && fsync(fd) == 0;
+    if (fclose(manifest) != 0) ok = false;
+    if (!ok) {
+        // A manifest is the completion marker, never leave a partial one.
+        unlinkat(capture->directory, "manifest.json.tmp", 0);
+        gpuCaptureAbort("manifest write failed");
+        return;
+    }
+    if (renameat(capture->directory, "manifest.json.tmp",
+                 capture->directory, "manifest.json") != 0) {
+        gpuCaptureAbort("manifest publication failed");
+        return;
+    }
+    fsync(capture->directory);
+    close(capture->directory);
+    capture->directory = -1;
+    logInfo("MiSTer GPU capture: sequence %u complete; capture pause is not a performance sample\n",
+            capture->sequence);
+}
+#endif
