+static MisterGpuTexture* reuseReleasedTexture(const void* rgbaPixels,
+                                              size_t bytes,
+                                              bool requireSecondCopy,
+                                              bool requireAlternateShadow,
+                                              bool sourceRevisionValid,
+                                              uint32_t sourceRevision) {
+    MisterGpuTexture* best = NULL;
+    for (uint32_t i = 0; i < g_gpu_texture_record_count; ++i) {
+        MisterGpuTexture* record = &g_gpu_texture_records[i];
+        if (!record->released || record->bytes != bytes ||
+            record->released_frame == g_gpu_frame_serial)
+            continue;
+        if (requireSecondCopy && record->physical[1] == 0) continue;
+        if (best == NULL || (requireAlternateShadow && best->shadow_alt == NULL &&
+                             record->shadow_alt != NULL))
+            best = record;
+    }
+    if (best == NULL || !waitGpuCompletion(NULL)) return NULL;
+
+    if (requireAlternateShadow && best->shadow_alt == NULL) {
+        best->shadow_alt = malloc(bytes);
+        if (best->shadow_alt == NULL) return NULL;
+    }
+    best->source = rgbaPixels;
+    best->active = 0;
+    best->dynamic = best->physical[1] != 0;
+    best->source_revision = sourceRevision;
+    best->source_revision_valid = sourceRevisionValid;
+    best->shadow_valid = true;
+    best->sparse = requireAlternateShadow;
+    best->released = false;
+    best->released_frame = 0;
+    best->last_upload_frame = g_gpu_frame_serial;
+    best->generation = nextTextureGeneration();
+    best->opaque_generation = 0;
+    memcpy(best->shadow, rgbaPixels, bytes);
+    memcpy(g_gpu_textures + (best->physical[0] - GPU_TEXTURE_PHYS),
+           rgbaPixels, bytes);
+    if (best->physical[1] != 0)
+        memcpy(g_gpu_textures + (best->physical[1] - GPU_TEXTURE_PHYS),
+               rgbaPixels, bytes);
+    if (best->shadow_alt != NULL) memcpy(best->shadow_alt, rgbaPixels, bytes);
+    __sync_synchronize();
+    return best;
+}
