+void MisterGpu_releaseTexture(const void* rgbaPixels) {
+    if (rgbaPixels == NULL) return;
+    for (uint32_t i = 0; i < g_gpu_texture_record_count; ++i) {
+        MisterGpuTexture* record = &g_gpu_texture_records[i];
+        if (record->released || record->source != rgbaPixels) continue;
+        record->released = true;
+        record->released_frame = g_gpu_frame_serial;
+        record->source_revision_valid = false;
+        record->opaque_generation = 0;
+
+        // A freed GameMaker surface cannot remain the source of a deferred
+        // export or a derived fused/map cache. These caches are cheap to
+        // rebuild and keeping their record pointers would make record reuse
+        // unsafe.
+        uint32_t write = 0;
+        for (uint32_t read = 0; read < g_gpu_deferred_export_count; ++read) {
+            uint32_t physical = g_gpu_deferred_exports[read];
+            bool belongs = false;
+            for (uint32_t copy = 0; copy < (record->dynamic ? 2u : 1u); ++copy) {
+                uint32_t base = record->physical[copy];
+                if (base != 0 && physical >= base &&
+                    (size_t)(physical - base) < record->bytes) {
+                    belongs = true;
+                    break;
+                }
+            }
+            if (!belongs) g_gpu_deferred_exports[write++] = physical;
+        }
+        g_gpu_deferred_export_count = write;
+        g_gpu_fused_base_valid = false;
+        g_gpu_fused_valid = false;
+        g_gpu_fused_source_record = NULL;
+        g_gpu_fused_overlay_record = NULL;
+        g_gpu_fused_base_source_count = 0;
+        g_gpu_map_overlay_cache_record = NULL;
+        g_gpu_map_overlay_cache_valid = false;
+        g_gpu_map_base_cache_record = NULL;
+        g_gpu_map_base_cache_valid = false;
+    }
+}
