+// Intersect a full 1:1 surface draw with its translated non-transparent box.
+// The incoming rectangle is already clipped to the target/scissor. Subtracting
+// transparent margins from that clipped rectangle instead loses real HUD rows
+// when an inset moves the original full-height quad beyond the screen bottom.
+static bool swGpuIntersectSurfaceContentBounds(float x, float y,
+        int32_t sourceMinX, int32_t sourceMinY, int32_t sourceMaxX, int32_t sourceMaxY,
+        int32_t* minX, int32_t* minY, int32_t* maxX, int32_t* maxY) {
+    int32_t left = swPixelCoverageEdge(x + (float)sourceMinX);
+    int32_t top = swPixelCoverageEdge(y + (float)sourceMinY);
+    int32_t right = swPixelCoverageEdge(x + (float)sourceMaxX);
+    int32_t bottom = swPixelCoverageEdge(y + (float)sourceMaxY);
+    if (*minX < left) *minX = left;
+    if (*minY < top) *minY = top;
+    if (*maxX > right) *maxX = right;
+    if (*maxY > bottom) *maxY = bottom;
+    return *minX < *maxX && *minY < *maxY;
+}
