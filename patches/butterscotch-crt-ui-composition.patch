+// This is a presentation adjustment for the supported AM2R 1.1 HUD, not a
+// rule for arbitrary shallow surfaces. Reuse the parser's whole-file proof,
+// then resolve the live owner field on every call: IDs can change on room
+// transitions or logical-state restore, and restored content bounds are
+// deliberately conservative/full-frame. No cached ID or alpha scan is used.
+static int32_t swCrtUiHudSurface(const SWRenderer* sw) {
+    Runner* runner = sw->base.runner;
+    if (runner == nullptr || runner->dataWin == nullptr || runner->vmContext == nullptr ||
+        !runner->dataWin->am2rLightSurfaceOwnershipVerified ||
+        runner->dataWin->objt.count != 737u || runner->dataWin->code.count != 8667u ||
+        runner->dataWin->objt.objects == nullptr) return -1;
+    const GameObject* object = &runner->dataWin->objt.objects[425];
+    VMContext* ctx = runner->vmContext;
+    Instance* owner = ctx->currentInstance;
+    if (object->name == nullptr || strcmp(object->name, "oControl") != 0 ||
+        owner == nullptr || owner->objectIndex != 425 || owner->destroyed) return -1;
+    ptrdiff_t field = shgeti(ctx->varNameMap, "gui_surface");
+    if (field < 0) return -1;
+    RValue value = Instance_getSelfVar(owner, ctx->varNameMap[field].value);
+    int32_t id;
+    switch (value.type) {
+        case RVALUE_INT32: id = value.int32; break;
+        case RVALUE_REAL:
+            if (!isfinite(value.real) || value.real <= 0 || value.real > INT32_MAX ||
+                value.real != (GMLReal)(int32_t)value.real) return -1;
+            id = (int32_t)value.real; break;
+#ifndef NO_RVALUE_INT64
+        case RVALUE_INT64:
+            if (value.int64 <= 0 || value.int64 > INT32_MAX) return -1;
+            id = (int32_t)value.int64; break;
+#endif
+        default: return -1;
+    }
+    if (id <= 0 || (uint32_t)id >= sw->surfaceCount || id == runner->applicationSurfaceId ||
+        !sw->surfaceExistsFlags[id] || sw->surfacePixels[id] == nullptr ||
+        sw->surfaceWidths[id] != 320 || sw->surfaceHeights[id] != 240) return -1;
+    return id;
+}
+
+static int32_t swCrtUiHudCompositeOffset(const SWRenderer* sw, int32_t id,
+        int32_t srcLeft, int32_t srcTop, int32_t srcWidth, int32_t srcHeight,
+        float x, float y, float xscale, float yscale, float angleDeg,
+        uint32_t c1, uint32_t c2, uint32_t c3, uint32_t c4, float alpha) {
+    uint32_t inset = MisterGpu_getCrtUiInset();
+    if (!inset || sw->currentSurface != RENDER_TARGET_HOST_FRAMEBUFFER ||
+        sw->hostWidth != 320 || sw->hostHeight != 240 ||
+        sw->fbWidth != 320 || sw->fbHeight != 240 ||
+        srcLeft != 0 || srcTop != 0 || srcWidth != 320 || srcHeight != 240 ||
+        x != 0.0f || y != 0.0f || xscale != 1.0f || yscale != 1.0f ||
+        angleDeg != 0.0f || alpha != 1.0f ||
+        (c1 & 0xffffffu) != 0xffffffu || (c2 & 0xffffffu) != 0xffffffu ||
+        (c3 & 0xffffffu) != 0xffffffu || (c4 & 0xffffffu) != 0xffffffu ||
+        sw->worldToScreen.m[1] != 0.0f || sw->worldToScreen.m[4] != 0.0f ||
+        sw->worldToScreen.m[5] != 1.0f || swCrtUiHudSurface(sw) != id) return 0;
+    const Runner* runner = sw->base.runner;
+    const VMContext* ctx = runner->vmContext;
+    if (!runner->inGuiPass || ctx->currentEventType != EVENT_DRAW ||
+        ctx->currentEventSubtype != DRAW_GUI || ctx->currentCodeName == nullptr ||
+        strcmp(ctx->currentCodeName, "gml_Object_oControl_Draw_64") != 0) return 0;
+    // The exact authored GUI surface holds the complete top HUD (including
+    // minimap/tanks/icons/counts). Move its final composite once, independent
+    // of legacy/unified raster dispatch and without modifying its pixels.
+    return CrtUi_verticalOffset(240, 0, 32, inset);
+}
