 static bool openJoyShared(void);
 
+static bool mapFramebuffer(void) {
+    g_fb_fd = open("/dev/fb0", O_RDWR | O_SYNC | O_CLOEXEC);
+    if (g_fb_fd < 0) {
+        logError("MiSTer: cannot open /dev/fb0: %s\n", strerror(errno));
+        return false;
+    }
+
+    g_fb = (uint32_t *)mmap(NULL, MISTER_FB_BYTES, PROT_READ | PROT_WRITE,
+                            MAP_SHARED, g_fb_fd, 0);
+    if (g_fb != MAP_FAILED) return true;
+
+    const int mmapError = errno;
+    g_fb = NULL;
+    if (mmapError != ENODEV) {
+        logError("MiSTer: cannot map /dev/fb0: %s\n", strerror(mmapError));
+        close(g_fb_fd);
+        g_fb_fd = -1;
+        return false;
+    }
+
+    // Linux 6.8 removed the fbdev core's default mmap implementation. The
+    // MiSTer_fb driver in current 6.18 kernels still reports its physical
+    // range through FBIOGET_FSCREENINFO but has no fb_mmap callback. Preserve
+    // the native fbdev path on older kernels and redirect only this ENODEV
+    // failure to the same pixels through /dev/mem, as Main_MiSTer does.
+    struct fb_fix_screeninfo fixed = {0};
+    if (ioctl(g_fb_fd, FBIOGET_FSCREENINFO, &fixed) != 0 ||
+        fixed.smem_start == 0 || fixed.smem_len < MISTER_FB_BYTES) {
+        logError("MiSTer: /dev/fb0 mmap unavailable and framebuffer range is invalid\n");
+        close(g_fb_fd);
+        g_fb_fd = -1;
+        return false;
+    }
+    close(g_fb_fd);
+
+    g_fb_fd = open("/dev/mem", O_RDWR | O_SYNC | O_CLOEXEC);
+    if (g_fb_fd < 0) {
+        logError("MiSTer: cannot open /dev/mem for framebuffer fallback: %s\n",
+                 strerror(errno));
+        return false;
+    }
+    g_fb = (uint32_t *)mmap(NULL, MISTER_FB_BYTES, PROT_READ | PROT_WRITE,
+                            MAP_SHARED, g_fb_fd, fixed.smem_start);
+    if (g_fb == MAP_FAILED) {
+        logError("MiSTer: cannot map framebuffer through /dev/mem: %s\n",
+                 strerror(errno));
+        g_fb = NULL;
+        close(g_fb_fd);
+        g_fb_fd = -1;
+        return false;
+    }
+
+    logInfo("MiSTer framebuffer mmap fallback: /dev/mem at 0x%lx (%u bytes)\n",
+            (unsigned long)fixed.smem_start, fixed.smem_len);
+    return true;
+}
