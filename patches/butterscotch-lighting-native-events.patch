diff --git a/src/runner.c b/src/runner.c
--- a/src/runner.c
+++ b/src/runner.c
@@ -608,6 +608,66 @@ static bool Runner_tryExecuteAm2rSandDraw(Runner* runner, Instance* instance,
     }
     return true;
 }
+
+// AM2R 1.1 requests the same complete light-mask rebuild from both Normal Step
+// and End Step.  Nothing presents or samples that surface between those two
+// phases; End Step runs after movement, collisions, and every ordinary Step
+// handler and therefore produces the mask that Draw actually consumes.  Keep
+// the Normal Step fade-out state change but defer its redundant rebuild to the
+// authored End Step event.  Fall back unless that exact companion handler is
+// present, so other games/data revisions retain interpreted semantics.
+static bool Runner_tryExecuteAm2rLightStep(Runner* runner,
+                                           Instance* instance,
+                                           int32_t eventType,
+                                           int32_t eventSubtype,
+                                           int32_t codeId,
+                                           int32_t ownerObjectIndex) {
+    static const char objectName[] = "oLightEngine";
+    static const char codeName[] = "gml_Object_oLightEngine_Step_0";
+    static const char endStepCodeName[] = "gml_Object_oLightEngine_Step_2";
+
+    if (eventType != EVENT_STEP || eventSubtype != STEP_NORMAL ||
+        instance == nullptr || codeId < 0 ||
+        (uint32_t)codeId >= runner->dataWin->code.count ||
+        ownerObjectIndex < 0 ||
+        (uint32_t)ownerObjectIndex >= runner->dataWin->objt.count)
+        return false;
+
+    const CodeEntry* code = &runner->dataWin->code.entries[codeId];
+    const GameObject* owner = &runner->dataWin->objt.objects[ownerObjectIndex];
+    if (code->name == nullptr || owner->name == nullptr ||
+        strcmp(code->name, codeName) != 0 ||
+        strcmp(owner->name, objectName) != 0)
+        return false;
+
+    int32_t endOwner = -1;
+    int32_t endCodeId = findEventCodeIdAndOwner(
+        runner, instance->objectIndex, EVENT_STEP, STEP_END, &endOwner);
+    if (endCodeId < 0 || (uint32_t)endCodeId >= runner->dataWin->code.count ||
+        endOwner != ownerObjectIndex ||
+        runner->dataWin->code.entries[endCodeId].name == nullptr ||
+        strcmp(runner->dataWin->code.entries[endCodeId].name,
+               endStepCodeName) != 0)
+        return false;
+
+    ptrdiff_t fadeoutSlot = shgeti(runner->vmContext->varNameMap, "fadeout");
+    if (fadeoutSlot < 0) return false;
+    int32_t fadeoutVariable =
+        runner->vmContext->varNameMap[fadeoutSlot].value;
+    if (!IntRValueHashMap_contains(&instance->selfVars, fadeoutVariable))
+        return false;
+
+    if (!RValue_toBool(Instance_getSelfVar(instance, fadeoutVariable)))
+        return true;
+    if (instance->imageAlpha > 0.0f) {
+        instance->imageAlpha =
+            (float)((GMLReal)instance->imageAlpha - (GMLReal)0.01);
+    } else {
+        Runner_destroyInstance(runner, instance, true);
+    }
+    return true;
+}
+
 #endif
 
