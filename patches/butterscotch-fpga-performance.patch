+    size_t index = (size_t)row * (size_t)ctx->am2rMapDiscoveryCols + (size_t)col;
+    uint8_t before = ctx->am2rMapDiscoveryVisible[index];
+    uint8_t now = am2rMapDiscoveryAt(ctx->am2rMapCurrentDiscovery, row, col);
