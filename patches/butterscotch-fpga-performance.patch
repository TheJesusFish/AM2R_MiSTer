+static uint8x8_t neonBlendChannel(uint8x8_t source, uint8x8_t destination,
+                                  uint8x8_t sourceAlpha) {
+    uint8x8_t inverseAlpha = vsub_u8(vdup_n_u8(255), sourceAlpha);
+    uint16x8_t sum = vmull_u8(source, sourceAlpha);
+    sum = vmlal_u8(sum, destination, inverseAlpha);
+    uint16x8_t rounded = vaddq_u16(sum, vdupq_n_u16(1));
+    rounded = vaddq_u16(rounded, vshrq_n_u16(sum, 8));
+    return vmovn_u16(vshrq_n_u16(rounded, 8));
+}
+
+static uint8x8_t neonBlendAlpha(uint8x8_t destinationAlpha,
+                                uint8x8_t sourceAlpha) {
+    uint8x8_t inverseAlpha = vsub_u8(vdup_n_u8(255), sourceAlpha);
+    uint16x8_t product = vmull_u8(destinationAlpha, inverseAlpha);
+    uint16x8_t divided = vaddq_u16(product, vdupq_n_u16(1));
+    divided = vaddq_u16(divided, vshrq_n_u16(product, 8));
+    return vadd_u8(sourceAlpha, vmovn_u16(vshrq_n_u16(divided, 8)));
+}
