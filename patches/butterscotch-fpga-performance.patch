+static bool gpuBuffersEqual(const void* lhs, const void* rhs, size_t bytes) {
+    if ((((uintptr_t)lhs | (uintptr_t)rhs | bytes) & 3u) != 0)
+        return memcmp(lhs, rhs, bytes) == 0;
+
+    const uint32_t* a = (const uint32_t*)lhs;
+    const uint32_t* b = (const uint32_t*)rhs;
+    size_t words = bytes / sizeof(uint32_t);
+    while (words >= 8u) {
+        if (a[0] != b[0] || a[1] != b[1] || a[2] != b[2] || a[3] != b[3] ||
+            a[4] != b[4] || a[5] != b[5] || a[6] != b[6] || a[7] != b[7])
+            return false;
+        a += 8;
+        b += 8;
+        words -= 8u;
+    }
+    while (words-- != 0) {
+        if (*a++ != *b++) return false;
+    }
+    return true;
+}
