+static uint32_t neonReduceOrU32(uint32x4_t values) {
+    uint32x2_t paired = vorr_u32(vget_low_u32(values), vget_high_u32(values));
+    paired = vorr_u32(paired, vrev64_u32(paired));
+    return vget_lane_u32(paired, 0);
+}
+
+static uint32_t neonReduceAndU32(uint32x4_t values) {
+    uint32x2_t paired = vand_u32(vget_low_u32(values), vget_high_u32(values));
+    paired = vand_u32(paired, vrev64_u32(paired));
+    return vget_lane_u32(paired, 0);
+}
+
+static uint8x16_t neonBlendConstantAlphaPacked(uint8x16_t source,
+                                               uint8x16_t destination,
+                                               uint8_t alpha) {
+    if (alpha == 0) return destination;
+    if (alpha == 255) return source;
+    uint8x8_t alphaVector = vdup_n_u8(alpha);
+    uint8x8_t inverseAlpha = vdup_n_u8((((uint8_t)(255u - alpha))));
+    uint16x8_t low = vmull_u8(vget_low_u8(source), alphaVector);
+    uint16x8_t high = vmull_u8(vget_high_u8(source), alphaVector);
+    low = vmlal_u8(low, vget_low_u8(destination), inverseAlpha);
+    high = vmlal_u8(high, vget_high_u8(destination), inverseAlpha);
+    uint16x8_t lowDivided = vaddq_u16(low, vdupq_n_u16(1));
+    uint16x8_t highDivided = vaddq_u16(high, vdupq_n_u16(1));
+    lowDivided = vaddq_u16(lowDivided, vshrq_n_u16(low, 8));
+    highDivided = vaddq_u16(highDivided, vshrq_n_u16(high, 8));
+    return vcombine_u8(vmovn_u16(vshrq_n_u16(lowDivided, 8)),
+                       vmovn_u16(vshrq_n_u16(highDivided, 8)));
+}
