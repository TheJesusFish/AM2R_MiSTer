+    ptrdiff_t dmapName = shgeti(ctx->varNameMap, "dmap");
+    if (mapName < 0 || dmapName < 0) return false;
+    RValue map = Instance_getSelfVar(source, ctx->varNameMap[mapName].value);
+    RValue dmap = Instance_getSelfVar(source, ctx->varNameMap[dmapName].value);
+    if (map.type != RVALUE_ARRAY || dmap.type != RVALUE_ARRAY ||
+        map.array == nullptr || dmap.array == nullptr) return false;
