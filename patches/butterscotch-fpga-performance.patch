+static const MisterGpuTexture* textureRecordForPhysical(uint32_t physical,
+                                                         size_t *recordOffset) {
+    for (uint32_t i = 0; i < g_gpu_texture_record_count; ++i) {
+        const MisterGpuTexture *record = &g_gpu_texture_records[i];
+        uint32_t copies = record->dynamic ? 2u : 1u;
+        for (uint32_t copy = 0; copy < copies; ++copy) {
+            uint32_t base = record->physical[copy];
+            if (base != 0 && physical >= base &&
+                (size_t)(physical - base) < record->bytes) {
+                if (recordOffset != NULL) *recordOffset = physical - base;
+                return record;
+            }
+        }
+    }
+    return NULL;
+}
