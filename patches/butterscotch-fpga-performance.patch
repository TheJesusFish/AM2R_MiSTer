+    if (discovery == nullptr || discovery->type != GML_LEGACY_ARRAY) return false;
+    int32_t rowCount = discovery->legacy.rowCount;
+    int32_t colCount = 0;
+    for (int32_t row = 0; row < rowCount; ++row) {
+        if (discovery->legacy.rows[row].length > colCount)
