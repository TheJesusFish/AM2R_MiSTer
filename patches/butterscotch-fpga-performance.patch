+static uint8x8x4_t neonBlendTintedPixels(uint8x8x4_t source,
+                                         uint8x8x4_t destination,
+                                         uint8_t tintAlpha) {
+    uint8x8_t sourceAlpha = tintAlpha == 255
+        ? source.val[3]
+        : neonMul255Round(source.val[3], vdup_n_u8(tintAlpha));
+    destination.val[0] = neonBlendChannel(source.val[0], destination.val[0],
+                                          sourceAlpha);
+    destination.val[1] = neonBlendChannel(source.val[1], destination.val[1],
+                                          sourceAlpha);
+    destination.val[2] = neonBlendChannel(source.val[2], destination.val[2],
+                                          sourceAlpha);
+    destination.val[3] = neonBlendAlpha(destination.val[3], sourceAlpha);
+    return destination;
+}
