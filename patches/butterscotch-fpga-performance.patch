+SWAm2rMapCacheMode SWRenderer_misterPrepareAm2rMapSurface(
+        Renderer* renderer, uint64_t topologyHash, uint64_t discoveryHash,
+        bool incrementalEligible) {
+    if (renderer == nullptr || !swIsAm2rMapTarget((SWRenderer*)renderer))
+        return SW_AM2R_MAP_CACHE_REBUILD;
+    SWRenderer* sw = (SWRenderer*)renderer;
+    bool reusable = sw->am2rMapSurfaceReused && sw->am2rMapSurfaceCacheValid &&
+                    sw->currentSurface == sw->am2rMapSurfaceId;
+    SWAm2rMapCacheMode mode = SW_AM2R_MAP_CACHE_REBUILD;
+    if (reusable && sw->am2rMapSurfaceTopologyHash == topologyHash) {
+        if (sw->am2rMapSurfaceDiscoveryHash == discoveryHash)
+            mode = SW_AM2R_MAP_CACHE_HIT;
+        else if (incrementalEligible)
+            mode = SW_AM2R_MAP_CACHE_INCREMENTAL;
+    }
+    if (sw->am2rMapSurfaceLogCount < 16) {
+        const char* modeName = mode == SW_AM2R_MAP_CACHE_HIT ? "hit" :
+                               (mode == SW_AM2R_MAP_CACHE_INCREMENTAL ?
+                                "incremental" : "rebuild");
+        logInfo("MiSTer AM2R map surface cache: %s id=%d topology=%08x%08x discovery=%08x%08x\n",
+                modeName, sw->currentSurface,
+                (uint32_t)(topologyHash >> 32), (uint32_t)topologyHash,
+                (uint32_t)(discoveryHash >> 32), (uint32_t)discoveryHash);
+        sw->am2rMapSurfaceLogCount++;
+    }
+    return mode;
+}
