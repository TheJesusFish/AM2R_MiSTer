+static uint8_t gpuMul255(uint8_t a, uint8_t b) {
+    uint32_t product = (uint32_t)a * b;
+    return (uint8_t)((product + 128u + ((product + 128u) >> 8)) >> 8);
+}
+
+static uint8_t gpuDiv255Floor(uint32_t value) {
+    return (uint8_t)((value + 1u + (value >> 8)) >> 8);
+}
+
+static uint32_t gpuApplyTint(uint32_t pixel, uint32_t tint) {
+    uint32_t result = 0;
+    for (uint32_t shift = 0; shift < 32; shift += 8) {
+        result |= (uint32_t)gpuMul255((uint8_t)(pixel >> shift),
+                                     (uint8_t)(tint >> shift)) << shift;
+    }
+    return result;
+}
+
+static uint32_t gpuAlphaBlend(uint32_t source, uint32_t destination) {
+    uint32_t sourceAlpha = source >> 24;
+    if (sourceAlpha == 0) return destination;
+    if (sourceAlpha == 255) return source;
+
+    uint32_t inverseAlpha = 255u - sourceAlpha;
+    uint32_t result = 0;
+    for (uint32_t shift = 0; shift < 24; shift += 8) {
+        uint32_t sourceChannel = (source >> shift) & 0xffu;
+        uint32_t destinationChannel = (destination >> shift) & 0xffu;
+        result |= (uint32_t)gpuDiv255Floor(sourceChannel * sourceAlpha +
+                                          destinationChannel * inverseAlpha) << shift;
+    }
+    result |= (sourceAlpha + gpuDiv255Floor((destination >> 24) * inverseAlpha)) << 24;
+    return result;
+}
+
+static int32_t gpuFixedFloor(int32_t value) {
+    if (value >= 0) return value / 65536;
+    return (int32_t)(-((-(int64_t)value + 65535) / 65536));
+}
