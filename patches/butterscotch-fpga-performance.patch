+
+static bool am2rMapCanIncremental(const VMContext* ctx,
+                                  const GMLArray* discovery,
+                                  int32_t rows, int32_t cols) {
+    if (ctx->am2rMapDiscoveryVisible == nullptr ||
+        ctx->am2rMapDiscoveryRows != rows ||
+        ctx->am2rMapDiscoveryCols != cols) return false;
+    bool added = false;
+    for (int32_t row = 0; row < rows; ++row) {
+        for (int32_t col = 0; col < cols; ++col) {
+            size_t index = (size_t)row * (size_t)cols + (size_t)col;
+            uint8_t before = ctx->am2rMapDiscoveryVisible[index];
+            uint8_t now = am2rMapDiscoveryAt(discovery, row, col);
+            if (before && !now) return false;
+            if (!before && now) added = true;
+        }
+    }
+    return added;
+}
