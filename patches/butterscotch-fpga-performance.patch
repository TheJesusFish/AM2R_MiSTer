+static bool compositeAxisCommand(uint32_t *destination,
+                                 const MisterGpuCommand *command,
+                                 const MisterGpuTexture *sourceRecord,
+                                 size_t sourceBaseOffset,
+                                 int32_t clipYStart,
+                                 int32_t clipYEnd) {
+    uint16_t width = (uint16_t)(command->word[0] >> 16);
+    uint16_t height = (uint16_t)(command->word[0] >> 32);
+    int16_t destinationX = (int16_t)command->word[2];
+    int16_t destinationY = (int16_t)(command->word[2] >> 16);
+    uint32_t sourceStride = (uint32_t)(command->word[1] >> 32);
+    int32_t uStart = (int32_t)command->word[4];
+    int32_t vStart = (int32_t)(command->word[4] >> 32);
+    int32_t uStep = (int32_t)command->word[5];
+    int32_t vStep = (int32_t)(command->word[5] >> 32);
+    uint32_t tint = (uint32_t)command->word[6];
+    const uint8_t *source = (const uint8_t *)sourceRecord->shadow;
+
+    if (uStep == 0x00010000 && vStep == 0x00010000) {
+        int32_t sourceX = gpuFixedFloor(uStart);
+        int32_t sourceY = gpuFixedFloor(vStart);
+        int32_t firstX = destinationX < 0 ? -destinationX : 0;
+        int32_t firstY = destinationY < 0 ? -destinationY : 0;
+        int32_t lastX = width;
+        int32_t lastY = height;
+        if (destinationX + lastX > MISTER_WIDTH) lastX = MISTER_WIDTH - destinationX;
+        if (destinationY + lastY > MISTER_HEIGHT) lastY = MISTER_HEIGHT - destinationY;
+        if (destinationY + firstY < clipYStart) firstY = clipYStart - destinationY;
+        if (destinationY + lastY > clipYEnd) lastY = clipYEnd - destinationY;
+        if (firstX >= lastX || firstY >= lastY) return true;
+
+        int32_t clippedSourceX = sourceX + firstX;
+        int32_t clippedSourceY = sourceY + firstY;
+        if (clippedSourceX < 0 || clippedSourceY < 0) return false;
+        size_t lastSourceOffset = sourceBaseOffset +
+            (size_t)(clippedSourceY + lastY - firstY - 1) * sourceStride +
+            (size_t)(clippedSourceX + lastX - firstX - 1) * sizeof(uint32_t);
+        if (lastSourceOffset > sourceRecord->bytes ||
+            sizeof(uint32_t) > sourceRecord->bytes - lastSourceOffset)
+            return false;
+
+        bool alphaOnlyTint = (tint & 0x00ffffffu) == 0x00ffffffu;
+        uint8_t tintAlpha = (uint8_t)(tint >> 24);
+        for (int32_t y = firstY; y < lastY; ++y) {
+            const uint32_t *sourcePixel = (const uint32_t *)(source + sourceBaseOffset +
+                (size_t)(sourceY + y) * sourceStride +
+                (size_t)(sourceX + firstX) * sizeof(uint32_t));
+            uint32_t *destinationPixel = destination +
+                (size_t)(destinationY + y) * MISTER_WIDTH + destinationX + firstX;
+            if (tint == 0xffffffffu) {
+                int32_t x = firstX;
+#if defined(__ARM_NEON)
+                for (; x + 8 <= lastX; x += 8) {
+                    uint32x4_t packed0 = vld1q_u32(sourcePixel);
+                    uint32x4_t packed1 = vld1q_u32(sourcePixel + 4);
+                    uint32x4_t alphaMask = vdupq_n_u32(0xff000000u);
+                    uint32_t alphaOr = neonReduceOrU32(
+                        vandq_u32(vorrq_u32(packed0, packed1), alphaMask));
+                    if (alphaOr == 0) {
+                        sourcePixel += 8;
+                        destinationPixel += 8;
+                        continue;
+                    }
+                    uint32_t alphaAnd = neonReduceAndU32(
+                        vandq_u32(vandq_u32(packed0, packed1), alphaMask));
+                    if (alphaAnd == 0xff000000u) {
+                        vst1q_u32(destinationPixel, packed0);
+                        vst1q_u32(destinationPixel + 4, packed1);
+                        sourcePixel += 8;
+                        destinationPixel += 8;
+                        continue;
+                    }
+                    uint8x8x4_t sourcePixels =
+                        vld4_u8((const uint8_t *)sourcePixel);
+                    uint8x8x4_t destinationPixels =
+                        vld4_u8((const uint8_t *)destinationPixel);
+                    uint8x8_t sourceAlpha = sourcePixels.val[3];
+                    uint8x8x4_t outputPixels;
+                    outputPixels.val[0] = neonBlendChannel(
+                        sourcePixels.val[0], destinationPixels.val[0], sourceAlpha);
+                    outputPixels.val[1] = neonBlendChannel(
+                        sourcePixels.val[1], destinationPixels.val[1], sourceAlpha);
+                    outputPixels.val[2] = neonBlendChannel(
+                        sourcePixels.val[2], destinationPixels.val[2], sourceAlpha);
+                    outputPixels.val[3] = neonBlendAlpha(
+                        destinationPixels.val[3], sourceAlpha);
+                    vst4_u8((uint8_t *)destinationPixel, outputPixels);
+                    sourcePixel += 8;
+                    destinationPixel += 8;
+                }
+#endif
+                for (; x < lastX; ++x) {
+                    uint32_t pixel = *sourcePixel++;
+                    *destinationPixel = gpuAlphaBlend(pixel, *destinationPixel);
+                    destinationPixel++;
+                }
+            } else if (alphaOnlyTint) {
+                int32_t x = firstX;
+#if defined(__ARM_NEON)
+                for (; x + 8 <= lastX; x += 8) {
+                    uint32x4_t packed0 = vld1q_u32(sourcePixel);
+                    uint32x4_t packed1 = vld1q_u32(sourcePixel + 4);
+                    uint32x4_t alphaMask = vdupq_n_u32(0xff000000u);
+                    uint32_t alphaOr = neonReduceOrU32(
+                        vandq_u32(vorrq_u32(packed0, packed1), alphaMask));
+                    if (alphaOr == 0) {
+                        sourcePixel += 8;
+                        destinationPixel += 8;
