+    }
+    return hash;
+}
+
+static uint64_t am2rMapHashRValue(uint64_t hash, const RValue* value, int depth);
+
+static uint64_t am2rMapHashArray(uint64_t hash, const GMLArray* array, int depth) {
+    if (array == nullptr || depth > 4) {
+        uint8_t marker = 0xff;
+        return am2rMapHashBytes(hash, &marker, sizeof(marker));
+    }
+    hash = am2rMapHashBytes(hash, &array->type, sizeof(array->type));
+    if (array->type == GML_LEGACY_ARRAY) {
+        hash = am2rMapHashBytes(hash, &array->legacy.rowCount,
+                               sizeof(array->legacy.rowCount));
+        for (int32_t rowIndex = 0; rowIndex < array->legacy.rowCount; ++rowIndex) {
+            const GMLArrayRow* row = &array->legacy.rows[rowIndex];
+            hash = am2rMapHashBytes(hash, &row->length, sizeof(row->length));
+            for (int32_t col = 0; col < row->length; ++col)
+                hash = am2rMapHashRValue(hash, &row->data[col], depth + 1);
+        }
+    } else {
+        hash = am2rMapHashBytes(hash, &array->modern.length,
+                               sizeof(array->modern.length));
+        for (int32_t index = 0; index < array->modern.length; ++index)
+            hash = am2rMapHashRValue(hash, &array->modern.data[index], depth + 1);
+    }
+    return hash;
+}
+
+static uint64_t am2rMapHashRValue(uint64_t hash, const RValue* value, int depth) {
+    hash = am2rMapHashBytes(hash, &value->type, sizeof(value->type));
+    switch (value->type) {
+        case RVALUE_STRING:
+            if (value->string != nullptr)
+                hash = am2rMapHashBytes(hash, value->string, strlen(value->string) + 1u);
+            break;
+        case RVALUE_INT32:
+        case RVALUE_BOOL:
+            hash = am2rMapHashBytes(hash, &value->int32, sizeof(value->int32));
+            break;
+#ifndef NO_RVALUE_INT64
+        case RVALUE_INT64:
+            hash = am2rMapHashBytes(hash, &value->int64, sizeof(value->int64));
+            break;
+#endif
+        case RVALUE_REAL:
+            hash = am2rMapHashBytes(hash, &value->real, sizeof(value->real));
+            break;
+        case RVALUE_ARRAY:
+            hash = am2rMapHashArray(hash, value->array, depth);
+            break;
