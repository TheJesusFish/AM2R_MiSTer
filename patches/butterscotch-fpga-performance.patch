+                    uint32_t alphaAnd = neonReduceAndU32(
+                        vandq_u32(vandq_u32(packed0, packed1), alphaMask));
+                    if (alphaAnd == 0xff000000u) {
+                        uint32x4_t destination0 = vld1q_u32(destinationPixel);
+                        uint32x4_t destination1 = vld1q_u32(destinationPixel + 4);
+                        uint32x4_t output0 = vreinterpretq_u32_u8(
+                            neonBlendConstantAlphaPacked(
+                                vreinterpretq_u8_u32(packed0),
+                                vreinterpretq_u8_u32(destination0), tintAlpha));
+                        uint32x4_t output1 = vreinterpretq_u32_u8(
+                            neonBlendConstantAlphaPacked(
+                                vreinterpretq_u8_u32(packed1),
+                                vreinterpretq_u8_u32(destination1), tintAlpha));
+                        uint32x4_t rgbMask = vdupq_n_u32(0x00ffffffu);
+                        uint32x4_t opaque = vdupq_n_u32(0xff000000u);
+                        vst1q_u32(destinationPixel,
+                                  vorrq_u32(vandq_u32(output0, rgbMask), opaque));
+                        vst1q_u32(destinationPixel + 4,
+                                  vorrq_u32(vandq_u32(output1, rgbMask), opaque));
+                        sourcePixel += 8;
+                        destinationPixel += 8;
+                        continue;
+                    }
+                    uint8x8x4_t sourcePixels =
+                        vld4_u8((const uint8_t *)sourcePixel);
+                    uint8x8x4_t destinationPixels =
+                        vld4_u8((const uint8_t *)destinationPixel);
+                    uint8x8_t sourceAlpha = neonMul255Round(
+                        sourcePixels.val[3], vdup_n_u8(tintAlpha));
+                    uint8x8x4_t outputPixels;
+                    outputPixels.val[0] = neonBlendChannel(
+                        sourcePixels.val[0], destinationPixels.val[0], sourceAlpha);
+                    outputPixels.val[1] = neonBlendChannel(
+                        sourcePixels.val[1], destinationPixels.val[1], sourceAlpha);
+                    outputPixels.val[2] = neonBlendChannel(
+                        sourcePixels.val[2], destinationPixels.val[2], sourceAlpha);
+                    outputPixels.val[3] = neonBlendAlpha(
+                        destinationPixels.val[3], sourceAlpha);
+                    vst4_u8((uint8_t *)destinationPixel, outputPixels);
+                    sourcePixel += 8;
+                    destinationPixel += 8;
+                }
+#endif
+                for (; x < lastX; ++x) {
+                    uint32_t pixel = *sourcePixel++;
+                    uint32_t alpha = gpuMul255((uint8_t)(pixel >> 24), tintAlpha);
+                    pixel = (pixel & 0x00ffffffu) | (alpha << 24);
+                    *destinationPixel = gpuAlphaBlend(pixel, *destinationPixel);
+                    destinationPixel++;
+                }
+            } else {
+                for (int32_t x = firstX; x < lastX; ++x) {
+                    uint32_t pixel = gpuApplyTint(*sourcePixel++, tint);
+                    *destinationPixel = gpuAlphaBlend(pixel, *destinationPixel);
+                    destinationPixel++;
+                }
+            }
+        }
+        return true;
+    }
+
+    for (uint32_t y = 0; y < height; ++y) {
+        int32_t outputY = destinationY + (int32_t)y;
+        uint32_t vBits = (uint32_t)vStart + (uint32_t)((uint64_t)(uint32_t)vStep * y);
+        int32_t sourceY = gpuFixedFloor((int32_t)vBits);
+        if (outputY < clipYStart || outputY >= clipYEnd) continue;
+        if (sourceY < 0) return false;
+
+        for (uint32_t x = 0; x < width; ++x) {
+            int32_t outputX = destinationX + (int32_t)x;
+            if (outputX < 0 || outputX >= MISTER_WIDTH) continue;
+            uint32_t uBits = (uint32_t)uStart + (uint32_t)((uint64_t)(uint32_t)uStep * x);
+            int32_t sourceX = gpuFixedFloor((int32_t)uBits);
+            if (sourceX < 0) return false;
+            size_t sourceOffset = sourceBaseOffset + (size_t)sourceY * sourceStride +
+                                  (size_t)sourceX * sizeof(uint32_t);
+            if (sourceOffset > sourceRecord->bytes ||
+                sizeof(uint32_t) > sourceRecord->bytes - sourceOffset)
+                return false;
+
+            uint32_t pixel;
+            memcpy(&pixel, source + sourceOffset, sizeof(pixel));
+            if (tint != 0xffffffffu) pixel = gpuApplyTint(pixel, tint);
+            size_t destinationOffset = (size_t)outputY * MISTER_WIDTH + outputX;
+            destination[destinationOffset] = gpuAlphaBlend(pixel, destination[destinationOffset]);
+        }
+    }
+    return true;
+}
+
+static void compositeFillCommand(uint32_t *destination,
+                                 const MisterGpuCommand *command,
+                                 int32_t clipYStart,
+                                 int32_t clipYEnd) {
+    uint16_t width = (uint16_t)(command->word[0] >> 16);
+    uint16_t height = (uint16_t)(command->word[0] >> 32);
+    int16_t destinationX = (int16_t)command->word[2];
+    int16_t destinationY = (int16_t)(command->word[2] >> 16);
+    uint32_t color = (uint32_t)command->word[1];
+    if (destinationX == 0 && destinationY == 0 &&
+        width == MISTER_WIDTH && height == MISTER_HEIGHT && color == 0xcc000000u) {
+        size_t i = (size_t)clipYStart * MISTER_WIDTH;
+        size_t last = (size_t)clipYEnd * MISTER_WIDTH;
+#if defined(__ARM_NEON)
+        for (; i + 8 <= last; i += 8) {
+            uint8x8x4_t pixels = vld4_u8((const uint8_t *)(destination + i));
+            pixels.val[0] = neonScaleFloor255(pixels.val[0], 51);
+            pixels.val[1] = neonScaleFloor255(pixels.val[1], 51);
+            pixels.val[2] = neonScaleFloor255(pixels.val[2], 51);
+            pixels.val[3] = vdup_n_u8(255);
+            vst4_u8((uint8_t *)(destination + i), pixels);
+        }
+#endif
+        for (; i < last; ++i) {
+            uint32_t pixel = destination[i];
+            uint32_t r = gpuDiv255Floor((pixel & 0xffu) * 51u);
+            uint32_t g = gpuDiv255Floor(((pixel >> 8) & 0xffu) * 51u);
+            uint32_t b = gpuDiv255Floor(((pixel >> 16) & 0xffu) * 51u);
+            destination[i] = r | (g << 8) | (b << 16) | 0xff000000u;
+        }
+        return;
+    }
+    for (uint32_t y = 0; y < height; ++y) {
+        int32_t outputY = destinationY + (int32_t)y;
+        if (outputY < clipYStart || outputY >= clipYEnd) continue;
+        for (uint32_t x = 0; x < width; ++x) {
+            int32_t outputX = destinationX + (int32_t)x;
+            if (outputX < 0 || outputX >= MISTER_WIDTH) continue;
+            size_t offset = (size_t)outputY * MISTER_WIDTH + outputX;
+            destination[offset] = gpuAlphaBlend(color, destination[offset]);
+        }
+    }
+}
+
+typedef struct {
+    uint32_t *destination;
+    const MisterGpuCommand *commands;
+    uint32_t commandCount;
+    const MisterGpuTexture *sourceRecord;
+    size_t sourceBaseOffset;
+    const MisterGpuCommand *fill;
+    int32_t clipYStart;
+    int32_t clipYEnd;
+    bool success;
+} MapCompositeBatch;
+
+static void *compositeMapBatch(void *opaque) {
+    MapCompositeBatch *batch = (MapCompositeBatch *)opaque;
+    batch->success = true;
+    for (uint32_t i = 0; i < batch->commandCount; ++i) {
+        if (!compositeAxisCommand(batch->destination, &batch->commands[i],
+                                  batch->sourceRecord, batch->sourceBaseOffset,
+                                  batch->clipYStart, batch->clipYEnd)) {
+            batch->success = false;
+            return NULL;
+        }
+    }
+    if (batch->fill != NULL)
+        compositeFillCommand(batch->destination, batch->fill,
+                             batch->clipYStart, batch->clipYEnd);
+    return NULL;
+}
+
+static bool compositeMapParallel(uint32_t *destination,
+                                 const MisterGpuCommand *commands,
+                                 uint32_t commandCount,
+                                 const MisterGpuTexture *sourceRecord,
+                                 size_t sourceBaseOffset,
+                                 const MisterGpuCommand *fill) {
+    MapCompositeBatch top = {
+        destination, commands, commandCount, sourceRecord, sourceBaseOffset,
+        fill, 0, MISTER_HEIGHT / 2, false
+    };
+    MapCompositeBatch bottom = {
+        destination, commands, commandCount, sourceRecord, sourceBaseOffset,
+        fill, MISTER_HEIGHT / 2, MISTER_HEIGHT, false
+    };
+    pthread_t worker;
+    int created = pthread_create(&worker, NULL, compositeMapBatch, &top);
+    if (created != 0) compositeMapBatch(&top);
+    compositeMapBatch(&bottom);
+    if (created == 0 && pthread_join(worker, NULL) != 0) return false;
+    return top.success && bottom.success;
+}
+
+static bool mapTransitionPatternMatches(const MisterGpuCommand *commands,
+                                        uint32_t blitCount,
+                                        const MisterGpuCommand *fill,
+                                        const MisterGpuCommand *overlays,
+                                        uint32_t overlayCount) {
+    if (blitCount != 5 || overlayCount != 4 ||
+        (uint32_t)fill->word[1] != 0xcc000000u)
+        return false;
+
+    const MisterGpuCommand *base = &commands[0];
+    int32_t baseU = (int32_t)base->word[4];
+    int32_t baseV = (int32_t)(base->word[4] >> 32);
+    if ((uint16_t)(base->word[0] >> 16) != MISTER_WIDTH ||
+        (uint16_t)(base->word[0] >> 32) != MISTER_HEIGHT ||
+        (uint32_t)base->word[2] != 0 ||
+        (uint32_t)base->word[5] != 0x00010000u ||
+        (uint32_t)(base->word[5] >> 32) != 0x00010000u ||
+        (uint32_t)base->word[6] != 0xffffffffu)
+        return false;
+
+    const uint16_t widths[4] = {319, 319, 318, 318};
+    const int16_t xs[4] = {1, 0, 2, 0};
+    const int32_t us[4] = {baseU, baseU + 0x10000,
+                           baseU, baseU + 0x20000};
+    for (uint32_t i = 0; i < 4; ++i) {
+        const MisterGpuCommand *command = &commands[1 + i];
+        if ((uint16_t)(command->word[0] >> 16) != widths[i] ||
+            (uint16_t)(command->word[0] >> 32) != MISTER_HEIGHT ||
+            (int16_t)command->word[2] != xs[i] ||
+            (int16_t)(command->word[2] >> 16) != 0 ||
+            (int32_t)command->word[4] != us[i] ||
+            (int32_t)(command->word[4] >> 32) != baseV ||
+            (uint32_t)command->word[5] != 0x00010000u ||
+            (uint32_t)(command->word[5] >> 32) != 0x00010000u ||
+            ((uint32_t)command->word[6] & 0x00ffffffu) != 0x00ffffffu)
+            return false;
+    }
+    if ((uint8_t)(commands[1].word[6] >> 24) !=
+            (uint8_t)(commands[2].word[6] >> 24) ||
+        (uint8_t)(commands[3].word[6] >> 24) !=
+            (uint8_t)(commands[4].word[6] >> 24))
+        return false;
+
+    const int16_t overlayX[4] = {0, MISTER_WIDTH / 2, 0, MISTER_WIDTH / 2};
+    const int16_t overlayY[4] = {0, 0, MISTER_HEIGHT / 2, MISTER_HEIGHT / 2};
+    const int32_t overlayDu[4] = {0x00010000, -0x00010000,
+                                  0x00010000, -0x00010000};
+    const int32_t overlayDv[4] = {0x00010000, 0x00010000,
+                                  -0x00010000, -0x00010000};
+    uint8_t overlayAlpha = (uint8_t)(overlays[0].word[6] >> 24);
+    for (uint32_t i = 0; i < 4; ++i) {
+        if ((uint16_t)(overlays[i].word[0] >> 16) != MISTER_WIDTH / 2 ||
+            (uint16_t)(overlays[i].word[0] >> 32) != MISTER_HEIGHT / 2 ||
+            (int16_t)overlays[i].word[2] != overlayX[i] ||
+            (int16_t)(overlays[i].word[2] >> 16) != overlayY[i] ||
+            (int32_t)overlays[i].word[5] != overlayDu[i] ||
+            (int32_t)(overlays[i].word[5] >> 32) != overlayDv[i] ||
+            ((uint32_t)overlays[i].word[6] & 0x00ffffffu) != 0x00ffffffu ||
+            (uint8_t)(overlays[i].word[6] >> 24) != overlayAlpha)
+            return false;
+    }
+    return true;
+}
+
+static bool prepareMapBaseRegion(const MisterGpuCommand *base,
+                                 const MisterGpuTexture *record,
+                                 size_t baseOffset) {
+    if (g_gpu_map_base_cache_valid &&
+        g_gpu_map_base_cache_record == record &&
+        g_gpu_map_base_cache_generation == record->generation &&
+        memcmp(&g_gpu_map_base_geometry, base, sizeof(*base)) == 0)
+        return true;
+
+    int32_t sourceX = gpuFixedFloor((int32_t)base->word[4]);
+    int32_t sourceY = gpuFixedFloor((int32_t)(base->word[4] >> 32));
+    uint32_t stride = (uint32_t)(base->word[1] >> 32);
+    bool valid = sourceX >= 0 && sourceY >= 0;
+    bool opaque = true;
+    for (int32_t y = 0; valid && y < MISTER_HEIGHT; ++y) {
+        size_t rowOffset = baseOffset + (size_t)(sourceY + y) * stride +
+                           (size_t)sourceX * sizeof(uint32_t);
+        if (rowOffset > record->bytes ||
+            (size_t)MISTER_WIDTH * sizeof(uint32_t) > record->bytes - rowOffset) {
+            valid = false;
+            break;
+        }
+        const uint32_t *row = (const uint32_t *)((const uint8_t *)record->shadow +
+                                                 rowOffset);
+        for (int32_t x = 0; x < MISTER_WIDTH; ++x) {
+            if ((row[x] >> 24) != 255u) {
+                opaque = false;
+            }
+        }
+    }
+    g_gpu_map_base_geometry = *base;
+    g_gpu_map_base_cache_record = record;
+    g_gpu_map_base_cache_generation = record->generation;
+    g_gpu_map_base_cache_opaque = opaque;
+    g_gpu_map_base_cache_valid = valid;
+    return valid;
+}
+
+static bool prepareMapOverlayPixels(const MisterGpuCommand *overlays,
+                                    const MisterGpuTexture *record,
+                                    size_t baseOffset) {
+    MisterGpuCommand geometry[4];
+    memcpy(geometry, overlays, sizeof(geometry));
+    for (uint32_t i = 0; i < 4; ++i) geometry[i].word[6] = 0xffffffffu;
+    if (g_gpu_map_overlay_cache_valid &&
+        g_gpu_map_overlay_cache_record == record &&
+        g_gpu_map_overlay_cache_generation == record->generation &&
+        memcmp(g_gpu_map_overlay_geometry, geometry, sizeof(geometry)) == 0)
+        return true;
+
+    if (g_gpu_map_overlay_pixels == NULL)
+        g_gpu_map_overlay_pixels = (uint32_t *)malloc(MISTER_FB_BYTES);
+    if (g_gpu_map_overlay_pixels == NULL) return false;
+
+    bool valid = true;
+    bool opaque = true;
+    for (uint32_t i = 0; i < 4 && valid; ++i) {
+        const MisterGpuCommand *command = &overlays[i];
+        uint16_t width = (uint16_t)(command->word[0] >> 16);
+        uint16_t height = (uint16_t)(command->word[0] >> 32);
+        int16_t destinationX = (int16_t)command->word[2];
+        int16_t destinationY = (int16_t)(command->word[2] >> 16);
+        int32_t uStart = (int32_t)command->word[4];
+        int32_t vStart = (int32_t)(command->word[4] >> 32);
+        int32_t uStep = (int32_t)command->word[5];
+        int32_t vStep = (int32_t)(command->word[5] >> 32);
+        uint32_t stride = (uint32_t)(command->word[1] >> 32);
+        for (uint32_t y = 0; y < height && valid; ++y) {
+            int32_t sourceY = gpuFixedFloor((int32_t)((int64_t)vStart +
+                                                       (int64_t)vStep * y));
+            for (uint32_t x = 0; x < width; ++x) {
+                int32_t sourceX = gpuFixedFloor((int32_t)((int64_t)uStart +
+                                                           (int64_t)uStep * x));
+                if (sourceX < 0 || sourceY < 0) {
+                    valid = false;
+                    break;
+                }
+                size_t sourceOffset = baseOffset + (size_t)sourceY * stride +
+                                      (size_t)sourceX * sizeof(uint32_t);
+                if (sourceOffset > record->bytes ||
+                    sizeof(uint32_t) > record->bytes - sourceOffset) {
+                    valid = false;
+                    break;
+                }
+                uint32_t pixel;
+                memcpy(&pixel, (const uint8_t *)record->shadow + sourceOffset,
+                       sizeof(pixel));
+                if ((pixel >> 24) != 255u) {
+                    opaque = false;
+                }
+                g_gpu_map_overlay_pixels[
+                    (size_t)(destinationY + y) * MISTER_WIDTH + destinationX + x] = pixel;
+            }
+        }
+    }
+
+    memcpy(g_gpu_map_overlay_geometry, geometry, sizeof(geometry));
+    g_gpu_map_overlay_cache_record = record;
+    g_gpu_map_overlay_cache_generation = record->generation;
+    g_gpu_map_overlay_cache_opaque = opaque;
+    g_gpu_map_overlay_cache_valid = valid;
+    return valid;
+}
+
+typedef struct {
+    uint32_t *destination;
+    const uint8_t *basePixels;
+    uint32_t baseStride;
+    const uint32_t *overlayPixels;
+    uint8_t ghostAlpha1;
+    uint8_t ghostAlpha2;
+    uint8_t overlayAlpha;
+    uint32_t clearColor;
+    int32_t clipYStart;
+    int32_t clipYEnd;
+} MapTransitionBatch;
+
+static uint32_t blendTintedPixel(uint32_t source, uint32_t destination,
+                                 uint8_t tintAlpha) {
+    uint32_t alpha = gpuMul255((uint8_t)(source >> 24), tintAlpha);
+    return gpuAlphaBlend((source & 0x00ffffffu) | (alpha << 24), destination);
+}
+
+static void *compositeMapTransitionBatch(void *opaque) {
+    MapTransitionBatch *batch = (MapTransitionBatch *)opaque;
+    for (int32_t y = batch->clipYStart; y < batch->clipYEnd; ++y) {
+        const uint32_t *base = (const uint32_t *)(batch->basePixels +
+                                                  (size_t)y * batch->baseStride);
+        const uint32_t *overlay = batch->overlayPixels + (size_t)y * MISTER_WIDTH;
+        uint32_t *destination = batch->destination + (size_t)y * MISTER_WIDTH;
+        int32_t x = 0;
+        for (; x < 2; ++x) {
+            uint32_t pixel = blendTintedPixel(base[x], batch->clearColor, 255);
+            if (x >= 1) pixel = blendTintedPixel(base[x - 1], pixel,
+                                                 batch->ghostAlpha1);
+            pixel = blendTintedPixel(base[x + 1], pixel, batch->ghostAlpha1);
+            if (x >= 2) pixel = blendTintedPixel(base[x - 2], pixel,
+                                                 batch->ghostAlpha2);
+            pixel = blendTintedPixel(base[x + 2], pixel, batch->ghostAlpha2);
+            pixel = gpuAlphaBlend(0xcc000000u, pixel);
+            destination[x] = blendTintedPixel(overlay[x], pixel,
+                                              batch->overlayAlpha);
+        }
+#if defined(__ARM_NEON)
+        for (; x + 8 <= MISTER_WIDTH - 2; x += 8) {
+            uint8x8x4_t pixel;
+            pixel.val[0] = vdup_n_u8((uint8_t)batch->clearColor);
+            pixel.val[1] = vdup_n_u8((uint8_t)(batch->clearColor >> 8));
+            pixel.val[2] = vdup_n_u8((uint8_t)(batch->clearColor >> 16));
+            pixel.val[3] = vdup_n_u8((uint8_t)(batch->clearColor >> 24));
+            pixel = neonBlendTintedPixels(
+                vld4_u8((const uint8_t *)(base + x)), pixel, 255);
+            pixel = neonBlendTintedPixels(
+                vld4_u8((const uint8_t *)(base + x - 1)), pixel,
+                batch->ghostAlpha1);
+            pixel = neonBlendTintedPixels(
+                vld4_u8((const uint8_t *)(base + x + 1)), pixel,
+                batch->ghostAlpha1);
+            pixel = neonBlendTintedPixels(
+                vld4_u8((const uint8_t *)(base + x - 2)), pixel,
+                batch->ghostAlpha2);
+            pixel = neonBlendTintedPixels(
+                vld4_u8((const uint8_t *)(base + x + 2)), pixel,
+                batch->ghostAlpha2);
+            uint8x8_t fillAlpha = vdup_n_u8(204);
+            uint8x8_t black = vdup_n_u8(0);
+            pixel.val[0] = neonBlendChannel(black, pixel.val[0], fillAlpha);
+            pixel.val[1] = neonBlendChannel(black, pixel.val[1], fillAlpha);
+            pixel.val[2] = neonBlendChannel(black, pixel.val[2], fillAlpha);
+            pixel.val[3] = neonBlendAlpha(pixel.val[3], fillAlpha);
+            pixel = neonBlendTintedPixels(
+                vld4_u8((const uint8_t *)(overlay + x)), pixel,
+                batch->overlayAlpha);
+            vst4_u8((uint8_t *)(destination + x), pixel);
+        }
+#endif
+        for (; x < MISTER_WIDTH; ++x) {
+            uint32_t pixel = blendTintedPixel(base[x], batch->clearColor, 255);
+            if (x >= 1) pixel = blendTintedPixel(base[x - 1], pixel,
+                                                 batch->ghostAlpha1);
+            if (x + 1 < MISTER_WIDTH)
+                pixel = blendTintedPixel(base[x + 1], pixel,
+                                         batch->ghostAlpha1);
+            if (x >= 2) pixel = blendTintedPixel(base[x - 2], pixel,
+                                                 batch->ghostAlpha2);
+            if (x + 2 < MISTER_WIDTH)
+                pixel = blendTintedPixel(base[x + 2], pixel,
+                                         batch->ghostAlpha2);
+            pixel = gpuAlphaBlend(0xcc000000u, pixel);
+            destination[x] = blendTintedPixel(overlay[x], pixel,
+                                              batch->overlayAlpha);
+        }
+    }
+    return NULL;
+}
+
+static bool compositeMapTransitionParallel(uint32_t *destination,
+                                           const uint8_t *basePixels,
+                                           uint32_t baseStride,
+                                           uint8_t ghostAlpha1,
+                                           uint8_t ghostAlpha2,
+                                           uint8_t overlayAlpha,
+                                           uint32_t clearColor) {
+    MapTransitionBatch top = {
+        destination, basePixels, baseStride, g_gpu_map_overlay_pixels,
+        ghostAlpha1, ghostAlpha2, overlayAlpha, clearColor,
+        0, MISTER_HEIGHT / 2
+    };
+    MapTransitionBatch bottom = {
+        destination, basePixels, baseStride, g_gpu_map_overlay_pixels,
+        ghostAlpha1, ghostAlpha2, overlayAlpha, clearColor,
+        MISTER_HEIGHT / 2, MISTER_HEIGHT
+    };
+    pthread_t worker;
+    int created = pthread_create(&worker, NULL, compositeMapTransitionBatch, &top);
+    if (created != 0) compositeMapTransitionBatch(&top);
+    compositeMapTransitionBatch(&bottom);
+    return created != 0 || pthread_join(worker, NULL) == 0;
+}
+
+static void replaceMapPrefixWithFused(uint32_t tailIndex,
+                                      uint32_t removedCommandCount) {
+    MisterGpuCommand fused;
+    memset(&fused, 0, sizeof(fused));
+    fused.word[0] = 2u | ((uint64_t)MISTER_WIDTH << 16) |
+                    ((uint64_t)MISTER_HEIGHT << 32);
+    fused.word[1] = g_gpu_fused_physical | ((uint64_t)(MISTER_WIDTH * 4u) << 32);
+    fused.word[5] = 0x00010000u | ((uint64_t)0x00010000u << 32);
+    fused.word[6] = 0xffffffffu;
+    g_gpu_commands[1] = fused;
+    memmove(&g_gpu_commands[2], &g_gpu_commands[tailIndex],
+            (g_gpu_command_count - tailIndex) * sizeof(MisterGpuCommand));
+    g_gpu_command_count -= removedCommandCount;
+}
+
+static bool tryFuseMapBackground(void) {
+    if (g_gpu_command_count < 6 || (g_gpu_commands[0].word[0] & 0x1ffu) != 1u)
+        return false;
+
+    uint32_t sourcePhysical = (uint32_t)g_gpu_commands[1].word[1];
+    uint32_t sourceStride = (uint32_t)(g_gpu_commands[1].word[1] >> 32);
