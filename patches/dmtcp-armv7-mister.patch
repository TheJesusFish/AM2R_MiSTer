diff --git a/include/dmtcpalloc.h b/include/dmtcpalloc.h
index 58e3332..baa8d0a 100644
--- a/include/dmtcpalloc.h
+++ b/include/dmtcpalloc.h
@@ -262,7 +262,20 @@ struct std::hash<dmtcp::string>
 {
     std::size_t operator()(dmtcp::string const& s) const noexcept
     {
-        return std::_Hash_impl::hash(s.data(), s.length());
+        // libc++ does not expose libstdc++'s private _Hash_impl.  Use the
+        // allocation-free FNV-1a hash so the checkpoint runtime stays
+        // independent of either standard library's internals.
+        std::size_t hash = sizeof(std::size_t) == 8
+                         ? static_cast<std::size_t>(1469598103934665603ULL)
+                         : static_cast<std::size_t>(2166136261U);
+        const std::size_t prime = sizeof(std::size_t) == 8
+                                ? static_cast<std::size_t>(1099511628211ULL)
+                                : static_cast<std::size_t>(16777619U);
+        for (char c : s) {
+            hash ^= static_cast<unsigned char>(c);
+            hash *= prime;
+        }
+        return hash;
     }
 };
 
diff --git a/jalib/jalloc.cpp b/jalib/jalloc.cpp
index 8ae86f1..987a67a 100644
--- a/jalib/jalloc.cpp
+++ b/jalib/jalloc.cpp
@@ -186,16 +186,19 @@ bool_atomic_dwcas(void volatile *dst, void *oldValue, void *newValue)
       futex_wait(&atomic_compare_futex, 1); // Wait if futex is 1
     }
   }
-  // 16-byte object is the same as a 128-bit object
+  // StackHead is two machine words: 16 bytes on 64-bit targets and 8 bytes
+  // on ARM32.  The original fixed 16-byte copy overwrote the allocator's
+  // adjacent fields on 32-bit targets.
+  const size_t atomicWidth = 2 * sizeof(void *);
   // This is slower, and might affect codes with _very_ frequent
   //   DMTCP-internal operations (e.g., thread create/destroy).
   //   See: https://en.wikipedia.org/wiki/ABA_problem
   //   for other workarounds, but if a CPU truly is missing dwcas
   //   assembly instructions, then maybe it's not yet widely used, and
   //   a future version of the CPU architecture will support dwcas.
-  if (memcmp((void *)dst, oldValue, 16) == 0) {
+  if (memcmp((void *)dst, oldValue, atomicWidth) == 0) {
     result = true;
-    memcpy((void *)dst, newValue, 16);
+    memcpy((void *)dst, newValue, atomicWidth);
   } else {
     result = false;
   }
