@@ -75,6 +75,23 @@ typedef double GMLReal;
 // While the original runner uses "llrint(double)", we use our own banker's rounding implementation to avoid quirks in specific platforms (like the PlayStation 2) having different llrint rounding implementations.
 static inline GMLReal GMLReal_bankersRound(GMLReal v) {
     if (isnan(v) || isinf(v)) return v;
+
+    // Instance coordinates and collision bounds overwhelmingly fit in a
+    // signed 32-bit integer.  Converting those values toward zero is a single
+    // VFP operation on MiSTer, whereas floor() enters libm.  Handle positive
+    // and negative fractions explicitly so this remains exact round-to-even,
+    // including negative half-way values.  Keep the original implementation
+    // as the range-safe fallback for unusually large script values.
+    if (v >= (GMLReal)INT32_MIN && v <= (GMLReal)INT32_MAX) {
+        int32_t integer = (int32_t)v;
+        GMLReal fraction = v - (GMLReal)integer;
+        if (fraction > 0.5) return (GMLReal)(integer + 1);
+        if (fraction < -0.5) return (GMLReal)(integer - 1);
+        if (fraction == 0.5) return (GMLReal)((integer & 1) ? integer + 1 : integer);
+        if (fraction == -0.5) return (GMLReal)((integer & 1) ? integer - 1 : integer);
+        return (GMLReal)integer;
+    }
+
     GMLReal f = GMLReal_floor(v);
     GMLReal frac = v - f;
     if (0.5 > frac) return f;
