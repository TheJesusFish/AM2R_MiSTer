+bool Runner_beginFastStateRestore(Runner* runner, int32_t roomIndex) {
+    if (runner == nullptr || roomIndex < 0 ||
+        (uint32_t)roomIndex >= runner->dataWin->room.count)
+        return false;
+
+    // Runner_reset is the single audited owner of all VM/game heap teardown.
+    // It leaves immutable parsed resources, input endpoints, the renderer, and
+    // the audio backend allocated, which are exactly the process-local pieces
+    // a logical state must retain.
+    Runner_reset(runner);
+
+    // A logical restore can happen after the player visited and mutated rooms
+    // which had not yet been touched when the snapshot was taken. Reset every
+    // loaded room to its immutable authored tile list first; the serialized
+    // current/persistent-room state is applied on top below.
+    repeat(runner->dataWin->room.count, i) {
+        Room* loadedRoom = &runner->dataWin->room.rooms[i];
+        if (!loadedRoom->payloadLoaded) continue;
+        replaceRoomTiles(loadedRoom, loadedRoom->initialTiles,
+                         loadedRoom->initialTileCount);
+    }
+
+    Room* room = &runner->dataWin->room.rooms[roomIndex];
+    if (!room->payloadLoaded) DataWin_loadRoomPayload(runner->dataWin, roomIndex);
+    runner->currentRoom = room;
+    runner->currentRoomIndex = roomIndex;
+    runner->currentRoomOrderPosition = -1;
+    repeat(runner->dataWin->gen8.roomOrderCount, i) {
+        if (runner->dataWin->gen8.roomOrder[i] == roomIndex) {
+            runner->currentRoomOrderPosition = (int32_t)i;
+            break;
+        }
+    }
+    runner->viewsEnabled = (room->flags & 1) != 0;
+    if (runner->spatialGrid != nullptr) SpatialGrid_free(runner->spatialGrid);
+    runner->spatialGrid = SpatialGrid_create(room->width, room->height);
+    runner->pendingRoom = -1;
+    return true;
+}
+
+Instance* Runner_createFastStateInstance(Runner* runner, uint32_t instanceId,
+                                         int32_t objectIndex, bool currentRoom) {
+    if (runner == nullptr || objectIndex < 0 ||
+        (uint32_t)objectIndex >= runner->dataWin->objt.count ||
+        hmget(runner->instancesById, instanceId) != nullptr)
+        return nullptr;
+    Instance* instance = Instance_create(instanceId, objectIndex, 0.0, 0.0);
+    hmput(runner->instancesById, instanceId, instance);
+    if (currentRoom) arrput(runner->instances, instance);
+    if (runner->nextInstanceId <= instanceId) runner->nextInstanceId = instanceId + 1;
+    return instance;
+}
+
+void Runner_finishFastStateRestore(Runner* runner) {
+    if (runner == nullptr || runner->currentRoom == nullptr) return;
+    Runner_clearAllObjectLists(runner);
+    runner->nextObjectListOrder = 0;
+    if (runner->spatialGrid != nullptr) SpatialGrid_free(runner->spatialGrid);
+    runner->spatialGrid = SpatialGrid_create(runner->currentRoom->width,
+                                             runner->currentRoom->height);
+    repeat((int32_t)arrlen(runner->instances), i) {
+        Instance* instance = runner->instances[i];
+        instance->spatialGridDirty = false;
+        arrfree(instance->collisionCells);
+        instance->collisionCells = nullptr;
+        instance->collisionGridBBoxValid = false;
+        Runner_addInstanceToObjectLists(runner, instance);
+    }
+    SpatialGrid_syncGrid(runner, runner->spatialGrid);
+    arrsetlen(runner->cachedDrawables, 0);
+    runner->drawableListStructureDirty = true;
+    runner->drawableListSortDirty = false;
+    runner->drawableListCursorDirty = false;
+    runner->vmContext->currentInstance = nullptr;
+    runner->vmContext->otherInstance = nullptr;
+}
+
