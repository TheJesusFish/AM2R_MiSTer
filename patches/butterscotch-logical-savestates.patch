+} FastRunnerFields;
+
+static uint32_t crc32Bytes(const uint8_t* bytes, size_t length) {
+    uint32_t crc = 0xffffffffu;
+    for (size_t i = 0; i < length; ++i) {
+        crc ^= bytes[i];
+        for (int bit = 0; bit < 8; ++bit)
+            crc = (crc >> 1) ^ (0xedb88320u & (uint32_t)-(int32_t)(crc & 1u));
+    }
+    return ~crc;
+}
+
+static bool writerReserve(FastWriter* writer, size_t bytes) {
+    if (writer->error) return false;
+    if (bytes > FAST_STATE_MAX_BYTES || writer->size > FAST_STATE_MAX_BYTES - bytes) {
+        writer->error = EFBIG;
+        return false;
+    }
+    size_t needed = writer->size + bytes;
+    if (needed <= writer->capacity) return true;
+    size_t capacity = writer->capacity ? writer->capacity : 65536;
+    while (capacity < needed) capacity *= 2;
+    uint8_t* replacement = (uint8_t*)realloc(writer->data, capacity);
+    if (replacement == nullptr) {
+        writer->error = ENOMEM;
+        return false;
+    }
+    writer->data = replacement;
+    writer->capacity = capacity;
+    return true;
+}
+
+static bool writerBytes(FastWriter* writer, const void* data, size_t bytes) {
+    if (!writerReserve(writer, bytes)) return false;
+    if (bytes != 0) memcpy(writer->data + writer->size, data, bytes);
+    writer->size += bytes;
+    return true;
+}
+
+static bool writerU8(FastWriter* writer, uint8_t value) {
+    return writerBytes(writer, &value, sizeof(value));
+}
+
+static bool writerU32(FastWriter* writer, uint32_t value) {
+    return writerBytes(writer, &value, sizeof(value));
+}
+
+static bool writerI32(FastWriter* writer, int32_t value) {
+    return writerBytes(writer, &value, sizeof(value));
+}
+
+static bool readerBytes(FastReader* reader, void* target, size_t bytes) {
+    if (reader->error) return false;
+    if (bytes > reader->size || reader->offset > reader->size - bytes) {
+        reader->error = EBADMSG;
+        return false;
+    }
+    if (bytes != 0) memcpy(target, reader->data + reader->offset, bytes);
+    reader->offset += bytes;
+    return true;
+}
+
+static uint8_t readerU8(FastReader* reader) {
+    uint8_t value = 0;
+    readerBytes(reader, &value, sizeof(value));
+    return value;
+}
+
+static uint32_t readerU32(FastReader* reader) {
+    uint32_t value = 0;
+    readerBytes(reader, &value, sizeof(value));
+    return value;
+}
+
+static int32_t readerI32(FastReader* reader) {
+    int32_t value = 0;
+    readerBytes(reader, &value, sizeof(value));
+    return value;
+}
+
+static bool countOkay(FastReader* reader, uint32_t count) {
+    if (count <= FAST_STATE_MAX_COUNT) return true;
+    reader->error = EBADMSG;
+    return false;
+}
+
+static bool writeString(FastWriter* writer, const char* string) {
+    size_t length = string ? strlen(string) : 0;
+    if (length > UINT32_MAX) {
+        writer->error = EFBIG;
+        return false;
+    }
+    return writerU32(writer, (uint32_t)length) &&
+           writerBytes(writer, string ? string : "", length);
+}
+
+static char* readString(FastReader* reader) {
+    uint32_t length = readerU32(reader);
+    if (reader->error || length > 4u * 1024u * 1024u ||
+        length > reader->size - reader->offset) {
+        reader->error = EBADMSG;
+        return nullptr;
+    }
+    char* result = (char*)malloc((size_t)length + 1u);
+    if (result == nullptr) {
+        reader->error = ENOMEM;
+        return nullptr;
+    }
+    readerBytes(reader, result, length);
+    result[length] = '\0';
+    return result;
+}
+
+static bool writeRValue(FastWriter* writer, RValue value, uint32_t depth);
+static RValue readRValue(FastReader* reader, Runner* runner, uint32_t depth);
+
+static int32_t writerArrayIndex(FastWriter* writer, GMLArray* array) {
+    repeat((int32_t)arrlen(writer->arrays), i) {
+        if (writer->arrays[i] == array) return i;
+    }
+    return -1;
+}
+
+static bool writeArray(FastWriter* writer, GMLArray* array, uint32_t depth) {
+    if (array == nullptr || depth >= FAST_STATE_ARRAY_DEPTH) {
+        writer->error = array ? ELOOP : EBADMSG;
+        return false;
+    }
+    int32_t existing = writerArrayIndex(writer, array);
+    if (existing >= 0)
+        return writerU32(writer, (uint32_t)existing) && writerU8(writer, 0);
+
+    uint32_t id = (uint32_t)arrlen(writer->arrays);
+    arrput(writer->arrays, array);
+    if (!writerU32(writer, id) || !writerU8(writer, 1) ||
+        !writerU32(writer, (uint32_t)array->type)) return false;
+    if (array->type == GML_LEGACY_ARRAY) {
+        uint32_t rows = (uint32_t)array->legacy.rowCount;
+        if (!writerU32(writer, rows)) return false;
+        repeat(rows, rowIndex) {
+            GMLArrayRow* row = &array->legacy.rows[rowIndex];
+            if (!writerU32(writer, (uint32_t)row->length)) return false;
+            repeat(row->length, itemIndex) {
+                if (!writeRValue(writer, row->data[itemIndex], depth + 1)) return false;
+            }
+        }
+        return true;
+    }
+    if (array->type == GML_MODERN_ARRAY) {
+        if (!writerU32(writer, (uint32_t)array->modern.length)) return false;
+        repeat(array->modern.length, itemIndex) {
+            if (!writeRValue(writer, array->modern.data[itemIndex], depth + 1)) return false;
+        }
+        return true;
+    }
+    writer->error = ENOTSUP;
+    return false;
+}
+
+static GMLArray* createEmptyArray(Runner* runner, uint32_t type) {
+    GMLArray* array = GMLArray_create(runner->dataWin->gen8.wadVersion, 0);
+    if (array == nullptr) return nullptr;
+    if ((uint32_t)array->type != type) {
+        // WAD14 AM2R is legacy-array-only. Keeping this guard makes a future
+        // format extension explicit instead of misreading a newer VM state.
+        GMLArray_decRef(array);
+        return nullptr;
+    }
+    return array;
+}
+
+static RValue readArray(FastReader* reader, Runner* runner, uint32_t depth) {
+    if (depth >= FAST_STATE_ARRAY_DEPTH) {
+        reader->error = ELOOP;
+        return RValue_makeUndefined();
+    }
+    uint32_t id = readerU32(reader);
+    uint8_t isNew = readerU8(reader);
+    if (reader->error) return RValue_makeUndefined();
+    if (!isNew) {
+        if (id >= arrlenu(reader->arrays) || reader->arrays[id] == nullptr) {
+            reader->error = EBADMSG;
+            return RValue_makeUndefined();
+        }
+        GMLArray_incRef(reader->arrays[id]);
+        return RValue_makeArray(reader->arrays[id]);
+    }
+    if (id != arrlenu(reader->arrays)) {
+        reader->error = EBADMSG;
+        return RValue_makeUndefined();
+    }
+    uint32_t type = readerU32(reader);
+    GMLArray* array = createEmptyArray(runner, type);
+    if (array == nullptr) {
+        reader->error = ENOTSUP;
+        return RValue_makeUndefined();
+    }
+    arrput(reader->arrays, array);
+    uint32_t outer = readerU32(reader);
+    if (!countOkay(reader, outer)) return RValue_makeArray(array);
+    if (array->type == GML_LEGACY_ARRAY) {
+        repeat(outer, rowIndex) {
+            uint32_t length = readerU32(reader);
+            if (!countOkay(reader, length) ||
+                rowIndex > (uint32_t)INT32_MAX / GML_LEGACY_ARRAY_STRIDE ||
+                length > GML_LEGACY_ARRAY_STRIDE) {
+                reader->error = EBADMSG;
+                break;
+            }
+            if (length > 0)
+                GMLArray_growTo(array, (int32_t)rowIndex * GML_LEGACY_ARRAY_STRIDE +
+                                       (int32_t)length);
+            repeat(length, itemIndex) {
+                RValue value = readRValue(reader, runner, depth + 1);
+                if (reader->error) {
+                    RValue_free(&value);
+                    break;
+                }
+                RValue* slot = &array->legacy.rows[rowIndex].data[itemIndex];
+                RValue_free(slot);
+                *slot = value;
+            }
+            if (reader->error) break;
+        }
+    } else {
+        if (outer > 0) GMLArray_growTo(array, (int32_t)outer);
+        repeat(outer, itemIndex) {
+            RValue value = readRValue(reader, runner, depth + 1);
+            if (reader->error) {
+                RValue_free(&value);
+                break;
+            }
+            RValue* slot = &array->modern.data[itemIndex];
+            RValue_free(slot);
+            *slot = value;
+        }
+    }
+    return RValue_makeArray(array);
+}
+
+static bool writeRValue(FastWriter* writer, RValue value, uint32_t depth) {
+    if (!writerU8(writer, value.type) || !writerU8(writer, value.gmlStackType) ||
+        !writerU8(writer, value.assetRefType)) return false;
+    switch (value.type) {
+    case RVALUE_UNDEFINED: return true;
+    case RVALUE_STRING: return writeString(writer, value.string);
+    case RVALUE_INT32:
+    case RVALUE_BOOL:
+    case RVALUE_ASSETREF: return writerI32(writer, value.int32);
+#ifndef NO_RVALUE_INT64
+    case RVALUE_INT64: return writerBytes(writer, &value.int64, sizeof(value.int64));
+#endif
+    case RVALUE_REAL: return writerBytes(writer, &value.real, sizeof(value.real));
+    case RVALUE_ARRAY: return writeArray(writer, value.array, depth);
+    case RVALUE_METHOD:
+    case RVALUE_STRUCT:
+    default:
+        writer->error = ENOTSUP;
+        return false;
+    }
+}
+
+static RValue readRValue(FastReader* reader, Runner* runner, uint32_t depth) {
+    uint8_t type = readerU8(reader);
+    uint8_t stackType = readerU8(reader);
+    uint8_t assetType = readerU8(reader);
+    RValue value = RValue_makeUndefined();
+    if (reader->error) return value;
+    switch (type) {
+    case RVALUE_UNDEFINED: break;
+    case RVALUE_STRING: {
+        char* string = readString(reader);
+        if (!reader->error) value = RValue_makeOwnedString(string);
+        else free(string);
+        break;
+    }
+    case RVALUE_INT32: value = RValue_makeInt32(readerI32(reader)); break;
+    case RVALUE_BOOL: value = RValue_makeBool(readerI32(reader) != 0); break;
+    case RVALUE_ASSETREF:
+        value = RValue_makeInt32(readerI32(reader));
+        value.type = RVALUE_ASSETREF;
+        value.assetRefType = assetType;
+        break;
+#ifndef NO_RVALUE_INT64
+    case RVALUE_INT64:
+        value = RValue_makeInt64(0);
+        readerBytes(reader, &value.int64, sizeof(value.int64));
+        break;
+#endif
+    case RVALUE_REAL:
+        value = RValue_makeReal(0);
+        readerBytes(reader, &value.real, sizeof(value.real));
+        break;
+    case RVALUE_ARRAY: value = readArray(reader, runner, depth); break;
+    default: reader->error = ENOTSUP; break;
+    }
+    value.gmlStackType = stackType;
+    return value;
+}
+
+static bool writeVarMap(FastWriter* writer, const IntRValueHashMap* map) {
+    uint32_t count = map->count;
+    if (!writerU32(writer, count)) return false;
+    repeat(count, i) {
+        uint32_t index = map->occupiedIndices[i];
+        const IntRValueEntry* entry = &map->entries[index];
+        if (!writerI32(writer, entry->key) ||
+            !writeRValue(writer, entry->value, 0)) return false;
+    }
+    return true;
+}
+
+static bool readVarMap(FastReader* reader, Runner* runner, Instance* instance) {
+    uint32_t count = readerU32(reader);
+    if (!countOkay(reader, count)) return false;
+    repeat(count, i) {
+        int32_t key = readerI32(reader);
+        RValue value = readRValue(reader, runner, 0);
+        if (reader->error) {
+            RValue_free(&value);
+            return false;
+        }
+        Instance_setSelfVar(instance, key, value);
+        RValue_free(&value);
+    }
+    return !reader->error;
+}
+
+static FastInstanceFields captureInstance(const Instance* instance) {
+    FastInstanceFields fields = {0};
+    fields.instanceId = instance->instanceId;
+    fields.objectIndex = instance->objectIndex;
+    fields.x = instance->x; fields.y = instance->y;
+    fields.xprevious = instance->xprevious; fields.yprevious = instance->yprevious;
+    fields.xstart = instance->xstart; fields.ystart = instance->ystart;
+    fields.persistent = instance->persistent; fields.solid = instance->solid;
+    fields.active = instance->active; fields.destroyed = instance->destroyed;
+    fields.visible = instance->visible; fields.createEventFired = instance->createEventFired;
+    fields.outsideRoom = instance->outsideRoom; fields.mouseOver = instance->mouseOver;
+    fields.activeAlarmMask = instance->activeAlarmMask; fields.maskIndex = instance->maskIndex;
+    fields.spriteIndex = instance->spriteIndex; fields.imageSpeed = instance->imageSpeed;
+    fields.imageIndex = instance->imageIndex; fields.imageXscale = instance->imageXscale;
+    fields.imageYscale = instance->imageYscale; fields.imageAngle = instance->imageAngle;
+    fields.imageAlpha = instance->imageAlpha; fields.imageBlend = instance->imageBlend;
+    fields.depth = instance->depth; fields.layer = instance->layer;
+    fields.speed = instance->speed; fields.direction = instance->direction;
+    fields.hspeed = instance->hspeed; fields.vspeed = instance->vspeed;
+    fields.friction = instance->friction; fields.gravity = instance->gravity;
+    fields.gravityDirection = instance->gravityDirection;
+    fields.pathIndex = instance->pathIndex; fields.pathPosition = instance->pathPosition;
+    fields.pathPositionPrevious = instance->pathPositionPrevious;
+    fields.pathSpeed = instance->pathSpeed; fields.pathScale = instance->pathScale;
+    fields.pathOrientation = instance->pathOrientation;
+    fields.pathEndAction = instance->pathEndAction;
+    fields.pathXStart = instance->pathXStart; fields.pathYStart = instance->pathYStart;
+    memcpy(fields.alarm, instance->alarm, sizeof(fields.alarm));
+    fields.timelineIndex = instance->timelineIndex;
+    fields.timelinePosition = instance->timelinePosition;
+    fields.timelineSpeed = instance->timelineSpeed;
+    fields.timelineLoop = instance->timelineLoop;
+    fields.timelineRunning = instance->timelineRunning;
+    return fields;
+}
+
+static void restoreInstance(Instance* instance, const FastInstanceFields* fields) {
+    uint32_t id = instance->instanceId;
+    int32_t object = instance->objectIndex;
+    IntRValueHashMap vars = instance->selfVars;
+    *instance = (Instance){0};
+    instance->instanceId = id;
+    instance->objectIndex = object;
+    instance->selfVars = vars;
+    instance->x = fields->x; instance->y = fields->y;
+    instance->xprevious = fields->xprevious; instance->yprevious = fields->yprevious;
+    instance->xstart = fields->xstart; instance->ystart = fields->ystart;
+    instance->persistent = fields->persistent; instance->solid = fields->solid;
+    instance->active = fields->active; instance->destroyed = fields->destroyed;
+    instance->visible = fields->visible; instance->createEventFired = fields->createEventFired;
+    instance->outsideRoom = fields->outsideRoom; instance->mouseOver = fields->mouseOver;
+    instance->activeAlarmMask = fields->activeAlarmMask; instance->maskIndex = fields->maskIndex;
+    instance->spriteIndex = fields->spriteIndex; instance->imageSpeed = fields->imageSpeed;
+    instance->imageIndex = fields->imageIndex; instance->imageXscale = fields->imageXscale;
+    instance->imageYscale = fields->imageYscale; instance->imageAngle = fields->imageAngle;
+    instance->imageAlpha = fields->imageAlpha; instance->imageBlend = fields->imageBlend;
+    instance->depth = fields->depth; instance->layer = fields->layer;
+    instance->speed = fields->speed; instance->direction = fields->direction;
+    instance->hspeed = fields->hspeed; instance->vspeed = fields->vspeed;
+    instance->friction = fields->friction; instance->gravity = fields->gravity;
+    instance->gravityDirection = fields->gravityDirection;
+    instance->pathIndex = fields->pathIndex; instance->pathPosition = fields->pathPosition;
+    instance->pathPositionPrevious = fields->pathPositionPrevious;
+    instance->pathSpeed = fields->pathSpeed; instance->pathScale = fields->pathScale;
+    instance->pathOrientation = fields->pathOrientation;
+    instance->pathEndAction = fields->pathEndAction;
+    instance->pathXStart = fields->pathXStart; instance->pathYStart = fields->pathYStart;
+    memcpy(instance->alarm, fields->alarm, sizeof(instance->alarm));
+    instance->timelineIndex = fields->timelineIndex;
+    instance->timelinePosition = fields->timelinePosition;
+    instance->timelineSpeed = fields->timelineSpeed;
+    instance->timelineLoop = fields->timelineLoop;
+    instance->timelineRunning = fields->timelineRunning;
+}
+
+static bool writeInstance(FastWriter* writer, const Instance* instance) {
+    FastInstanceFields fields = captureInstance(instance);
+    return writerBytes(writer, &fields, sizeof(fields)) &&
+           writeVarMap(writer, &instance->selfVars);
+}
+
+static Instance* readInstance(FastReader* reader, Runner* runner, bool currentRoom) {
+    FastInstanceFields fields = {0};
+    if (!readerBytes(reader, &fields, sizeof(fields)) ||
+        fields.objectIndex < 0 ||
+        (uint32_t)fields.objectIndex >= runner->dataWin->objt.count) {
+        reader->error = EBADMSG;
+        return nullptr;
+    }
+    Instance* instance = Runner_createFastStateInstance(
+        runner, fields.instanceId, fields.objectIndex, currentRoom);
+    if (instance == nullptr) {
+        reader->error = EBADMSG;
+        return nullptr;
+    }
+    restoreInstance(instance, &fields);
+    if (!readVarMap(reader, runner, instance)) return nullptr;
+    return instance;
+}
+
+static bool writeTileMap(FastWriter* writer, TileLayerMapEntry* map) {
+    uint32_t count = (uint32_t)hmlen(map);
+    if (!writerU32(writer, count)) return false;
+    repeat(count, i) {
+        if (!writerBytes(writer, &map[i], sizeof(map[i]))) return false;
+    }
+    return true;
+}
+
+static bool readTileMap(FastReader* reader, TileLayerMapEntry** map) {
+    uint32_t count = readerU32(reader);
+    if (!countOkay(reader, count)) return false;
+    repeat(count, i) {
+        TileLayerMapEntry entry = {0};
+        if (!readerBytes(reader, &entry, sizeof(entry))) return false;
+        hmput(*map, entry.key, entry.value);
+    }
+    return true;
+}
+
+static bool writeInstances(FastWriter* writer, Instance** instances) {
+    uint32_t count = (uint32_t)arrlen(instances);
+    if (!writerU32(writer, count)) return false;
+    repeat(count, i) if (!writeInstance(writer, instances[i])) return false;
+    return true;
+}
+
+static bool readInstances(FastReader* reader, Runner* runner,
+                          Instance*** destination, bool currentRoom) {
+    uint32_t count = readerU32(reader);
+    if (!countOkay(reader, count)) return false;
+    repeat(count, i) {
+        Instance* instance = readInstance(reader, runner, currentRoom);
+        if (instance == nullptr) return false;
+        if (!currentRoom) arrput(*destination, instance);
+    }
+    return true;
+}
+
+static bool writeRoomVisual(FastWriter* writer, const RuntimeBackground* backgrounds,
+                            uint32_t backgroundColor, bool drawBackgroundColor,
+                            TileLayerMapEntry* tileMap, const RoomTile* tiles,
+                            uint32_t tileCount, const RuntimeView* views,
+                            bool viewsEnabled, const GMLCamera* cameras) {
+    return writerBytes(writer, backgrounds, sizeof(RuntimeBackground) * 8u) &&
+           writerU32(writer, backgroundColor) && writerU8(writer, drawBackgroundColor) &&
+           writeTileMap(writer, tileMap) && writerU32(writer, tileCount) &&
+           writerBytes(writer, tiles, sizeof(RoomTile) * tileCount) &&
+           writerBytes(writer, views, sizeof(RuntimeView) * MAX_VIEWS) &&
+           writerU8(writer, viewsEnabled) &&
+           writerBytes(writer, cameras, sizeof(GMLCamera) * MAX_DEFAULT_ROOM_CAMERAS);
+}
+
+static bool readRoomVisual(FastReader* reader, RuntimeBackground* backgrounds,
+                           uint32_t* backgroundColor, bool* drawBackgroundColor,
+                           TileLayerMapEntry** tileMap, RoomTile** tiles,
+                           uint32_t* tileCount, RuntimeView* views,
+                           bool* viewsEnabled, GMLCamera* cameras) {
+    if (!readerBytes(reader, backgrounds, sizeof(RuntimeBackground) * 8u)) return false;
+    *backgroundColor = readerU32(reader);
+    *drawBackgroundColor = readerU8(reader) != 0;
+    if (!readTileMap(reader, tileMap)) return false;
+    *tileCount = readerU32(reader);
+    if (!countOkay(reader, *tileCount)) return false;
+    if (*tileCount > 0) {
+        *tiles = (RoomTile*)malloc(sizeof(RoomTile) * *tileCount);
+        if (*tiles == nullptr) { reader->error = ENOMEM; return false; }
+        if (!readerBytes(reader, *tiles, sizeof(RoomTile) * *tileCount)) return false;
+    }
+    return readerBytes(reader, views, sizeof(RuntimeView) * MAX_VIEWS) &&
+           ((*viewsEnabled = readerU8(reader) != 0), !reader->error) &&
+           readerBytes(reader, cameras, sizeof(GMLCamera) * MAX_DEFAULT_ROOM_CAMERAS);
+}
