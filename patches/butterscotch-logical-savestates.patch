+static bool writeSurfaces(FastWriter* writer, Runner* runner) {
+    SWRenderer* sw = (SWRenderer*)runner->renderer;
+    if (!writerU32(writer, sw->surfaceCount) || !writerI32(writer, sw->currentSurface))
+        return false;
+    repeat(sw->surfaceCount, id) {
+        bool exists = sw->surfaceExistsFlags[id];
+        if (!writerU8(writer, exists)) return false;
+        if (!exists) continue;
+        int32_t width = sw->surfaceWidths[id], height = sw->surfaceHeights[id];
+        uint64_t bytes = (uint64_t)(uint32_t)width * (uint64_t)(uint32_t)height * 4u;
+        if (width <= 0 || height <= 0 || bytes > FAST_STATE_MAX_BYTES ||
+            !writerI32(writer, width) || !writerI32(writer, height) ||
+            !writerU32(writer, sw->surfaceRevisions[id]) ||
+            !writerBytes(writer, sw->surfacePixels[id], (size_t)bytes)) {
+            if (!writer->error) writer->error = EFBIG;
+            return false;
+        }
+    }
+    return true;
+}
+
+static bool readSurfaces(FastReader* reader, Runner* runner) {
+    uint32_t count = readerU32(reader);
+    int32_t current = readerI32(reader);
+    if (!countOkay(reader, count) || count > 4096) return false;
+    SWRenderer_fastStateResetSurfaces(runner->renderer);
+    repeat(count, id) {
+        if (!readerU8(reader)) continue;
+        int32_t width = readerI32(reader), height = readerI32(reader);
+        uint32_t revision = readerU32(reader);
+        uint64_t bytes = (uint64_t)(uint32_t)width * (uint64_t)(uint32_t)height * 4u;
+        if (width <= 0 || height <= 0 || bytes > FAST_STATE_MAX_BYTES ||
+            bytes > reader->size - reader->offset) {
+            reader->error = EBADMSG; return false;
+        }
+        if (!SWRenderer_fastStateRestoreSurface(runner->renderer, id, width, height,
+                                                revision, reader->data + reader->offset)) {
+            reader->error = ENOMEM; return false;
+        }
+        reader->offset += (size_t)bytes;
+    }
+    SWRenderer* sw = (SWRenderer*)runner->renderer;
+    if (current != -1 &&
+        (current <= 0 || (uint32_t)current >= sw->surfaceCount ||
+         !sw->surfaceExistsFlags[current])) {
+        reader->error = EBADMSG;
+        return false;
+    }
+    sw->currentSurface = current;
+    return true;
+}
