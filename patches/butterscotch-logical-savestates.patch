+#ifdef USE_MISTER
+void SWRenderer_fastStateResetSurfaces(Renderer* renderer) {
+    SWRenderer* sw = (SWRenderer*)renderer;
+    if (sw == nullptr) return;
+    swUseHostTarget(sw);
+    for (uint32_t id = 0; id < sw->surfaceCount; ++id) {
+        if (sw->surfacePixels[id] != nullptr)
+            MisterGpu_releaseTexture(sw->surfacePixels[id]);
+        free(sw->surfacePixels[id]);
+        sw->surfacePixels[id] = nullptr;
+        sw->surfaceWidths[id] = 0;
+        sw->surfaceHeights[id] = 0;
+        sw->surfaceExistsFlags[id] = false;
+        sw->surfaceRevisions[id] = 0;
+        swResetSurfaceContentBounds(sw, (int32_t)id, false);
+    }
+    sw->surfaceCount = 1; // ID zero remains GameMaker's invalid sentinel.
+    sw->surfaceWriteSerial = 0;
+    sw->am2rMapSurfaceId = -1;
+    sw->am2rMapSurfaceRetained = false;
+    sw->am2rMapSurfaceReused = false;
+    sw->am2rMapSurfaceCacheValid = false;
+    sw->am2rMapSurfaceTopologyHash = 0;
+    sw->am2rMapSurfaceDiscoveryHash = 0;
+}
+
+bool SWRenderer_fastStateRestoreSurface(Renderer* renderer, uint32_t id,
+                                        int32_t width, int32_t height,
+                                        uint32_t revision,
+                                        const uint8_t* rgba) {
+    SWRenderer* sw = (SWRenderer*)renderer;
+    if (sw == nullptr || id == 0 || width <= 0 || height <= 0 ||
+        width > 4096 || height > 4096 || rgba == nullptr)
+        return false;
+    swEnsureSurfaceCapacity(sw, id + 1);
+    if (sw->surfaceCount <= id) sw->surfaceCount = id + 1;
+    size_t bytes = (size_t)width * (size_t)height * 4u;
+    sw->surfacePixels[id] = (uint8_t*)safeMalloc(bytes);
+    memcpy(sw->surfacePixels[id], rgba, bytes);
+    sw->surfaceWidths[id] = width;
+    sw->surfaceHeights[id] = height;
+    sw->surfaceExistsFlags[id] = true;
+    sw->surfaceRevisions[id] = revision;
+    if (sw->surfaceWriteSerial < revision) sw->surfaceWriteSerial = revision;
+    swResetSurfaceContentBounds(sw, (int32_t)id, true);
+    return true;
+}
+#endif
