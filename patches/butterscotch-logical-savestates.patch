+static bool writeFileFindState(FastWriter* writer, Runner* runner) {
+    uint32_t count = (uint32_t)arrlen(runner->fileFindResults);
+    if (!writerU32(writer, count) || !writerI32(writer, runner->fileFindPosition))
+        return false;
+    repeat(count, i) {
+        if (!writeString(writer, runner->fileFindResults[i])) return false;
+    }
+    return true;
+}
+
+static bool readFileFindState(FastReader* reader, Runner* runner) {
+    uint32_t count = readerU32(reader);
+    int32_t position = readerI32(reader);
+    if (!countOkay(reader, count) || position < 0 ||
+        (uint32_t)position > count) {
+        reader->error = EBADMSG;
+        return false;
+    }
+    repeat(count, i) {
+        char* result = readString(reader);
+        if (reader->error) {
+            free(result);
+            return false;
+        }
+        arrput(runner->fileFindResults, result);
+    }
+    runner->fileFindPosition = position;
+    return true;
+}
+
+static int auditUnsupportedState(Runner* runner) {
+    if (arrlen(runner->structInstances) || arrlen(runner->runtimeLayers) ||
+        arrlen(runner->asyncBufferGroupOps) || arrlen(runner->asyncSaveLoadQueue) ||
+        runner->asyncBufferGroupActive || runner->currentIni != nullptr) {
+        logWarn("AM2R logical state unsupported: structs=%zu layers=%zu buffer_ops=%zu "
+                "save_ops=%zu buffer_active=%d ini=%d\n",
+                arrlen(runner->structInstances), arrlen(runner->runtimeLayers),
+                arrlen(runner->asyncBufferGroupOps), arrlen(runner->asyncSaveLoadQueue),
+                runner->asyncBufferGroupActive, runner->currentIni != nullptr);
+        return ENOTSUP;
+    }
+    repeat(runner->dataWin->room.count, i) {
+        if (arrlen(runner->savedRoomStates[i].runtimeLayers)) {
+            logWarn("AM2R logical state unsupported: saved room %d has %zu runtime layers\n",
+                    i, arrlen(runner->savedRoomStates[i].runtimeLayers));
+            return ENOTSUP;
+        }
+    }
+    repeat(MAX_OPEN_BINARY_FILES, i) if (runner->openBinaryFiles[i].isOpen) {
+        logWarn("AM2R logical state busy: binary file handle %d is open\n", i);
+        return EBUSY;
+    }
+    return 0;
+}
+
+static bool serializeState(FastWriter* writer, Runner* runner) {
+    FastStateHeader header = {0};
+    memcpy(header.magic, "AM2RFST", 7);
+    header.version = FAST_STATE_VERSION;
+    header.headerSize = sizeof(header);
+    header.roomCount = runner->dataWin->room.count;
+    header.objectCount = runner->dataWin->objt.count;
+    header.instanceSize = sizeof(FastInstanceFields);
+    header.rvalueSize = sizeof(RValue);
+    header.dataFileSize = runner->dataWin->fileSize;
+    header.gameId = runner->dataWin->gen8.gameID;
+    header.licenseCrc32 = runner->dataWin->gen8.licenseCRC32;
+    memcpy(header.directPlayGuid, runner->dataWin->gen8.directPlayGuid,
+           sizeof(header.directPlayGuid));
+    header.codeCount = runner->dataWin->code.count;
+    header.spriteCount = runner->dataWin->sprt.count;
+    if (!writerBytes(writer, &header, sizeof(header))) return false;
+
+    FastRunnerFields fields = captureRunnerFields(runner);
+    if (!writerI32(writer, runner->currentRoomIndex) ||
+        !writerBytes(writer, &fields, sizeof(fields)) ||
+        !writeVarMap(writer, &runner->vmContext->globalScopeInstance->selfVars) ||
+        !writerBytes(writer, runner->views, sizeof(runner->views)) ||
+        !writerBytes(writer, runner->defaultCameras, sizeof(runner->defaultCameras)) ||
+        !writerBytes(writer, runner->userCameras, sizeof(runner->userCameras)) ||
+        !writerBytes(writer, &runner->surfaceCamera, sizeof(runner->surfaceCamera)) ||
+        !writerBytes(writer, &runner->guiCamera, sizeof(runner->guiCamera)) ||
+        !writeRoomVisual(writer, runner->backgrounds, runner->backgroundColor,
+                         runner->drawBackgroundColor, runner->tileLayerMap,
+                         runner->currentRoom->tiles, runner->currentRoom->tileCount,
+                         runner->views, runner->viewsEnabled, runner->defaultCameras) ||
+        !writeInstances(writer, runner->instances)) return false;
+
+    if (!writerU32(writer, runner->dataWin->room.count)) return false;
+    repeat(runner->dataWin->room.count, i) {
+        SavedRoomState* state = &runner->savedRoomStates[i];
+        if (!writerU8(writer, state->initialized)) return false;
+        if (!state->initialized) continue;
+        if (!writeRoomVisual(writer, state->backgrounds, state->backgroundColor,
+                             state->drawBackgroundColor, state->tileLayerMap,
+                             state->tiles, state->tileCount, state->views,
+                             state->viewsEnabled, state->defaultCameras) ||
+            !writeInstances(writer, state->instances)) return false;
+    }
+    if (!writeDataStructures(writer, runner) || !writeAuxiliaryPools(writer, runner) ||
+        !writeOpenTextFiles(writer, runner) || !writeFileFindState(writer, runner) ||
+        !writeSurfaces(writer, runner) || !writeAudio(writer, runner)) return false;
+
+    header.payloadSize = (uint32_t)(writer->size - sizeof(header));
+    header.payloadCrc32 = crc32Bytes(writer->data + sizeof(header), header.payloadSize);
+    memcpy(writer->data, &header, sizeof(header));
+    return true;
+}
+
+static bool deserializeState(FastReader* reader, Runner* runner) {
+    FastStateHeader header = {0};
+    if (!readerBytes(reader, &header, sizeof(header)) ||
+        memcmp(header.magic, "AM2RFST", 7) != 0 ||
+        header.version != FAST_STATE_VERSION || header.headerSize != sizeof(header) ||
+        header.payloadSize != reader->size - sizeof(header) ||
+        header.roomCount != runner->dataWin->room.count ||
+        header.objectCount != runner->dataWin->objt.count ||
+        header.instanceSize != sizeof(FastInstanceFields) ||
+        header.rvalueSize != sizeof(RValue) ||
+        header.dataFileSize != runner->dataWin->fileSize ||
+        header.gameId != runner->dataWin->gen8.gameID ||
+        header.licenseCrc32 != runner->dataWin->gen8.licenseCRC32 ||
+        memcmp(header.directPlayGuid, runner->dataWin->gen8.directPlayGuid,
+               sizeof(header.directPlayGuid)) != 0 ||
+        header.codeCount != runner->dataWin->code.count ||
+        header.spriteCount != runner->dataWin->sprt.count ||
+        header.payloadCrc32 != crc32Bytes(reader->data + sizeof(header), header.payloadSize)) {
+        reader->error = EBADMSG;
+        return false;
+    }
+    int32_t roomIndex = readerI32(reader);
+    FastRunnerFields fields = {0};
+    if (!readerBytes(reader, &fields, sizeof(fields)) ||
+        !Runner_beginFastStateRestore(runner, roomIndex)) {
+        reader->error = EBADMSG;
+        return false;
+    }
+    if (!readVarMap(reader, runner, runner->vmContext->globalScopeInstance) ||
+        !readerBytes(reader, runner->views, sizeof(runner->views)) ||
+        !readerBytes(reader, runner->defaultCameras, sizeof(runner->defaultCameras)) ||
+        !readerBytes(reader, runner->userCameras, sizeof(runner->userCameras)) ||
+        !readerBytes(reader, &runner->surfaceCamera, sizeof(runner->surfaceCamera)) ||
+        !readerBytes(reader, &runner->guiCamera, sizeof(runner->guiCamera))) return false;
+
+    RoomTile* currentTiles = nullptr;
+    uint32_t currentTileCount = 0;
+    hmfree(runner->tileLayerMap); runner->tileLayerMap = nullptr;
+    if (!readRoomVisual(reader, runner->backgrounds, &runner->backgroundColor,
+                        &runner->drawBackgroundColor, &runner->tileLayerMap,
+                        &currentTiles, &currentTileCount, runner->views,
+                        &runner->viewsEnabled, runner->defaultCameras)) return false;
+    free(runner->currentRoom->tiles);
+    runner->currentRoom->tiles = currentTiles;
+    runner->currentRoom->tileCount = currentTileCount;
+    if (!readInstances(reader, runner, &runner->instances, true)) return false;
+
+    uint32_t roomCount = readerU32(reader);
+    if (roomCount != runner->dataWin->room.count) { reader->error = EBADMSG; return false; }
+    repeat(roomCount, i) {
+        SavedRoomState* state = &runner->savedRoomStates[i];
+        state->initialized = readerU8(reader) != 0;
+        if (!state->initialized) continue;
+        if (!readRoomVisual(reader, state->backgrounds, &state->backgroundColor,
+                            &state->drawBackgroundColor, &state->tileLayerMap,
+                            &state->tiles, &state->tileCount, state->views,
+                            &state->viewsEnabled, state->defaultCameras) ||
+            !readInstances(reader, runner, &state->instances, false)) return false;
+    }
+    if (!readDataStructures(reader, runner) || !readAuxiliaryPools(reader, runner) ||
+        !readOpenTextFiles(reader, runner) || !readFileFindState(reader, runner) ||
+        !readSurfaces(reader, runner) || !readAudio(reader, runner)) return false;
+    if (reader->offset != reader->size) { reader->error = EBADMSG; return false; }
+    restoreRunnerFields(runner, &fields);
+    Runner_finishFastStateRestore(runner);
+    return true;
+}
+
+static void statePath(char* target, size_t size, int slot, const char* suffix) {
+    snprintf(target, size, FAST_STATE_PATH "/slot%d.fast%s", slot + 1, suffix);
+}
+
+static int writeAtomic(const uint8_t* data, size_t size, int slot) {
+    mkdir("/media/fat/savestates", 0755);
+    mkdir(FAST_STATE_PATH, 0755);
+    char path[PATH_MAX], temporary[PATH_MAX];
+    statePath(path, sizeof(path), slot, "");
+    statePath(temporary, sizeof(temporary), slot, ".new");
+    unlink(temporary);
+    int fd = open(temporary, O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC, 0644);
+    if (fd < 0) return errno;
+    size_t offset = 0;
+    while (offset < size) {
+        ssize_t written = write(fd, data + offset, size - offset);
+        if (written < 0 && errno == EINTR) continue;
+        if (written <= 0) { int error = errno ? errno : EIO; close(fd); unlink(temporary); return error; }
+        offset += (size_t)written;
+    }
+    if (fsync(fd) != 0 || close(fd) != 0) {
+        int error = errno ? errno : EIO; unlink(temporary); return error;
+    }
+    if (rename(temporary, path) != 0) {
+        int error = errno; unlink(temporary); return error;
+    }
+    return 0;
+}
+
+static int readWholeFile(int slot, uint8_t** data, size_t* size) {
+    char path[PATH_MAX];
+    statePath(path, sizeof(path), slot, "");
+    int fd = open(path, O_RDONLY | O_CLOEXEC);
+    if (fd < 0) return errno;
+    struct stat status = {0};
+    if (fstat(fd, &status) != 0 || status.st_size < (off_t)sizeof(FastStateHeader) ||
+        status.st_size > (off_t)FAST_STATE_MAX_BYTES) {
+        int error = errno ? errno : EBADMSG; close(fd); return error;
+    }
+    *size = (size_t)status.st_size;
+    *data = (uint8_t*)malloc(*size);
+    if (*data == nullptr) { close(fd); return ENOMEM; }
+    size_t offset = 0;
+    while (offset < *size) {
+        ssize_t got = read(fd, *data + offset, *size - offset);
+        if (got < 0 && errno == EINTR) continue;
+        if (got <= 0) { int error = errno ? errno : EIO; close(fd); free(*data); *data = nullptr; return error; }
+        offset += (size_t)got;
+    }
+    close(fd);
+    return 0;
+}
+
+int Am2rFastState_save(Runner* runner, int slot, size_t* bytesWritten) {
+    if (bytesWritten) *bytesWritten = 0;
+    if (runner == nullptr || slot < 0 || slot >= 4 || runner->currentRoom == nullptr)
+        return EINVAL;
+    int audit = auditUnsupportedState(runner);
+    if (audit) return audit;
+    FastWriter writer = {0};
+    bool okay = serializeState(&writer, runner);
+    int error = okay ? writeAtomic(writer.data, writer.size, slot) :
+                       (writer.error ? writer.error : EIO);
+    if (!error && bytesWritten) *bytesWritten = writer.size;
+    arrfree(writer.arrays);
+    free(writer.data);
+    return error;
+}
+
+int Am2rFastState_load(Runner* runner, int slot, size_t* bytesRead) {
+    if (bytesRead) *bytesRead = 0;
+    if (runner == nullptr || slot < 0 || slot >= 4) return EINVAL;
+    uint8_t* data = nullptr;
+    size_t size = 0;
+    int error = readWholeFile(slot, &data, &size);
+    if (error) return error;
+    FastReader reader = { .data = data, .size = size };
+    bool okay = deserializeState(&reader, runner);
+    error = okay ? 0 : (reader.error ? reader.error : EIO);
+    if (!error && bytesRead) *bytesRead = size;
+    arrfree(reader.arrays);
+    free(data);
+    return error;
+}
+
+#endif
