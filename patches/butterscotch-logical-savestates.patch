+static bool writeAuxiliaryPools(FastWriter* writer, Runner* runner) {
+    uint32_t count = (uint32_t)arrlen(runner->gmlBufferPool);
+    if (!writerU32(writer, count)) return false;
+    repeat(count, i) {
+        GmlBuffer* buffer = &runner->gmlBufferPool[i];
+        if (!writerBytes(writer, &buffer->size, sizeof(int32_t) * 5u) ||
+            !writerU8(writer, buffer->isValid) ||
+            (buffer->isValid && !writerBytes(writer, buffer->data, (size_t)buffer->size)))
+            return false;
+    }
+    count = (uint32_t)arrlen(runner->mpGridPool);
+    if (!writerU32(writer, count)) return false;
+    repeat(count, i) {
+        MpGrid copy = runner->mpGridPool[i];
+        copy.cells = nullptr;
+        uint64_t cells = (uint64_t)(uint32_t)copy.hcells * (uint64_t)(uint32_t)copy.vcells;
+        if (cells > FAST_STATE_MAX_COUNT || !writerBytes(writer, &copy, sizeof(copy)) ||
+            (copy.inUse && !writerBytes(writer, runner->mpGridPool[i].cells, (size_t)cells))) {
+            if (!writer->error) writer->error = EFBIG;
+            return false;
+        }
+    }
+    count = (uint32_t)arrlen(runner->particleTypePool);
+    if (!writerU32(writer, count) ||
+        !writerBytes(writer, runner->particleTypePool, sizeof(ParticleType) * count)) return false;
+    count = (uint32_t)arrlen(runner->particleSystemPool);
+    if (!writerU32(writer, count)) return false;
+    repeat(count, i) {
+        ParticleSystem copy = runner->particleSystemPool[i];
+        copy.particles = nullptr; copy.emitters = nullptr;
+        uint32_t particles = (uint32_t)arrlen(runner->particleSystemPool[i].particles);
+        uint32_t emitters = (uint32_t)arrlen(runner->particleSystemPool[i].emitters);
+        if (!writerBytes(writer, &copy, sizeof(copy)) || !writerU32(writer, particles) ||
+            !writerBytes(writer, runner->particleSystemPool[i].particles,
+                         sizeof(Particle) * particles) || !writerU32(writer, emitters) ||
+            !writerBytes(writer, runner->particleSystemPool[i].emitters,
+                         sizeof(ParticleEmitter) * emitters)) return false;
+    }
+    count = (uint32_t)arrlen(runner->callLaterEntries);
+    if (!writerU32(writer, count)) return false;
+    repeat(count, i) {
+        CallLaterEntry copy = runner->callLaterEntries[i];
+        copy.callback = RValue_makeUndefined();
+        if (!writerBytes(writer, &copy, sizeof(copy)) ||
+            !writeRValue(writer, runner->callLaterEntries[i].callback, 0)) return false;
+    }
+    return true;
+}
+
+static bool readAuxiliaryPools(FastReader* reader, Runner* runner) {
+    uint32_t count = readerU32(reader);
+    if (!countOkay(reader, count)) return false;
+    arrsetlen(runner->gmlBufferPool, count);
+    memset(runner->gmlBufferPool, 0, sizeof(GmlBuffer) * count);
+    repeat(count, i) {
+        GmlBuffer* buffer = &runner->gmlBufferPool[i];
+        if (!readerBytes(reader, &buffer->size, sizeof(int32_t) * 5u)) return false;
+        buffer->isValid = readerU8(reader) != 0;
+        if (buffer->size < 0 || (uint32_t)buffer->size > FAST_STATE_MAX_BYTES) {
+            reader->error = EBADMSG; return false;
+        }
+        if (buffer->isValid && buffer->size > 0) {
+            buffer->data = (uint8_t*)malloc((size_t)buffer->size);
+            if (buffer->data == nullptr) { reader->error = ENOMEM; return false; }
+            if (!readerBytes(reader, buffer->data, (size_t)buffer->size)) return false;
+        }
+    }
+    count = readerU32(reader);
+    if (!countOkay(reader, count)) return false;
+    arrsetlen(runner->mpGridPool, count);
+    memset(runner->mpGridPool, 0, sizeof(MpGrid) * count);
+    repeat(count, i) {
+        MpGrid* grid = &runner->mpGridPool[i];
+        if (!readerBytes(reader, grid, sizeof(*grid))) return false;
+        grid->cells = nullptr;
+        uint64_t cells = (uint64_t)(uint32_t)grid->hcells * (uint64_t)(uint32_t)grid->vcells;
+        if (grid->hcells < 0 || grid->vcells < 0 || cells > FAST_STATE_MAX_COUNT) {
+            reader->error = EBADMSG; return false;
+        }
+        if (grid->inUse && cells) {
+            grid->cells = (uint8_t*)malloc((size_t)cells);
+            if (grid->cells == nullptr) { reader->error = ENOMEM; return false; }
+            if (!readerBytes(reader, grid->cells, (size_t)cells)) return false;
+        }
+    }
+    count = readerU32(reader);
+    if (!countOkay(reader, count)) return false;
+    arrsetlen(runner->particleTypePool, count);
+    if (!readerBytes(reader, runner->particleTypePool, sizeof(ParticleType) * count)) return false;
+    count = readerU32(reader);
+    if (!countOkay(reader, count)) return false;
+    arrsetlen(runner->particleSystemPool, count);
+    memset(runner->particleSystemPool, 0, sizeof(ParticleSystem) * count);
+    repeat(count, i) {
+        ParticleSystem* system = &runner->particleSystemPool[i];
+        if (!readerBytes(reader, system, sizeof(*system))) return false;
+        system->particles = nullptr; system->emitters = nullptr;
+        uint32_t particles = readerU32(reader);
+        if (!countOkay(reader, particles)) return false;
+        arrsetlen(system->particles, particles);
+        if (!readerBytes(reader, system->particles, sizeof(Particle) * particles)) return false;
+        uint32_t emitters = readerU32(reader);
+        if (!countOkay(reader, emitters)) return false;
+        arrsetlen(system->emitters, emitters);
+        if (!readerBytes(reader, system->emitters, sizeof(ParticleEmitter) * emitters)) return false;
+    }
+    count = readerU32(reader);
+    if (!countOkay(reader, count)) return false;
+    repeat(count, i) {
+        CallLaterEntry entry = {0};
+        if (!readerBytes(reader, &entry, sizeof(entry))) return false;
+        entry.callback = readRValue(reader, runner, 0);
+        if (reader->error) { RValue_free(&entry.callback); return false; }
+        arrput(runner->callLaterEntries, entry);
+    }
+    return true;
+}
