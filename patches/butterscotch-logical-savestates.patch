+static bool writeDataStructures(FastWriter* writer, Runner* runner) {
+    uint32_t count = (uint32_t)arrlen(runner->dsMapPool);
+    if (!writerU32(writer, count)) return false;
+    repeat(count, i) {
+        DsMapEntry* map = runner->dsMapPool[i];
+        uint8_t present = map != nullptr;
+        if (!writerU8(writer, present)) return false;
+        if (!present) continue;
+        uint32_t entries = (uint32_t)shlen(map);
+        if (!writerU32(writer, entries)) return false;
+        repeat(entries, j) {
+            if (!writeString(writer, map[j].key) ||
+                !writeRValue(writer, map[j].value, 0)) return false;
+        }
+    }
+#define WRITE_SIMPLE_POOL(poolName) do { \
+    count = (uint32_t)arrlen(runner->poolName); \
+    if (!writerU32(writer, count)) return false; \
+    repeat(count, i) { \
+        if (!writerU8(writer, runner->poolName[i].freed) || \
+            !writeRValueArray(writer, runner->poolName[i].items, \
+                              (uint32_t)arrlen(runner->poolName[i].items))) return false; \
+    } \
+} while (0)
+    WRITE_SIMPLE_POOL(dsListPool);
+    WRITE_SIMPLE_POOL(dsQueuePool);
+    WRITE_SIMPLE_POOL(dsStackPool);
+#undef WRITE_SIMPLE_POOL
+    count = (uint32_t)arrlen(runner->dsPriorityPool);
+    if (!writerU32(writer, count)) return false;
+    repeat(count, i) {
+        DsPriority* priority = &runner->dsPriorityPool[i];
+        uint32_t items = (uint32_t)arrlen(priority->items);
+        if (!writerU8(writer, priority->freed) || !writerU32(writer, items)) return false;
+        repeat(items, j) {
+            if (!writerBytes(writer, &priority->items[j].depth, sizeof(GMLReal)) ||
+                !writeRValue(writer, priority->items[j].item, 0)) return false;
+        }
+    }
+    count = (uint32_t)arrlen(runner->dsGridPool);
+    if (!writerU32(writer, count)) return false;
+    repeat(count, i) {
+        DsGrid* grid = &runner->dsGridPool[i];
+        uint64_t items = (uint64_t)(uint32_t)grid->width * (uint64_t)(uint32_t)grid->height;
+        if (items > FAST_STATE_MAX_COUNT || !writerU8(writer, grid->freed) ||
+            !writerI32(writer, grid->width) || !writerI32(writer, grid->height)) {
+            if (!writer->error) writer->error = EFBIG;
+            return false;
+        }
+        repeat((uint32_t)items, j)
+            if (!writeRValue(writer, grid->items[j], 0)) return false;
+    }
+    return true;
+}
+
+static bool readDataStructures(FastReader* reader, Runner* runner) {
+    uint32_t count = readerU32(reader);
+    if (!countOkay(reader, count)) return false;
+    arrsetlen(runner->dsMapPool, count);
+    memset(runner->dsMapPool, 0, sizeof(*runner->dsMapPool) * count);
+    repeat(count, i) {
+        if (!readerU8(reader)) continue;
+        uint32_t entries = readerU32(reader);
+        if (!countOkay(reader, entries)) return false;
+        repeat(entries, j) {
+            char* key = readString(reader);
+            RValue value = readRValue(reader, runner, 0);
+            if (reader->error) { free(key); RValue_free(&value); return false; }
+            shput(runner->dsMapPool[i], key, value);
+        }
+    }
+#define READ_SIMPLE_POOL(poolName, poolType) do { \
+    count = readerU32(reader); \
+    if (!countOkay(reader, count)) return false; \
+    arrsetlen(runner->poolName, count); \
+    memset(runner->poolName, 0, sizeof(poolType) * count); \
+    repeat(count, i) { \
+        runner->poolName[i].freed = readerU8(reader) != 0; \
+        if (!readRValueArray(reader, runner, &runner->poolName[i].items)) return false; \
+    } \
+} while (0)
+    READ_SIMPLE_POOL(dsListPool, DsList);
+    READ_SIMPLE_POOL(dsQueuePool, DsQueue);
+    READ_SIMPLE_POOL(dsStackPool, DsStack);
+#undef READ_SIMPLE_POOL
+    count = readerU32(reader);
+    if (!countOkay(reader, count)) return false;
+    arrsetlen(runner->dsPriorityPool, count);
+    memset(runner->dsPriorityPool, 0, sizeof(DsPriority) * count);
+    repeat(count, i) {
+        DsPriority* priority = &runner->dsPriorityPool[i];
+        priority->freed = readerU8(reader) != 0;
+        uint32_t items = readerU32(reader);
+        if (!countOkay(reader, items)) return false;
+        repeat(items, j) {
+            DsPriorityItem item = {0};
+            readerBytes(reader, &item.depth, sizeof(GMLReal));
+            item.item = readRValue(reader, runner, 0);
+            if (reader->error) { RValue_free(&item.item); return false; }
+            arrput(priority->items, item);
+        }
+    }
+    count = readerU32(reader);
+    if (!countOkay(reader, count)) return false;
+    arrsetlen(runner->dsGridPool, count);
+    memset(runner->dsGridPool, 0, sizeof(DsGrid) * count);
+    repeat(count, i) {
+        DsGrid* grid = &runner->dsGridPool[i];
+        grid->freed = readerU8(reader) != 0;
+        grid->width = readerI32(reader); grid->height = readerI32(reader);
+        uint64_t items = (uint64_t)(uint32_t)grid->width * (uint64_t)(uint32_t)grid->height;
+        if (grid->width < 0 || grid->height < 0 || items > FAST_STATE_MAX_COUNT) {
+            reader->error = EBADMSG; return false;
+        }
+        grid->items = items ? (RValue*)calloc((size_t)items, sizeof(RValue)) : nullptr;
+        if (items && grid->items == nullptr) { reader->error = ENOMEM; return false; }
+        repeat((uint32_t)items, j) {
+            grid->items[j] = readRValue(reader, runner, 0);
+            if (reader->error) return false;
+        }
+    }
+    return true;
+}
