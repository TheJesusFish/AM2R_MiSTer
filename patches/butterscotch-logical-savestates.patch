+static bool writeRValueArray(FastWriter* writer, RValue* values, uint32_t count) {
+    if (!writerU32(writer, count)) return false;
+    repeat(count, i) if (!writeRValue(writer, values[i], 0)) return false;
+    return true;
+}
+
+static bool readRValueArray(FastReader* reader, Runner* runner, RValue** values) {
+    uint32_t count = readerU32(reader);
+    if (!countOkay(reader, count)) return false;
+    repeat(count, i) {
+        RValue value = readRValue(reader, runner, 0);
+        if (reader->error) { RValue_free(&value); return false; }
+        arrput(*values, value);
+    }
+    return true;
+}
