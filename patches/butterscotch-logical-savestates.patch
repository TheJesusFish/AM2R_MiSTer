+static bool writeAudio(FastWriter* writer, Runner* runner) {
+    MaAudioSystem* audio = (MaAudioSystem*)runner->audioSystem;
+    if (!audio->checkpointValid) { writer->error = EIO; return false; }
+    if (!writerI32(writer, audio->nextInstanceCounter) ||
+        !writerBytes(writer, audio->listenerGains, sizeof(audio->listenerGains)) ||
+        !writerBytes(writer, audio->checkpoint, sizeof(audio->checkpoint))) return false;
+    repeat(MAX_AUDIO_STREAMS, i) {
+        AudioStreamEntry* stream = &audio->streams[i];
+        if (!writerU8(writer, stream->active)) return false;
+        if (!stream->active) continue;
+        if (!writerBytes(writer, &stream->initialGain, sizeof(float)) ||
+            !writerBytes(writer, &stream->initialPitch, sizeof(float)) ||
+            !writeString(writer, stream->filePath)) return false;
+    }
+    return true;
+}
+
+static bool readAudio(FastReader* reader, Runner* runner) {
+    MaAudioSystem* audio = (MaAudioSystem*)runner->audioSystem;
+    audio->nextInstanceCounter = readerI32(reader);
+    if (!readerBytes(reader, audio->listenerGains, sizeof(audio->listenerGains)) ||
+        !readerBytes(reader, audio->checkpoint, sizeof(audio->checkpoint))) return false;
+    repeat(MAX_AUDIO_STREAMS, i) {
+        free(audio->streams[i].filePath);
+        memset(&audio->streams[i], 0, sizeof(audio->streams[i]));
+        audio->streams[i].active = readerU8(reader) != 0;
+        if (!audio->streams[i].active) continue;
+        if (!readerBytes(reader, &audio->streams[i].initialGain, sizeof(float)) ||
+            !readerBytes(reader, &audio->streams[i].initialPitch, sizeof(float))) return false;
+        audio->streams[i].filePath = readString(reader);
+        if (reader->error) return false;
+    }
+    audio->checkpointValid = true;
+    return true;
+}
+
+static bool writeOpenTextFiles(FastWriter* writer, Runner* runner) {
+    repeat(MAX_OPEN_TEXT_FILES, i) {
+        OpenTextFile* file = &runner->openTextFiles[i];
+        if (!writerU8(writer, file->isOpen)) return false;
+        if (!file->isOpen) continue;
+        if (!writerU8(writer, file->isWriteMode) ||
+            !writerI32(writer, file->readPos) ||
+            !writeString(writer, file->content) ||
+            !writeString(writer, file->writeBuffer) ||
+            !writeString(writer, file->filePath)) return false;
+    }
+    return true;
+}
+
+static bool readOpenTextFiles(FastReader* reader, Runner* runner) {
+    repeat(MAX_OPEN_TEXT_FILES, i) {
+        OpenTextFile* file = &runner->openTextFiles[i];
+        bool isOpen = readerU8(reader) != 0;
+        if (reader->error) return false;
+        if (!isOpen) continue;
+
+        file->isWriteMode = readerU8(reader) != 0;
+        file->readPos = readerI32(reader);
+        file->content = readString(reader);
+        file->writeBuffer = readString(reader);
+        file->filePath = readString(reader);
+        if (reader->error) return false;
+        file->contentLen = (int32_t)strlen(file->content);
+        if (file->readPos < 0 || file->readPos > file->contentLen) {
+            reader->error = EBADMSG;
+            return false;
+        }
+        file->isOpen = true;
+    }
+    return true;
+}
