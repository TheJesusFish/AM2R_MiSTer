+    worldToScreen(sw, wx0, wy0, &sx0, &sy0);
+    worldToScreen(sw, wx1, wy1, &sx1, &sy1);
+    return swAxisBoundsOutsideScissor(sx0, sy0, sx1, sy1,
+                                     sw->scissorX, sw->scissorY,
+                                     sw->scissorW, sw->scissorH);
