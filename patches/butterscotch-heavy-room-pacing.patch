+                                                GMLReal left, GMLReal top,
+                                                GMLReal right, GMLReal bottom,
+                                                int32_t target) {
+    SpatialGrid_syncGrid(runner, runner->spatialGrid);
+    SpatialGridQuery query = SpatialGrid_prepareQuery(
+        runner, left, top, right, bottom, target);
+
+    for (int32_t gx = query.range.minGridX;
+         gx <= query.range.maxGridX; ++gx) {
+        for (int32_t gy = query.range.minGridY;
+             gy <= query.range.maxGridY; ++gy) {
+            Instance** cell = runner->spatialGrid->grid[
+                SpatialGrid_cellIndex(runner->spatialGrid, gx, gy)];
+            repeat(arrlen(cell), ci) {
+                Instance* inst = cell[ci];
+                if (inst->lastCollisionQueryId == query.queryId) continue;
+                if (!inst->active || inst->destroyed) continue;
+                if (!query.matchAll && query.filterByObject &&
+                    !VM_isObjectOrDescendant(runner->dataWin,
+                                             inst->objectIndex, target))
+                    continue;
+                if (!query.matchAll && query.filterByInstanceId &&
+                    inst->instanceId != (uint32_t)target)
+                    continue;
+                inst->lastCollisionQueryId = query.queryId;
+            }
+        }
+    }
+    return query.queryId;
+}
