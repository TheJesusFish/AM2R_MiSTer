+// Conservative geometry-level rejection for an axis-aligned quad. Touching a
+// scissor edge cannot cover a pixel inside its half-open rectangle.
+static inline bool swAxisBoundsOutsideScissor(float x0, float y0,
+                                              float x1, float y1,
+                                              int32_t scissorX,
+                                              int32_t scissorY,
+                                              int32_t scissorW,
+                                              int32_t scissorH)
+{
+    const float minX = fminf(x0, x1);
+    const float minY = fminf(y0, y1);
+    const float maxX = fmaxf(x0, x1);
+    const float maxY = fmaxf(y0, y1);
+    const float scissorRight = (float)(scissorX + scissorW);
+    const float scissorBottom = (float)(scissorY + scissorH);
+    return maxX <= (float)scissorX || minX >= scissorRight ||
+           maxY <= (float)scissorY || minY >= scissorBottom;
+}
