+// An instance inserted into a cell necessarily intersects that cell. If any
+// tracked cell is wholly inside an activation region, the instance overlaps
+// the region without requiring its comparatively expensive exact sprite bbox.
+static inline bool SpatialGrid_instanceHasCellFullyInsideBounds(
+    Instance* instance, GMLReal left, GMLReal top,
+    GMLReal right, GMLReal bottom) {
+    repeat(arrlen(instance->collisionCells), i) {
+        GMLReal cellLeft = (GMLReal)SpatialGrid_unpackGridX(instance->collisionCells[i]) *
+                           SPATIAL_GRID_CELL_SIZE;
+        GMLReal cellTop = (GMLReal)SpatialGrid_unpackGridY(instance->collisionCells[i]) *
+                          SPATIAL_GRID_CELL_SIZE;
+        GMLReal cellRight = cellLeft + SPATIAL_GRID_CELL_SIZE - 1;
+        GMLReal cellBottom = cellTop + SPATIAL_GRID_CELL_SIZE - 1;
+        if (cellLeft >= left && cellRight <= right &&
+            cellTop >= top && cellBottom <= bottom)
+            return true;
+    }
+    return false;
+}
