 }
+
+void RD_cropUpload(const uint8_t* shadow, const uint8_t* source,
+                   size_t sourceStride, size_t cropRowBytes, size_t rows) {
+    if (!cropFrames || !current) return;
+    RD_CropFrame* frame = &cropFrames[used];
+    uint32_t ordinal = frame->seen++;
+    if (frame->count == RD_CROP_RECORDS || !shadow || !source || !cropRowBytes ||
+        cropRowBytes > RD_CROP_MAX_ROW_BYTES || !rows || rows > RD_CROP_MAX_ROWS ||
+        sourceStride < cropRowBytes || sourceStride > UINT32_MAX ||
+        sourceStride > SIZE_MAX / rows || cropRowBytes > RD_CROP_MAX_BYTES / rows) {
+        ++frame->dropped;
+        return;
+    }
+    RD_CropRecord* record = &frame->records[frame->count++];
+    record->ordinal = ordinal;
+    record->stride = (uint32_t)sourceStride;
+    record->width = (uint32_t)cropRowBytes;
+    record->rows = (uint32_t)rows;
+    const uint64_t begin = rdNow();
+    for (size_t y = 0; y < rows; ++y) {
+        const uint8_t* a = shadow + y * cropRowBytes;
+        const uint8_t* b = source + y * sourceStride;
+        size_t first = cropRowBytes, previousEnd = 0;
+        for (size_t p = 0; p < cropRowBytes; p += 4) {
+            size_t bytes = cropRowBytes - p < 4 ? cropRowBytes - p : 4;
+            if (memcmp(a + p, b + p, bytes) == 0) continue;
+            record->changedBytes += bytes;
+            if (first == cropRowBytes) {
+                first = p;
+                ++record->singleCalls;
+                for (uint32_t t = 0; t < RD_CROP_THRESHOLDS; ++t)
+                    ++record->predictedCalls[t];
+            } else {
+                size_t gap = p - previousEnd;
+                record->gapBytes += gap;
+                for (uint32_t t = 0; t < RD_CROP_THRESHOLDS; ++t) {
+                    if (gap <= cropThresholds[t]) record->predictedBytes[t] += gap;
+                    else ++record->predictedCalls[t];
+                }
+            }
+            for (uint32_t t = 0; t < RD_CROP_THRESHOLDS; ++t)
+                record->predictedBytes[t] += bytes;
+            previousEnd = p + bytes;
+        }
+        if (first != cropRowBytes) record->singleBytes += previousEnd - first;
+    }
+    record->nanos = rdNow() - begin;
+}
 #endif
