+    fputc('\n', cropOutput);
+    for (uint32_t i = 0; i < used; ++i) {
+        RD_Frame* frame = &frames[i];
+        RD_CropFrame* crop = &cropFrames[i];
+        // A summary row establishes coverage even for zero observations or all
+        // rejected/overflowed calls. Zero-valued summary metrics are not samples.
+        for (uint32_t j = 0; j <= crop->count; ++j) {
+            RD_CropRecord empty = {0};
+            RD_CropRecord* record = j == 0 ? &empty : &crop->records[j - 1];
+            fprintf(cropOutput, "%" PRIu64 ",%d,%d,%u,%s,%d,%u,%u,%u,%u,%u,%u,%" PRIu64 ",%u,%" PRIu64 ",%" PRIu64 ",%" PRIu64 ",1",
+                frame->start - origin, frame->frame, frame->room, frame->input,
+                j == 0 ? "summary" : "upload", j == 0 ? -1 : (int)record->ordinal,
+                crop->seen, crop->count, crop->dropped,
+                record->stride, record->width, record->rows, record->singleBytes,
+                record->singleCalls, record->changedBytes, record->gapBytes, record->nanos);
+            for (uint32_t t = 0; t < RD_CROP_THRESHOLDS; ++t)
+                fprintf(cropOutput, ",%" PRIu64 ",%u", record->predictedBytes[t], record->predictedCalls[t]);
+            fputc('\n', cropOutput);
+        }
+    }
+    int failed = ferror(cropOutput);
+    if (fclose(cropOutput) != 0) failed = 1;
+    fprintf(stderr, "AM2R crop gaps: %u frames, output %s (predictions only; timings perturbed)\n",
+            used, failed ? "FAILED (discard incomplete CSV)" : "complete");
+    cropOutput = NULL;
