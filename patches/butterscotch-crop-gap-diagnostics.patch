+static void openCropFrames(const char* path, uint32_t wanted) {
+    const char* requested = getenv("AM2R_CROP_GAPS");
+    if (!requested || strcmp(requested, "1") != 0) return;
+    char name[1024];
+    if (snprintf(name, sizeof(name), "%s/render-crop.csv", path) >= (int)sizeof(name)) return;
+    RD_CropFrame* allocation = calloc(wanted, sizeof(*allocation));
+    if (!allocation) {
+        fputs("AM2R crop gaps: unavailable (allocation failed)\n", stderr);
+        return;
+    }
+    int fd = open(name, O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC | O_NOFOLLOW, 0600);
+    if (fd < 0) {
+        free(allocation);
+        fputs("AM2R crop gaps: unavailable (exclusive output creation failed)\n", stderr);
+        return;
+    }
+    cropOutput = fdopen(fd, "w");
+    if (!cropOutput) { close(fd); free(allocation); return; }
+    cropFrames = allocation;
+    fprintf(stderr, "AM2R crop gaps: enabled, at most %u uploads/frame; timings perturbed\n", RD_CROP_RECORDS);
