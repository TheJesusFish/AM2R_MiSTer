+static void flushCropFrames(void) {
+    if (!cropFrames || !cropOutput) return;
+    fputs("elapsed_ns,frame,room,input_mask,record_kind,upload_ordinal,seen_uploads,recorded_uploads,dropped_uploads,source_stride,crop_row_bytes,rows,single_span_bytes,single_span_calls,changed_pixel_bytes,interior_gap_bytes,measurement_ns,timing_perturbed", cropOutput);
+    for (uint32_t t = 0; t < RD_CROP_THRESHOLDS; ++t)
