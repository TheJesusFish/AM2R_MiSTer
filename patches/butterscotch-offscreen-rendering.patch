+    record->revision = g_gpu_offscreen_revision;
+    record->committed_frame = g_gpu_frame_serial;
+    g_gpu_scene_start = g_gpu_command_count;
+    g_gpu_offscreen_index = UINT32_MAX;
+    g_gpu_offscreen_key = NULL;
+    g_gpu_offscreen_needs_scene_clear = true;
+    return physical;
+}
