+        g_gpu_commands[g_gpu_offscreen_start].word[0] == 1u;
+    for (uint32_t i = g_gpu_offscreen_start + 1u;
+         i < g_gpu_command_count && valid; ++i) {
+        const MisterGpuCommand* command = &g_gpu_commands[i];
+        uint32_t opcode = (uint8_t)command->word[0];
+        uint32_t flags = (uint16_t)command->word[0] & ~0xffu;
+        if ((flags & (1u << 10)) && opcode == 2u && g_gpu_floor_tint)
+            flags &= ~(1u << 10);
