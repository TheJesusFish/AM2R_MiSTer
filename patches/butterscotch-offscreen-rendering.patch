+bool MisterGpu_beginOffscreen(const void* key, uint32_t revision) {
+    if (!g_gpu_available || !g_gpu_frame_open || !g_gpu_offscreen_allowed ||
+        key == NULL || g_gpu_offscreen_index != UINT32_MAX ||
+        g_gpu_command_count != g_gpu_scene_start ||
+        g_gpu_command_count > GPU_COMMAND_CAPACITY - 4u)
+        return false;
+
+    uint32_t selected = UINT32_MAX;
+    for (uint32_t i = 0; i < GPU_OFFSCREEN_RECORDS; ++i) {
+        MisterGpuOffscreen* record = &g_gpu_offscreen[i];
+        if (record->key == key) {
+            // A second version in one command list would overwrite the first
+            // before scene commands have sampled it. Materialize on CPU instead.
+            if (record->committed_frame == g_gpu_frame_serial) return false;
+            selected = i;
+            break;
+        }
+        if (selected == UINT32_MAX && record->key == NULL &&
+            record->committed_frame != g_gpu_frame_serial)
+            selected = i;
+    }
+    if (selected == UINT32_MAX) return false;
+    MisterGpuOffscreen* record = &g_gpu_offscreen[selected];
+    if (record->physical[0] == 0) {
+        // Reserve both command-bank copies atomically. No CPU writes target
+        // this storage. The preceding job owns the opposite command bank;
+        // released entries therefore need no overlap-destroying wait here.
+        uint32_t physical = reserveGpuTexture(
+            MISTER_FB_BYTES * GPU_COMMAND_BUFFER_COUNT);
+        if (physical == 0) return false;
+        for (uint32_t bank = 0; bank < GPU_COMMAND_BUFFER_COUNT; ++bank)
+            record->physical[bank] = physical + bank * (uint32_t)MISTER_FB_BYTES;
+    }
+    g_gpu_offscreen_index = selected;
+    g_gpu_offscreen_key = key;
+    g_gpu_offscreen_revision = revision;
+    g_gpu_offscreen_start = g_gpu_command_count;
+    return true;
+}
+
+void MisterGpu_abortOffscreen(void) {
+    if (g_gpu_offscreen_index == UINT32_MAX) return;
+    g_gpu_command_count = g_gpu_offscreen_start;
+    g_gpu_offscreen_index = UINT32_MAX;
+    g_gpu_offscreen_key = NULL;
