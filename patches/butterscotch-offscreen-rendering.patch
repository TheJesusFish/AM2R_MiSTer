+// The first offscreen client is AM2R's 512x256 lighting surface. Its public
+// dimensions never change: only a proved 320x240 sample uses the GPU crop.
+// Unknown operations materialize the complete journal before touching pixels.
+// Atlas pointers are immutable for the renderer lifetime; surface sources are
+// deliberately not journaled (they require independent dependency snapshots).
+#define SW_OFFSCREEN_MAX_OPS 256u
+typedef struct {
+    MisterOffscreenAxis axis;
+    uint32_t address;
+    bool textured;
+    bool subtract;
+} SWOffscreenOperation;
+
+struct SWOffscreenJournal {
+    bool active;
+    uint32_t clear;
+    uint32_t count;
+    SWOffscreenOperation operations[SW_OFFSCREEN_MAX_OPS];
+};
+
+static void swMarkSurfaceWrite(SWRenderer* sw, int32_t id);
+
+static void swOffscreenDiscard(SWRenderer* sw, int32_t id) {
+    if (id < 0 || (uint32_t)id >= sw->surfaceCount) return;
+    SWOffscreenJournal* journal = sw->offscreenJournals[id];
+    if (journal) { journal->active = false; journal->count = 0; }
+    MisterGpu_releaseOffscreen(sw->surfacePixels[id]);
+}
+
+static void swOffscreenReplay(const SWOffscreenJournal* journal,
+        uint32_t* pixels, int32_t width, int32_t height) {
+    for (size_t i = 0; i < (size_t)width * height; ++i) pixels[i] = journal->clear;
+    for (uint32_t i = 0; i < journal->count; ++i) {
+        const SWOffscreenOperation* operation = &journal->operations[i];
+        const MisterOffscreenAxis* axis = &operation->axis;
+        if (operation->textured) {
+            // Operations are validated before recording; replay cannot fail.
+            // Use the same optimized spans as the immediate renderer.
+            for (int32_t y = axis->y; y < axis->y + axis->height; ++y) {
+                int32_t sy = (int32_t)(axis->sourceY0 +
+                    (((double)y + 0.5) - axis->vertexY0) * axis->sourceDy);
+                if (sy < 0) sy = 0;
+                if (sy >= axis->sourceHeight) sy = axis->sourceHeight - 1;
+                blendSubtractTextureSpan(pixels + (size_t)y * width + axis->x,
+                    axis->source + (size_t)sy * axis->sourceWidth,
+                    axis->sourceWidth, axis->startU, axis->stepU, axis->width,
+                    axis->tint, axis->tint >> 8, axis->tint >> 16, axis->tint >> 24);
+            }
+        } else {
+            for (int32_t y = axis->y; y < axis->y + axis->height; ++y) {
+                uint32_t* row = pixels + (size_t)y * width + axis->x;
+                if (operation->subtract)
+                    blendSubtractSolidSpan(row, axis->width, axis->tint,
+                        axis->tint >> 8, axis->tint >> 16, axis->tint >> 24);
+                else for (int32_t x = 0; x < axis->width; ++x) row[x] = axis->tint;
+            }
+        }
+    }
+}
+
+static void swOffscreenMaterialize(SWRenderer* sw, int32_t id) {
+    if (id < 0 || (uint32_t)id >= sw->surfaceCount) return;
+    SWOffscreenJournal* journal = sw->offscreenJournals[id];
+    if (!journal || !journal->active) return;
+    swOffscreenReplay(journal, (uint32_t*)sw->surfacePixels[id],
+        sw->surfaceWidths[id], sw->surfaceHeights[id]);
+    swOffscreenDiscard(sw, id);
+}
+
+#if defined(MISTER_RENDER_DIAGNOSTICS)
+bool SWRenderer_misterOffscreenReference(Renderer* renderer, uint32_t address,
+        uint8_t* crop) {
+    SWRenderer* sw = (SWRenderer*)renderer;
+    if (!sw || !crop || !address) return false;
+    for (uint32_t id = 0; id < sw->surfaceCount; ++id) {
+        const SWOffscreenJournal* journal = sw->offscreenJournals[id];
+        if (!journal || !journal->active ||
+            MisterGpu_findOffscreen(sw->surfacePixels[id], sw->surfaceRevisions[id]) != address)
+            continue;
+        const int32_t width = sw->surfaceWidths[id], height = sw->surfaceHeights[id];
+        uint32_t* full = safeMalloc((size_t)width * height * 4u);
+        swOffscreenReplay(journal, full, width, height);
+        for (int32_t y = 0; y < 240; ++y)
+            memcpy(crop + (size_t)y * 1280u, full + (size_t)y * width, 1280u);
+        free(full);
+        return true;
+    }
+    return false;
+}
+#endif
+
+static void swOffscreenMaterializeSource(SWRenderer* sw, const uint8_t* source) {
+    if (!sw->offscreenEnabled || !source) return;
+    for (uint32_t id = 0; id < sw->surfaceCount; ++id) {
+        if (!sw->surfaceExistsFlags[id]) continue;
+        const uintptr_t base = (uintptr_t)sw->surfacePixels[id];
+        const size_t bytes = (size_t)sw->surfaceWidths[id] * sw->surfaceHeights[id] * 4u;
+        if ((uintptr_t)source >= base && (uintptr_t)source - base < bytes) {
+            swOffscreenMaterialize(sw, (int32_t)id);
+            return;
+        }
+    }
+}
+
+void SWRenderer_materializeSurfaces(Renderer* renderer) {
+    SWRenderer* sw = (SWRenderer*)renderer;
+    if (!sw) return;
+    for (uint32_t id = 0; id < sw->surfaceCount; ++id)
+        swOffscreenMaterialize(sw, (int32_t)id);
+}
+
+static bool swOffscreenClear(SWRenderer* sw, uint32_t rgba) {
+    const int32_t id = sw->currentSurface;
+    if (!sw->offscreenEnabled || !MisterGpu_isAvailable() || id <= 0 ||
+        id == sw->base.runner->applicationSurfaceId || sw->fbWidth != 512 ||
+        sw->fbHeight != 256) return false;
+    swOffscreenDiscard(sw, id);
+    if (!sw->offscreenJournals[id])
+        sw->offscreenJournals[id] = safeCalloc(1, sizeof(SWOffscreenJournal));
+    SWOffscreenJournal* journal = sw->offscreenJournals[id];
+    journal->clear = rgba;
+    journal->count = 0;
+    journal->active = true;
+    swMarkSurfaceWrite(sw, id);
+    return true;
+}
+
+static bool swOffscreenTryAxis(SWRenderer* sw, SWVertex v[4],
+        const uint8_t* source, int32_t texW, int32_t texH,
+        int32_t minX, int32_t minY, int32_t maxX, int32_t maxY,
+        bool compatible, uint32_t tint) {
+    const int32_t id = sw->currentSurface;
+    if (id < 0 || (uint32_t)id >= sw->surfaceCount) return false;
+    SWOffscreenJournal* journal = sw->offscreenJournals[id];
+    if (!journal || !journal->active || !compatible ||
+        journal->count == SW_OFFSCREEN_MAX_OPS) return false;
+    SWOffscreenOperation op = {0};
+    op.axis.x = minX; op.axis.y = minY;
+    op.axis.width = maxX-minX; op.axis.height = maxY-minY;
+    op.axis.tint = tint;
+    op.subtract = sw->blendEnable && sw->blendMode == bm_subtract;
+    if (source) {
+        if (!op.subtract || texW <= 0 || texH <= 0) return false;
+        for (uint32_t page = 0; page < sw->textureCount; ++page)
+            if (source == sw->texturePixels[page]) op.address = sw->gpuTextureAddresses[page];
+        if (!op.address) return false;
+        const float dx = v[1].x-v[0].x, dy = v[3].y-v[0].y;
+        const double sx = (double)v[0].u*texW;
+        const double du = (double)(v[1].u-v[0].u)*texW/dx;
+        const double start = (sx+(((double)minX+0.5)-v[0].x)*du)*65536.0;
+        const double step = du*65536.0;
+        op.axis.sourceY0 = (double)v[0].v*texH;
+        op.axis.sourceDy = (double)(v[3].v-v[0].v)*texH/dy;
+        op.axis.vertexY0 = v[0].y;
+        // Conservative bounded UVs make both signed conversion and replay
+        // safe. Unusual coordinates retain the original immediate path.
+        if (!isfinite(start) || !isfinite(step) || fabs(start)>1.0e12 ||
+            fabs(step)>1.0e9 || !isfinite(op.axis.sourceY0) ||
+            !isfinite(op.axis.sourceDy) || fabs(op.axis.sourceY0)>1.0e8 ||
+            fabs(op.axis.sourceDy)>1.0e5 || fabs(op.axis.vertexY0)>1.0e4)
+            return false;
+        op.axis.startU = (int64_t)start; op.axis.stepU = (int64_t)step;
+        op.axis.source = (const uint32_t*)source;
+        op.axis.sourceWidth = texW; op.axis.sourceHeight = texH;
+        op.textured = true;
+    } else {
+        if ((tint >> 24) != 255u ||
+            (sw->blendEnable && sw->blendMode != bm_normal && !op.subtract)) return false;
+    }
+    journal->operations[journal->count++] = op;
+    swMarkSurfaceWrite(sw, id);
+    return true;
+}
+
+static void swOffscreenEmitPending(SWRenderer* sw) {
+    if (!sw->offscreenEnabled) return;
+    for (uint32_t id = 0; id < sw->surfaceCount; ++id) {
+        SWOffscreenJournal* journal = sw->offscreenJournals[id];
+        if (!journal || !journal->active) continue;
+        // A fully covered, solid prefix still describes one constant crop.
+        // Fold it with the exact CPU channel operation before clearing BRAM.
+        // The logical journal retains every operation and all 512x256 pixels.
+        uint32_t clear = journal->clear, first = 0;
+        while (first < journal->count) {
+            const SWOffscreenOperation* op = &journal->operations[first];
+            if (op->textured || op->axis.x != 0 || op->axis.y != 0 ||
+                op->axis.width < 320 || op->axis.height < 240) break;
+            if (op->subtract) {
+                uint32_t result = 0;
+                for (unsigned shift = 0; shift < 32; shift += 8)
+                    result |= ((((clear >> shift) & 255u) *
+                        (255u - ((op->axis.tint >> shift) & 255u))) / 255u) << shift;
+                clear = result;
+            } else clear = op->axis.tint;
+            ++first;
+        }
+        bool ok = MisterGpu_beginOffscreen(sw->surfacePixels[id], sw->surfaceRevisions[id]);
+        if (ok) ok = MisterGpu_addClear(clear);
+        for (uint32_t i = first; ok && i < journal->count; ++i) {
+            const SWOffscreenOperation* op = &journal->operations[i];
+            if (op->textured) {
+                MisterOffscreenBlit blits[240];
+                size_t count = 0;
+                const bool floorTint = MisterGpu_hasFloorTint();
+                ok = MisterOffscreen_planAxisTint(&op->axis, 0, 0, 320, 240,
+                                               blits, 240, &count, floorTint);
+#if defined(MISTER_RENDER_DIAGNOSTICS)
+                if (!ok && sw->offscreenLogCount < 24)
+                    fprintf(stderr, "MiSTer offscreen reject: op=%u tint=%08x rect=%d,%d/%dx%d uv=%lld/%lld\n",
+                        i, op->axis.tint, op->axis.x, op->axis.y, op->axis.width,
+                        op->axis.height, (long long)op->axis.startU, (long long)op->axis.stepU);
+#endif
+                for (size_t b = 0; ok && b < count; ++b) {
+                    const MisterOffscreenBlit* blit = &blits[b];
+                    bool (*addBlit)(uint32_t, uint32_t, int16_t, int16_t,
+                        uint16_t, uint16_t, int32_t, int32_t, int32_t, int32_t,
+                        uint32_t, uint8_t) = floorTint ?
+                        MisterGpu_addBlitFloorTint : MisterGpu_addBlit;
+                    ok = addBlit(op->address, op->axis.sourceWidth*4u,
+                        blit->x, blit->y, blit->width, blit->height,
+                        blit->u, blit->v, blit->du, blit->dv,
+                        op->axis.tint, MISTER_GPU_BLEND_SUBTRACT);
+                }
+            } else {
+                const int32_t x = op->axis.x, y = op->axis.y;
+                int32_t x1 = x+op->axis.width, y1 = y+op->axis.height;
+                if (x1 > 320) x1 = 320; if (y1 > 240) y1 = 240;
+                if (x < x1 && y < y1)
+                    ok = MisterGpu_addFill(x, y, x1-x, y1-y, op->axis.tint,
+                        op->subtract ? MISTER_GPU_BLEND_SUBTRACT : MISTER_GPU_BLEND_NORMAL);
+            }
+        }
+        uint32_t address = ok ? MisterGpu_commitOffscreen() : 0;
+        if (!address) MisterGpu_abortOffscreen();
+#if defined(MISTER_RENDER_DIAGNOSTICS)
+        if (sw->offscreenLogCount < 24) {
+            fprintf(stderr, "MiSTer offscreen: id=%u ops=%u export=%08x revision=%u\n",
+                id, journal->count, address, sw->surfaceRevisions[id]);
+            sw->offscreenLogCount++;
+        }
+#endif
+        if (!address) swOffscreenMaterialize(sw, (int32_t)id);
+    }
+}
+
+static bool swOffscreenTryConsume(SWRenderer* sw, SWVertex v[4],
+        const uint8_t* source, int32_t texW, int32_t texH,
+        int32_t minX, int32_t minY, int32_t maxX, int32_t maxY,
+        bool compatible, uint32_t tint, uint8_t blend) {
+    if (!sw->offscreenEnabled || !source || !compatible || !sw->gpuFrameEligible || !sw->gpuSawClear ||
+        !swGpuIsOutputTarget(sw) || !sw->blendEnable || texW != 512 || texH != 256 ||
+        minX != 0 || minY != 0 || maxX != 320 || maxY != 240) return false;
+    const double dx = v[1].x-v[0].x, dy = v[3].y-v[0].y;
+    const double du = (double)(v[1].u-v[0].u)*texW/dx;
+    const double dv = (double)(v[3].v-v[0].v)*texH/dy;
+    if (du != 1.0 || dv != 1.0 ||
+        (double)v[0].u*texW+(0.5-v[0].x)*du != 0.5 ||
+        (double)v[0].v*texH+(0.5-v[0].y)*dv != 0.5) return false;
+    for (uint32_t id = 0; id < sw->surfaceCount; ++id) {
+        if (!sw->surfaceExistsFlags[id] || sw->surfacePixels[id] != source) continue;
+        const uint32_t address = MisterGpu_findOffscreen(source, sw->surfaceRevisions[id]);
+        if (!address) return false;
+        if (!MisterGpu_addBlit(address, 1280, 0, 0, 320, 240,
+            0x8000, 0x8000, 0x10000, 0x10000, tint, blend)) return false;
+        sw->gpuHasSkippedDraws = true;
+        return true;
+    }
+    return false;
+}
