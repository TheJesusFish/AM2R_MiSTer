+static bool offscreenAxisSourceIsStable(const MisterGpuCommand* command) {
+    size_t offset = 0;
+    MisterGpuTexture* record = textureRecordForPhysical(
+        (uint32_t)command->word[1], &offset);
+    if (record == NULL || record->dynamic || !record->shadow_valid)
+        return false;
+    uint32_t stride = (uint32_t)(command->word[1] >> 32);
+    if (stride < 4u || (stride & 3u) != 0) return false;
+    int32_t x = (int16_t)command->word[2];
+    int32_t y = (int16_t)(command->word[2] >> 16);
+    int32_t width = (uint16_t)(command->word[0] >> 16);
+    int32_t height = (uint16_t)(command->word[0] >> 32);
+    int32_t x0 = x < 0 ? -x : 0;
+    int32_t y0 = y < 0 ? -y : 0;
+    int32_t x1 = width < MISTER_WIDTH - x ? width : MISTER_WIDTH - x;
+    int32_t y1 = height < MISTER_HEIGHT - y ? height : MISTER_HEIGHT - y;
+    if (x1 <= x0 || y1 <= y0) return true;
+    int64_t u = (int32_t)command->word[4];
+    int64_t v = (int32_t)(command->word[4] >> 32);
+    int64_t du = (int32_t)command->word[5];
+    int64_t dv = (int32_t)(command->word[5] >> 32);
+    int64_t u0 = u + x0 * du, u1 = u + (x1 - 1) * du;
+    int64_t v0 = v + y0 * dv, v1 = v + (y1 - 1) * dv;
+    int64_t minU = u0 < u1 ? u0 : u1, maxU = u0 > u1 ? u0 : u1;
+    int64_t minV = v0 < v1 ? v0 : v1, maxV = v0 > v1 ? v0 : v1;
+    // Prove every sampled byte belongs to this immutable allocation, and that
+    // the RTL's signed 16.16 accumulators cannot wrap on any visible sample.
+    if (minU < 0 || minV < 0 || maxU > INT32_MAX || maxV > INT32_MAX ||
+        (uint64_t)(maxU / 65536) * 4u + 4u > stride)
+        return false;
+    uint64_t last = (uint64_t)offset +
+        (uint64_t)(maxV / 65536) * stride +
+        (uint64_t)(maxU / 65536) * 4u;
+    return last <= record->bytes && 4u <= record->bytes - last;
+}
+
+uint32_t MisterGpu_commitOffscreen(void) {
+    if (g_gpu_offscreen_index == UINT32_MAX) return 0;
+    bool valid = g_gpu_available && g_gpu_frame_open &&
+        g_gpu_command_count > g_gpu_offscreen_start &&
