diff --git a/src/mister_offscreen.c b/src/mister_offscreen.c
new file mode 100644
--- /dev/null
+++ b/src/mister_offscreen.c
@@ -0,0 +1,190 @@
+#include "mister_offscreen.h"
+
+#include <limits.h>
+#include <math.h>
+#include <string.h>
+
+static bool sampleU(const MisterOffscreenAxis* op, int64_t offset,
+                    int64_t* result) {
+    int64_t delta;
+    return !__builtin_mul_overflow(offset, op->stepU, &delta) &&
+           !__builtin_add_overflow(op->startU, delta, result);
+}
+
+static bool sampleRow(const MisterOffscreenAxis* op, int32_t y,
+                      int32_t* result) {
+    const double value = op->sourceY0 +
+        (((double)y + 0.5) - op->vertexY0) * op->sourceDy;
+    // Match the defined range of the CPU int32 cast; reject invalid geometry
+    // before any output can be partially materialized.
+    if (!isfinite(value) || value < INT32_MIN || value > INT32_MAX) return false;
+    int32_t row = (int32_t)value;
+    if (row < 0) row = 0;
+    if (row >= op->sourceHeight) row = op->sourceHeight - 1;
+    *result = row;
+    return true;
+}
+
+static bool valid(const MisterOffscreenAxis* op) {
+    if (!op || !op->source || op->sourceWidth <= 0 ||
+        op->sourceHeight <= 0 || op->sourceWidth > 32767 ||
+        op->sourceHeight > 32767 || op->x < 0 || op->y < 0 ||
+        op->width < 0 || op->height < 0 ||
+        (int64_t)op->x + op->width > INT32_MAX ||
+        (int64_t)op->y + op->height > INT32_MAX ||
+        !isfinite(op->sourceY0) || !isfinite(op->sourceDy) ||
+        !isfinite(op->vertexY0)) return false;
+    int64_t last;
+    if (op->width == 0) return true;
+    if (!sampleU(op, (int64_t)op->width - 1, &last)) return false;
+    // The original CPU path casts the shifted sample to int32 before clamping.
+    // Do not silently choose different behavior for an out-of-range conversion.
+    return (op->startU >> 16) >= INT32_MIN &&
+           (op->startU >> 16) <= INT32_MAX &&
+           (last >> 16) >= INT32_MIN && (last >> 16) <= INT32_MAX;
+}
+
+static uint32_t subtract(uint32_t destination, uint32_t source,
+                         uint32_t tint) {
+    uint32_t result = 0;
+    for (unsigned shift = 0; shift < 32; shift += 8) {
+        const uint32_t sample = ((source >> shift) & 255u) *
+                                ((tint >> shift) & 255u) / 255u;
+        const uint32_t channel = ((destination >> shift) & 255u) *
+                                  (255u - sample) / 255u;
+        result |= channel << shift;
+    }
+    return result;
+}
+
+bool MisterOffscreen_replayAxis(uint32_t* target, int32_t targetWidth,
+                               int32_t targetHeight,
+                               const MisterOffscreenAxis* op) {
+    if (!target || targetWidth <= 0 || targetHeight <= 0 || !valid(op) ||
+        (int64_t)op->x + op->width > targetWidth ||
+        (int64_t)op->y + op->height > targetHeight ||
+        (uint64_t)targetWidth * (uint64_t)targetHeight > SIZE_MAX / 4u)
+        return false;
+    if (!op->width || !op->height) return true;
+    // Validate all Y conversions first so failure is transactional.
+    for (int32_t row = 0; row < op->height; ++row) {
+        int32_t unused;
+        if (!sampleRow(op, op->y + row, &unused)) return false;
+    }
+    for (int32_t row = 0; row < op->height; ++row) {
+        int32_t sy;
+        (void)sampleRow(op, op->y + row, &sy);
+        int64_t u = op->startU;
+        uint32_t* destination = target +
+            (size_t)(op->y + row) * (size_t)targetWidth + (size_t)op->x;
+        const uint32_t* source = op->source +
+            (size_t)sy * (size_t)op->sourceWidth;
+        for (int32_t col = 0; col < op->width; ++col) {
+            int64_t sx = u >> 16;
+            if (sx < 0) sx = 0;
+            if (sx >= op->sourceWidth) sx = op->sourceWidth - 1;
+            // Sample before writing; do not vectorize away self-alias order.
+            const uint32_t pixel = source[sx];
+            destination[col] = subtract(destination[col], pixel, op->tint);
+            if (col + 1 < op->width) u += op->stepU;
+        }
+    }
+    return true;
+}
+
+bool MisterOffscreen_planAxisTint(const MisterOffscreenAxis* op,
+                             int32_t viewX, int32_t viewY,
+                             int32_t viewWidth, int32_t viewHeight,
+                             MisterOffscreenBlit* output, size_t capacity,
+                             size_t* count, bool floorTint) {
+    if (!count) return false;
+    *count = 0;
+    if (!valid(op) || viewX < 0 || viewY < 0 || viewWidth <= 0 ||
+        viewHeight <= 0 || viewWidth > 320 || viewHeight > 240 ||
+        (int64_t)viewX + viewWidth > INT32_MAX ||
+        (int64_t)viewY + viewHeight > INT32_MAX) return false;
+    int32_t left = op->x > viewX ? op->x : viewX;
+    int32_t top = op->y > viewY ? op->y : viewY;
+    int32_t right = op->x + op->width;
+    int32_t bottom = op->y + op->height;
+    if (right > viewX + viewWidth) right = viewX + viewWidth;
+    if (bottom > viewY + viewHeight) bottom = viewY + viewHeight;
+    if (left >= right || top >= bottom) return true;
+    for (unsigned shift = 0; shift < 32; shift += 8) {
+        uint32_t lane = (op->tint >> shift) & 255u;
+        if (!floorTint && lane != 0 && lane != 255) return false;
+    }
+    int64_t u, last;
+    if (!sampleU(op, (int64_t)left - op->x, &u) ||
+        !sampleU(op, (int64_t)right - op->x - 1, &last) ||
+        u < INT32_MIN || u > INT32_MAX ||
+        last < INT32_MIN || last > INT32_MAX ||
+        op->stepU < INT32_MIN || op->stepU > INT32_MAX ||
+        (u >> 16) < 0 || (u >> 16) >= op->sourceWidth ||
+        (last >> 16) < 0 || (last >> 16) >= op->sourceWidth) return false;
+    int32_t rows[MISTER_OFFSCREEN_MAX_BLITS];
+    const int32_t height = bottom - top;
+    for (int32_t row = 0; row < height; ++row)
+        if (!sampleRow(op, top + row, &rows[row])) return false;
+    // A fractional scale usually fits one ordinary 16.16 blit. Prove this
+    // against EVERY CPU-selected row instead of trusting endpoint rounding.
+    // Each row gives an interval for the starting accumulator; a nonempty
+    // intersection supplies an exact descriptor even at integer boundaries.
+    // Clamp plateaus or unrepresentable row sequences use the row runs below.
+    const double proposedStep = op->sourceDy * 65536.0;
+    if (isfinite(proposedStep) && proposedStep >= INT32_MIN && proposedStep <= INT32_MAX) {
+        const int32_t step = (int32_t)proposedStep;
+        int64_t lower = INT32_MIN, upper = INT32_MAX;
+        for (int32_t row = 0; row < height; ++row) {
+            const int64_t start = (int64_t)rows[row] * 65536 - (int64_t)row * step;
+            if (start > lower) lower = start;
+            if (start + 65535 < upper) upper = start + 65535;
+        }
+        if (lower <= upper) {
+            if (!capacity || !output) return false;
+            output[0] = (MisterOffscreenBlit){
+                .x = (int16_t)(left - viewX), .y = (int16_t)(top - viewY),
+                .width = (uint16_t)(right - left), .height = (uint16_t)height,
+                .u = (int32_t)u, .v = (int32_t)lower,
+                .du = (int32_t)op->stepU, .dv = step,
+            };
+            *count = 1;
+            return true;
+        }
+    }
+    MisterOffscreenBlit planned[MISTER_OFFSCREEN_MAX_BLITS];
+    size_t total = 0;
+    for (int32_t first = 0; first < height;) {
+        const int32_t delta = first + 1 < height ?
+            rows[first + 1] - rows[first] : 0;
+        int32_t end = first + 1;
+        if (end < height) {
+            ++end;
+            while (end < height && rows[end] - rows[end - 1] == delta) ++end;
+        }
+        planned[total++] = (MisterOffscreenBlit){
+            .x = (int16_t)(left - viewX),
+            .y = (int16_t)(top + first - viewY),
+            .width = (uint16_t)(right - left),
+            .height = (uint16_t)(end - first),
+            .u = (int32_t)u,
+            .v = rows[first] * 65536,
+            .du = (int32_t)op->stepU,
+            .dv = delta * 65536,
+        };
+        first = end;
+    }
+    if (total > capacity || (total && !output)) return false;
+    memcpy(output, planned, total * sizeof(*output));
+    *count = total;
+    return true;
+}
+
+bool MisterOffscreen_planAxis(const MisterOffscreenAxis* op,
+                             int32_t viewX, int32_t viewY,
+                             int32_t viewWidth, int32_t viewHeight,
+                             MisterOffscreenBlit* output, size_t capacity,
+                             size_t* count) {
+    return MisterOffscreen_planAxisTint(op, viewX, viewY, viewWidth, viewHeight,
+        output, capacity, count, false);
+}
diff --git a/src/mister_offscreen.h b/src/mister_offscreen.h
new file mode 100644
--- /dev/null
+++ b/src/mister_offscreen.h
@@ -0,0 +1,55 @@
+#pragma once
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+// An already-covered/scissored logical CPU axis draw. The source is immutable
+// until its deferred use completes; ownership is the caller's responsibility.
+// startU is quantized at x, not at the later visible-crop origin. CPU Y is
+// recomputed as sourceY0 + (((double)y + .5) - vertexY0) * sourceDy per row.
+typedef struct {
+    const uint32_t* source;
+    int32_t sourceWidth, sourceHeight;
+    int32_t x, y, width, height;
+    int64_t startU, stepU;
+    double sourceY0, sourceDy, vertexY0;
+    uint32_t tint;
+} MisterOffscreenAxis;
+
+// Existing opcode-2 axis descriptor geometry, relative to the visible crop.
+// The caller provides source address/stride, the original tint, and subtract
+// blend mode. Rows have exact integer source indices, not approximate Y steps.
+typedef struct {
+    int16_t x, y;
+    uint16_t width, height;
+    int32_t u, v, du, dv;
+} MisterOffscreenBlit;
+
+#define MISTER_OFFSCREEN_MAX_BLITS 240u
+
+// Exact scalar materialization of the full original logical coverage. Performs
+// validation before writing anything; reproduces per-channel floor tint and
+// ZERO/INV_SRC_COLOR blend, including alpha-zero RGB. Aliases retain CPU order.
+bool MisterOffscreen_replayAxis(uint32_t* target, int32_t targetWidth,
+                               int32_t targetHeight,
+                               const MisterOffscreenAxis* operation);
+
+// Conservative unchanged-RBF plan: binary (0/255) tint lanes, no visible X
+// clamp/overflow, exact CPU Y rows grouped into arithmetic-progression runs.
+// viewW/H must fit 320x240. Empty visible coverage succeeds with zero commands.
+// Failure leaves output untouched and sets *count to zero. Caller must rule out
+// source/destination aliasing and prove supported shader/blend/write state.
+bool MisterOffscreen_planAxis(const MisterOffscreenAxis* operation,
+                             int32_t viewX, int32_t viewY,
+                             int32_t viewWidth, int32_t viewHeight,
+                             MisterOffscreenBlit* output, size_t capacity,
+                             size_t* count);
+
+// Same sampling proof with arbitrary tint when the current RBF advertises
+// exact floor-tint opcode support. The caller must set that descriptor flag.
+bool MisterOffscreen_planAxisTint(const MisterOffscreenAxis* operation,
+                             int32_t viewX, int32_t viewY,
+                             int32_t viewWidth, int32_t viewHeight,
+                             MisterOffscreenBlit* output, size_t capacity,
+                             size_t* count, bool floorTint);
