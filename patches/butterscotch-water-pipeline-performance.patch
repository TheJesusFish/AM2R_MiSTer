+// Water must sample the application-surface export made in this command list.
+// The completed native buffer is one game frame older, so substituting it here
+// creates a visible stale-image band whenever the camera moves through lava.
+// Strip the HPS-only recognition marker and leave both the export and opcode 7
+// source intact.
+static void finalizeWaterExports(void) {
+    for (uint32_t i = 0; i < g_gpu_command_count; ++i) {
+        if ((uint8_t)g_gpu_commands[i].word[0] == 7u)
+            g_gpu_commands[i].word[0] &= ~GPU_WATER_NATIVE_ALIAS_FLAG;
+    }
+}
+
+// AM2R's underwater foreground is emitted as a clipped leading slice,
+// repeated 32-pixel slices, and a clipped trailing slice of the same source
+// tile.  Eleven independent partial-alpha blits make the FPGA repeatedly pay
+// descriptor, DDR, and read/modify/write setup costs.  Collapse only the exact
+// full-screen-width pattern into opcode 9.  The hardware fetches each 32-pixel
+// source row once and repeats it through its two-pixel blend pipeline.
+static uint32_t tryFuseRepeatedAdditiveTiles(void) {
+    uint32_t fusedCommands = 0;
+    uint32_t index = 0;
+    while (index < g_gpu_command_count) {
+        MisterGpuCommand *first = &g_gpu_commands[index];
+        if ((first->word[0] & 0x1ffu) != (2u | (1u << 8)) ||
+            (int16_t)first->word[2] != 0 ||
+            (int16_t)(first->word[2] >> 16) < 0 ||
+            (uint16_t)(first->word[0] >> 32) < GPU_REPEAT_TILE_MIN_HEIGHT ||
+            (uint16_t)(first->word[0] >> 32) > MISTER_HEIGHT ||
+            (uint16_t)(first->word[0] >> 16) == 0 ||
+            (uint16_t)(first->word[0] >> 16) > GPU_REPEAT_TILE_WIDTH ||
+            first->word[3] != 0 || first->word[7] != 0 ||
+            first->word[5] != UINT64_C(0x0001000000010000) ||
+            ((uint32_t)first->word[6] & 0x00ffffffu) != 0x00ffffffu ||
+            (uint8_t)(first->word[6] >> 24) == 0 ||
+            (uint8_t)(first->word[6] >> 24) == 255) {
+            index++;
+            continue;
+        }
+
+        uint32_t firstWidth = (uint16_t)(first->word[0] >> 16);
+        uint32_t height = (uint16_t)(first->word[0] >> 32);
+        int32_t destinationY = (int16_t)(first->word[2] >> 16);
+        if ((uint32_t)destinationY + height > MISTER_HEIGHT) {
+            index++;
+            continue;
+        }
+
+        uint32_t secondIndex = index + 1u;
+        if (secondIndex >= g_gpu_command_count) {
+            index++;
+            continue;
+        }
+        MisterGpuCommand *second = &g_gpu_commands[secondIndex];
+        int32_t baseU = firstWidth == GPU_REPEAT_TILE_WIDTH
+            ? (int32_t)first->word[4]
+            : (int32_t)second->word[4];
+        int64_t expectedFirstU = (int64_t)baseU +
+            (int64_t)(GPU_REPEAT_TILE_WIDTH - firstWidth) * 65536;
+        if (expectedFirstU < INT32_MIN || expectedFirstU > INT32_MAX ||
+            (int32_t)first->word[4] != (int32_t)expectedFirstU) {
+            index++;
+            continue;
+        }
+
+        uint32_t covered = 0;
+        uint32_t runEnd = index;
+        while (runEnd < g_gpu_command_count && covered < MISTER_WIDTH) {
+            MisterGpuCommand *command = &g_gpu_commands[runEnd];
+            uint32_t remaining = MISTER_WIDTH - covered;
+            uint32_t expectedWidth = runEnd == index
+                ? firstWidth
+                : (remaining < GPU_REPEAT_TILE_WIDTH
+                    ? remaining : GPU_REPEAT_TILE_WIDTH);
+            int32_t expectedU = runEnd == index
+                ? (int32_t)expectedFirstU : baseU;
+            if ((command->word[0] & 0x1ffu) != (2u | (1u << 8)) ||
+                (uint16_t)(command->word[0] >> 16) != expectedWidth ||
+                (uint16_t)(command->word[0] >> 32) != height ||
+                (int16_t)command->word[2] != (int32_t)covered ||
+                (int16_t)(command->word[2] >> 16) != destinationY ||
+                command->word[1] != first->word[1] ||
+                (int32_t)command->word[4] != expectedU ||
+                (uint32_t)(command->word[4] >> 32) !=
+                    (uint32_t)(first->word[4] >> 32) ||
+                command->word[5] != first->word[5] ||
+                command->word[6] != first->word[6] ||
+                command->word[3] != 0 || command->word[7] != 0)
+                break;
+            covered += expectedWidth;
+            runEnd++;
+        }
+        if (covered != MISTER_WIDTH || runEnd - index < 3u) {
+            index++;
+            continue;
+        }
+
+        int32_t sourceX = gpuFixedFloor(baseU);
+        int32_t sourceY = gpuFixedFloor((int32_t)(first->word[4] >> 32));
+        uint32_t source = (uint32_t)first->word[1];
+        uint32_t stride = (uint32_t)(first->word[1] >> 32);
+        uint64_t firstByte = (uint64_t)source + (uint64_t)sourceY * stride +
+            (uint64_t)sourceX * sizeof(uint32_t);
+        uint64_t lastByte = firstByte + (uint64_t)(height - 1u) * stride +
+            GPU_REPEAT_TILE_WIDTH * sizeof(uint32_t);
+        if (sourceX < 0 || sourceY < 0 || stride == 0 ||
+            source < GPU_TEXTURE_PHYS || firstByte < GPU_TEXTURE_PHYS ||
+            lastByte > (uint64_t)GPU_TEXTURE_PHYS + GPU_TEXTURE_BYTES) {
+            index++;
+            continue;
+        }
+
+        MisterGpuCommand fused = *first;
+        fused.word[0] = 9u | (1u << 8) |
+            ((uint64_t)MISTER_WIDTH << 16) | ((uint64_t)height << 32);
+        fused.word[3] = GPU_REPEAT_TILE_WIDTH - firstWidth;
+        fused.word[4] = (uint32_t)baseU |
+            ((uint64_t)(uint32_t)(first->word[4] >> 32) << 32);
+        fused.word[7] = 0;
+        g_gpu_commands[index] = fused;
+        memmove(&g_gpu_commands[index + 1u], &g_gpu_commands[runEnd],
+                (g_gpu_command_count - runEnd) * sizeof(MisterGpuCommand));
+        fusedCommands += runEnd - index - 1u;
+        g_gpu_command_count -= runEnd - index - 1u;
+        index++;
+    }
+    return fusedCommands;
+}
