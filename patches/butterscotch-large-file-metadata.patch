 static bool pathExists(const char* fullPath) {
+#ifdef _WIN32
     struct stat st;
     return stat(fullPath, &st) == 0;
+#else
+    // A 32-bit stat() reports EOVERFLOW for otherwise ordinary files on CIFS
+    // when the server supplies an inode number wider than ino_t. Existence
+    // checks do not need metadata, and access(F_OK) is not subject to that ABI
+    // conversion, so network saves remain visible without changing file I/O.
+    return access(fullPath, F_OK) == 0;
+#endif
 }
 
 // Returns a heap-allocated full path for reads. Absolute inputs pass through as-is.
