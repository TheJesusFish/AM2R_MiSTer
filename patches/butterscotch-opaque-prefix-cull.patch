+static int32_t gpuFixedFloor(int32_t value);
+
+static bool prepareTextureOpacity(MisterGpuTexture *record) {
+    if (record->opaque_generation == record->generation &&
+        record->opaque_pixels != NULL)
+        return true;
+    if (record->shadow == NULL || !record->shadow_valid || record->bytes < 4u)
+        return false;
+
+    size_t pixelCount = record->bytes / sizeof(uint32_t);
+    size_t wordCount = (pixelCount + 63u) / 64u;
+    if (record->opaque_word_count != wordCount) {
+        uint64_t *replacement = (uint64_t *)realloc(
+            record->opaque_pixels, wordCount * sizeof(uint64_t));
+        if (replacement == NULL) return false;
+        record->opaque_pixels = replacement;
+        record->opaque_word_count = wordCount;
+    }
+    memset(record->opaque_pixels, 0, wordCount * sizeof(uint64_t));
+    const uint32_t *pixels = (const uint32_t *)record->shadow;
+    for (size_t i = 0; i < pixelCount; ++i)
+        if ((pixels[i] >> 24) == 255u)
+            record->opaque_pixels[i >> 6] |= UINT64_C(1) << (i & 63u);
+    record->opaque_generation = record->generation;
+    return true;
+}
+
+static bool textureOpacityRangeIsSet(const MisterGpuTexture *record,
+                                     size_t firstPixel, size_t pixelCount) {
+    if (pixelCount == 0) return true;
+    size_t lastPixel = firstPixel + pixelCount - 1u;
+    size_t firstWord = firstPixel >> 6;
+    size_t lastWord = lastPixel >> 6;
+    if (lastWord >= record->opaque_word_count) return false;
+    uint64_t firstMask = UINT64_MAX << (firstPixel & 63u);
+    uint64_t lastMask = UINT64_MAX >> (63u - (lastPixel & 63u));
+    if (firstWord == lastWord)
+        return (record->opaque_pixels[firstWord] & firstMask & lastMask) ==
+            (firstMask & lastMask);
+    if ((record->opaque_pixels[firstWord] & firstMask) != firstMask)
+        return false;
+    for (size_t word = firstWord + 1u; word < lastWord; ++word)
+        if (record->opaque_pixels[word] != UINT64_MAX) return false;
+    return (record->opaque_pixels[lastWord] & lastMask) == lastMask;
+}
