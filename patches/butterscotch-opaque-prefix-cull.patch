+static bool axisCommandCanOverwrite(const MisterGpuCommand *command) {
+    return (command->word[0] & 0x1ffu) == 2u &&
+        (uint32_t)command->word[5] == 0x00010000u &&
+        (uint32_t)(command->word[5] >> 32) == 0x00010000u &&
+        (uint8_t)(command->word[6] >> 24) == 255u &&
+        command->word[7] == 0;
+}
+
+static void markAxisCommandCoverage(const MisterGpuCommand *command) {
+    int32_t destinationX = (int16_t)command->word[2];
+    int32_t destinationY = (int16_t)(command->word[2] >> 16);
+    int32_t firstX = destinationX < 0 ? -destinationX : 0;
+    int32_t firstY = destinationY < 0 ? -destinationY : 0;
+    int32_t lastX = (uint16_t)(command->word[0] >> 16);
+    int32_t lastY = (uint16_t)(command->word[0] >> 32);
+    if (destinationX + lastX > MISTER_WIDTH) lastX = MISTER_WIDTH - destinationX;
+    if (destinationY + lastY > MISTER_HEIGHT) lastY = MISTER_HEIGHT - destinationY;
+    if (firstX >= lastX || firstY >= lastY) return;
+
+    uint32_t outputFirstX = (uint32_t)(destinationX + firstX);
+    uint32_t outputLastX = (uint32_t)(destinationX + lastX);
+    uint32_t firstWord = outputFirstX >> 6;
+    uint32_t lastWord = (outputLastX - 1u) >> 6;
+    uint64_t firstMask = UINT64_MAX << (outputFirstX & 63u);
+    uint64_t lastMask = UINT64_MAX >> (63u - ((outputLastX - 1u) & 63u));
+    for (int32_t y = firstY; y < lastY; ++y) {
+        uint64_t *coverage = g_gpu_opaque_coverage[destinationY + y];
+        if (firstWord == lastWord) {
+            coverage[firstWord] |= firstMask & lastMask;
+            continue;
+        }
+        coverage[firstWord] |= firstMask;
+        for (uint32_t word = firstWord + 1u; word < lastWord; ++word)
+            coverage[word] = UINT64_MAX;
+        coverage[lastWord] |= lastMask;
+    }
+}
+
+static bool coverageIsFull(void) {
+    for (uint32_t y = 0; y < MISTER_HEIGHT; ++y)
+        for (uint32_t word = 0; word < MISTER_WIDTH / 64; ++word)
+            if (g_gpu_opaque_coverage[y][word] != UINT64_MAX) return false;
+    return true;
+}
+
+static bool axisCommandSourceIsOpaque(const MisterGpuCommand *command) {
+    size_t sourceBaseOffset = 0;
+    MisterGpuTexture *record = textureRecordForPhysical(
+        (uint32_t)command->word[1], &sourceBaseOffset);
+    if (record == NULL || record->shadow == NULL || !record->shadow_valid)
+        return false;
+
+    int32_t destinationX = (int16_t)command->word[2];
+    int32_t destinationY = (int16_t)(command->word[2] >> 16);
+    int32_t firstX = destinationX < 0 ? -destinationX : 0;
+    int32_t firstY = destinationY < 0 ? -destinationY : 0;
+    int32_t lastX = (uint16_t)(command->word[0] >> 16);
+    int32_t lastY = (uint16_t)(command->word[0] >> 32);
+    if (destinationX + lastX > MISTER_WIDTH) lastX = MISTER_WIDTH - destinationX;
+    if (destinationY + lastY > MISTER_HEIGHT) lastY = MISTER_HEIGHT - destinationY;
+    if (firstX >= lastX || firstY >= lastY) return true;
+
+    int32_t sourceX = gpuFixedFloor((int32_t)command->word[4]);
+    int32_t sourceY = gpuFixedFloor((int32_t)(command->word[4] >> 32));
+    uint32_t sourceStride = (uint32_t)(command->word[1] >> 32);
+    if (sourceX + firstX < 0 || sourceY + firstY < 0 || sourceStride == 0)
+        return false;
+
+    size_t firstOffset = sourceBaseOffset +
+        (size_t)(sourceY + firstY) * sourceStride +
+        (size_t)(sourceX + firstX) * sizeof(uint32_t);
+    size_t lastOffset = sourceBaseOffset +
+        (size_t)(sourceY + lastY - 1) * sourceStride +
+        (size_t)(sourceX + lastX - 1) * sizeof(uint32_t);
+    if (firstOffset > record->bytes || sizeof(uint32_t) > record->bytes - firstOffset ||
+        lastOffset > record->bytes || sizeof(uint32_t) > record->bytes - lastOffset)
+        return false;
+
+    if (!prepareTextureOpacity(record)) return false;
+    for (int32_t y = firstY; y < lastY; ++y) {
+        size_t rowOffset = sourceBaseOffset +
+            (size_t)(sourceY + y) * sourceStride +
+            (size_t)(sourceX + firstX) * sizeof(uint32_t);
+        if ((rowOffset & (sizeof(uint32_t) - 1u)) != 0 ||
+            !textureOpacityRangeIsSet(record, rowOffset / sizeof(uint32_t),
+                                      (size_t)(lastX - firstX)))
+            return false;
+    }
+    return true;
+}
