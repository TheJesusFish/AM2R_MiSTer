+static uint32_t cullFullyCoveredPrefix(void) {
+    // GameMaker often draws several independently scrolling room layers as
+    // screen-sized strips. If a later consecutive strip group covers every
+    // output pixel with opaque samples, everything before it is unobservable.
+    // Detect that condition from the exact CPU texture shadows rather than
+    // assuming a particular AM2R room or layer order.
+    uint32_t bestPrefix = 0;
+    uint32_t groupEnd = g_gpu_command_count;
+    while (groupEnd != 0) {
+        uint32_t groupStart = groupEnd - 1u;
+        if (!axisCommandCanOverwrite(&g_gpu_commands[groupStart])) {
+            groupEnd = groupStart;
+            continue;
+        }
+        uint64_t source = g_gpu_commands[groupStart].word[1];
+        while (groupStart != 0 &&
+               axisCommandCanOverwrite(&g_gpu_commands[groupStart - 1u]) &&
+               g_gpu_commands[groupStart - 1u].word[1] == source)
+            groupStart--;
+
+        memset(g_gpu_opaque_coverage, 0, sizeof(g_gpu_opaque_coverage));
+        for (uint32_t i = groupStart; i < groupEnd; ++i)
+            markAxisCommandCoverage(&g_gpu_commands[i]);
+        if (coverageIsFull()) {
+            bool opaque = true;
+            for (uint32_t i = groupStart; i < groupEnd && opaque; ++i)
+                opaque = axisCommandSourceIsOpaque(&g_gpu_commands[i]);
+            if (opaque) {
+                bestPrefix = groupStart;
+                break;
+            }
+        }
+        groupEnd = groupStart;
+    }
+
+    if (bestPrefix != 0) {
+        memmove(g_gpu_commands, &g_gpu_commands[bestPrefix],
+                (g_gpu_command_count - bestPrefix) * sizeof(MisterGpuCommand));
+        g_gpu_command_count -= bestPrefix;
+    }
+    return bestPrefix;
+}
