+static void am2rStateClose(void) {
+    // The control endpoint is deliberately invisible to DMTCP's socket
+    // plugin. Unix datagrams are unsupported there, and retaining their
+    // connection metadata makes an otherwise valid image crash on restart.
+    // This endpoint is always closed before capture and recreated afterward.
+    if (am2rStateFd >= 0) syscall(SYS_close, am2rStateFd);
+    am2rStateFd = -1;
+    unlink(AM2R_STATE_RUNNER_SOCKET);
+}
+
+static bool am2rStateOpen(void) {
+    am2rStateClose();
+    am2rStateFd = (int)syscall(SYS_socket, AF_UNIX, SOCK_DGRAM, 0);
+    if (am2rStateFd < 0) return false;
+
+    struct sockaddr_un runnerAddress = {0};
+    runnerAddress.sun_family = AF_UNIX;
+    strncpy(runnerAddress.sun_path, AM2R_STATE_RUNNER_SOCKET,
+            sizeof(runnerAddress.sun_path) - 1);
+    if (syscall(SYS_bind, am2rStateFd, (struct sockaddr*)&runnerAddress,
+                sizeof(runnerAddress)) != 0) {
+        am2rStateClose();
+        return false;
+    }
+    int flags = (int)syscall(SYS_fcntl, am2rStateFd, F_GETFL, 0);
+    if (flags >= 0)
+        syscall(SYS_fcntl, am2rStateFd, F_SETFL, flags | O_NONBLOCK);
+
+    memset(&am2rStateWrapperAddress, 0, sizeof(am2rStateWrapperAddress));
+    am2rStateWrapperAddress.sun_family = AF_UNIX;
+    strncpy(am2rStateWrapperAddress.sun_path, AM2R_STATE_WRAPPER_SOCKET,
+            sizeof(am2rStateWrapperAddress.sun_path) - 1);
+    return true;
+}
