+bool platformWaitForVblank(uint32_t timeoutUsec) {
+    if (g_gpu_control == NULL || g_vblank_status_disabled) return false;
+
+    __sync_synchronize();
+    if (g_gpu_control[GPU_VBLANK_MAGIC_WORD] != GPU_VBLANK_MAGIC) return false;
+
+    uint32_t current = g_gpu_control[GPU_VBLANK_COUNTER_WORD];
+    if (!g_vblank_counter_initialized) {
+        g_vblank_last_counter = current;
+        g_vblank_counter_initialized = true;
+    }
+
+    uint64_t deadline = nowNanos() + (uint64_t)timeoutUsec * 1000u;
+    while (nowNanos() < deadline) {
+        __sync_synchronize();
+        if (g_gpu_control[GPU_VBLANK_MAGIC_WORD] != GPU_VBLANK_MAGIC) {
+            g_vblank_status_disabled = true;
+            return false;
+        }
+        current = g_gpu_control[GPU_VBLANK_COUNTER_WORD];
+        if (current != g_vblank_last_counter) {
+            uint32_t elapsedFrames = current - g_vblank_last_counter;
+            g_vblank_last_counter = current;
+            if (!g_vblank_sync_reported) {
+                logInfo("MiSTer pacing: synchronized to FPGA native vblank\n");
+                g_vblank_sync_reported = true;
+            }
+            if (elapsedFrames > 1) {
+                static uint32_t missedVblankLogs = 0;
+                if (missedVblankLogs < 100) {
+                    logWarn("MiSTer pacing: %u raster intervals elapsed during one game tick\n",
+                            elapsedFrames);
+                    missedVblankLogs++;
+                }
+            }
+            return true;
+        }
+        // The heartbeat write is normally visible within a small fraction of
+        // a scanline. A short sleep avoids burning an HPS core for the entire
+        // frame while keeping the game-step phase tightly behind vblank.
+        usleep(50);
+    }
+
+    // A stale magic word can remain in DDR when a newer runner is paired with
+    // an older RBF. Disable further polling for this process and use the
+    // established absolute-timer path instead of adding a timeout every tick.
+    g_vblank_status_disabled = true;
+    logWarn("MiSTer pacing: FPGA vblank heartbeat unavailable; using timer fallback\n");
+    return false;
+}
