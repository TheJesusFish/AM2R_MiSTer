# AM2R wrapper for the untouched MiSTer framework file list. The only
# substitution is the core-local, explicit-RAM OSD implementation.
set am2r_sys_path sys

set_global_assignment -name QIP_FILE           [file join $am2r_sys_path [join [list pll_q [regexp -inline {[0-9]+} $quartus(version)] .qip] {}]]
set_global_assignment -name VERILOG_FILE       [file join $am2r_sys_path sys_top.v ]
set_global_assignment -name SDC_FILE           [file join $am2r_sys_path sys_top.sdc ]
set_global_assignment -name VHDL_FILE          [file join $am2r_sys_path ascal.vhd ]
set_global_assignment -name VHDL_FILE          [file join $am2r_sys_path pll_hdmi_adj.vhd ]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $am2r_sys_path math.sv ]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $am2r_sys_path hq2x.sv ]
set_global_assignment -name VERILOG_FILE       [file join $am2r_sys_path scandoubler.v ]
set_global_assignment -name VERILOG_FILE       [file join $am2r_sys_path scanlines.v ]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $am2r_sys_path shadowmask.sv ]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $am2r_sys_path video_cleaner.sv ]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $am2r_sys_path gamma_corr.sv ]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $am2r_sys_path video_mixer.sv ]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $am2r_sys_path video_freak.sv ]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $am2r_sys_path video_freezer.sv ]
set_global_assignment -name VERILOG_FILE       [file join $am2r_sys_path arcade_video.v ]
set_global_assignment -name VERILOG_FILE       [file join rtl am2r_osd.v ]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $am2r_sys_path vga_out.sv ]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $am2r_sys_path yc_out.sv ]
set_global_assignment -name VERILOG_FILE       [file join $am2r_sys_path i2c.v ]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $am2r_sys_path alsa.sv ]
set_global_assignment -name VERILOG_FILE       [file join $am2r_sys_path i2s.v ]
set_global_assignment -name VERILOG_FILE       [file join $am2r_sys_path spdif.v ]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $am2r_sys_path audio_out.sv ]
set_global_assignment -name VERILOG_FILE       [file join $am2r_sys_path iir_filter.v ]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $am2r_sys_path ltc2308.sv ]
set_global_assignment -name VERILOG_FILE       [file join $am2r_sys_path sigma_delta_dac.v ]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $am2r_sys_path mt32pi.sv ]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $am2r_sys_path mcp23009.sv ]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $am2r_sys_path f2sdram_safe_terminator.sv ]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $am2r_sys_path ddr_svc.sv ]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $am2r_sys_path sysmem.sv ]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $am2r_sys_path sd_card.sv ]
